--- lory.navigation and lory.display held, number for number, to what the
--- libraries they follow answer on fixed inputs: reference.mjs beside this
--- file ran Vuetify 4.3.1, TOAST UI Pagination 3.4.1, MUI 9.5.0,
--- @vuetify/v0 1.3.2 and Radix Themes 3.3.0 and wrote reference.json. Run
--- from the repository's root:
---
---     crow test tests/display/reference.co
---     crow test --compiled tests/display/reference.co
---
--- What a library computes in whole numbers or words (the pages shown,
--- TOAST UI's buttons and where its "more" buttons go, the crumbs MUI
--- shows, the spans a highlight marks, the keys a shortcut shows and its
--- label) is held exactly. Vuetify's circle is held to 2^-40 of its own
--- size (its numbers pass through JavaScript's floats as Lory's do). The
--- CSS animations were read back from headless Chrome, which keeps a
--- transform's angle in single precision and writes a length or an
--- opacity to six figures and a colour to 8 bits; each is held to that:
--- an angle to a thousandth of a degree, a length to 6 figures of the
--- largest it reaches, an opacity to a millionth, the skeleton's colour to
--- one step of 255. Each test logs how many it held and the farthest off.

use math
use lory
use lory.display
use lory.navigation

struct Tally [held, exact, worst, wrong]

fn _reference[]
    json[read['tests/display/reference.json']]

fn _tally[]
    Tally[0, 0, 0.0, slice[[''], 0, 0]]

--- one more answer that must be the library's exactly
fn _same[tally, what, ours, theirs]
    tally.held = tally.held + 1
    if ours eq theirs
        tally.exact = tally.exact + 1
        return tally
    tally.wrong = push[tally.wrong, '`what`: Lory `ours`, the library `theirs`']
    tally

--- one more number held within `within` of the library's
fn _near[tally, what, ours, theirs, within]
    tally.held = tally.held + 1
    off = abs[ours - theirs]
    if off eq 0.0
        tally.exact = tally.exact + 1
        return tally
    if off gt tally.worst
        tally.worst = off
    if off gt within
        tally.wrong = push[tally.wrong, '`what`: Lory `ours`, the library `theirs`']
    tally

--- an angle held within `within` degrees of the library's, a whole turn
--- either way
fn _turned[tally, what, ours, theirs, within]
    d = ours - theirs
    d = d - floor[d / 360.0 + 0.5] * 360.0
    _near[tally, what, theirs + d, theirs, within]

fn _told[tally, group]
    log['`group`: `tally.held` held, `tally.exact` exactly, the farthest off by `tally.worst`']
    len[tally.wrong] eq 0

fn _wrongs[tally]
    join[slice[tally.wrong, 0, 20], '\n']

--- a whole number of the reference's (JSON's numbers are read as floats)
fn _int_of[v]
    int[0.0 + v]

fn _wholes_of[parsed]
    out = []
    for v in parsed
        out = push[out, _int_of[v]]
    out

--- the reference's spans as Lory's, [start, end] (each pair is pushed as
--- a row of its own: Crow 0.9.0 lowers a pair of numbers read from JSON,
--- pushed as a list, to a pair of floats)
fn _spans_of[parsed]
    out = slice[[[0, 0]], 0, 0]
    for v in parsed
        row = slice[[0], 0, 0]
        row = push[row, int[0.0 + v[0]]]
        row = push[row, int[0.0 + v[1]]]
        out = push[out, row]
    out

fn _texts_of[parsed]
    out = slice[[''], 0, 0]
    for v in parsed
        out = push[out, str[v]]
    out

fn _flag[v]
    v eq true

test vuetifys_pages_shown_with_a_most_are_held[]
    t = _tally[]
    for one in _reference[]['windows']
        length = _int_of[one['length']]
        page = _int_of[one['page']]
        visible = _int_of[one['visible']]
        what = 'length `length`, page `page`, `visible` shown'
        items = navigation.pages_shown[length, page, visible]
        t = _same[t, '`what`: pages', items, _wholes_of[one['items']]]
        t = _same[t, '`what`: current', navigation.page_current[items, page], _int_of[one['current']]]
        off = navigation.arrows_off[length, page]
        t = _same[t, '`what`: before', off[0], _flag[one['prev_off']]]
        t = _same[t, '`what`: after', off[1], _flag[one['next_off']]]
    assert[_told[t, 'Vuetify total-visible'], _wrongs[t]]

test vuetifys_pages_fitted_to_a_width_are_held[]
    t = _tally[]
    for one in _reference[]['fitted']
        length = _int_of[one['length']]
        page = _int_of[one['page']]
        wide = 0.0 + one['width']
        what = 'length `length`, page `page`, `wide` wide'
        items = navigation.pages_fitted[length, page, wide]
        t = _same[t, '`what`: pages', items, _wholes_of[one['items']]]
        t = _same[t, '`what`: current', navigation.page_current[items, page], _int_of[one['current']]]
        off = navigation.arrows_off[length, page]
        t = _same[t, '`what`: before', off[0], _flag[one['prev_off']]]
        t = _same[t, '`what`: after', off[1], _flag[one['next_off']]]
    assert[_told[t, 'Vuetify fitted'], _wrongs[t]]

test toast_uis_buttons_and_more_buttons_are_held[]
    t = _tally[]
    for one in _reference[]['tui']
        total = _int_of[one['total']]
        per = _int_of[one['per']]
        visible = _int_of[one['visible']]
        centered = _flag[one['center']]
        page = _int_of[one['page']]
        what = '`total` by `per`, `visible` shown, centred `centered`, page `page`'
        t = _same[t, '`what`: buttons', navigation.page_buttons[total, per, page, visible, centered], _texts_of[one['buttons']]]
        t = _same[t, '`what`: more before', navigation.page_more[total, per, page, 'prev', visible, centered], _int_of[one['prev_more']]]
        t = _same[t, '`what`: more after', navigation.page_more[total, per, page, 'next', visible, centered], _int_of[one['next_more']]]
    assert[_told[t, 'TOAST UI'], _wrongs[t]]

--- (MUI's ellipsis is no crumb of its own: the reference lists the crumbs
--- shown, and the separators between all that is shown)
test muis_crumbs_shown_are_held[]
    t = _tally[]
    for one in _reference[]['crumbs']
        count = _int_of[one['count']]
        most = _int_of[one['most']]
        before = _int_of[one['before']]
        after = _int_of[one['after']]
        what = '`count` crumbs, most `most`, `before` before, `after` after'
        shown = navigation.crumbs_shown[count, most, before, after]
        kept = []
        for k in shown
            if k gte 0
                kept = push[kept, k]
        t = _same[t, '`what`: crumbs', kept, _wholes_of[one['shown']]]
        t = _same[t, '`what`: separators', max[0, len[shown] - 1], _int_of[one['between']]]
    assert[_told[t, 'MUI breadcrumbs'], _wrongs[t]]

test vuetifys_highlights_are_held[]
    t = _tally[]
    for one in _reference[]['highlights']
        words = str[one['text']]
        terms = _texts_of[one['query']]
        ignore_case = _flag[one['ignore_case']]
        match_all = _flag[one['match_all']]
        accents = str[one['accents']]
        joined = join[terms, '|']
        what = '`words` for `joined` (case `ignore_case`, all `match_all`, accents `accents`)'
        t = _same[t, what, display.highlight_ranges[words, terms, ignore_case, match_all, accents], _spans_of[one['ranges']]]
    for one in _reference[]['merged']
        t = _same[t, 'merged', display.ranges_merged[_spans_of[one['matches']]], _spans_of[one['ranges']]]
    assert[_told[t, 'Vuetify highlight'], _wrongs[t]]

test vuetifys_hotkeys_are_held[]
    t = _tally[]
    for one in _reference[]['hotkeys']
        shortcut = str[one['keys']]
        platform = str[one['platform']]
        mode = str[one['mode']]
        what = '`shortcut` on `platform` as `mode`'
        ours = display.hotkey_parts[shortcut, platform, mode]
        theirs = one['combinations']
        t = _same[t, '`what`: combinations', len[ours], len[theirs]]
        i = 0
        while i lt min[len[ours], len[theirs]]
            caps = ours[i]
            given = theirs[i]
            t = _same[t, '`what`: combination `i` length', len[caps], len[given]]
            j = 0
            while j lt min[len[caps], len[given]]
                cap = caps[j]
                g = given[j]
                t = _same[t, '`what`: `i`.`j` part', cap.part, str[g['part']]]
                t = _same[t, '`what`: `i`.`j` words', cap.words, str[g['words']]]
                t = _same[t, '`what`: `i`.`j` shown', cap.shown, str[g['shown']]]
                j = j + 1
            i = i + 1
        t = _same[t, '`what`: label', display.hotkey_label[shortcut, platform, mode], str[one['label']]]
    assert[_told[t, 'Vuetify hotkey'], _wrongs[t]]

test vuetifys_circle_is_held[]
    t = _tally[]
    for one in _reference[]['circles']
        value = 0.0 + one['value']
        size = 0.0 + one['size']
        width = 0.0 + one['width']
        rotate = 0.0 + one['rotate']
        rounded = _flag[one['rounded']]
        what = 'value `value`, `size` by `width`, turned `rotate`, rounded `rounded`'
        g = display.circle_geometry[value, size, width, rotate, rounded]
        within = 2.0 ^ -40 * max[1.0, max[abs[0.0 + one['view']], 0.0 + one['around']]]
        t = _near[t, '`what`: view', g[0], 0.0 + one['view'], within]
        t = _near[t, '`what`: stroke', g[1], 0.0 + one['stroke'], within]
        t = _near[t, '`what`: around', 2.0 * pi * 20.0, 0.0 + one['around'], within]
        t = _near[t, '`what`: offset', g[2], 0.0 + one['offset'], within]
        t = _near[t, '`what`: start', g[3], 0.0 + one['start'], within]
    assert[_told[t, 'Vuetify circle'], _wrongs[t]]

test the_animations_are_held_to_chromes[]
    j = _reference[]
    t = _tally[]
    for one in j['spin']
        at = 0.0 + one['t']
        parts = display.spin_parts[at]
        t = _turned[t, 'circle at `at`: its square turned', parts[0], 0.0 + one['svg'], 0.001]
        t = _turned[t, 'circle at `at`: its circle turned', parts[1], 0.0 + one['circle'], 0.001]
        t = _near[t, 'circle at `at`: dash', parts[2], 0.0 + one['dash'], 0.0005]
        t = _near[t, 'circle at `at`: offset', parts[3], 0.0 + one['offset'], 0.0005]
    for one in j['leaves']
        at = 0.0 + one['t']
        ours = display.spinner_leaves[at]
        turns = display.spinner_turns[]
        k = 0
        while k lt 8
            t = _near[t, 'spinner at `at`: leaf `k`', ours[k], 0.0 + one['opacity'][k], 0.000001]
            t = _turned[t, 'spinner: leaf `k` turned', turns[k], 0.0 + one['turn'][k], 0.001]
            k = k + 1
        t = _near[t, 'spinner at `at`: its opacity', display.spinner_opacity[], 0.0 + one['whole'], 0.000001]
    for one in j['pulse']
        at = 0.0 + one['t']
        t = _near[t, 'skeleton at `at`', display.skeleton_pulse[at], 0.0 + one['blue'], 1.0 / 255.0]
    for one in j['shimmer']
        at = 0.0 + one['t']
        t = _near[t, 'shimmer at `at`', display.shimmer_at[at], 0.0 + one['shift'], 0.000005]
    assert[_told[t, 'animations'], _wrongs[t]]
