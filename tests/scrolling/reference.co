--- lory.scrolling held, number for number, to what AOS 2.3.4 and
--- 3.0.0-beta.6, Motion 14.7.1, Lenis 1.3.27 and fullPage.js 4.0.41 did
--- on fixed pages in headless Chrome: reference.py beside this file ran
--- them (pages/) and wrote reference.json. Run from the repository's root:
---
---     crow test tests/scrolling/reference.co
---     crow test --compiled tests/scrolling/reference.co
---
--- A number is held when Lory's float is the library's, or differs from it
--- by no more than its tolerance: 2^-50 of the largest number its case
--- reaches for what is computed in doubles (a bézier's curve, Motion's
--- progress, Lenis's frames: exp and powers round a last bit apart on the
--- machine's maths library and V8's); 2^-22 of it for what the browser
--- keeps as a float (an element's opacity and its transform's matrix);
--- what is counted or named (a scroll at which an element is shown, a
--- section moved to, a callback's arguments) must be the library's
--- exactly. fullPage's times are its timers' (a move's callbacks 700 ms
--- apart), held to within the few milliseconds its timers wander. Each
--- test logs how many of its numbers it held, how many bit for bit, and
--- the farthest any of the rest was off.

use lory
use lory.scrolling

--- how many numbers were held, how many bit for bit, the farthest any was
--- off (a fraction of its case's size), and every one not held
struct Tally [held, exact, worst, wrong]

fn _reference[]
    json[read['tests/scrolling/reference.json']]

fn _tally[]
    Tally[0, 0, 0.0, slice[[''], 0, 0]]

--- the tally with one more number held to within `tolerance` of `size`
fn _near[tally, what, ours, theirs, size, tolerance]
    tally.held = tally.held + 1
    if ours eq theirs
        tally.exact = tally.exact + 1
        return tally
    scale = max[size, max[abs[ours], abs[theirs]]]
    off = abs[ours - theirs] / scale
    if off gt tally.worst
        tally.worst = off
    if not (off lte tolerance)
        tally.wrong = push[tally.wrong, '`what`: Lory `ours`, the library `theirs`']
    tally

fn _held[tally, what, ours, theirs, size]
    _near[tally, what, ours, theirs, size, 2.0 ^ -50]

--- a float the browser keeps (an opacity, a matrix's entry)
fn _float32[tally, what, ours, theirs]
    _near[tally, what, ours, theirs, 1.0, 2.0 ^ -22]

--- one more answer that must be the library's exactly
fn _same[tally, what, ours, theirs]
    tally.held = tally.held + 1
    if ours eq theirs
        tally.exact = tally.exact + 1
        return tally
    tally.wrong = push[tally.wrong, '`what`: Lory `ours`, the library `theirs`']
    tally

fn _same_words[tally, what, ours, theirs]
    tally.held = tally.held + 1
    if ours eq theirs
        tally.exact = tally.exact + 1
        return tally
    tally.wrong = push[tally.wrong, '`what`: Lory `ours`, the library `theirs`']
    tally

--- whether every number was held, after logging the group's counts
fn _told[tally, group]
    units = round[tally.worst * 2.0 ^ 52 * 100.0] / 100.0
    log['`group`: `tally.held` held, `tally.exact` bit for bit, the farthest off by `units` × 2^-52 of its case']
    for w in slice[tally.wrong, 0, min[12, len[tally.wrong]]]
        log['  not held: `w`']
    len[tally.wrong] eq 0

fn _numbers_of[parsed]
    out = []
    for i in range[0]
        out = push[out, 0.0]
    for v in parsed
        out = push[out, 0.0 + v]
    out

fn _words_or[j, key, otherwise]
    if key in j
        v = j[key]
        if v.ok
            return '`v`'
    otherwise

fn _number_in[j, key, otherwise]
    if key in j
        v = j[key]
        if v.ok
            return 0.0 + v
    otherwise

fn _flag_in[j, key]
    if key in j
        return j[key] eq true
    false

--- ---- AOS ----

--- the settings a run gave AOS.init
fn _aos_settings[run]
    s = run['settings']
    version = 3
    if '`run.version`' eq 'aos'
        version = 2
    scrolling.reveals[offset = _number_in[s, 'offset', 120.0], delay = _number_in[s, 'delay', 0.0], duration = _number_in[s, 'duration', 400.0], easing = _words_or[s, 'easing', 'ease'], once = _flag_in[s, 'once'], mirror = _flag_in[s, 'mirror'], placement = _words_or[s, 'anchorPlacement', 'top-bottom'], version = version]

--- an element of the page, as it was given its attributes (its anchor's
--- box found among the others)
fn _aos_element[c, everyone]
    r = scrolling.reveal['`c.id`', 'fade-up', 0.0 + c.top, 0.0 + c.height, 240.0, offset = _words_or[c, 'offset', ''], placement = _words_or[c, 'placement', ''], once = _words_or[c, 'once', ''], mirror = _words_or[c, 'mirror', '']]
    anchor = _words_or[c, 'anchor', '']
    if anchor ne ''
        for other in everyone
            if '#`other.id`' eq anchor
                r = scrolling.reveal_anchor[r, 0.0 + other.top, 0.0 + other.height]
    r

--- the scrolls at which a thing might turn: a step either side of each of
--- its triggers, and the page's ends
fn _candidates[points, most]
    out = []
    for i in range[0]
        out = push[out, 0.0]
    out = push[out, 0.0]
    for p in points
        base = floor[p]
        for k in [-1.0, 0.0, 1.0, 2.0]
            y = base + k
            if y gt 0.0 and y lt most
                out = push[out, y]
    out = push[out, most]
    sort[out]

--- a sweep of the page as the browser's was, through the scrolls where
--- anything can change: the turns it made ([scroll, 1 shown or 0 hidden])
--- and how it ends
struct Swept [turns, shown]

fn _sweep[o, r, view_tall, ys, shown]
    turns = []
    for i in range[0]
        turns = push[turns, [0.0, 0.0]]
    was = shown
    for y in ys
        now_shown = scrolling.reveal_shown[o, r, y, view_tall, was]
        if now_shown ne was
            on = 0.0
            if now_shown
                on = 1.0
            turns = push[turns, [y, on]]
            was = now_shown
    Swept[turns, was]

fn _turns_held[tally, what, ours, theirs]
    tally = _same[tally, '`what`: how many turns', len[ours], len[theirs]]
    if len[ours] eq len[theirs]
        i = 0
        for t in theirs
            tally = _same[tally, '`what` turn `i` at', ours[i][0], 0.0 + t[0]]
            tally = _same[tally, '`what` turn `i` to', ours[i][1], 0.0 + t[1]]
            i = i + 1
    tally

fn _aos_positions[run, tally]
    o = _aos_settings[run]
    view_tall = 0.0 + run.window_height
    most = 0.0 + run.max_scroll
    for c in run['cases']
        r = _aos_element[c, run['cases']]
        at = scrolling.reveal_in[o, r, view_tall]
        if o.version eq 2
            tally = _same[tally, '`c.id` position', at, 0.0 + c.position]
        else
            pos = c['position']
            tally = _same[tally, '`c.id` in', at, 0.0 + pos['in']]
            out_at = pos['out']
            if '`out_at`' ne 'false'
                tally = _same[tally, '`c.id` out', scrolling.reveal_out[o, r], 0.0 + out_at]
        points = []
        for i in range[0]
            points = push[points, 0.0]
        points = push[points, at]
        points = push[points, at - view_tall]
        points = push[points, scrolling.reveal_out[o, r]]
        ys = _candidates[points, most]
        first = scrolling.reveal_shown[o, r, 0.0, view_tall, false]
        down = _sweep[o, r, view_tall, ys, first]
        up = _sweep[o, r, view_tall, reverse[ys], down.shown]
        again = _sweep[o, r, view_tall, ys, up.shown]
        tally = _turns_held[tally, '`c.id` down', down.turns, c['down']]
        tally = _turns_held[tally, '`c.id` up', up.turns, c['up']]
        tally = _turns_held[tally, '`c.id` again', again.turns, c['again']]
    tally

--- 0.4s, 50ms: in milliseconds
fn _ms[words]
    if ends[words, 'ms']
        return 0.0 + float[slice[words, 0, len[words] - 2]]
    1000.0 * float[slice[words, 0, len[words] - 1]]

fn _curve_held[tally, what, ours, css]
    theirs = scrolling.css_curve[css]
    i = 0
    while i lt 4
        tally = _same[tally, '`what` curve `i`', ours[i], theirs[i]]
        i = i + 1
    tally

fn _aos_timing[run, tally]
    o = _aos_settings[run]
    for one in run['timing']
        attr = '`one.attr`'
        given = _words_or[one, 'value', '']
        r = scrolling.reveal['probe', 'fade-up', 0.0, 10.0]
        if attr eq 'data-aos-duration'
            r = scrolling.reveal['probe', 'fade-up', 0.0, 10.0, duration = given]
        if attr eq 'data-aos-delay'
            r = scrolling.reveal['probe', 'fade-up', 0.0, 10.0, delay = given]
        if attr eq 'data-aos-easing'
            r = scrolling.reveal['probe', 'fade-up', 0.0, 10.0, easing = given]
        what = '`attr`=`given`'
        tally = _same[tally, '`what` duration', scrolling.reveal_duration[o, r], _ms['`one.shown.duration`']]
        tally = _same[tally, '`what` duration hidden', scrolling.reveal_duration[o, r], _ms['`one.hidden.duration`']]
        tally = _same[tally, '`what` delay', scrolling.reveal_delay[o, r, true], _ms['`one.shown.delay`']]
        tally = _same[tally, '`what` delay hidden', scrolling.reveal_delay[o, r, false], _ms['`one.hidden.delay`']]
        curve = scrolling.aos_curve[scrolling.reveal_easing[o, r]]
        tally = _curve_held[tally, what, curve, '`one.shown.easing`']
    tally

fn _aos_curves[run, tally]
    for one in run['curves']
        name = '`one.name`'
        c = scrolling.aos_curve[name]
        tally = _curve_held[tally, name, c, '`one.css`']
        k = 0
        for y in one['at']
            x = (0.0 + k * 25) / 1000.0
            tally = _held[tally, '`name` at `x`', scrolling.bezier[c[0], c[1], c[2], c[3], x], 0.0 + y, 1.0]
            k = k + 1
    tally

fn _pose_held[tally, what, look, pose, seen]
    tally = _float32[tally, '`what` opacity', pose.opacity, 0.0 + seen.opacity]
    visible = '`seen.visibility`' eq 'visible'
    tally = _same[tally, '`what` visible', pose.visible, visible]
    m = scrolling.pose_matrix[look, pose]
    i = 0
    for x in seen['matrix']
        tally = _float32[tally, '`what` matrix `i`', m[i], 0.0 + x]
        i = i + 1
    tally

fn _aos_looks[run, tally]
    o = _aos_settings[run]
    for one in run['looks']
        look = '`one.name`'
        tally = _pose_held[tally, '`look` hidden', look, scrolling.reveal_pose[look, 0.0, 240.0, 120.0, o.version], one['hidden']]
        tally = _pose_held[tally, '`look` shown', look, scrolling.reveal_pose[look, 1.0, 240.0, 120.0, o.version], one['shown']]
        for b in one['between']
            v = (0.0 + b.t) / 1000.0
            tally = _pose_held[tally, '`look` at `b.t`', look, scrolling.reveal_pose[look, v, 240.0, 120.0, o.version], b]
    tally

--- a transition turned back: shown with its delay, held at 500 ms, then
--- hidden; the way back shortened
fn _aos_reversed[run, tally]
    o = _aos_settings[run]
    back = run['reversed']
    curve = scrolling.aos_curve['ease-out-quad']
    g = scrolling.going_to[scrolling.going_still[false], 0.0, 1.0, 200.0, 1000.0, curve]
    held_at = 0.0 + back.held_at
    v = scrolling.going_value[g, held_at]
    tally = _pose_held[tally, 'midway', 'fade-up', scrolling.reveal_pose['fade-up', v, 50.0, 50.0, o.version], back['midway']]
    returning = scrolling.going_to[g, held_at, 0.0, 0.0, 1000.0, curve]
    for a in back['returning']
        tally = _held[tally, 'way back duration', returning.lasting, 0.0 + a.duration, 1000.0]
        tally = _same[tally, 'way back delay', returning.delay, 0.0 + a.delay]
        prop = '`a.property`'
        for s in a['samples']
            at = scrolling.going_value[returning, held_at + (0.0 + s.t)]
            pose = scrolling.reveal_pose['fade-up', at, 50.0, 50.0, o.version]
            if prop eq 'opacity'
                tally = _float32[tally, 'way back opacity at `s.t`', pose.opacity, 0.0 + s.opacity]
            else
                tally = _float32[tally, 'way back y at `s.t`', pose.y, 0.0 + s.matrix[13]]
    tally

test aos_triggers_turns_timing_and_looks_hold_to_aos[]
    j = _reference[]
    t = _tally[]
    for key in ['aos?v=aos&run=defaults', 'aos?v=aos&run=once', 'aos?v=aos3&run=defaults', 'aos?v=aos3&run=moved', 'aos?v=aos3&run=once', 'aos?v=aos3&run=mirror', 'aos?v=aos3&run=timing']
        run = j[key]
        t = _aos_positions[run, t]
        t = _aos_timing[run, t]
        if 'curves' in run
            t = _aos_curves[run, t]
            t = _aos_looks[run, t]
            t = _aos_reversed[run, t]
    _told[t, 'AOS']

--- ---- Motion ----

--- an offset as Motion was given it: words, or a plain number (both edges)
fn _offset_words[v]
    words = '`v`'
    n = float[words]
    if n.ok
        return '`words` `words`'
    words

--- Motion's progress is lory.motion's (`motion.scroll_progress`), which
--- `linked_progress` hands the offsets to with `vh` and `vw` written as
--- pixels: what is held here is that progress, for every target and
--- offset Motion was given, at every scroll sampled
test scroll_offsets_and_progress_hold_to_motion[]
    j = _reference[]
    m = j['motion']
    t = _tally[]
    page_w = 1000.0
    page_h = 0.0 + m.client_height
    for s in m['samples']
        y = 0.0 + s.scroll
        for h in m['handlers']
            key = '`h.key`'
            view_tall = 0.0 + h.container_length
            ours = 0.0
            if key eq 'container'
                ours = scrolling.page_progress[y, 3000.0, view_tall]
            else
                offsets = slice[[''], 0, 0]
                for o in h['offset']
                    offsets = push[offsets, _offset_words[o]]
                ours = scrolling.linked_progress[y, view_tall, 0.0 + h.target_length, 0.0 + h.target_offset, offsets, page_w = page_w, page_h = page_h]
            t = _held[t, '`key` at `y`', ours, 0.0 + s.progress[key], 1.0]
    for p in m['page']
        ours = scrolling.page_progress[0.0 + p.scroll, 0.0 + p.scroll_length + p.container_length, 0.0 + p.container_length]
        t = _held[t, 'page at `p.scroll`', ours, 0.0 + p.progress, 1.0]
    _told[t, 'Motion']

--- ---- Lenis ----

fn _lenis_acted[s, act, limit]
    what = '`act[0]`'
    if what eq 'wheel'
        mode = 0
        if len[act] gt 2
            mode = 0 + act[2]
        return scrolling.smooth_wheel[s, 0.0 + act[1], mode]
    if what eq 'stop'
        return scrolling.smooth_stop[s]
    if what eq 'start'
        return scrolling.smooth_start[s]
    target = 0.0
    if '`act[1]`' eq 'bottom'
        target = limit
    else
        target = 0.0 + act[1]
    o = act[2]
    if not o.ok
        return scrolling.smooth_to[s, target]
    duration = _number_in[o, 'duration', -1.0]
    curve = _words_or[o, 'easing', '']
    scrolling.smooth_to[s, target, offset = _number_in[o, 'offset', 0.0], duration = duration, curve = curve, immediate = _flag_in[o, 'immediate']]

test smooth_scrolling_holds_to_lenis_frame_by_frame[]
    j = _reference[]
    l = j['lenis']
    t = _tally[]
    for c in l['cases']
        name = '`c.name`'
        o = c['options']
        limit = 0.0 + c.limit
        s = scrolling.smooth[limit, lerp = _number_in[o, 'lerp', 0.1], multiplier = _number_in[o, 'wheelMultiplier', 1.0], duration = _number_in[o, 'duration', 0.0], page = 0.0 + l.window_height, at = 0.0 + c.start]
        s = scrolling.smooth_frame[s, 1000.0]
        k = 0
        for f in c['frames']
            given = '`k`'
            if given in c['at']
                for act in c['at'][given]
                    s = _lenis_acted[s, act, limit]
            s = scrolling.smooth_frame[s, 0.0 + f[0]]
            size = max[1.0, limit]
            t = _held[t, '`name` frame `k` scroll', s.at, 0.0 + f[1], size]
            t = _held[t, '`name` frame `k` aim', s.aim, 0.0 + f[2], size]
            t = _held[t, '`name` frame `k` velocity', s.velocity, 0.0 + f[3], size]
            t = _held[t, '`name` frame `k` progress', scrolling.smooth_progress[s], 0.0 + f[4], 1.0]
            t = _same[t, '`name` frame `k` moving', s.moving, '`f[5]`' eq 'smooth']
            k = k + 1
    _told[t, 'Lenis']

--- ---- fullPage ----
---
--- Each run of pages/fullpage.html is played again on Lory's pages: the
--- same sections and options, the same keys, wheel turns, presses, hashes
--- and calls at the times the page made them (each just after the state
--- before it was read), and every state the page read held: the section
--- and slide shown, the hash, the body's `fp-viewing-` word, the history's
--- length, where the wrapper and the slides were sent, the order the
--- sections were laid in, the page's scroll, and every callback, its
--- arguments exactly and its time within 10 ms (fullPage takes a key a few
--- milliseconds after it is pressed). The state just after a key is not
--- held: fullPage has not yet taken it.

--- a callback's argument as fullPage gave it: a section or slide by its
--- index, nothing as ''
fn _fp_word[a]
    w = '`a`'
    if starts[w, '[']
        return '`a.index`'
    if w eq 'error: null'
        return ''
    w

fn _fp_name[name]
    if name eq 'beforeLeave'
        return 'before_leave'
    if name eq 'onLeave'
        return 'on_leave'
    if name eq 'afterLoad'
        return 'after_load'
    if name eq 'afterRender'
        return 'after_render'
    if name eq 'afterResponsive'
        return 'after_responsive'
    if name eq 'afterSlideLoad'
        return 'after_slide_load'
    if name eq 'onSlideLeave'
        return 'on_slide_leave'
    if name eq 'onScrollOverflow'
        return 'on_scroll_overflow'
    name

--- a callback Lory told, written as fullPage's arguments are
fn _told_words[e]
    n = e.name
    if n eq 'after_render'
        return '`n` `e.section` '
    if n eq 'after_responsive'
        if e.num gt 0.5
            return '`n` true'
        return '`n` false'
    if n eq 'on_slide_leave' or n eq 'after_slide_load'
        return '`n` `e.section` `e.slide` `e.to_slide` `e.direction` `e.trigger`'
    if n eq 'on_scroll_overflow'
        slide = ''
        if e.slide gte 0
            slide = '`e.slide`'
        at = _whole_words[e.num]
        return '`n` `e.section` `slide` `at` `e.direction`'
    '`n` `e.section` `e.to` `e.direction` `e.trigger`'

fn _call_words[calls, k]
    c = calls[k]
    out = _fp_name['`c.name`']
    for a in c['args']
        w = ''
        if a.ok
            w = _fp_word[a]
        out = '`out` `w`'
    out

--- a whole number as JavaScript writes one ('400', not '400.0')
fn _whole_words[x]
    if x eq floor[x]
        whole = int[x]
        return '`whole`'
    '`x`'

fn _words_number[words, otherwise]
    n = float[trim[words]]
    if not n.ok
        return otherwise
    0.0 + n

fn _within[tally, what, ours, theirs, tolerance]
    tally.held = tally.held + 1
    if ours eq theirs
        tally.exact = tally.exact + 1
        return tally
    if abs[ours - theirs] gt tolerance
        tally.wrong = push[tally.wrong, '`what`: Lory `ours`, the library `theirs`']
    tally

fn _fp_calls[tally, what, p, calls, from = 0]
    mine = slice[p.told, 0, 0]
    for e in p.told
        if e.name ne 'media_play' and e.name ne 'media_pause'
            mine = push[mine, e]
    tally = _same[tally, '`what`: how many callbacks', len[mine], len[calls] - from]
    k = 0
    while k lt min[len[mine], len[calls] - from]
        c = calls[k + from]
        tally = _same_words[tally, '`what`: callback `k`', _told_words[mine[k]], _call_words[calls, k + from]]
        tally = _within[tally, '`what`: callback `k` time', mine[k].t, 0.0 + c.t, 10.0]
        k = k + 1
    tally

--- the number in a CSS length or a translate3d's piece ('-713px')
fn _px[words]
    _words_number[replace[replace[trim[words], 'translate3d(', ''], 'px', ''], 0.0]

fn _fp_state[tally, what, p, s, run]
    tally = _same[tally, '`what`: section', scrolling.page_index[p], 0 + s.section]
    slide = -1
    sw = '`s.slide`'
    if sw ne 'error: null'
        slide = 0 + s.slide
    tally = _same[tally, '`what`: slide', scrolling.page_slide[p], slide]
    tally = _same_words[tally, '`what`: hash', p.hash, '`s.hash`']
    tally = _same[tally, '`what`: history', len[p.history], 0 + s.history]
    if run ne 'continuous'
        viewing = ''
        for w in split['`s.body`', ' ']
            if starts[w, 'fp-viewing-']
                viewing = w
        v = scrolling.page_viewing[p]
        tally = _same_words[tally, '`what`: viewing', 'fp-viewing-`v`', viewing]
    tf = '`s.transform`'
    if starts[tf, 'translate3d(']
        tally = _same[tally, '`what`: wrapper sent to', 0.0 - scrolling.page_offset[p], _px[split[tf, ','][1]]]
    top = '`s.top`'
    if top ne '' and scrolling.page_mode[p] eq 'script'
        tally = _same[tally, '`what`: wrapper top', 0.0 - scrolling.page_offset[p], _px[top]]
    mode = scrolling.page_mode[p]
    if mode eq 'free' or mode eq 'bar'
        tally = _same[tally, '`what`: page scroll', p.y, 0.0 + s.scroll]
    laid = slice[[0], 0, 0]
    for i in s['order']
        k = int[0.0 + i]
        if not p.sections[k].hidden
            laid = push[laid, k]
    tally = _same_words[tally, '`what`: order', '`p.order`', '`laid`']
    if 'slides' in s
        sl = s['slides']
        st = '`sl.transform`'
        x = 0.0
        if starts[st, 'translate3d(']
            x = 0.0 - _px[split[st, ','][0]]
        tally = _same[tally, '`what`: slides sent to', scrolling.page_slides_offset[p, p.at], x]
    _fp_calls[tally, what, p, s['calls']]

fn _five[]
    out = [scrolling.section[]]
    k = 1
    while k lt 5
        out = push[out, scrolling.section[]]
        k = k + 1
    out

fn _named_five[]
    out = [scrolling.section[name = 'one']]
    for n in ['two', 'three', 'four', 'five']
        out = push[out, scrolling.section[name = n]]
    out

fn _plain[n]
    out = [scrolling.section[]]
    k = 1
    while k lt n
        out = push[out, scrolling.section[]]
        k = k + 1
    out

--- a key as the page pressed it
fn _fp_key[p, did, t]
    if did eq 'Space'
        return scrolling.page_key[p, ' ', t]
    if did eq 'shift+Space'
        return scrolling.page_key[p, ' ', t, shift = true]
    scrolling.page_key[p, did, t]

fn _fp_defaults[run, tally]
    o = scrolling.page_options[]
    theirs = run['options']
    tally = _same[tally, 'scrollingSpeed', o.speed, 0.0 + theirs.scrollingSpeed]
    tally = _same_words[tally, 'easingcss3', o.easing, '`theirs.easingcss3`']
    tally = _same_words[tally, 'loopTop', '`o.loop_top`', '`theirs.loopTop`']
    tally = _same_words[tally, 'loopBottom', '`o.loop_bottom`', '`theirs.loopBottom`']
    tally = _same_words[tally, 'continuousVertical', '`o.continuous`', '`theirs.continuousVertical`']
    tally = _same_words[tally, 'loopHorizontal', '`o.loop_slides`', '`theirs.loopHorizontal`']
    tally = _same_words[tally, 'keyboardScrolling', '`o.keyboard`', '`theirs.keyboardScrolling`']
    tally = _same_words[tally, 'lockAnchors', '`o.lock_anchors`', '`theirs.lockAnchors`']
    tally = _same_words[tally, 'recordHistory', '`o.record_history`', '`theirs.recordHistory`']
    tally = _same_words[tally, 'animateAnchor', '`o.animate_anchor`', '`theirs.animateAnchor`']
    tally = _same_words[tally, 'autoScrolling', '`o.auto`', '`theirs.autoScrolling`']
    tally = _same_words[tally, 'fitToSection', '`o.fit`', '`theirs.fitToSection`']
    tally = _same[tally, 'fitToSectionDelay', o.fit_delay, 0.0 + theirs.fitToSectionDelay]
    tally = _same[tally, 'responsiveWidth', o.responsive_w, 0.0 + theirs.responsiveWidth]
    tally = _same[tally, 'responsiveHeight', o.responsive_h, 0.0 + theirs.responsiveHeight]
    tally = _same[tally, 'lazyLoadThreshold', o.lazy_ahead, 0 + theirs.lazyLoadThreshold]
    tally = _same_words[tally, 'scrollBar', '`o.scroll_bar`', '`theirs.scrollBar`']
    tally = _same_words[tally, 'css3', '`not o.by_script`', '`theirs.css3`']
    tally = _same_words[tally, 'navigation', '`o.nav`', '`theirs.navigation`']
    tally = _same_words[tally, 'navigationPosition', o.nav_side, '`theirs.navigationPosition`']
    tally = _same_words[tally, 'showActiveTooltip', '`o.show_tooltip`', '`theirs.showActiveTooltip`']
    tally = _same_words[tally, 'slidesNavigation', '`o.slides_nav`', '`theirs.slidesNavigation`']
    tally = _same_words[tally, 'controlArrows', '`o.arrows`', '`theirs.controlArrows`']
    tally = _same_words[tally, 'scrollOverflowReset', '`o.overflow_reset`', '`theirs.scrollOverflowReset`']
    p = scrolling.pages[_five[], 1000.0, 713.0, o, t = 3.0]
    tally = _fp_state[tally, 'defaults start', p, run['first'], 'defaults']
    k = 0
    for r in run['sections']
        tally = _same[tally, 'section `k` top', scrolling.page_dot_item[p, 0][0] * 0.0 + (0.0 + k) * 713.0, 0.0 + r[1]]
        tally = _same[tally, 'section `k` height', 713.0, 0.0 + r[3]]
        k = k + 1
    tally

--- steps one after another, each act made at the time the state before
--- it was read
fn _fp_keys[run, tally]
    sections = _named_five[]
    sections[1] = scrolling.section[name = 'two', slides = 3]
    p = scrolling.pages[sections, 1000.0, 713.0, scrolling.page_options[], t = 3.0]
    steps = run['steps']
    tally = _fp_state[tally, 'keys start', p, steps[0], 'keys']
    p = scrolling.pages_taken[p]
    k = 1
    while k lt len[steps]
        s = steps[k]
        p = _fp_key[p, '`s.did`', 0.0 + steps[k - 1].t]
        p = scrolling.pages_at[p, 0.0 + s.t]
        tally = _fp_state[tally, 'keys `k` `s.did`', p, s, 'keys']
        p = scrolling.pages_taken[p]
        k = k + 1
    tally

fn _fp_lock[run, tally]
    p = scrolling.pages[_plain[10], 1000.0, 713.0, scrolling.page_options[], t = 3.0]
    p = scrolling.pages_taken[p]
    begin = 0.0 + run.begin
    t = begin
    while t lt begin + 4000.0
        p = scrolling.page_key[p, 'ArrowDown', t]
        t = t + 5.0
    held = run['held']
    p = scrolling.pages_at[p, 0.0 + held.t]
    tally = _same[tally, 'held: section', scrolling.page_index[p], 0 + held.section]
    tally = _fp_calls[tally, 'held', p, held['calls'], from = 2]
    p = scrolling.pages_taken[p]
    p = scrolling.page_move_to[p, 0, 0.0 + held.t]
    back = run['back']
    p = scrolling.pages_at[p, 0.0 + back.t]
    tally = _fp_state[tally, 'moveTo 1', p, back, 'lock']
    p = scrolling.pages_taken[p]
    p = scrolling.page_down[p, 0.0 + back.t]
    p = scrolling.page_down[p, 0.0 + back.t + 200.0]
    api = run['api']
    p = scrolling.pages_at[p, 0.0 + api.t]
    tally = _fp_state[tally, 'moveSectionDown twice, 200 ms apart', p, api, 'lock']
    p = scrolling.pages_taken[p]
    p = scrolling.page_down[p, 0.0 + api.t]
    p = scrolling.page_down[p, 0.0 + api.t + 705.0]
    after = run['after']
    p = scrolling.pages_at[p, 0.0 + after.t]
    _fp_state[tally, 'moveSectionDown twice, 705 ms apart', p, after, 'lock']

fn _fp_wheel[run, tally]
    p = scrolling.pages[_plain[40], 1000.0, 713.0, scrolling.page_options[], t = 3.0]
    p = scrolling.pages_taken[p]
    from = 2
    for c in run['cases']
        name = '`c.name`'
        for sent in c['sent']
            p = scrolling.page_wheel[p, 0.0 + sent[1], 0.0 + sent[0]]
        seen = c['seen']
        p = scrolling.pages_at[p, 0.0 + seen.t]
        tally = _same[tally, '`name`: section', scrolling.page_index[p], 0 + seen.section]
        tally = _fp_calls[tally, name, p, seen['calls'], from = from]
        from = 0
        p = scrolling.pages_taken[p]
    tally

fn _box_held[tally, what, ours, theirs]
    i = 0
    for x in theirs
        tally = _same[tally, '`what` `i`', ours[i], 0.0 + x]
        i = i + 1
    tally

fn _fp_nav[run, tally]
    sections = _named_five[]
    sections[1] = scrolling.section[name = 'two', slides = 3]
    sections[2] = scrolling.section[name = 'three', tooltip = 'From data']
    o = scrolling.page_options[nav = true, tooltips = 'First Second', show_tooltip = true, slides_nav = true]
    p = scrolling.pages[sections, 1000.0, 713.0, o, t = 5.0]
    nav = run['nav']
    tally = _box_held[tally, 'nav box', scrolling.page_nav_box[p], nav['rect']]
    k = 0
    for d in run['dots']
        tally = _box_held[tally, 'dot `k` item', scrolling.page_dot_item[p, k], d['rect']]
        tally = _box_held[tally, 'dot `k`', scrolling.page_dot_box[p, k], d['dot']]
        tip = ''
        given = d['tip']
        if given.ok
            tip = '`given`'
        tally = _same_words[tally, 'dot `k` tooltip', scrolling.page_tooltip[p, k], tip]
        tally = _same_words[tally, 'dot `k` link', '#`sections[k].name`', '`d.link`']
        k = k + 1
    steps = run['steps']
    tally = _fp_state[tally, 'nav start', p, steps[0], 'nav']
    p = scrolling.pages_taken[p]
    k = 1
    while k lt len[steps]
        s = steps[k]
        did = '`s.did`'
        t = 0.0 + steps[k - 1].t
        if starts[did, 'dot ']
            dot = 0
            for d in [1, 2, 3, 4]
                if did eq 'dot `d`'
                    dot = d
            p = scrolling.page_dot[p, dot, t]
        if starts[did, 'slide dot ']
            p = scrolling.page_slide_dot[p, 2, t]
        if starts[did, 'menu ']
            p = scrolling.page_menu[p, 'four', t]
        p = scrolling.pages_at[p, 0.0 + s.t]
        tally = _fp_state[tally, 'nav `did`', p, s, 'nav']
        if 'menu' in s
            m = 0
            for active in s['menu']
                yes = '`active`' eq 'active'
                tally = _same[tally, 'nav `did` menu `m`', sections[m].name eq scrolling.page_menu_active[p], yes]
                m = m + 1
        p = scrolling.pages_taken[p]
        k = k + 1
    m = 0
    for d in run['slide_dots']
        b = scrolling.page_slide_dot_box[p, m]
        b[1] = b[1] + 713.0
        tally = _box_held[tally, 'slide dot `m`', b, d['rect']]
        m = m + 1
    left = scrolling.pages[_five[], 1000.0, 713.0, scrolling.page_options[nav = true, nav_side = 'left'], t = 5.0]
    lr = run['left']
    _box_held[tally, 'nav on the left', scrolling.page_nav_box[left], lr['rect']]

fn _fp_anchors[run, still, tally]
    sections = _named_five[]
    sections[1] = scrolling.section[name = 'two', slides = 3, slide_names = 's0 s1 s2']
    o = scrolling.page_options[animate_anchor = not still]
    if still
        sections = _named_five[]
    p = scrolling.pages[sections, 1000.0, 713.0, o, t = 3.0, address = '#three']
    steps = run['steps']
    --- (fullPage reads its address a moment after it is drawn: the state
    --- read at once holds its first callback, and the move it begins is
    --- told with the next)
    first = p
    first.told = slice[p.told, 0, 1]
    tally = _fp_calls[tally, 'opened', first, steps[0]['calls']]
    p.told = slice[p.told, 1, len[p.told]]
    k = 1
    while k lt len[steps]
        s = steps[k]
        did = '`s.did`'
        t = 0.0 + steps[k - 1].t
        if starts[did, 'hash ']
            p = scrolling.page_hash[p, slice[did, 5, len[did]], t]
        if did eq 'moveTo four'
            p = scrolling.page_move_to[p, scrolling.page_named[p, 'four'], t]
        if did eq 'moveTo 2, 2'
            p = scrolling.page_move_to[p, 1, t, slide = 2]
        if did eq 'silentMoveTo 1'
            p = scrolling.page_silent_to[p, 0, t]
        if did eq 'history back'
            p = scrolling.page_back[p, t]
        if did eq 'setLockAnchors true, hash #five'
            p = scrolling.page_lock_anchors[p, true]
            p = scrolling.page_hash[p, '#five', t]
        if did eq 'setRecordHistory false, moveTo 3'
            p = scrolling.page_lock_anchors[p, false]
            p = scrolling.page_record_history[p, false]
            p = scrolling.page_move_to[p, 2, t]
        if did eq 'moveTo 4'
            p = scrolling.page_move_to[p, 3, t]
        p = scrolling.pages_at[p, 0.0 + s.t]
        tally = _fp_state[tally, 'anchors `did`', p, s, 'anchors']
        if did eq 'silentMoveTo 1'
            tally = _same_words[tally, 'silentMoveTo transition', p.transition, '`s.transition`']
        if still
            tally = _same_words[tally, 'still transition', p.transition, '`s.transition`']
        p = scrolling.pages_taken[p]
        k = k + 1
    tally

--- keys, each held one state just after (not yet taken) and one after
--- its move: loops, and continuous scrolling's order mid-move
fn _fp_looped[run, o, name, tally]
    p = scrolling.pages[_five[], 1000.0, 713.0, o, t = 3.0]
    steps = run['steps']
    tally = _fp_state[tally, '`name` start', p, steps[0], name]
    p = scrolling.pages_taken[p]
    pressed = 0.0
    k = 1
    while k lt len[steps]
        s = steps[k]
        did = '`s.did`'
        if ends[did, ', at once']
            pressed = 0.0 + s.t
            p = _fp_key[p, slice[did, 0, len[did] - 9], pressed]
        else
            p = scrolling.pages_at[p, 0.0 + s.t]
            tally = _fp_state[tally, '`name` `did`', p, s, name]
            p = scrolling.pages_taken[p]
        k = k + 1
    tally

fn _arrow_shown[p, side]
    if scrolling.page_arrow_shown[p, side]
        return 'block'
    'none'

fn _fp_slides[run, still, tally]
    sections = [scrolling.section[], scrolling.section[slides = 4], scrolling.section[]]
    o = scrolling.page_options[slides_nav = true]
    if still
        o = scrolling.page_options[loop_slides = false, arrow_color = '#00aa00']
    p = scrolling.pages[sections, 1000.0, 713.0, o, t = 3.0]
    p = scrolling.page_move_to[p, 1, 303.6]
    steps = run['steps']
    if not still
        a = run['arrows']
        prev = scrolling.page_arrow_box[p, 'prev']
        prev[1] = prev[1] + 713.0
        nxt = scrolling.page_arrow_box[p, 'next']
        nxt[1] = nxt[1] + 713.0
        tally = _box_held[tally, 'prev arrow', prev, a[0]['rect']]
        tally = _box_held[tally, 'next arrow', nxt, a[1]['rect']]
        p = scrolling.pages_at[p, 0.0 + steps[0].t]
        tally = _fp_state[tally, 'at the slides', p, steps[0], 'slides']
        p = scrolling.pages_taken[p]
    else
        p = scrolling.pages_at[p, 0.0 + steps[0].t]
        tally = _fp_state[tally, 'still start', p, steps[0], 'slides']
        p = scrolling.pages_taken[p]
    k = 1
    last_t = 0.0 + run['steps'][0].t
    while k lt len[steps]
        s = steps[k]
        did = '`s.did`'
        t = last_t
        if 'at_once' in s
            t = 0.0 + s['at_once'].t
        if starts[did, 'next']
            p = scrolling.page_arrow[p, 'next', t]
        if starts[did, 'prev']
            p = scrolling.page_arrow[p, 'prev', t]
        if starts[did, 'ArrowLeft']
            p = scrolling.page_key[p, 'ArrowLeft', t]
        if starts[did, 'ArrowRight']
            p = scrolling.page_key[p, 'ArrowRight', t]
        if starts[did, 'ArrowDown']
            p = scrolling.page_key[p, 'ArrowDown', t]
        if starts[did, 'ArrowUp']
            p = scrolling.page_key[p, 'ArrowUp', t]
        if did eq 'slide dot 1'
            p = scrolling.page_slide_dot[p, 1, t]
        if did eq 'moveSlideRight'
            p = scrolling.page_slide_right[p, t]
        if did eq 'moveSlideLeft'
            p = scrolling.page_slide_left[p, t]
        if 'at_once' in s and not starts[did, 'Arrow']
            once = s['at_once']
            tally = _fp_state[tally, '`did`, at once', p, once, 'slides']
            p = scrolling.pages_taken[p]
        p = scrolling.pages_at[p, 0.0 + s.t]
        tally = _fp_state[tally, 'slides `did`', p, s, 'slides']
        shown = s['arrows']
        if len[shown] eq 2
            tally = _same_words[tally, '`did` prev arrow', _arrow_shown[p, 'prev'], '`shown[0]`']
            tally = _same_words[tally, '`did` next arrow', _arrow_shown[p, 'next'], '`shown[1]`']
        else
            tally = _same[tally, '`did` no arrows', scrolling.page_arrow_shown[p, 'next'], false]
        p = scrolling.pages_taken[p]
        last_t = 0.0 + s.t
        k = k + 1
    tally

--- ---- fullPage's curves ----
---
--- A curve fullPage scrolls by script is sampled every 4 ms, a sample
--- written where it changed. fullPage's clock for it starts at its first
--- frame, one frame (16 ms) after the move begins, and takes a key a few
--- milliseconds late: so each sample shows the curve as it stood between
--- 11 and 22 ms before. A sample is held where Lory's move (begun when it
--- is asked; a fit, when its pause is over) shows the sample's value at
--- some time in that stretch: the page's scroll in whole pixels, the
--- wrapper's top to the six digits the browser writes.

--- the first time from `lo` to `hi` at which the move has come to
--- `value` (`rising`: up to it; else down to it), found by halving
fn _reached[p, lo, hi, value, rising, sign]
    if _come[p, lo, value, rising, sign]
        return lo
    if not _come[p, hi, value, rising, sign]
        return hi + 1000.0
    a = lo
    b = hi
    k = 0
    while k lt 50
        m = (a + b) / 2.0
        if _come[p, m, value, rising, sign]
            b = m
        else
            a = m
        k = k + 1
    b

fn _come[p, tau, value, rising, sign]
    y = sign * scrolling.page_y_at[p, tau]
    if rising
        return y gte value
    y lte value

fn _fp_curve_held[tally, what, p, curve, begin, field]
    sign = 1.0
    if field eq 2
        sign = -1.0
    first = curve[0]
    last = curve[len[curve] - 1]
    origin = 0.0 + first[1]
    to = 0.0 + last[1]
    if field eq 2
        origin = _px['`first[2]`']
        to = _px['`last[2]`']
    rising = to gt origin
    lo = begin - 50.0
    hi = begin + 2000.0
    for sample in curve
        s = 0.0 + sample[0]
        v = 0.0 + sample[1]
        if field eq 2
            v = _px['`sample[2]`']
        near = 0.5
        if field eq 2
            near = 0.000005 * max[1.0, abs[v]]
        a = 0.0
        b = 0.0
        if rising
            a = _reached[p, lo, hi, v - near, true, sign]
            b = _reached[p, lo, hi, v + near, true, sign]
        else
            a = _reached[p, lo, hi, v + near, false, sign]
            b = _reached[p, lo, hi, v - near, false, sign]
        if v eq to
            b = hi + 1000.0
        if v eq origin
            a = lo
        tally.held = tally.held + 1
        from_t = begin + s - 22.0
        until = begin + s - 11.0
        if a lte until and b gte from_t
            tally.exact = tally.exact + 1
        else
            seen = a - begin
            tally.wrong = push[tally.wrong, '`what` at `s` ms: the library `v`, Lory there at `seen` ms']
    tally

fn _fp_fit[run, tally]
    p = scrolling.pages[_five[], 1000.0, 713.0, scrolling.page_options[auto = false], t = 3.0]
    steps = run['steps']
    tally = _fp_state[tally, 'fit start', p, steps[0], 'fit']
    p = scrolling.pages_taken[p]
    k = 1
    while k lt len[steps]
        s = steps[k]
        did = '`s.did`'
        if 'at_once' in s
            once = s['at_once']
            a = 0.0 + once.t
            y = _words_number[replace[did, 'scrolled to ', ''], 0.0]
            p = scrolling.page_scrolled[p, y, a]
            tally = _fp_state[tally, '`did`, at once', p, once, 'fit']
            p = scrolling.pages_taken[p]
            p = scrolling.pages_at[p, a + 600.0]
            tally = _fp_curve_held[tally, did, p, s['curve'], a, 1]
        else if did eq 'ArrowDown'
            a = 0.0 + steps[k - 1].t
            p = scrolling.page_key[p, 'ArrowDown', a]
            tally = _fp_curve_held[tally, did, p, s['curve'], a, 1]
        else
            a = 0.0 + steps[k - 1].t
            p = scrolling.page_scrolled[p, 800.0, a]
            p = scrolling.page_scrolled[p, 900.0, a + 300.0]
            p = scrolling.page_scrolled[p, 1000.0, a + 600.0]
            p = scrolling.pages_at[p, a + 1200.0]
            tally = _fp_curve_held[tally, did, p, s['curve'], a + 900.0, 1]
        p = scrolling.pages_at[p, 0.0 + s.t]
        tally = _fp_state[tally, 'fit `did`', p, s, 'fit']
        p = scrolling.pages_taken[p]
        k = k + 1
    tally

fn _fp_fit_off[run, tally]
    p = scrolling.pages[_five[], 1000.0, 713.0, scrolling.page_options[auto = false, fit = false], t = 3.0]
    steps = run['steps']
    tally = _fp_state[tally, 'fit_off start', p, steps[0], 'fit_off']
    p = scrolling.pages_taken[p]
    k = 1
    while k lt len[steps]
        s = steps[k]
        did = '`s.did`'
        y = _words_number[replace[did, 'scrolled to ', ''], 0.0]
        p = scrolling.page_scrolled[p, y, 0.0 + steps[k - 1].t]
        p = scrolling.pages_at[p, 0.0 + s.t]
        tally = _fp_state[tally, 'fit_off `did`', p, s, 'fit_off']
        p = scrolling.pages_taken[p]
        k = k + 1
    tally

fn _fp_scrollbar[run, tally]
    p = scrolling.pages[_five[], 1000.0, 713.0, scrolling.page_options[scroll_bar = true], t = 3.0]
    steps = run['steps']
    tally = _fp_state[tally, 'scrollbar start', p, steps[0], 'scrollbar']
    p = scrolling.pages_taken[p]
    a = 0.0 + steps[0].t
    p = scrolling.page_down[p, a]
    tally = _fp_curve_held[tally, 'scrollbar moveSectionDown', p, steps[1]['curve'], a, 1]
    p = scrolling.pages_at[p, 0.0 + steps[1].t]
    tally = _fp_state[tally, 'scrollbar moveSectionDown', p, steps[1], 'scrollbar']
    p = scrolling.pages_taken[p]
    a = 0.0 + steps[1].t
    p = scrolling.page_scrolled[p, 1100.0, a]
    p = scrolling.pages_at[p, a + 600.0]
    tally = _fp_curve_held[tally, 'scrollbar scrolled to 1100', p, steps[2]['curve'], a, 1]
    p = scrolling.pages_at[p, 0.0 + steps[2].t]
    _fp_state[tally, 'scrollbar scrolled to 1100', p, steps[2], 'scrollbar']

fn _fp_script[run, tally]
    p = scrolling.pages[_five[], 1000.0, 713.0, scrolling.page_options[by_script = true], t = 3.0]
    steps = run['steps']
    tally = _fp_state[tally, 'script start', p, steps[0], 'script']
    p = scrolling.pages_taken[p]
    k = 1
    while k lt len[steps]
        s = steps[k]
        did = '`s.did`'
        a = 0.0 + steps[k - 1].t
        if did eq 'moveSectionDown'
            p = scrolling.page_down[p, a]
        if did eq 'moveTo 4'
            p = scrolling.page_move_to[p, 3, a]
        if did eq 'moveSectionUp'
            p = scrolling.page_up[p, a]
        tally = _fp_curve_held[tally, 'script `did`', p, s['curve'], a, 2]
        p = scrolling.pages_at[p, 0.0 + s.t]
        tally = _fp_state[tally, 'script `did`', p, s, 'script']
        p = scrolling.pages_taken[p]
        k = k + 1
    tally

fn _fp_speed[run, tally]
    o = scrolling.page_options[speed = 1200.0, easing = 'cubic-bezier(0.1, 0.7, 1.0, 0.1)']
    p = scrolling.pages[_five[], 1000.0, 713.0, o, t = 3.0]
    steps = run['steps']
    p = scrolling.page_down[p, 303.0]
    tally = _fp_state[tally, 'speed moveSectionDown, at once', p, steps[0], 'speed']
    tally = _same_words[tally, 'speed transition', p.transition, '`steps[0].transition`']
    p = scrolling.pages_taken[p]
    p = scrolling.pages_at[p, 0.0 + steps[1].t]
    tally = _fp_state[tally, 'speed moveSectionDown', p, steps[1], 'speed']
    p = scrolling.pages_taken[p]
    p = scrolling.page_speed[p, 300.0]
    p = scrolling.page_down[p, 0.0 + steps[1].t]
    tally = _fp_state[tally, 'speed 300, at once', p, steps[2], 'speed']
    tally = _same_words[tally, 'speed 300 transition', p.transition, '`steps[2].transition`']
    p = scrolling.pages_taken[p]
    p = scrolling.pages_at[p, 0.0 + steps[3].t]
    _fp_state[tally, 'speed 300', p, steps[3], 'speed']

fn _fp_responsive[run, tally]
    for c in run['cases']
        given = c['options']
        rw = 0.0
        rh = 0.0
        if 'responsiveWidth' in given
            rw = 0.0 + given.responsiveWidth
        if 'responsiveHeight' in given
            rh = 0.0 + given.responsiveHeight
        started = c['started']
        first = started['calls'][0]
        p = scrolling.pages[_five[], 1000.0, 713.0, scrolling.page_options[responsive_w = rw, responsive_h = rh], t = 0.0 + first.t]
        what = 'responsive `rw` `rh`'
        tally = _same_words[tally, '`what` autoScrolling', '`not scrolling.page_free[p]`', '`c.autoScrolling`']
        tally = _same[tally, '`what` fp-responsive', p.responsive, ' fp-responsive ' in ' `started.body` ']
        tally = _fp_calls[tally, '`what` started', p, started['calls']]
        p = scrolling.pages_taken[p]
        keyed = c['keyed']
        p = scrolling.page_key[p, 'ArrowDown', 0.0 + started.t]
        p = scrolling.pages_at[p, 0.0 + keyed.t]
        tally = _same[tally, '`what` keyed: section', scrolling.page_index[p], 0 + keyed.section]
        tally = _fp_calls[tally, '`what` keyed', p, keyed['calls']]
    sets = run['set']
    on = sets[0]
    first = on['calls'][0]
    p = scrolling.pages[_five[], 1000.0, 713.0, scrolling.page_options[], t = 0.0 + first.t]
    p = scrolling.page_responsive[p, true, 0.0 + first.t + 300.0]
    tally = _same_words[tally, 'setResponsive true autoScrolling', '`not scrolling.page_free[p]`', '`on.autoScrolling`']
    tally = _fp_calls[tally, 'setResponsive true', p, on['calls']]
    p = scrolling.pages_taken[p]
    off = sets[1]
    p = scrolling.page_responsive[p, false, 0.0 + on.t]
    tally = _same_words[tally, 'setResponsive false autoScrolling', '`not scrolling.page_free[p]`', '`off.autoScrolling`']
    _fp_calls[tally, 'setResponsive false', p, off['calls']]

fn _loaded_words[p]
    out = _texts_of[]
    for k in p.loaded
        out = push[out, 'img`k`']
    join[sort[out], ' ']

fn _texts_of[]
    slice[[''], 0, 0]

fn _fp_lazy[run, tally]
    for c in run['cases']
        ahead = 0 + c.threshold
        sections = _five[]
        sections[1] = scrolling.section[slides = 3]
        steps = c['steps']
        first = steps[0]['calls'][0]
        start_t = 0.0 + first.t
        p = scrolling.pages[sections, 1000.0, 713.0, scrolling.page_options[lazy_ahead = ahead], t = start_t]
        last_t = start_t
        for s in steps
            did = '`s.did`'
            if did eq 'moveTo 2'
                p = scrolling.page_move_to[p, 1, last_t]
            if did eq 'moveSlideRight'
                p = scrolling.page_slide_right[p, last_t]
            if did eq 'moveTo 4'
                p = scrolling.page_move_to[p, 3, last_t]
            p = scrolling.pages_at[p, 0.0 + s.t]
            tally = _fp_state[tally, 'lazy `ahead` `did`', p, s, 'lazy']
            theirs = _texts_of[]
            for w in s['loaded']
                theirs = push[theirs, '`w`']
            tally = _same_words[tally, 'lazy `ahead` `did` loaded', _loaded_words[p], join[sort[theirs], ' ']]
            p = scrolling.pages_taken[p]
            last_t = 0.0 + s.t
    tally

fn _fp_hidden[run, tally]
    sections = _five[]
    sections[1] = scrolling.section[hidden = true]
    p = scrolling.pages[sections, 1000.0, 713.0, scrolling.page_options[nav = true], t = 3.0]
    steps = run['steps']
    tally = _fp_state[tally, 'hidden start', p, steps[0], 'hidden']
    n = len[split[trim[replace['`scrolling.page_nav_box[p]`', ',', ' ']], ' ']]
    tally = _same[tally, 'hidden dots', scrolling.page_dots[p], 0 + steps[0].dots]
    p = scrolling.pages_taken[p]
    k = 1
    while k lt len[steps]
        s = steps[k]
        p = _fp_key[p, '`s.did`', 0.0 + steps[k - 1].t]
        p = scrolling.pages_at[p, 0.0 + s.t]
        tally = _fp_state[tally, 'hidden `k` `s.did`', p, s, 'hidden']
        p = scrolling.pages_taken[p]
        k = k + 1
    tally

--- a section taller than the page: the page's wheel and keys did not
--- scroll it (they were made by script, where a reader's scroll it), so
--- its inner scroll is held only where the page set it, and the section
--- shown always
fn _fp_overflow[run, tally]
    sections = _five[]
    sections[1] = scrolling.section[content = 1518.0]
    sections[3] = scrolling.section[content = 1518.0, noscroll = true]
    p = scrolling.pages[sections, 1000.0, 713.0, scrolling.page_options[], t = 3.0]
    steps = run['steps']
    tally = _fp_state[tally, 'overflow start', p, steps[0], 'overflow']
    p = scrolling.pages_taken[p]
    k = 1
    while k lt len[steps]
        s = steps[k]
        did = '`s.did`'
        a = 0.0 + steps[k - 1].t
        native = false
        if starts[did, 'ArrowDown'] or starts[did, 'ArrowUp']
            p = scrolling.page_key[p, replace[split[did, ' '][0], ',', ''], a]
            native = did eq 'ArrowDown at its top'
        if did eq 'wheel at its top'
            p = scrolling.page_wheel[p, 100.0, a]
            native = true
        if did eq 'wheel up'
            p = scrolling.page_wheel[p, -100.0, a]
            native = true
        if did eq 'inner scrolled to 400, wheel'
            p = scrolling.page_inner[p, 400.0, a]
            p = scrolling.page_wheel[p, 100.0, a]
            native = true
        if did eq 'inner scrolled to its end, wheel'
            p = scrolling.page_inner[p, 1000000.0, a]
            p = scrolling.page_wheel[p, 100.0, a + 50.0]
        if did eq 'inner scrolled to its top, wheel up'
            p = scrolling.page_inner[p, 0.0, a]
            p = scrolling.page_wheel[p, -100.0, a + 50.0]
        if did eq 'moveTo 4, the one with fp-noscroll'
            p = scrolling.page_move_to[p, 3, a]
        p = scrolling.pages_at[p, 0.0 + s.t]
        tally = _same[tally, 'overflow `did`: section', scrolling.page_index[p], 0 + s.section]
        if not native
            tally = _fp_state[tally, 'overflow `did`', p, s, 'overflow']
            inner = s['inner']
            if 0 + inner.height gt 0 + inner.client and not p.sections[p.at].noscroll
                tally = _same[tally, 'overflow `did`: inner scroll', p.inner[p.at], 0.0 + inner.scroll]
                tally = _same[tally, 'overflow `did`: inner reach', scrolling.page_inner_most[p], 0.0 + inner.height - inner.client]
        p = scrolling.pages_taken[p]
        k = k + 1
    tally

fn _fp_heights[run, tally]
    sections = [scrolling.section[], scrolling.section[], scrolling.section[], scrolling.section[tall = 78.0]]
    p = scrolling.pages[sections, 1000.0, 713.0, scrolling.page_options[], t = 3.0]
    k = 0
    for r in run['sections']
        box = r['rect']
        tally = _same[tally, 'heights section `k` top', scrolling.page_section_top[p, k], 0.0 + box[1]]
        tally = _same[tally, 'heights section `k` height', scrolling.page_section_tall[p, k], 0.0 + box[3]]
        k = k + 1
    steps = run['steps']
    tally = _fp_state[tally, 'heights start', p, steps[0], 'heights']
    p = scrolling.pages_taken[p]
    k = 1
    while k lt len[steps]
        s = steps[k]
        p = _fp_key[p, '`s.did`', 0.0 + steps[k - 1].t]
        p = scrolling.pages_at[p, 0.0 + s.t]
        tally = _fp_state[tally, 'heights `s.did`', p, s, 'heights']
        p = scrolling.pages_taken[p]
        k = k + 1
    tally

--- the page's callbacks refuse: `beforeLeave` twice, then `onLeave` once
fn _fp_refused[run, tally]
    p = scrolling.pages[_five[], 1000.0, 713.0, scrolling.page_options[], t = 3.0]
    steps = run['steps']
    tally = _fp_state[tally, 'refused start', p, steps[0], 'refused']
    p = scrolling.pages_taken[p]
    before = 0
    leave = 0
    k = 1
    while k lt len[steps]
        s = steps[k]
        p = scrolling.page_key[p, 'ArrowDown', 0.0 + steps[k - 1].t]
        refused = false
        for e in p.told
            if e.name eq 'before_leave' and not refused
                before = before + 1
                if before lte 2
                    p = scrolling.pages_refuse[p]
                    refused = true
            if e.name eq 'on_leave' and not refused
                leave = leave + 1
                if leave eq 1
                    p = scrolling.pages_refuse[p, at = 'on_leave']
                    refused = true
        p = scrolling.pages_at[p, 0.0 + s.t]
        tally = _fp_state[tally, 'refused `s.did`', p, s, 'refused']
        p = scrolling.pages_taken[p]
        k = k + 1
    tally

test full_page_sections_hold_to_fullpage[]
    j = _reference[]
    t = _tally[]
    t = _fp_defaults[j['fullpage?run=defaults'], t]
    t = _fp_keys[j['fullpage?run=keys'], t]
    t = _fp_lock[j['fullpage?run=lock'], t]
    t = _fp_wheel[j['fullpage?run=wheel'], t]
    t = _fp_nav[j['fullpage?run=nav'], t]
    t = _fp_anchors[j['fullpage?run=anchors#three'], false, t]
    t = _fp_anchors[j['fullpage?run=anchors_still#three'], true, t]
    t = _fp_looped[j['fullpage?run=loops'], scrolling.page_options[loop_top = true, loop_bottom = true], 'loops', t]
    t = _fp_looped[j['fullpage?run=continuous'], scrolling.page_options[continuous = true], 'continuous', t]
    t = _fp_slides[j['fullpage?run=slides'], false, t]
    t = _fp_slides[j['fullpage?run=slides_still'], true, t]
    t = _fp_fit[j['fullpage?run=fit'], t]
    t = _fp_fit_off[j['fullpage?run=fit_off'], t]
    t = _fp_scrollbar[j['fullpage?run=scrollbar'], t]
    t = _fp_script[j['fullpage?run=script'], t]
    t = _fp_speed[j['fullpage?run=speed'], t]
    t = _fp_responsive[j['fullpage?run=responsive'], t]
    t = _fp_lazy[j['fullpage?run=lazy'], t]
    t = _fp_hidden[j['fullpage?run=hidden'], t]
    t = _fp_overflow[j['fullpage?run=overflow'], t]
    t = _fp_heights[j['fullpage?run=heights'], t]
    t = _fp_refused[j['fullpage?run=refused'], t]
    _told[t, 'fullPage']
