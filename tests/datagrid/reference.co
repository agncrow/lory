--- lory.datagrid held to the libraries it follows. reference.json is what
--- TanStack Table's table-core 9.3.1, TOAST UI Grid 4.21.22 and JavaScript
--- itself answered on fixed inputs (reference.mjs ran them), and each block
--- below takes the same steps through lory.datagrid and holds every answer
--- to theirs: the cell selection's rectangles, counts, ids, values, flags
--- and edges after each press, drag and key, the merged cells' spans, the
--- keymap's focus and selection and the grid's data after each key, the
--- text a copy makes, and every cell of the 7GUIs sheets. Run from the
--- repository's root: `crow test tests/datagrid/reference.co`.
use lory.datatable as dt
use lory.datagrid as dg

--- What a block held: how many values, and the ones that differ.
struct Tally [held, wrong]

fn _reference[]
    json[read['tests/datagrid/reference.json']]

fn _no_texts[]
    slice[[''], 0, 0]

fn _begun[]
    Tally[0, _no_texts[]]

--- One value held: the library's and Lory's, each as text.
fn _with[k, label, want, got]
    k.held = k.held + 1
    if want ne got
        k.wrong = push[k.wrong, '`label`: the library has `want`, Lory has `got`']
    k

--- The block's verdict: every value held the same (the first forty
--- differences shown when one is not), and how many were held, which each
--- block holds to the count it had when it was written.
fn _verdict[k, what]
    log['`what`: `k.held` values held, `len[k.wrong]` differ']
    shown = _no_texts[]
    for w in k.wrong
        if len[shown] lt 40
            shown = push[shown, w]
    assert[len[k.wrong] eq 0, join[shown, '\n']]
    k.held

--- A JSON value as text: numbers as JavaScript writes them.
fn _text[j]
    kind = type[j]
    if kind eq 'error'
        return 'null'
    if kind eq 'bool'
        if j
            return 'true'
        return 'false'
    if kind eq 'int' or kind eq 'float'
        return dt.number_text[0.0 + j]
    if kind eq 'array' or kind eq 'map'
        return encode[j]
    '`j`'

fn _int_text[n]
    dt.number_text[0.0 + n]

fn _flag[j]
    if j
        return true
    false

fn _bit[b]
    if b
        return '1'
    '0'

fn _part[j, name]
    if name in j
        return j[name]
    json['{}']

--- A list held item by item (and its length).
fn _list_held[k, label, want, got]
    n = len[want]
    if n ne len[got]
        k.held = k.held + n
        w = encode[want]
        g = join[got, ' ']
        k.wrong = push[k.wrong, '`label`: the library has `n` items `w`, Lory has `len[got]`: `g`']
        return k
    i = 0
    while i lt n
        k = _with[k, '`label`[`i`]', _text[want[i]], got[i]]
        i = i + 1
    k

-------------------------------------------------------------------- values

fn value_from[j]
    t = '`j.t`'
    if t eq 'missing'
        return dt.missing[]
    if t eq 'null'
        return dt.nothing[]
    if t eq 'number'
        if type[j.v] eq 'str'
            w = '`j.v`'
            if w eq 'NaN'
                return dt.number[0.0 / 0.0]
            if w eq 'inf'
                return dt.number[1.0 / 0.0]
            return dt.number[-1.0 / 0.0]
        return dt.number[0.0 + j.v]
    if t eq 'bool'
        return dt.truth[_flag[j.v]]
    dt.words['`j.v`']

fn value_text[v]
    if v.is eq 'number'
        return 'number `dt.number_text[v.num]`'
    if v.is eq 'text'
        return 'text "`v.words`"'
    if v.is eq 'bool'
        if v.num ne 0.0
            return 'bool true'
        return 'bool false'
    v.is

fn _cells[j]
    out = map['' = dt.missing[]]
    out = del[out, '']
    for key in keys[j]
        out = set[out, '`key`', value_from[j[key]]]
    out

fn _sheet_rows[j]
    out = slice[[dt.row['', _cells[json['{}']]]], 0, 0]
    for r in j
        out = push[out, dt.row['`r.id`', _cells[r.cells]]]
    out

-------------------------------------------------------------------- cell selection and spanning

fn _columns[ks]
    out = slice[[dt.column['', '']], 0, 0]
    for key in ks
        out = push[out, dt.column['`key`', '`key`']]
    out

--- the table a case's state makes: sorted, filtered, ordered, pinned,
--- hidden, paged and with rows pinned as it says
fn _table_of[ref, c]
    t = dt.new[_columns[ref.keys], _sheet_rows[ref.sheet]]
    s = _part[c, 'state']
    if 'sorting' in s
        sorts = slice[[dt.Sort['', false]], 0, 0]
        for x in s.sorting
            sorts = push[sorts, dt.Sort['`x.id`', _flag[x.desc]]]
        t = dt.sorted_by[t, sorts]
    if 'columnFilters' in s
        for f in s.columnFilters
            t = dt.filter_set[t, '`f.id`', dt.words['`f.value`']]
    if 'columnOrder' in s
        ids = _no_texts[]
        for x in s.columnOrder
            ids = push[ids, '`x`']
        t = dt.order_set[t, ids]
    if 'columnPinning' in s
        for x in s.columnPinning.start
            t = dt.column_pinned[t, '`x`', 'start']
        for x in s.columnPinning.end
            t = dt.column_pinned[t, '`x`', 'end']
    if 'columnVisibility' in s
        for key in keys[s.columnVisibility]
            t = dt.visibility_set[t, '`key`', _flag[s.columnVisibility[key]]]
    t = dt.page_size_set[t, 100]
    if 'pagination' in s
        t = dt.page_size_set[t, 0 + s.pagination.pageSize]
        t = dt.page_set[t, 0 + s.pagination.pageIndex]
    if 'rowPinning' in s
        for x in s.rowPinning.top
            t = dt.row_pinned[t, '`x`', 'top', false, false]
        for x in s.rowPinning.bottom
            t = dt.row_pinned[t, '`x`', 'bottom', false, false]
    t

fn _option[o, name]
    if name in o
        return _flag[o[name]]
    true

fn _span_number[j]
    if type[j] eq 'str'
        return 1000000.0
    0.0 + j

fn _spanning_of[c]
    sp = _part[c, 'span']
    rows = _no_texts[]
    if 'rows' in sp
        for x in sp.rows
            rows = push[rows, '`x`']
    off = _no_texts[]
    if 'off' in sp
        for x in sp.off
            off = push[off, '`x`']
    across = map['' = 0.0]
    if 'columns' in sp
        for key in keys[sp.columns]
            across = set[across, '`key`', _span_number[sp.columns[key]]]
    wide = map['' = 0.0]
    if 'wide' in sp
        for key in keys[sp.wide]
            wide = set[wide, '`key`', _span_number[sp.wide[key]]]
    dg.spanning[on = _option[_part[c, 'options'], 'enableCellSpanning'], rows = rows, columns = across, wide = wide, off = off]

fn _selecting_of[c]
    o = _part[c, 'options']
    off = _no_texts[]
    for x in c.unselectable
        off = push[off, '`x`']
    dg.selecting[on = _option[o, 'enableCellSelection'], unselectable = off, ranges = _option[o, 'enableCellRangeSelection'], drag = _option[o, 'enableCellSelectionDrag'], multi = _option[o, 'enableMultiCellRangeSelection']]

--- A step of a case: the selection and whether a drag is open after it.
struct Stepped [sel, dragging]

fn _no_sel[]
    slice[[dg.range_of['', '', '', '']], 0, 0]

fn _stepped[k, st, step]
    op = '`step[0]`'
    sel = st.sel
    if op eq 'press'
        row = '`step[1]`'
        col = '`step[2]`'
        shift = len[step] gt 3 and _flag[step[3]]
        multi = len[step] gt 4 and _flag[step[4]]
        if dg.cell_selectable[k, row, col]
            sel = dg.pressed[k, sel, row, col, shift = shift, multi = multi]
            if dg.drags[k]
                return Stepped[sel, true]
        return Stepped[sel, st.dragging]
    if op eq 'reach'
        if st.dragging
            sel = dg.reached[k, sel, '`step[1]`', '`step[2]`']
        return Stepped[sel, st.dragging]
    if op eq 'release'
        return Stepped[sel, false]
    if op eq 'move'
        return Stepped[dg.moved[k, sel, '`step[1]`'], st.dragging]
    if op eq 'extend'
        return Stepped[dg.extended[k, sel, '`step[1]`'], st.dragging]
    if op eq 'all'
        return Stepped[dg.all_selected[k, sel], st.dragging]
    if op eq 'focus'
        return Stepped[dg.focus_set['`step[1]`', '`step[2]`'], st.dragging]
    if op eq 'range'
        r = dg.range_of['`step[1]`', '`step[2]`', '`step[3]`', '`step[4]`']
        return Stepped[dg.range_selected[sel, r, mode = '`step[5]`'], st.dragging]
    Stepped[_no_sel[], st.dragging]

fn _bounds_texts[bounds]
    out = _no_texts[]
    for b in bounds
        out = push[out, '[`b.top`,`b.bottom`,`b.left`,`b.right`]']
    out

fn _held_step[k, label, want, lay, sel]
    got = _no_texts[]
    for r in sel
        how = 'include'
        if r.exclude
            how = 'exclude'
        got = push[got, '["`r.anchor_row`","`r.anchor_column`","`r.focus_row`","`r.focus_column`","`how`"]']
    k = _list_held[k, '`label` state', want.state, got]
    bounds = dg.selection_bounds[lay, sel]
    k = _list_held[k, '`label` bounds', want.bounds, _bounds_texts[bounds]]
    k = _with[k, '`label` count', _text[want.count], _int_text[dg.selected_count[lay, bounds]]]
    k = _list_held[k, '`label` ids', want.ids, dg.selected_ids[lay, bounds]]
    k = _list_held[k, '`label` rows', want.rows, dg.selection_rows[lay, bounds]]
    k = _list_held[k, '`label` columns', want.columns, dg.selection_columns[lay, bounds]]
    data = dg.selected_values[lay, bounds]
    k = _with[k, '`label` regions', _int_text[len[want.data]], _int_text[len[data]]]
    if len[want.data] eq len[data]
        i = 0
        while i lt len[data]
            wr = want.data[i]
            --- (a region of no cell that may be chosen is a hole in the
            --- library's list, written null: Lory's is empty)
            if type[wr] ne 'array'
                k = _with[k, '`label` region `i` rows', '0', _int_text[len[data[i]]]]
            else if len[wr] ne len[data[i]]
                k = _with[k, '`label` region `i` rows', _int_text[len[wr]], _int_text[len[data[i]]]]
            else
                j = 0
                while j lt len[wr]
                    ws = _no_texts[]
                    for x in wr[j]
                        ws = push[ws, value_text[value_from[x]]]
                    gs = _no_texts[]
                    for v in data[i][j]
                        gs = push[gs, value_text[v]]
                    k = _with[k, '`label` region `i` row `j`', join[ws, '; '], join[gs, '; ']]
                    j = j + 1
            i = i + 1
    f = dg.focused_cell[sel]
    focused = ''
    if f.row ne ''
        focused = '`f.row`_`f.column`'
    k = _with[k, '`label` focused', '`want.focused`', focused]
    i = 0
    for r in lay.display
        for c in lay.columns
            e = dg.cell_edges[lay, bounds, r.id, c.id]
            got_cell = '[`_bit[dg.cell_selected[lay, bounds, r.id, c.id]]`,`_bit[dg.cell_focused[sel, r.id, c.id]]`,`_bit[e.top]`,`_bit[e.right]`,`_bit[e.bottom]`,`_bit[e.left]`]'
            if i lt len[want.cells]
                k = _with[k, '`label` cell `r.id`_`c.id`', _text[want.cells[i]], got_cell]
            i = i + 1
    _with[k, '`label` cells', _int_text[len[want.cells]], _int_text[i]]

fn _held_spans[k, label, want, lay]
    sp = lay.spans
    ids = _no_texts[]
    for r in sp.rows
        ids = push[ids, r.id]
    k = _list_held[k, '`label` rendered', want.rendered, ids]
    --- (the harness reads the columns off the first row drawn: none without rows)
    cols = _no_texts[]
    if len[sp.rows] gt 0
        for c in lay.columns
            cols = push[cols, c.id]
    k = _list_held[k, '`label` columns', want.columns, cols]
    got = _no_texts[]
    for r in sp.rows
        for c in lay.columns
            got = push[got, '[`dg.row_span[sp, r.id, c.id]`,`dg.column_span[sp, r.id, c.id]`,`_bit[dg.covered[sp, r.id, c.id]]`]']
    k = _list_held[k, '`label` spans', want.cells, got]
    _list_held[k, '`label` merges', want.merges, _bounds_texts[lay.merges]]

test cell_selection_and_spanning_hold_to_table_core[]
    ref = _reference[]
    k = _begun[]
    for c in ref.selections
        t = _table_of[ref, c]
        lay = dg.laid[t, _selecting_of[c], _spanning_of[c]]
        st = Stepped[_no_sel[], false]
        i = 0
        for want in c.steps
            label = '`c.name` step `i` `encode[want.step]`'
            skipped = 'skipped' in want
            if not skipped
                st = _stepped[lay, st, want.step]
                k = _held_step[k, label, want, lay, st.sel]
            i = i + 1
        k = _held_spans[k, '`c.name` spans', c.spans, lay]
    _verdict[k, 'cell selection and spanning'] eq 44152

-------------------------------------------------------------------- TOAST UI Grid's keymap

fn _toast_grid[ref]
    rows = slice[[dt.row['', map['' = dt.missing[]]]], 0, 0]
    i = 0
    for r in ref.toast.rows
        cells = map['' = dt.missing[]]
        cells = del[cells, '']
        for key in ['a', 'b', 'c', 'd', 'e']
            cells = set[cells, key, dt.words['`r[key]`']]
        rows = push[rows, dt.row['t`i`', cells]]
        i = i + 1
    t = dt.new[_columns[['a', 'b', 'c', 'd', 'e']], rows]
    t = dt.page_size_set[t, 100]
    dg.grid['toast', t]

--- a TOAST UI key stroke as a browser names the key, with its modifiers
struct Stroke [key, shift, ctrl]

fn _stroke[s]
    parts = split[s, '-']
    name = parts[len[parts] - 1]
    names = map[up = 'ArrowUp', down = 'ArrowDown', left = 'ArrowLeft', right = 'ArrowRight', pageUp = 'PageUp', pageDown = 'PageDown', home = 'Home', end = 'End', tab = 'Tab', del = 'Delete', backspace = 'Backspace', enter = 'Enter', esc = 'Escape', space = ' ']
    key = name
    if name in names
        key = names[name]
    Stroke[key, 'shift' in parts, 'ctrl' in parts]

fn _data_texts[g, lay]
    out = _no_texts[]
    for r in lay.page
        words = _no_texts[]
        for c in lay.columns
            words = push[words, dg.cell_words[dg.cell_value[g, lay, r.id, c.id]]]
        out = push[out, encode[words]]
    out

test the_keymap_holds_to_toast_ui_grid[]
    ref = _reference[]
    k = _begun[]
    for c in ref.toast.cases
        g = _toast_grid[ref]
        lay = dg.grid_laid[g]
        g = dg.focused_on[g, 't`c.focus[0]`', '`c.focus[1]`']
        i = 0
        for want in c.steps
            s = '`want.key`'
            label = '`c.name` key `i` `s`'
            g.copied = ''
            if starts[s, 'paste:']
                g = dg.pasted[g, lay, slice[s, 6, len[s]]]
            else
                st = _stroke[s]
                g = dg.keyed[g, lay, st.key, shift = st.shift, ctrl = st.ctrl]
                --- (the harness ends an edit begun, as TOAST UI's finishEditing)
                if g.editing.row ne ''
                    g = dg.edit_finished[g, lay]
            lay = dg.grid_laid[g]
            f = dg.place_of[lay, g.focus]
            k = _with[k, '`label` focus', _text[want.focus], '[`f.row`,"`g.focus.column`"]']
            b = dg.toast_selection[g, lay]
            got = 'null'
            if b.top gte 0
                got = '[`b.top`,`b.bottom`,`b.left`,`b.right`]'
            k = _with[k, '`label` selection', _text[want.selection], got]
            if type[want.copied] eq 'str'
                k = _with[k, '`label` copied', '`want.copied`', g.copied]
            k = _list_held[k, '`label` data', want.data, _data_texts[g, lay]]
            i = i + 1
    _verdict[k, 'TOAST UI Grid keymap'] eq 1333

-------------------------------------------------------------------- 7GUIs Cells

test the_sheet_works_formulas_out_as_javascript_does[]
    ref = _reference[]
    k = _begun[]
    i = 0
    for c in ref.cells
        s = dg.sheet[]
        for name in keys[c.raw]
            s = dg.sheet_set[s, '`name`', '`c.raw[name]`']
        for name in keys[c.cells]
            want = c.cells[name]
            label = 'sheet `i` `name`'
            got = dg.cell_result[s, '`name`']
            ok = got.is ne 'error'
            k = _with[k, '`label` worked out', _text[want['ok']], '`ok`']
            if ok and _flag[want['ok']]
                k = _with[k, '`label` value', value_text[value_from[want.value]], value_text[got]]
            k = _with[k, '`label` shown', '`want.text`', dg.cell_shown[s, '`name`']]
        i = i + 1
    _verdict[k, '7GUIs Cells'] eq 2093
