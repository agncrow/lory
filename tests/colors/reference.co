--- Lory's colours held to the libraries they follow. reference.json is what
--- culori 4.0.2, apca-w3 0.1.9, Vuetify 3.7.6, Semantic UI 2.4.1 (through
--- LESS 4.2.0), Radix Themes 3.2.1 and Radix Colors 3.0.0 answered on fixed
--- inputs (reference.mjs ran them), and each block holds lory.colors to
--- those answers: the same number to within a few units in the last place,
--- the same hex, the same choice. The scales are held to Radix's promises:
--- every text step's contrast, every step's role, every translucent step
--- laid over its page; and their nearness to Radix's published scales is
--- measured. Run from the repository's root:
--- `crow test tests/colors/reference.co`.
use math
use lory
use lory.colors

fn _reference[]
    json[read['tests/colors/reference.json']]

fn _number[x]
    0.0 + x

--- a colour of four numbers as the reference writes one
fn _color_of[j]
    lory.Color[0.0 + j[0], 0.0 + j[1], 0.0 + j[2], 0.0 + j[3]]

--- a hue as the reference writes it: -1000 for a missing one
fn _hue[x]
    h = 0.0 + x
    if h lt -500.0
        return nan
    h

fn _near[mine, theirs, tolerance]
    abs[mine - theirs] lte tolerance

--- two hues as one: both missing, or as near as `tolerance` round the
--- circle
fn _same_hue[mine, theirs, tolerance]
    if not (theirs eq theirs)
        return not (mine eq mine)
    if not (mine eq mine)
        return false
    d = abs[mine - theirs]
    min[d, 360.0 - d] lte tolerance

fn _same_color[c, d, tolerance]
    _near[c.r, d.r, tolerance] and _near[c.g, d.g, tolerance] and _near[c.b, d.b, tolerance] and _near[c.a, d.a, tolerance]

--- a colour shown for a message
fn _shown[c]
    r = fmt[c.r, decimals = 17]
    g = fmt[c.g, decimals = 17]
    b = fmt[c.b, decimals = 17]
    a = fmt[c.a, decimals = 17]
    '[`r`, `g`, `b`, `a`]'

--- the places a colour's conversions differ from culori's, as text
fn _conversion_misses[x]
    code = '`x.code`'
    c = colors.parse[code]
    out = slice[[''], 0, 0]
    if not _same_color[c, _color_of[x.rgb], 0.0]
        out = push[out, '`code` parsed']
    if colors.hex_of[c] ne '`x.hex`'
        out = push[out, '`code` hex']
    if colors.hex_alpha_of[c] ne '`x.hex8`'
        out = push[out, '`code` hex8']
    lin = colors.to_linear[c]
    if not (_near[lin.r, 0.0 + x.linear[0], 0.000000000000001] and _near[lin.g, 0.0 + x.linear[1], 0.000000000000001] and _near[lin.b, 0.0 + x.linear[2], 0.000000000000001])
        out = push[out, '`code` linear']
    lab = colors.to_oklab[c]
    if not (_near[lab.l, 0.0 + x.oklab[0], 0.00000000000001] and _near[lab.a, 0.0 + x.oklab[1], 0.00000000000001] and _near[lab.b, 0.0 + x.oklab[2], 0.00000000000001])
        out = push[out, '`code` oklab']
    lch = colors.to_oklch[c]
    if not (_near[lch.l, 0.0 + x.oklch[0], 0.00000000000001] and _near[lch.c, 0.0 + x.oklch[1], 0.00000000000001] and _same_hue[lch.h, _hue[x.oklch[2]], 0.0000000001])
        out = push[out, '`code` oklch']
    hsl = colors.to_hsl[c]
    if not (_same_hue[hsl.h, _hue[x.hsl[0]], 0.0000000001] and _near[hsl.s, 0.0 + x.hsl[1], 0.00000000000001] and _near[hsl.l, 0.0 + x.hsl[2], 0.00000000000001])
        out = push[out, '`code` hsl']
    hsv = colors.to_hsv[c]
    if not (_same_hue[hsv.h, _hue[x.hsv[0]], 0.0000000001] and _near[hsv.s, 0.0 + x.hsv[1], 0.00000000000001] and _near[hsv.v, 0.0 + x.hsv[2], 0.00000000000001])
        out = push[out, '`code` hsv']
    if not _near[colors.luminance[c], 0.0 + x.wcag, 0.000000000000001]
        out = push[out, '`code` luminance']
    if not _near[colors.apca_luminance[c], 0.0 + x.apca_y, 0.000000000000001]
        out = push[out, '`code` apca luminance']
    out

--- the sRGB colour of a colour given in a space, as the reference gives it
fn _back[x]
    space = '`x.space`'
    p = 0.0 + x.given[0]
    q = 0.0 + x.given[1]
    r = 0.0 + x.given[2]
    if space eq 'oklch'
        return colors.from_oklch[colors.Lch[p, q, _hue[r], 1.0]]
    if space eq 'oklab'
        return colors.from_oklab[colors.Lab[p, q, r, 1.0]]
    if space eq 'hsl'
        return colors.from_hsl[colors.Hsl[_hue[p], q, r, 1.0]]
    colors.from_hsv[colors.Hsv[_hue[p], q, r, 1.0]]

--- the misses, joined for an assertion's message
fn _join[misses]
    join[misses, '; ']

test conversions_match_culori[]
    j = _reference[]
    misses = slice[[''], 0, 0]
    i = 0
    while i lt len[j.colors]
        misses = concat[misses, _conversion_misses[j.colors[i]]]
        i = i + 1
    assert[_join[misses] eq '']
    len[j.colors] eq 79

test colours_given_in_a_space_match_culori[]
    j = _reference[]
    misses = slice[[''], 0, 0]
    i = 0
    while i lt len[j.backs]
        x = j.backs[i]
        mine = _back[x]
        if not _same_color[mine, _color_of[x.rgb], 0.00000000000001]
            misses = push[misses, '`i` `x.space`: `_shown[mine]`']
        i = i + 1
    assert[_join[misses] eq '']
    len[j.backs] eq 75

test mixing_matches_culori_in_every_space[]
    j = _reference[]
    misses = slice[[''], 0, 0]
    i = 0
    while i lt len[j.mixes]
        x = j.mixes[i]
        mine = colors.mix[colors.parse['`x.a`'], colors.parse['`x.b`'], 0.0 + x.t, '`x.space`']
        if not _same_color[mine, _color_of[x.rgb], 0.0000000000001]
            theirs = _shown[_color_of[x.rgb]]
            misses = push[misses, '`x.a` to `x.b` `x.t` in `x.space`: `_shown[mine]` for `theirs`']
        i = i + 1
    assert[_join[misses] eq '']
    len[j.mixes] eq 360

test laying_over_matches_culori[]
    j = _reference[]
    misses = slice[[''], 0, 0]
    for x in j.overs
        mine = colors.over[colors.parse['`x.top`'], colors.parse['`x.bottom`']]
        if not _same_color[mine, _color_of[x.rgb], 0.000000000000001]
            misses = push[misses, '`x.top` over `x.bottom`: `_shown[mine]`']
    assert[_join[misses] eq '']

test fitting_into_srgb_matches_culori[]
    j = _reference[]
    misses = slice[[''], 0, 0]
    i = 0
    while i lt len[j.fits]
        x = j.fits[i]
        mine = colors.fitted[colors.from_oklch[colors.Lch[0.0 + x.given[0], 0.0 + x.given[1], 0.0 + x.given[2], 1.0]]]
        wanted = _color_of[x.rgb]
        if not _same_color[mine, wanted, 0.000000000001]
            misses = push[misses, 'fit `i`: `_shown[mine]`']
        i = i + 1
    assert[_join[misses] eq '']
    len[j.fits] eq 29

test lighter_darker_and_saturated_match_culori[]
    j = _reference[]
    misses = slice[[''], 0, 0]
    i = 0
    while i lt len[j.moves]
        x = j.moves[i]
        c = colors.parse['`x.code`']
        amount = 0.0 + x.amount
        if not _same_color[colors.lighter[c, amount], _color_of[x.lighter], 0.000000000001]
            misses = push[misses, '`x.code` lighter `amount`']
        if not _same_color[colors.darker[c, amount], _color_of[x.darker], 0.000000000001]
            misses = push[misses, '`x.code` darker `amount`']
        if not _same_color[colors.saturated[c, amount], _color_of[x.saturated], 0.000000000001]
            misses = push[misses, '`x.code` saturated `amount`']
        if not _same_color[colors.saturated[c, 0.0 - amount], _color_of[x.desaturated], 0.000000000001]
            misses = push[misses, '`x.code` desaturated `amount`']
        i = i + 1
    assert[_join[misses] eq '']
    len[j.moves] eq 32

test contrast_matches_culori_and_apca_w3[]
    j = _reference[]
    misses = slice[[''], 0, 0]
    i = 0
    while i lt len[j.contrasts]
        x = j.contrasts[i]
        text = colors.parse['`x.text`']
        ground = colors.parse['`x.background`']
        if not _near[colors.contrast_ratio[text, ground], 0.0 + x.wcag, 0.0000000000001]
            misses = push[misses, '`x.text` on `x.background` wcag']
        if not _near[colors.apca[text, ground], 0.0 + x.apca, 0.000000000001]
            misses = push[misses, '`x.text` on `x.background` apca']
        i = i + 1
    assert[_join[misses] eq '']
    len[j.contrasts] eq 38

test text_on_a_colour_is_what_vuetify_puts_there[]
    j = _reference[]
    misses = slice[[''], 0, 0]
    i = 0
    while i lt len[j.foregrounds]
        x = j.foregrounds[i]
        mine = 'black'
        if colors.hex_of[colors.on_color[colors.parse['`x.code`']]] eq '#ffffff'
            mine = 'white'
        if mine ne '`x.on`'
            misses = push[misses, '`x.code`']
        i = i + 1
    assert[_join[misses] eq '']
    len[j.foregrounds] eq 276

test the_palette_has_vuetifys_names_and_shades[]
    j = _reference[]
    misses = slice[[''], 0, 0]
    names = slice[[''], 0, 0]
    i = 0
    while i lt len[j.palette]
        x = j.palette[i]
        name = '`x.name`'
        names = push[names, name]
        theirs = slice[[''], 0, 0]
        for s in x.shades
            theirs = push[theirs, '`s`']
        if join[colors.shade_names[name], ','] ne join[theirs, ',']
            misses = push[misses, '`name` shades']
        ladder = ['lighten-5', 'lighten-4', 'lighten-3', 'lighten-2', 'lighten-1', 'base', 'darken-1', 'darken-2', 'darken-3', 'darken-4']
        if x.falls and len[theirs] gt 1
            k = 1
            while k lt 10
                if not (colors.to_oklab[colors.palette[name, ladder[k]]].l lt colors.to_oklab[colors.palette[name, ladder[k - 1]]].l)
                    misses = push[misses, '`name` `ladder[k]` is not darker']
                k = k + 1
        if x.accents_fall and 'accent-1' in theirs
            k = 2
            while k lte 4
                if not (colors.to_oklab[colors.palette[name, 'accent-`k`']].l lt colors.to_oklab[colors.palette[name, 'accent-`k - 1`']].l)
                    misses = push[misses, '`name` accent-`k` is not darker']
                k = k + 1
        i = i + 1
    assert[_join[misses] eq '']
    join[names, ','] eq join[colors.palette_names[], ',']

test semantic_shades_are_what_less_derives[]
    j = _reference[]
    misses = slice[[''], 0, 0]
    i = 0
    while i lt len[j.semantic.states]
        x = j.semantic.states[i]
        c = colors.parse['`x.code`']
        st = colors.states_of[c, false]
        if colors.hex_of[st.hover] ne '`x.color.hover`' or colors.hex_of[st.focus] ne '`x.color.focus`' or colors.hex_of[st.down] ne '`x.color.down`' or colors.hex_of[st.active] ne '`x.color.active`'
            misses = push[misses, '`x.code` as a colour']
        ns = colors.states_of[c, true]
        if colors.hex_of[ns.hover] ne '`x.neutral.hover`' or colors.hex_of[ns.focus] ne '`x.neutral.focus`' or colors.hex_of[ns.down] ne '`x.neutral.down`' or colors.hex_of[ns.active] ne '`x.neutral.active`'
            misses = push[misses, '`x.code` as a neutral']
        i = i + 1
    assert[_join[misses] eq '']
    names = slice[[''], 0, 0]
    for n in j.semantic.names
        names = push[names, '`n`']
    join[names, ','] eq join[colors.semantic_names[], ',']

test grays_pair_with_accents_as_radix_themes_pairs_them[]
    j = _reference[]
    misses = slice[[''], 0, 0]
    for name in concat[['gray'], colors.accent_names[]]
        if colors.gray_for[name] ne '`j.themes.matching_gray[name]`'
            misses = push[misses, name]
    assert[_join[misses] eq '']

test text_on_solid_steps_is_radix_themes_contrast[]
    j = _reference[]
    misses = slice[[''], 0, 0]
    for name in concat[['gray'], colors.accent_names[]]
        x = j.themes.contrast[name]
        wanted = '#ffffff'
        if '`x.on`' eq 'step'
            wanted = colors.hex_of[colors.step['`x.gray`', 'light', round[0.0 + x.step]]]
        if colors.hex_of[colors.on_solid[name]] ne wanted
            misses = push[misses, name]
        if (wanted ne '#ffffff') ne colors.is_bright[name]
            misses = push[misses, '`name` bright']
    assert[_join[misses] eq '']

--- what a Radix Themes token names, in Lory's scales for a gray and an
--- appearance
fn _token[x, gray, look]
    what = '`x.what`'
    if what eq 'white'
        return lory.Color[1.0, 1.0, 1.0, 1.0]
    if what eq 'gray'
        return colors.step[gray, look, round[0.0 + x.step]]
    if what eq 'gray-alpha'
        return colors.alpha_scale[gray, look][round[0.0 + x.step] - 1]
    if what eq 'black-alpha'
        return colors.black_overlay[][round[0.0 + x.step] - 1]
    _color_of[x.rgba]

test theme_tokens_resolve_as_radix_themes_resolves_them[]
    j = _reference[]
    misses = slice[[''], 0, 0]
    for pair in [['indigo', 'auto'], ['amber', 'auto'], ['crimson', 'gray'], ['grass', 'sand']]
        for look in ['light', 'dark']
            t = colors.theme[pair[0], pair[1], look]
            gray = pair[1]
            if gray eq 'auto'
                gray = colors.gray_for[pair[0]]
            x = j.themes.tokens[look]
            if not _same_color[t.page, _token[x.color_background, gray, look], 0.0]
                misses = push[misses, '`pair[0]` `look` page']
            if not _same_color[t.panel, _token[x.color_panel_solid, gray, look], 0.0]
                misses = push[misses, '`pair[0]` `look` panel']
            if not _same_color[t.surface, _token[x.color_surface, gray, look], 0.000000000000001]
                misses = push[misses, '`pair[0]` `look` surface']
            if not _same_color[t.overlay, _token[x.color_overlay, gray, look], 0.0]
                misses = push[misses, '`pair[0]` `look` overlay']
            if not _same_color[t.shadow, _token[j.themes.shadow[look], gray, look], 0.0]
                misses = push[misses, '`pair[0]` `look` shadow']
            if not _same_color[t.field, colors.over[t.surface, t.panel], 0.0]
                misses = push[misses, '`pair[0]` `look` field']
            if colors.hex_of[t.focus] ne colors.hex_of[colors.step[pair[0], look, 8]] or colors.hex_of[t.accent] ne colors.hex_of[colors.step[pair[0], look, 9]] or colors.hex_of[t.ink] ne colors.hex_of[colors.step[gray, look, 12]]
                misses = push[misses, '`pair[0]` `look` steps']
    assert[_join[misses] eq '']

--- the places a scale in an appearance breaks Radix's promises for text:
--- step 11 at Lc 60 and step 12 at Lc 90 on steps 1 and 2, dark text on
--- light (a positive Lc) in light and light on dark (negative) in dark
fn _contrast_misses[name, look]
    s = colors.scale[name, look]
    out = slice[[''], 0, 0]
    polarity = 1.0
    if look eq 'dark'
        polarity = -1.0
    for pair in [[10, 0, 60], [10, 1, 60], [11, 0, 90], [11, 1, 90]]
        lc = polarity * colors.apca[s[pair[0]], s[pair[1]]]
        if lc lt 0.0 + pair[2]
            out = push[out, '`name` `look` step `pair[0] + 1` on `pair[1] + 1`: `lc`']
    out

test every_text_step_keeps_the_contrast_radix_states[]
    misses = slice[[''], 0, 0]
    for name in colors.scale_names[]
        for look in ['light', 'dark']
            misses = concat[misses, _contrast_misses[name, look]]
    assert[_join[misses] eq '']
    len[colors.scale_names[]] eq 31

--- the places a scale's steps leave their roles: steps 1 to 8 grow away
--- from the page (darker in light, lighter in dark), step 12 is further
--- from the page than step 11, step 12 has more contrast on step 2 than
--- step 11, and an accent's solid step 9 is one colour in both appearances
fn _role_misses[name]
    out = slice[[''], 0, 0]
    lit = colors.scale[name, 'light']
    dim = colors.scale[name, 'dark']
    k = 1
    while k lt 8
        if not (colors.to_oklab[lit[k]].l lt colors.to_oklab[lit[k - 1]].l)
            out = push[out, '`name` light step `k + 1`']
        if not (colors.to_oklab[dim[k]].l gt colors.to_oklab[dim[k - 1]].l)
            out = push[out, '`name` dark step `k + 1`']
        k = k + 1
    if not (colors.to_oklab[lit[11]].l lt colors.to_oklab[lit[10]].l and colors.to_oklab[dim[11]].l gt colors.to_oklab[dim[10]].l)
        out = push[out, '`name` step 12']
    if not (abs[colors.apca[lit[11], lit[1]]] gt abs[colors.apca[lit[10], lit[1]]] and abs[colors.apca[dim[11], dim[1]]] gt abs[colors.apca[dim[10], dim[1]]])
        out = push[out, '`name` text contrast']
    if name in colors.accent_names[] and colors.hex_of[lit[8]] ne colors.hex_of[dim[8]]
        out = push[out, '`name` step 9']
    out

test every_scale_keeps_the_roles_of_its_steps[]
    misses = slice[[''], 0, 0]
    for name in colors.scale_names[]
        misses = concat[misses, _role_misses[name]]
    assert[_join[misses] eq '']

test every_alpha_step_lays_over_its_page_to_the_solid[]
    misses = slice[[''], 0, 0]
    for name in colors.scale_names[]
        for look in ['light', 'dark']
            solids = colors.scale[name, look]
            glass = colors.alpha_scale[name, look]
            page = colors.page_of[look]
            for k in range[12]
                if not _same_color[colors.over[glass[k], page], solids[k], 0.000000000001]
                    misses = push[misses, '`name` `look` alpha step `k + 1`']
                if glass[k].a gt 1.0 or glass[k].a lt 0.0
                    misses = push[misses, '`name` `look` alpha step `k + 1` opacity']
    assert[_join[misses] eq '']

--- how far each step of Lory's scales lies from Radix's published one in
--- OKLCH lightness and chroma, step by step: the steps that lie further
--- than the tolerance for their step, and the mean distance
struct Nearness [misses, l_mean, c_mean]

fn _nearness[j, l_tolerance, c_tolerance]
    misses = slice[[''], 0, 0]
    l_sum = 0.0
    c_sum = 0.0
    names = colors.scale_names[]
    i = 0
    while i lt 62
        name = names[i / 2]
        look = 'light'
        if i % 2 eq 1
            look = 'dark'
        theirs = j.radix.measured[name][look]
        s = colors.scale[name, look]
        k = 0
        while k lt 12
            y = colors.to_oklch[s[k]]
            dl = abs[y.l - (0.0 + theirs.l[k])]
            dc = abs[y.c - (0.0 + theirs.c[k])]
            l_sum = l_sum + dl
            c_sum = c_sum + dc
            if dl gt l_tolerance[k] or dc gt c_tolerance[k]
                misses = push[misses, '`name` `look` step `k + 1`: lightness `dl`, chroma `dc`']
            k = k + 1
        i = i + 1
    Nearness[misses, l_sum / 744.0, c_sum / 744.0]

--- Lory's steps against Radix's, within a tolerance for each step: the
--- backgrounds and the solid within 0.02 of lightness, the borders within
--- 0.045, the text within 0.055; chroma within 0.015 for the backgrounds
--- and 0.045 for the borders, 0.01 for the solid, 0.105 for the hovered
--- solid (a bright scale's dark step 10 is where Radix's lies furthest)
--- and 0.06 for the text; and within 0.01 of each on the mean
test the_scales_come_near_radix_published_ones[]
    l_tolerance = [0.01, 0.02, 0.02, 0.02, 0.035, 0.04, 0.045, 0.04, 0.01, 0.015, 0.055, 0.035]
    c_tolerance = [0.015, 0.015, 0.04, 0.035, 0.045, 0.035, 0.04, 0.04, 0.01, 0.105, 0.06, 0.045]
    near = _nearness[_reference[], l_tolerance, c_tolerance]
    assert[_join[near.misses] eq '']
    near.l_mean lte 0.01
    near.c_mean lte 0.01
