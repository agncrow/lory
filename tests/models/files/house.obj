# A small house, written for Lory's tests: walls in two materials, a roof
# of a gable's five corners, a chimney whose faces give no normals, smoke
# as points and a garden path as lines.
mtllib house.mtl

o walls
v -1.0 0.0 -1.0
v 1.0 0.0 -1.0
v 1.0 0.0 1.0
v -1.0 0.0 1.0
v -1.0 1.25 -1.0
v 1.0 1.25 -1.0
v 1.0 1.25 1.0
v -1.0 1.25 1.0
vt 0 0
vt 1 0
vt 1 1
vt 0 1
vn 0 0 1
vn 0 0 -1
vn 1 0 0
vn -1 0 0
vn 0 -1 0
usemtl brick
f 4/1/1 3/2/1 7/3/1 8/4/1
f 2/1/2 1/2/2 5/3/2 6/4/2
f 3/1/3 2/2/3 6/3/3 7/4/3
f 1/1/4 4/2/4 8/3/4 5/4/4
usemtl floor
s off
f 1//5 2//5 3//5 4//5

o roof
v -1.1 1.25 -1.1
v 1.1 1.25 -1.1
v 1.1 1.25 1.1
v -1.1 1.25 1.1
v 0.0 2.0 -1.1
v 0.0 2.0 1.1
vt 0.5 1
vt 0.1 0.333333333333
vt 0.9 0.333333333333
usemtl tile
s 1
f -6/2 -5/3 -2/1
f -3/2 -4/3 -1/1
f -5 -4 -1 -2
f -3 -6 -2 -1
usemtl trim
f -6 -2 -5
f -6 -5 -4 -3 -2

g chimney
v 0.4 1.5 -0.6
v 0.7 1.5 -0.6
v 0.7 1.5 -0.3
v 0.4 1.5 -0.3
v 0.4 2.2 -0.6
v 0.7 2.2 -0.6
v 0.7 2.2 -0.3
v 0.4 2.2 -0.3
f 15 16 20 19
f 16 17 21 20
f 17 18 22 21
f 18 15 19 22
f 19 20 21 22

o smoke
v 0.55 2.4 -0.45 0.9 0.9 0.92
v 0.6 2.7 -0.4 0.8 0.8 0.85
v 0.5 3.0 -0.5 0.7 0.7 0.75
v 0.65 3.3 -0.35 0.6 0.6 0.66
p -4 -3 -2 -1

o path
v 0.0 0.001 1.0
v 0.2 0.001 1.8
v -0.3 0.001 2.6
v 0.1 0.001 3.4
vt 0 0.25
vt 0 0.5
vt 0 0.75
vt 0 1
l -4/-4 -3/-3 -2/-2 -1/-1
