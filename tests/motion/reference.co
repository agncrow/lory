--- Lory's motion held, number for number, to what anime.js 4.5.0, Motion
--- 14.7.1 and AOS 2.3.4 answer on fixed inputs: reference.mjs beside this
--- file ran the libraries and wrote reference.json. Run from the
--- repository's root:
---
---     crow test tests/motion/reference.co
---     crow test --compiled tests/motion/reference.co
---
--- A number is held when Lory's float is the library's, or differs from it
--- by no more than 2^-50 of the largest number its case reaches: four units
--- in the last place of a number between 1 and 2. (A case is one easing
--- over its 21 times, one spring's values or its speeds, one throw, one
--- stagger.) Only what exp, sine, cosine, arcsine, arccosine and powers
--- give differs at all: the machine's maths library and V8's round a last
--- bit apart, a formula holds up to three of them, and a sum that
--- cancels (a throw passing 14 on its way from 100 to -300) carries a
--- difference into a smaller number, which is why a difference is measured
--- against its case and not against the number alone. Each test logs how
--- many of its numbers are the same bit for bit, and the farthest any of
--- the rest is off, in units of 2^-52 of its case's largest number.

use math
use lory
use lory.motion

--- how many numbers were held, how many of them bit for bit, the farthest
--- any was off (a fraction of its case's size), and every one not held
struct Tally [held, exact, worst, wrong]

fn _reference[]
    json[read['tests/motion/reference.json']]

fn _tally[]
    Tally[0, 0, 0.0, slice[[''], 0, 0]]

fn _tolerance[]
    2.0 ^ -50

--- the tally with one more number held: Lory's float is the library's, or
--- off by no more than the tolerance of `size`, the case's largest number
fn _held[tally, what, ours, theirs, size]
    tally.held = tally.held + 1
    if ours eq theirs
        tally.exact = tally.exact + 1
        return tally
    scale = max[size, max[abs[ours], abs[theirs]]]
    off = abs[ours - theirs] / scale
    if off gt tally.worst
        tally.worst = off
    if not (off lte _tolerance[])
        tally.wrong = push[tally.wrong, '`what`: Lory `ours`, the library `theirs`']
    tally

--- the tally with one more answer that must be the library's exactly (a
--- count, a play's number, whether it is at rest)
fn _same[tally, what, ours, theirs]
    tally.held = tally.held + 1
    if ours eq theirs
        tally.exact = tally.exact + 1
        return tally
    tally.wrong = push[tally.wrong, '`what`: Lory `ours`, the library `theirs`']
    tally

--- whether every number was held, after logging the group's counts
fn _told[tally, group]
    units = round[tally.worst * 2.0 ^ 52 * 100.0] / 100.0
    log['`group`: `tally.held` held, `tally.exact` bit for bit, the farthest off by `units` × 2^-52 of its case']
    len[tally.wrong] eq 0

fn _wrongs[tally]
    join[slice[tally.wrong, 0, 20], '\n']

fn _numbers_of[parsed]
    out = []
    for i in range[0]
        out = push[out, 0.0]
    for v in parsed
        out = push[out, 0.0 + v]
    out

fn _texts_of[parsed]
    out = slice[[''], 0, 0]
    for v in parsed
        out = push[out, str[v]]
    out

--- the largest size among some numbers, 1 at the least
fn _size[xs]
    size = 1.0
    for x in xs
        size = max[size, abs[x]]
    size

--- the largest size in one column of a case's samples, 1 at the least
fn _column_size[samples, column]
    size = 1.0
    for s in samples
        size = max[size, abs[0.0 + s[column]]]
    size

test easings_hold_to_anime_motion_css_and_aos[]
    j = _reference[]
    times = _numbers_of[j['times']]
    t = _tally[]
    for one in j['eases']
        name = str[one['name']]
        easing = motion.ease[name]
        theirs = _numbers_of[one['values']]
        size = _size[theirs]
        i = 0
        while i lt len[times]
            at = times[i]
            t = _held[t, '`name` at `at`', motion.eased[easing, at], theirs[i], size]
            i = i + 1
    assert[_told[t, 'easings'], _wrongs[t]]

test aos_names_are_the_beziers_its_stylesheet_gives[]
    j = _reference[]
    names = motion.ease_names[]
    for one in j['aos']
        name = str[one['name']]
        given = str[one['value']]
        motion.ease_known[name]
        name in names
        motion.ease[name] eq motion.ease[given]
    len[j['aos']] eq 20

test anime_springs_settle_and_ease_as_anime_does[]
    j = _reference[]
    times = _numbers_of[j['times']]
    t = _tally[]
    for one in j['anime_springs']
        name = str[one['name']]
        easing = motion.ease[name]
        t = _held[t, '`name` settling', motion.spring_settling[easing], 0.0 + one['settling'], 1.0]
        t = _held[t, '`name` solver', easing.p[4], 0.0 + one['solver'], 1.0]
        t = _held[t, '`name` stiffness', easing.p[6], 0.0 + one['stiffness'], 1.0]
        t = _held[t, '`name` damping', easing.p[7], 0.0 + one['damping'], 1.0]
        theirs = _numbers_of[one['values']]
        size = _size[theirs]
        i = 0
        while i lt len[times]
            at = times[i]
            t = _held[t, '`name` at `at`', motion.eased[easing, at], theirs[i], size]
            i = i + 1
    assert[_told[t, 'anime.js springs'], _wrongs[t]]

fn _spring_of[one]
    form = str[one['form']]
    sp = motion.spring[0.0 + one['stiffness'], 0.0 + one['damping'], 0.0 + one['mass']]
    if form eq 'duration'
        sp = motion.spring_duration[0.0 + one['duration'], 0.0 + one['bounce']]
    if form eq 'visual'
        sp = motion.spring_visual[0.0 + one['visual'], 0.0 + one['bounce']]
    sp.rest_speed = 0.0 + one['rest_speed']
    sp.rest_delta = 0.0 + one['rest_delta']
    sp

fn _samples_held[t, what, sp, origin, target, velocity, samples]
    sizes = max[_column_size[samples, 1], max[abs[origin], abs[target]]]
    speeds = max[_column_size[samples, 2], abs[velocity]]
    for s in samples
        at = 0.0 + s[0]
        ours = motion.spring_sample[sp, origin, target, velocity, at]
        t = _held[t, '`what` value at `at`', ours.value, 0.0 + s[1], sizes]
        t = _held[t, '`what` velocity at `at`', ours.velocity, 0.0 + s[2], speeds]
        t = _same[t, '`what` at rest at `at`', ours.done, 0 + s[3] eq 1]
    t

test motion_springs_move_and_rest_as_motion_does[]
    j = _reference[]
    t = _tally[]
    k = 0
    for one in j['springs']
        sp = _spring_of[one]
        form = str[one['form']]
        t = _samples_held[t, 'spring `k` (`form`)', sp, 0.0 + one['from'], 0.0 + one['to'], 0.0 + one['velocity'], one['samples']]
        k = k + 1
    assert[_told[t, 'Motion springs'], _wrongs[t]]

test a_spring_given_a_new_target_keeps_its_speed_as_motion_does[]
    j = _reference[]
    t = _tally[]
    for one in j['retargets']
        sp = motion.spring[0.0 + one['stiffness'], 0.0 + one['damping'], 1.0]
        origin = 0.0 + one['from']
        t = _samples_held[t, 'before', sp, origin, 0.0 + one['to'], 0.0, one['before']]
        there = motion.spring_sample[sp, origin, 0.0 + one['to'], 0.0, 0.0 + one['at']]
        t = _held[t, 'value when retargeted', there.value, 0.0 + one['value'], _column_size[one['before'], 1]]
        t = _held[t, 'speed when retargeted', there.velocity, 0.0 + one['speed'], _column_size[one['before'], 2]]
        t = _samples_held[t, 'after', sp, there.value, 0.0 + one['next'], there.velocity, one['after']]
    assert[_told[t, 'retargeted springs'], _wrongs[t]]

fn _stagger_of[one]
    each = 0.0 + one['each']
    st = motion.stagger[each]
    if 0 + one['ranged'] eq 1
        st = motion.stagger_range[each, 0.0 + one['upto']]
    if str[one['rule']] eq 'motion'
        st = motion.stagger_motion[each]
    st.base = 0.0 + one['base']
    st.origin = str[one['origin']]
    st.origin_x = 0.0 + one['origin_x']
    st.origin_y = 0.0 + one['origin_y']
    st.reversed = 0 + one['reversed'] eq 1
    named = str[one['ease']]
    if named ne ''
        st = motion.stagger_eased[st, named]
    st = motion.stagger_grid[st, int[one['columns']], int[one['rows']]]
    st.axis = str[one['axis']]
    st.seed = int[one['seed']]
    st

test staggers_hold_to_anime_and_motion[]
    j = _reference[]
    t = _tally[]
    for one in j['staggers']
        st = _stagger_of[one]
        total = int[one['total']]
        rule = str[one['rule']]
        called = str[one['note']]
        note = '`rule` `called`'
        ours = motion.staggers[st, total]
        theirs = _numbers_of[one['values']]
        size = _size[theirs]
        t = _same[t, '`note` count', len[ours], len[theirs]]
        i = 0
        while i lt len[theirs] and i lt len[ours]
            t = _held[t, '`note` item `i`', ours[i], theirs[i], size]
            i = i + 1
    assert[_told[t, 'staggers'], _wrongs[t]]

test timeline_positions_hold_to_anime[]
    j = _reference[]
    t = _tally[]
    for one in j['timelines']
        note = str[one['note']]
        tl = motion.timeline[]
        tl.loops = int[one['loop']]
        tl.loop_delay = 0.0 + one['loop_delay']
        children = one['children']
        labels = one['labels']
        c = 0
        l = 0
        for step in one['steps']
            position = str[step['position']]
            if str[step['op']] eq 'add'
                name = 'child `c`'
                tl = motion.timeline_add[tl, name, 0.0 + step['duration'], position, delay = 0.0 + step['delay'], loops = int[step['loop']]]
                child = motion.child_of[tl, name]
                theirs = children[c]
                t = _held[t, '`note`: `name` at `position`', child.offset, 0.0 + theirs[0], 1.0]
                t = _held[t, '`note`: `name` delay', child.delay, 0.0 + theirs[1], 1.0]
                t = _held[t, '`note`: `name` length', child.total, 0.0 + theirs[2], 1.0]
                c = c + 1
            else
                name = str[step['name']]
                tl = motion.timeline_label[tl, name, position]
                theirs = labels[l]
                t = _held[t, '`note`: label `name` at `position`', motion.label_at[tl, name], 0.0 + theirs[1], 1.0]
                l = l + 1
        t = _held[t, '`note`: one play', tl.iteration_duration, 0.0 + one['iteration_duration'], 1.0]
        t = _held[t, '`note`: the whole', motion.timeline_duration[tl], 0.0 + one['duration'], 1.0]
    assert[_told[t, 'timelines'], _wrongs[t]]

test the_clock_loops_alternates_and_reverses_as_anime_does[]
    j = _reference[]
    t = _tally[]
    for one in j['timers']
        k = motion.tween_of[0.0, 1.0, 0.0 + one['duration'], 'linear']
        k.loops = int[one['loop']]
        k.alternate = 0 + one['alternate'] eq 1
        k.reversed = 0 + one['reversed'] eq 1
        k.loop_delay = 0.0 + one['loop_delay']
        k.delay = 0.0 + one['delay']
        t = _held[t, 'whole time', motion.tween_duration[k], 0.0 + one['total'], 1.0]
        for s in one['samples']
            at = 0.0 + s[0]
            head = motion.playhead[k, at]
            t = _same[t, 'play at `at`', head.iteration, int[s[1]]]
            t = _held[t, 'time in the play at `at`', head.time, 0.0 + s[2], 1.0]
    assert[_told[t, 'timer clocks'], _wrongs[t]]

test keyframes_hold_to_motion[]
    j = _reference[]
    t = _tally[]
    for one in j['keyframes']
        k = motion.keyframes[_numbers_of[one['values']], 0.0 + one['duration']]
        if len[one['times']] gt 0
            k.offsets = _numbers_of[one['times']]
        if len[one['eases']] gt 0
            eases = slice[[motion.ease['linear']], 0, 0]
            for name in _texts_of[one['eases']]
                eases = push[eases, motion.ease[name]]
            k.eases = eases
        named = str[one['ease']]
        if named ne ''
            k = motion.with_ease[k, named]
        size = _column_size[one['samples'], 1]
        for s in one['samples']
            at = 0.0 + s[0]
            t = _held[t, 'keyframes at `at`', motion.track_value[k, at], 0.0 + s[1], size]
    assert[_told[t, 'keyframes'], _wrongs[t]]

test inertia_glides_and_is_caught_as_motion_does[]
    j = _reference[]
    t = _tally[]
    n = 0
    for one in j['inertias']
        thrown = motion.inertia[0.0 + one['origin'], 0.0 + one['velocity']]
        thrown.power = 0.0 + one['power']
        thrown.time_constant = 0.0 + one['time_constant']
        thrown.bounce_stiffness = 0.0 + one['bounce_stiffness']
        thrown.bounce_damping = 0.0 + one['bounce_damping']
        thrown.rest_delta = 0.0 + one['rest_delta']
        thrown.rest_speed = 0.0 + one['rest_speed']
        thrown.snap = 0.0 + one['snap']
        if 0 + one['has_min'] eq 1
            thrown.low = 0.0 + one['min']
        if 0 + one['has_max'] eq 1
            thrown.high = 0.0 + one['max']
        g = motion.glide[thrown]
        size = _column_size[one['samples'], 1]
        for s in one['samples']
            at = 0.0 + s[0]
            g = motion.glided[thrown, g, at]
            t = _held[t, 'throw `n` at `at`', g.value, 0.0 + s[1], size]
            t = _same[t, 'throw `n` at rest at `at`', g.done, 0 + s[2] eq 1]
        n = n + 1
    assert[_told[t, 'inertia'], _wrongs[t]]

test scroll_progress_holds_to_motions_offsets[]
    j = _reference[]
    t = _tally[]
    for one in j['scrolls']
        offsets = _texts_of[one['offsets']]
        for s in one['samples']
            at = 0.0 + s[0]
            ours = motion.scroll_progress[at, 0.0 + one['container'], 0.0 + one['target'], 0.0 + one['inset'], offsets]
            t = _held[t, '`offsets` at `at`', ours, 0.0 + s[1], 1.0]
    assert[_told[t, 'scroll offsets'], _wrongs[t]]

test number_helpers_and_the_seeded_random_hold_to_anime[]
    j = _reference[]
    h = j['helpers']
    t = _tally[]
    for d in h['damp']
        t = _held[t, 'damp', motion.damp[0.0 + d[0], 0.0 + d[1], 0.0 + d[2], 0.0 + d[3]], 0.0 + d[4], 100.0]
    for d in h['lerp']
        t = _held[t, 'lerp', motion.blend[0.0 + d[0], 0.0 + d[1], 0.0 + d[2]], 0.0 + d[3], 1.0]
    for d in h['map_range']
        t = _held[t, 'mapRange', motion.map_range[0.0 + d[0], 0.0 + d[1], 0.0 + d[2], 0.0 + d[3], 0.0 + d[4]], 0.0 + d[5], 1.0]
    for d in h['wrap']
        t = _held[t, 'wrap', motion.wrapped[0.0 + d[0], 0.0 + d[1], 0.0 + d[2]], 0.0 + d[3], 1.0]
    for d in h['snap']
        t = _held[t, 'snap', motion.snapped[0.0 + d[0], 0.0 + d[1]], 0.0 + d[2], 1.0]
    for one in h['random']
        seed_number = int[one['seed']]
        r = motion.random_seeded[seed_number]
        for call in one['calls']
            r = motion.random_next[r, 0.0 + call[0], 0.0 + call[1], int[call[2]]]
            t = _held[t, 'seed `seed_number`', r.value, 0.0 + call[3], 1.0]
        u = motion.random_seeded[seed_number]
        for raw in one['raw']
            u = motion.random_unit[u]
            t = _held[t, 'seed `seed_number` unscaled', u.value, 0.0 + raw, 1.0]
    assert[_told[t, 'number helpers'], _wrongs[t]]
