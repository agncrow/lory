--- Lory's carousel held, number for number, to what react-slick 0.31.0
--- (with React 19.3.1) answers on fixed inputs, and its CSS `ease` to what
--- Chrome answers: reference.mjs beside this file ran react-slick's own
--- Slider in Node, a clock of its own firing its timers, and wrote
--- reference.json. Run from the repository's root:
---
---     crow test tests/carousel/reference.co
---     crow test --compiled tests/carousel/reference.co
---
--- Each case is a carousel mounted at 0 ms and acted on at fixed times
--- (arrows, dots, keys, slides pressed, swipes by a mouse and a touch,
--- the program's calls, the pointer resting on it, its width changed, its
--- slides added and taken away); after each act every number react-slick
--- shows is held: the slide shown and aimed at, whether it moves, the
--- track's offset and whether it moves there, autoplay's state, a drag
--- and where it dragged the track, a slide's width, the height adapted,
--- the slides loaded, every slide of the track (its index and whether it
--- is active, centred, a clone, the current one, loaded, and its opacity),
--- the dots and the arrows. Then every hook it told, with its time. All
--- are held exactly: the arithmetic is react-slick's, step for step.
--- The CSS timing functions a move is eased by (lory.motion's) are held to
--- Chrome's progress at 27 fractions of a second, within a millionth
--- (react-slick's, Vuetify's window's and Motion's default tween). And the
--- slide group's scroll targets and eased positions, the swipes Vuetify's
--- v-touch hears, and the Ticker's copies and wrap are held exactly to
--- Vuetify 4.3.3's and motion-plus-react 1.5.4's own functions.

use math
use lory
use lory.motion
use lory.carousel

--- how many numbers were held, how many of them exactly, the farthest any
--- was off, and every one not held
struct Tally [held, exact, worst, wrong]

fn _reference[]
    json[read['tests/carousel/reference.json']]

fn _tally[]
    Tally[0, 0, 0.0, slice[[''], 0, 0]]

--- the tally with one more answer that must be react-slick's exactly
fn _same[tally, where_held, what, ours, theirs]
    tally.held = tally.held + 1
    if ours eq theirs
        tally.exact = tally.exact + 1
        return tally
    tally.wrong = push[tally.wrong, '`where_held` `what`: Lory `ours`, react-slick `theirs`']
    tally

--- the tally with one more number held: Lory's progress is the browser's,
--- or off by no more than a millionth of the move (Chrome stops solving a
--- curve's x within 1e-7, lory.motion, as Motion does, within 1e-14)
fn _near[tally, where_held, what, ours, theirs]
    tally.held = tally.held + 1
    if ours eq theirs
        tally.exact = tally.exact + 1
        return tally
    scale = max[1.0, max[abs[ours], abs[theirs]]]
    off = abs[ours - theirs] / scale
    if off gt tally.worst
        tally.worst = off
    if not (off lte 0.000001)
        tally.wrong = push[tally.wrong, '`where_held` `what`: Lory `ours`, Chrome `theirs`']
    tally

--- whether every number was held, after logging the group's counts
fn _told[tally, group]
    log['`group`: `tally.held` held, `tally.exact` exactly']
    for w in slice[tally.wrong, 0, 20]
        log['  `w`']
    len[tally.wrong] eq 0

fn _ints[parsed]
    out = []
    for i in range[0]
        out = push[out, 0]
    i = 0
    while i lt len[parsed]
        out = push[out, int[0 + parsed[i]]]
        i = i + 1
    out

fn _floats[parsed]
    out = []
    for i in range[0]
        out = push[out, 0.0]
    i = 0
    while i lt len[parsed]
        out = push[out, 0.0 + parsed[i]]
        i = i + 1
    out

fn _filled[n, value]
    out = []
    for i in range[0]
        out = push[out, 0.0]
    i = 0
    while i lt n
        out = push[out, value]
        i = i + 1
    out

fn _flag[parsed]
    parsed eq true

--- ---- react-slick's settings, as Lory's ----

--- the settings `s` with those react-slick names in `j` put in
fn _overridden[s, j]
    if j.slidesToShow.ok
        s.show = int[0 + j.slidesToShow]
    if j.slidesToScroll.ok
        s.scroll = int[0 + j.slidesToScroll]
    if j.infinite.ok
        s.infinite = _flag[j.infinite]
    if j.centerMode.ok
        s.center = _flag[j.centerMode]
    if j.centerPadding.ok
        s.padding = '`j.centerPadding`'
    if j.variableWidth.ok
        s.variable = _flag[j.variableWidth]
    if j.fade.ok
        s.fade = _flag[j.fade]
    if j.speed.ok
        s.speed = 0.0 + j.speed
    if j.cssEase.ok
        s.ease = '`j.cssEase`'
    if j.autoplay.ok
        s.autoplay = _flag[j.autoplay]
    if j.autoplaySpeed.ok
        s.autoplay_speed = 0.0 + j.autoplaySpeed
    if j.pauseOnHover.ok
        s.pause_on_hover = _flag[j.pauseOnHover]
    if j.dots.ok
        s.dots = _flag[j.dots]
    if j.arrows.ok
        s.arrows = _flag[j.arrows]
    if j.initialSlide.ok
        s.initial = int[0 + j.initialSlide]
    if j.rtl.ok
        s.rtl = _flag[j.rtl]
    if j.vertical.ok
        s.vertical = _flag[j.vertical]
    if j.verticalSwiping.ok
        s.vertical_swiping = _flag[j.verticalSwiping]
    if j.adaptiveHeight.ok
        s.adaptive_height = _flag[j.adaptiveHeight]
    if j.lazyLoad.ok
        s.lazy = '`j.lazyLoad`'
    if j.swipe.ok
        s.swipe = _flag[j.swipe]
    if j.draggable.ok
        s.draggable = _flag[j.draggable]
    if j.touchThreshold.ok
        s.touch_threshold = 0.0 + j.touchThreshold
    if j.swipeToSlide.ok
        s.swipe_to_slide = _flag[j.swipeToSlide]
    if j.focusOnSelect.ok
        s.focus_on_select = _flag[j.focusOnSelect]
    if j.waitForAnimate.ok
        s.wait_for_animate = _flag[j.waitForAnimate]
    if j.accessibility.ok
        s.accessibility = _flag[j.accessibility]
    if j.rows.ok
        s.rows = int[0 + j.rows]
    if j.slidesPerRow.ok
        s.per_row = int[0 + j.slidesPerRow]
    s

--- a case's breakpoints, each its settings made from the base's
fn _points[base, j]
    out = slice[[carousel.unslicked[0.0]], 0, 0]
    if not j.responsive.ok
        return out
    i = 0
    while i lt len[j.responsive]
        b = j.responsive[i]
        wide = 0.0 + b.breakpoint
        if '`b.settings`' eq 'unslick'
            out = push[out, carousel.unslicked[wide]]
        else
            out = push[out, carousel.breakpoint[wide, _overridden[base, b.settings]]]
        i = i + 1
    out

--- the settings a case's carousel runs by: its breakpoint's at its page's
--- width (a window 10000 wide where it names none)
fn _chosen[c]
    base = _overridden[carousel.settings[], c.settings]
    page = 0.0 + c.page
    if page eq 0.0
        page = 10000.0
    carousel.at_width[base, _points[base, c.settings], page]

--- ---- a case run ----

--- one act of a case at its time
fn _acted[k, a, heights, widths, s]
    what = '`a.do`'
    at = 0.0 + a.t
    if what eq 'wait'
        return carousel.advanced[k, at]
    if what eq 'down' or what eq 'move' or what eq 'up' or what eq 'leave'
        return carousel.pointed[k, what, '`a.device`', 0.0 + a.x, 0.0 + a.y, at]
    if what eq 'resize'
        return carousel.resized[k, 0.0 + a.width, heights, widths, at]
    if what eq 'slides'
        n = int[0 + a.count]
        return carousel.reslid[k, s, n, _filled[n, 200.0], widths, at]
    if what eq 'go'
        if a.instant.ok and _flag[a.instant]
            return carousel.acted[k, 'go_now', int[0 + a.index], at]
        return carousel.acted[k, 'go', int[0 + a.index], at]
    if what eq 'slick_next'
        return carousel.acted[k, 'step_next', 0, at]
    if what eq 'slick_prev'
        return carousel.acted[k, 'step_previous', 0, at]
    if what eq 'key'
        return carousel.acted[k, 'key', int[0 + a.code], at]
    if what eq 'dot' or what eq 'slide'
        return carousel.acted[k, what, int[0 + a.index], at]
    carousel.acted[k, what, 0, at]

fn _one_if[b]
    if b
        return 1
    0

--- the tally with what the carousel shows held to what react-slick showed
fn _seen_held[tally, name, k, seen]
    if seen.plain.ok
        return _same[tally, name, 'plain', k.s.plain, true]
    tally = _same[tally, name, 'plain', k.s.plain, false]
    tally = _same[tally, name, 'time', k.now, 0.0 + seen.t]
    tally = _same[tally, name, 'current', k.current, int[0 + seen.current]]
    tally = _same[tally, name, 'target', k.target, int[0 + seen.target]]
    tally = _same[tally, name, 'animating', k.animating, _flag[seen.animating]]
    tally = _same[tally, name, 'left', carousel.track_left[k], 0.0 + seen.left]
    tally = _same[tally, name, 'moving', carousel.track_moving[k], _flag[seen.moving]]
    tally = _same[tally, name, 'autoplaying', k.autoplaying, '`seen.autoplaying`']
    tally = _same[tally, name, 'dragging', k.dragging, _flag[seen.dragging]]
    tally = _same[tally, name, 'swiped', k.has_swipe_left, seen.swipe_left.ok]
    if seen.swipe_left.ok and k.has_swipe_left
        tally = _same[tally, name, 'swipe left', k.swipe_left, 0.0 + seen.swipe_left]
    tally = _same[tally, name, 'slide width', k.slide_width, 0.0 + seen.slide_width]
    tally = _same[tally, name, 'list height', carousel.adapted_height[k], 0.0 + seen.list_height]
    loaded = _ints[seen.loaded]
    tally = _same[tally, name, 'loaded', len[k.loaded], len[loaded]]
    if len[k.loaded] eq len[loaded]
        i = 0
        while i lt len[loaded]
            tally = _same[tally, name, 'loaded `i`', k.loaded[i], loaded[i]]
            i = i + 1
    slots = carousel.slots_of[k]
    tally = _same[tally, name, 'slides', len[slots], len[seen.slides]]
    if len[slots] eq len[seen.slides]
        i = 0
        while i lt len[slots]
            one = slots[i]
            theirs = seen.slides[i]
            tally = _same[tally, name, 'slot `i` index', one.index, int[0 + theirs[0]]]
            tally = _same[tally, name, 'slot `i` active', _one_if[one.active], int[0 + theirs[1]]]
            tally = _same[tally, name, 'slot `i` center', _one_if[one.center], int[0 + theirs[2]]]
            tally = _same[tally, name, 'slot `i` cloned', _one_if[one.cloned], int[0 + theirs[3]]]
            tally = _same[tally, name, 'slot `i` current', _one_if[one.current], int[0 + theirs[4]]]
            tally = _same[tally, name, 'slot `i` loaded', _one_if[one.loaded], int[0 + theirs[5]]]
            tally = _same[tally, name, 'slot `i` alpha', one.alpha, 0.0 + theirs[6]]
            i = i + 1
    dots = carousel.dots_of[k]
    tally = _same[tally, name, 'dots', dots.count, int[0 + seen.dots.count]]
    tally = _same[tally, name, 'dot active', dots.active, int[0 + seen.dots.active]]
    previous = -1
    next_one = -1
    if carousel.arrows_shown[k]
        previous = _one_if[carousel.previous_off[k]]
        next_one = _one_if[carousel.next_off[k]]
    tally = _same[tally, name, 'previous off', previous, int[0 + seen.prev_disabled]]
    tally = _same[tally, name, 'next off', next_one, int[0 + seen.next_disabled]]
    tally

--- the tally with every hook the carousel told held to react-slick's, in
--- order, with its time
fn _events_held[tally, name, told, events]
    tally = _same[tally, name, 'hooks told', len[told], len[events]]
    if len[told] ne len[events]
        i = 0
        while i lt len[told]
            one = told[i]
            log['  `name` told `one.t` `one.what` `one.a` `one.b` `one.words` `one.slides`']
            i = i + 1
        i = 0
        while i lt len[events]
            theirs = events[i]
            log['  `name` react-slick `theirs.t` `theirs.what` `theirs.args`']
            i = i + 1
        return tally
    i = 0
    while i lt len[told]
        one = told[i]
        ev = events[i]
        what = '`ev.what`'
        tally = _same[tally, name, 'hook `i`', one.what, what]
        tally = _same[tally, name, 'hook `i` time', one.t, 0.0 + ev.t]
        if what eq 'before'
            tally = _same[tally, name, 'hook `i` from', one.a, int[0 + ev.args[0]]]
            tally = _same[tally, name, 'hook `i` to', one.b, int[0 + ev.args[1]]]
        if what eq 'after'
            tally = _same[tally, name, 'hook `i` at', one.a, int[0 + ev.args[0]]]
        if what eq 'swipe' or what eq 'edge'
            tally = _same[tally, name, 'hook `i` way', one.words, '`ev.args[0]`']
        if what eq 'lazy'
            slides = _ints[ev.args]
            tally = _same[tally, name, 'hook `i` slides', len[one.slides], len[slides]]
            if len[one.slides] eq len[slides]
                j = 0
                while j lt len[slides]
                    tally = _same[tally, name, 'hook `i` slide `j`', one.slides[j], slides[j]]
                    j = j + 1
        i = i + 1
    tally

--- the tally with the settings the carousel runs by held to those react-slick's
--- Slider handed on
fn _resolved_held[tally, name, k, r]
    if not r.slidesToShow.ok
        return tally
    s = k.s
    tally = _same[tally, name, 'show', s.show, int[0 + r.slidesToShow]]
    tally = _same[tally, name, 'scroll', s.scroll, int[0 + r.slidesToScroll]]
    tally = _same[tally, name, 'infinite', s.infinite, _flag[r.infinite]]
    tally = _same[tally, name, 'center', s.center, _flag[r.centerMode]]
    tally = _same[tally, name, 'padding', s.padding, '`r.centerPadding`']
    tally = _same[tally, name, 'variable', s.variable, _flag[r.variableWidth]]
    tally = _same[tally, name, 'fade', s.fade, _flag[r.fade]]
    tally = _same[tally, name, 'speed', s.speed, 0.0 + r.speed]
    tally = _same[tally, name, 'ease', s.ease, '`r.cssEase`']
    tally = _same[tally, name, 'autoplay', s.autoplay, _flag[r.autoplay]]
    tally = _same[tally, name, 'autoplay speed', s.autoplay_speed, 0.0 + r.autoplaySpeed]
    tally = _same[tally, name, 'pause on hover', s.pause_on_hover, _flag[r.pauseOnHover]]
    tally = _same[tally, name, 'dots', s.dots, _flag[r.dots]]
    tally = _same[tally, name, 'arrows', s.arrows, _flag[r.arrows]]
    tally = _same[tally, name, 'initial', s.initial, int[0 + r.initialSlide]]
    tally = _same[tally, name, 'rtl', s.rtl, _flag[r.rtl]]
    tally = _same[tally, name, 'vertical', s.vertical, _flag[r.vertical]]
    tally = _same[tally, name, 'vertical swiping', s.vertical_swiping, _flag[r.verticalSwiping]]
    tally = _same[tally, name, 'adaptive height', s.adaptive_height, _flag[r.adaptiveHeight]]
    lazy = ''
    if r.lazyLoad.ok
        lazy = '`r.lazyLoad`'
    tally = _same[tally, name, 'lazy', s.lazy, lazy]
    tally = _same[tally, name, 'swipe', s.swipe, _flag[r.swipe]]
    tally = _same[tally, name, 'draggable', s.draggable, _flag[r.draggable]]
    tally = _same[tally, name, 'touch move', s.touch_move, _flag[r.touchMove]]
    tally = _same[tally, name, 'touch threshold', s.touch_threshold, 0.0 + r.touchThreshold]
    tally = _same[tally, name, 'swipe to slide', s.swipe_to_slide, _flag[r.swipeToSlide]]
    tally = _same[tally, name, 'focus on select', s.focus_on_select, _flag[r.focusOnSelect]]
    tally = _same[tally, name, 'wait for animate', s.wait_for_animate, _flag[r.waitForAnimate]]
    tally = _same[tally, name, 'edge friction', s.edge_friction, 0.0 + r.edgeFriction]
    tally = _same[tally, name, 'accessibility', s.accessibility, _flag[r.accessibility]]
    tally = _same[tally, name, 'unslick', s.unslick, _flag[r.unslick]]
    tally = _same[tally, name, 'rows', s.rows, int[0 + r.rows]]
    tally = _same[tally, name, 'per row', s.per_row, int[0 + r.slidesPerRow]]
    tally = _same[tally, name, 'slide count', k.count, int[0 + r.slideCount]]
    tally

--- the tally with one case run and held
fn _case_held[tally, c]
    name = '`c.name`'
    s = _chosen[c]
    heights = _floats[c.heights]
    widths = _floats[c.widths]
    count = carousel.grouped[s, int[0 + c.count]]
    k = carousel.mount_at[s, count, 0.0 + c.width, heights, widths, 0.0]
    tally = _resolved_held[tally, name, k, c.resolved]
    tally = _seen_held[tally, '`name` mounted', k, c.steps[0].seen]
    i = 1
    while i lt len[c.steps]
        a = c.steps[i]
        k = _acted[k, a, heights, widths, s]
        tally = _seen_held[tally, '`name` at `a.t` (`a.do`)', k, a.seen]
        i = i + 1
    _events_held[tally, name, carousel.told_of[k], c.events]

--- ---- two carousels linked ----

--- the links each sent the other, carried until neither sends more (as
--- react-slick's asNavFor calls the other's slide handler as a move begins)
struct Pair [main, thumbs]

fn _carried[pair, at]
    going = true
    while going
        going = false
        sent = carousel.links_of[pair.main]
        pair.main = carousel.unlinked[pair.main]
        for index in sent
            pair.thumbs = carousel.linked_to[pair.thumbs, index, at]
            going = true
        sent = carousel.links_of[pair.thumbs]
        pair.thumbs = carousel.unlinked[pair.thumbs]
        for index in sent
            pair.main = carousel.linked_to[pair.main, index, at]
            going = true
    pair

fn _linked_held[tally, l]
    name = '`l.name`'
    main_s = _overridden[carousel.settings[], l.main.settings]
    main_s.nav_for = 'thumbs'
    thumbs_s = _overridden[carousel.settings[], l.thumbs.settings]
    thumbs_s.nav_for = 'main'
    n = int[0 + l.count]
    wide = 0.0 + l.width
    heights = _filled[n, 200.0]
    widths = slice[heights, 0, 0]
    pair = Pair[carousel.mount_at[main_s, n, wide, heights, widths, 0.0], carousel.mount_at[thumbs_s, n, wide, heights, widths, 0.0]]
    tally = _resolved_held[tally, '`name` main', pair.main, l.main.resolved]
    tally = _resolved_held[tally, '`name` thumbs', pair.thumbs, l.thumbs.resolved]
    tally = _seen_held[tally, '`name` main mounted', pair.main, l.main.seen[0]]
    tally = _seen_held[tally, '`name` thumbs mounted', pair.thumbs, l.thumbs.seen[0]]
    i = 1
    while i lt len[l.acts]
        a = l.acts[i]
        at = 0.0 + a.t
        --- (both clocks moved on first, as one page's timers fire in turn)
        pair.main = carousel.advanced[pair.main, at]
        pair.thumbs = carousel.advanced[pair.thumbs, at]
        if '`a.on`' eq 'main'
            pair.main = _acted[pair.main, a, heights, widths, main_s]
        else
            pair.thumbs = _acted[pair.thumbs, a, heights, widths, thumbs_s]
        pair = _carried[pair, at]
        tally = _seen_held[tally, '`name` main at `a.t` (`a.on` `a.do`)', pair.main, l.main.seen[i]]
        tally = _seen_held[tally, '`name` thumbs at `a.t` (`a.on` `a.do`)', pair.thumbs, l.thumbs.seen[i]]
        i = i + 1
    tally = _events_held[tally, '`name` main', carousel.told_of[pair.main], l.main.events]
    _events_held[tally, '`name` thumbs', carousel.told_of[pair.thumbs], l.thumbs.events]

--- ---- the tests ----

test every_case_moves_as_react_slick_moves[]
    r = _reference[]
    tally = _tally[]
    i = 0
    while i lt len[r.cases]
        tally = _case_held[tally, r.cases[i]]
        i = i + 1
    _told[tally, '`len[r.cases]` cases']

test two_linked_carousels_move_each_other_as_react_slick_s_do[]
    r = _reference[]
    tally = _tally[]
    i = 0
    while i lt len[r.linked]
        tally = _linked_held[tally, r.linked[i]]
        i = i + 1
    _told[tally, 'linked']

test css_timing_functions_ease_near_as_chrome_eases[]
    r = _reference[]
    tally = _tally[]
    names = ['ease', 'linear', 'ease-in', 'ease-out', 'ease-in-out', 'cubic-bezier(0.68, -0.55, 0.265, 1.55)', 'cubic-bezier(0.7, 0, 0.3, 1)', 'cubic-bezier(0.25, 0.8, 0.5, 1)', 'cubic-bezier(0.25, 0.1, 0.35, 1)']
    fractions = _floats[r.ease.fractions]
    for name in names
        curve = _floats[r.ease.curves[name]]
        i = 0
        while i lt len[fractions]
            tally = _near[tally, name, 'at `fractions[i]`', motion.ease_at[name, fractions[i]], curve[i]]
            i = i + 1
    units = round[tally.worst * 10.0 ^ 9] / 1000.0
    log['the farthest off by `units` millionths of a move']
    _told[tally, 'eased, against `r.ease.browser`']

test vuetify_s_slide_group_and_touch_and_motion_s_ticker_hold[]
    v = _reference[].vuetify
    tally = _tally[]
    for one in v.targets
        room = 0.0 + one.room
        here = 0.0 + one.here
        start = 0.0 + one.start
        size = 0.0 + one.size
        where = 'room `room` at `here` control `start`+`size`'
        tally = _same[tally, where, 'shown', carousel.group_target[room, here, start, size, false], 0.0 + one.updated]
        tally = _same[tally, where, 'centred', carousel.group_target[room, here, start, size, true], 0.0 + one.centered]
    fractions = _floats[v.fractions]
    for one in v.scrolls
        at = _floats[one.at]
        i = 0
        while i lt len[fractions]
            tally = _same[tally, 'scroll `one.from` to `one.to`', 'at `fractions[i]`', carousel.group_eased[0.0 + one.from, 0.0 + one.to, fractions[i]], at[i]]
            i = i + 1
    for one in v.swipes
        tally = _same[tally, 'swipe (`one.x0`, `one.y0`) to (`one.x1`, `one.y1`)', 'way', carousel.swipe_way[0.0 + one.x0, 0.0 + one.y0, 0.0 + one.x1, 0.0 + one.y1], '`one.heard`']
    for one in v.tickers
        n = len[one.positions]
        total = (0.0 + one.positions[n - 1].end) - (0.0 + one.positions[0].start)
        largest = 0.0
        i = 0
        while i lt n
            largest = max[largest, (0.0 + one.positions[i].end) - (0.0 + one.positions[i].start)]
            i = i + 1
        tally = _same[tally, 'ticker in `one.visible`', 'copies', carousel.ticker_copies[0.0 + one.visible, total, largest, 0.0 + one.gap], int[0 + one.copies]]
    for one in v.wraps
        tally = _same[tally, 'wrap `one.v` into [`one.low`, `one.high`)', 'wrapped', carousel.ticker_wrapped[0.0 + one.low, 0.0 + one.high, 0.0 + one.v], 0.0 + one.wrapped]
    _told[tally, 'Vuetify `v.vuetify`, motion-plus-react `v.motion_plus_react`']

