        for s in c.steps
            i = i + 1
            t = _selecting[t, s]
            k = _selects_held[k, '`name` after `i` (`s[0]`)', t, c.out[i]]
    _verdict[k, 'selection steps'] gte 12245

-------------------------------------------------------------------- sequences: row pinning

fn _pins_held[k, label, t, out]
    m = dt.models[t]
    k = _list_held[k, '`label` top', out.top, t.state.top]
    k = _list_held[k, '`label` bottom', out.bottom, t.state.bottom]
    k = _list_held[k, '`label` top rows', out.topRows, _ids[m, dt.top_rows[t, m], true]]
    k = _list_held[k, '`label` center rows', out.centerRows, _ids[m, dt.center_rows[t, m], true]]
    k = _list_held[k, '`label` bottom rows', out.bottomRows, _ids[m, dt.bottom_rows[t, m], true]]
    k = _with[k, '`label` some pinned', _text[out.some], _flag_text[dt.some_rows_pinned[t]]]
    k = _with[k, '`label` some pinned on top', _text[out.someTop], _flag_text[dt.some_rows_pinned[t, 'top']]]
    for key in keys[out.rows]
        id = '`key`'
        w = out.rows[key]
        at = '`label` `id`'
        k = _with[k, '`at` pinned', _text[w[0]], _or_false[dt.row_pin_of[t, id]]]
        k = _with[k, '`at` pinned index', _text[w[1]], _whole[dt.pinned_row_index[t, m, id]]]
        k = _with[k, '`at` can pin', _text[w[2]], _flag_text[dt.can_pin_row[t, id]]]
    k

test every_row_pin_is_tanstacks[]
    j = _reference[]
    k = _begun[]
    for c in j.pins
        t = table_from[j, c]
        name = '`c.name`'
        k = _pins_held[k, '`name` at first', t, c.out[0]]
        i = 0
        for s in c.steps
            i = i + 1
            side = ''
            if type[s[1]] eq 'str'
                side = '`s[1]`'
            leaves = len[s] gt 2 and _flag[s[2]]
            parents = len[s] gt 3 and _flag[s[3]]
            t = dt.row_pinned[t, '`s[0]`', side, leaves, parents]
            k = _pins_held[k, '`name` after `i`', t, c.out[i]]
    _verdict[k, 'row pins'] gte 3247

-------------------------------------------------------------------- columns: order, visibility, pinning, sizes, headers

fn _texts_held[k, label, want, got]
    n = len[want]
    if n ne len[got]
        k.held = k.held + n
        w = join[want, ' ']
        g = join[got, ' ']
        k.wrong = push[k.wrong, '`label`: the library has `n` items `w`, Lory has `len[got]`: `g`']
        return k
    i = 0
    while i lt n
        k = _with[k, '`label`[`i`]', want[i], got[i]]
        i = i + 1
    k

fn _key_list[j]
    sort[_words[keys[j]]]

fn _headers_held[k, label, want, got]
    k = _with[k, '`label` rows of headers', _whole[len[want]], _whole[len[got]]]
    if len[want] ne len[got]
        return k
    i = 0
    while i lt len[want]
        w = want[i]
        g = got[i]
        at = '`label` row `i`'
        k = _with[k, '`at` id', _text[w.id], g.id]
        k = _with[k, '`at` depth', _text[w.depth], _whole[g.depth]]
        k = _with[k, '`at` headers', _whole[len[w.headers]], _whole[len[g.headers]]]
        if len[w.headers] eq len[g.headers]
            x = 0
            while x lt len[w.headers]
                wh = w.headers[x]
                gh = g.headers[x]
                here = '`at` header `x`'
                k = _with[k, '`here` id', _text[wh.id], gh.id]
                k = _with[k, '`here` column', _text[wh.column], gh.column]
                k = _with[k, '`here` columns spanned', _text[wh.colSpan], _whole[gh.columns]]
                k = _with[k, '`here` rows spanned', _text[wh.rowSpan], _whole[gh.rows]]
                k = _with[k, '`here` holds a place', _text[wh.placeholder], _flag_text[gh.placeholder]]
                k = _with[k, '`here` place', _text[wh.placeholderId], gh.place]
                k = _with[k, '`here` depth', _text[wh.depth], _whole[gh.depth]]
                k = _with[k, '`here` index', _text[wh.index], _whole[gh.index]]
                k = _with[k, '`here` size', _text[wh.size], _real[gh.size]]
                k = _with[k, '`here` start', _text[wh.start], _real[gh.offset]]
                k = _list_held[k, '`here` subs', wh.subs, gh.subs]
                x = x + 1
        i = i + 1
    k

fn _place_of[t, id]
    side = dt.column_pin_of[t, id]
    if side eq ''
        return 'center'
    side

fn _columns_held[k, label, t, out]
    k = _list_held[k, '`label` all', out.all, _column_ids[dt.leaf_columns[t]]]
    k = _list_held[k, '`label` flat', out.flat, _column_ids[dt.flat_columns[t]]]
    k = _list_held[k, '`label` visible', out.visible, _column_ids[dt.visible_columns[t]]]
    k = _list_held[k, '`label` visible flat', out.visibleFlat, _column_ids[dt.visible_flat_columns[t]]]
    k = _list_held[k, '`label` start', out.start, _column_ids[dt.side_columns[t, 'start']]]
    k = _list_held[k, '`label` center', out.center, _column_ids[dt.side_columns[t, 'center']]]
    k = _list_held[k, '`label` end', out.end, _column_ids[dt.side_columns[t, 'end']]]
    k = _with[k, '`label` all visible', _text[out.allVisible], _flag_text[dt.all_visible[t]]]
    k = _with[k, '`label` some visible', _text[out.someVisible], _flag_text[dt.some_visible[t]]]
    k = _with[k, '`label` some pinned', _text[out.somePinned], _flag_text[dt.some_columns_pinned[t]]]
    k = _with[k, '`label` total size', _text[out.total], _real[dt.total_size[t]]]
    k = _with[k, '`label` start size', _text[out.startTotal], _real[dt.side_size[t, 'start']]]
    k = _with[k, '`label` center size', _text[out.centerTotal], _real[dt.side_size[t, 'center']]]
    k = _with[k, '`label` end size', _text[out.endTotal], _real[dt.side_size[t, 'end']]]
    k = _headers_held[k, '`label` headers', out.headers, dt.header_groups[t, 'all']]
    k = _headers_held[k, '`label` start headers', out.startHeaders, dt.header_groups[t, 'start']]
    k = _headers_held[k, '`label` center headers', out.centerHeaders, dt.header_groups[t, 'center']]
    k = _headers_held[k, '`label` end headers', out.endHeaders, dt.header_groups[t, 'end']]
    k = _texts_held[k, '`label` visibility state', _key_list[out.visibility], keys[t.state.visible]]
    for key in keys[out.visibility]
        id = '`key`'
        if id in t.state.visible
            k = _with[k, '`label` visibility of `id`', _text[out.visibility[key]], _flag_text[t.state.visible[id]]]
    k = _list_held[k, '`label` pinned to the start', _part[out.pinning, 'start'], t.state.start]
    k = _list_held[k, '`label` pinned to the end', _part[out.pinning, 'end'], t.state.end]
    k = _list_held[k, '`label` order', out.order, t.state.order]
    k = _texts_held[k, '`label` sizing state', _key_list[out.sizing], keys[t.state.sizes]]
    for key in keys[out.sizing]
        id = '`key`'
        if id in t.state.sizes
            k = _with[k, '`label` size of `id` in the state', _text[out.sizing[key]], _real[t.state.sizes[id]]]
    for key in keys[out.columns]
        id = '`key`'
        w = out.columns[key]
        place = _place_of[t, id]
        at = '`label` `id`'
        k = _with[k, '`at` visible', _text[w.visible], _flag_text[dt.is_visible[t, id]]]
        k = _with[k, '`at` can hide', _text[w.canHide], _flag_text[dt.can_hide[t, id]]]
        k = _with[k, '`at` pinned', _text[w.pinned], _or_false[dt.column_pin_of[t, id]]]
        k = _with[k, '`at` pinned index', _text[w.pinnedIndex], _whole[dt.pinned_column_index[t, id]]]
        k = _with[k, '`at` can pin', _text[w.canPin], _flag_text[dt.can_pin_column[t, id]]]
        k = _with[k, '`at` size', _text[w.size], _real[dt.column_size[t, id]]]
        k = _with[k, '`at` start', _text[w.start], _real[dt.column_start[t, id]]]
        k = _with[k, '`at` start in its part', _text[w.startHere], _real[dt.column_start[t, id, place]]]
        k = _with[k, '`at` after', _text[w.after], _real[dt.column_after[t, id]]]
        k = _with[k, '`at` after in its part', _text[w.afterHere], _real[dt.column_after[t, id, place]]]
        k = _with[k, '`at` index', _text[w.index], _whole[dt.column_index[t, id]]]
        k = _with[k, '`at` index in its part', _text[w.indexHere], _whole[dt.column_index[t, id, place]]]
        k = _with[k, '`at` first', _text[w.first], _flag_text[dt.is_first_column[t, id]]]
        k = _with[k, '`at` last', _text[w.last], _flag_text[dt.is_last_column[t, id]]]
        k = _with[k, '`at` first in its part', _text[w.firstHere], _flag_text[dt.is_first_column[t, id, place]]]
        k = _with[k, '`at` last in its part', _text[w.lastHere], _flag_text[dt.is_last_column[t, id, place]]]
        k = _with[k, '`at` can resize', _text[w.canResize], _flag_text[dt.can_resize[t, id]]]
        k = _with[k, '`at` depth', _text[w.depth], _whole[dt.column_depth[t, id]]]
        k = _with[k, '`at` parent', _text[w.parent], dt.column_parent[t, id]]
    k

fn _column_step[t, s]
    what = '`s[0]`'
    valued = len[s] gt 2 and type[s[2]] ne 'error'
    if what eq 'hide'
        if valued
            return dt.visibility_set[t, '`s[1]`', _flag[s[2]]]
        return dt.visibility_toggled[t, '`s[1]`']
    if what eq 'all'
        if valued
            return dt.all_visibility_set[t, _flag[s[2]]]
        return dt.all_visibility_toggled[t]
    if what eq 'pin'
        side = ''
        if type[s[2]] eq 'str'
            side = '`s[2]`'
        return dt.column_pinned[t, '`s[1]`', side]
    if what eq 'order'
        return dt.order_set[t, _words[s[2]]]
    if what eq 'reset size'
        return dt.column_size_reset[t, '`s[1]`']
    t

test every_column_report_is_tanstacks[]
    j = _reference[]
    k = _begun[]
    for c in j.columnCases
        t = table_from[j, c]
        name = '`c.name`'
        k = _columns_held[k, '`name` at first', t, c.out[0]]
        i = 0
        for s in c.steps
            i = i + 1
            t = _column_step[t, s]
            k = _columns_held[k, '`name` after `i` (`s[0]`)', t, c.out[i]]
    _verdict[k, 'columns'] gte 34587

-------------------------------------------------------------------- sequences: resizing

fn _resize_held[k, label, t, out]
    k = _texts_held[k, '`label` sizing', _key_list[out.sizing], keys[t.state.sizes]]
    for key in keys[out.sizing]
        id = '`key`'
        if id in t.state.sizes
            k = _with[k, '`label` size of `id`', _text[out.sizing[key]], _real[t.state.sizes[id]]]
    r = t.state.resizing
    w = out.resizing
    if r.column eq ''
        k = _with[k, '`label` column resizing', _text[w.isResizingColumn], 'false']
        k = _with[k, '`label` start offset', _text[w.startOffset], 'null']
        k = _with[k, '`label` start size', _text[w.startSize], 'null']
        k = _with[k, '`label` moved', _text[w.deltaOffset], 'null']
        k = _with[k, '`label` share', _text[w.deltaPercentage], 'null']
        k = _with[k, '`label` sizes it began with', _whole[len[w.columnSizingStart]], '0']
    else
        k = _with[k, '`label` column resizing', _text[w.isResizingColumn], r.column]
        k = _with[k, '`label` start offset', _text[w.startOffset], _real[r.offset]]
        k = _with[k, '`label` start size', _text[w.startSize], _real[r.size]]
        k = _with[k, '`label` moved', _text[w.deltaOffset], _real[r.moved]]
        k = _with[k, '`label` share', _text[w.deltaPercentage], _real[r.share]]
        k = _with[k, '`label` sizes it began with', _whole[len[w.columnSizingStart]], _whole[len[r.sizes]]]
        if len[w.columnSizingStart] eq len[r.sizes]
            i = 0
            while i lt len[r.sizes]
                k = _with[k, '`label` began with `i`', _text[w.columnSizingStart[i][0]], r.sizes[i].id]
                k = _with[k, '`label` began with `i` size', _text[w.columnSizingStart[i][1]], _real[r.sizes[i].size]]
                i = i + 1
    resizing = _no_texts[]
    for c in dt.leaf_columns[t]
        if dt.is_resizing[t, c.id]
            resizing = push[resizing, c.id]
    _list_held[k, '`label` columns resizing', out.resizingColumns, resizing]

test every_resize_is_tanstacks[]
    j = _reference[]
    k = _begun[]
    for c in j.resizes
        t = table_from[j, c]
        name = '`c.name`'
        moves = slice[[0.0], 0, 0]
        for x in c.moves
            moves = push[moves, 0.0 + x]
        last = len[moves] - 1
        t = dt.resize_started[t, '`c.header`', moves[0]]
        k = _resize_held[k, '`name` begun', t, c.out[0]]
        i = 1
        while i lt last
            t = dt.resize_moved[t, moves[i]]
            k = _resize_held[k, '`name` moved `i`', t, c.out[i]]
            i = i + 1
        t = dt.resize_ended[t, moves[last]]
        k = _resize_held[k, '`name` ended', t, c.out[last]]
    _verdict[k, 'resizes'] gte 292

-------------------------------------------------------------------- faceting

test every_facet_is_tanstacks[]
    j = _reference[]
    k = _begun[]
    for c in j.facets
        t = table_from[j, c]
        m = dt.models[t]
        name = '`c.name`'
        for key in keys[c.out]
            id = '`key`'
            w = c.out[key]
            at = '`name` `id`'
            k = _list_held[k, '`at` rows', w.rows, _ids[m, dt.faceted_rows[t, m.core, id].flat, false]]
            got = dt.faceted_values[t, m.core, id]
            k = _with[k, '`at` values', _whole[len[w.unique]], _whole[len[got]]]
            if len[w.unique] eq len[got]
                i = 0
                while i lt len[got]
                    k = _value_held[k, '`at` value `i`', w.unique[i][0], got[i].value]
                    k = _with[k, '`at` count `i`', _text[w.unique[i][1]], _whole[got[i].count]]
                    i = i + 1
            reach = dt.faceted_range[t, m.core, id]
            span = dt.missing[]
            if reach.found
                span = dt.listed[[dt.number[reach.least], dt.number[reach.greatest]]]
            k = _value_held[k, '`at` range', w.minmax, span]
    _verdict[k, 'facets'] gte 2933

-------------------------------------------------------------------- Grid.js

fn _grid_cells[j]
    out = slice[[[dt.missing[]]], 0, 0]
    for row in j
        cells = slice[[dt.missing[]], 0, 0]
        for x in row
            if type[x] eq 'str'
                cells = push[cells, dt.words['`x`']]
            else
                cells = push[cells, dt.number[0.0 + x]]
        out = push[out, cells]
    out

fn _grid_held[k, label, g, lang, out, width]
    total = dt.grid_total[g]
    if total eq 0
        k = _with[k, '`label` body', _whole[len[out.body]], '1']
        k = _with[k, '`label` nothing found', _text[out.body[0][0]], lang.none_found]
        k = _with[k, '`label` summary', _text[out.summary], 'null']
        k = _with[k, '`label` summary title', _text[out.summaryTitle], 'null']
        k = _with[k, '`label` empty', _text[out.empty], lang.none_found]
    else
        shown = dt.grid_shown[g]
        k = _with[k, '`label` body', _whole[len[out.body]], _whole[len[shown]]]
        if len[out.body] eq len[shown]
            r = 0
            while r lt len[shown]
                cells = g.rows[shown[r]]
                x = 0
                while x lt width
                    k = _with[k, '`label` cell `r` `x`', _text[out.body[r][x]], dt.grid_cell_text[cells[x]]]
                    x = x + 1
                r = r + 1
        k = _with[k, '`label` summary', _text[out.summary], dt.grid_summary[g, lang]]
        k = _with[k, '`label` summary title', _text[out.summaryTitle], dt.grid_summary_title[g, lang]]
        k = _with[k, '`label` empty', _text[out.empty], 'null']
    buttons = dt.grid_buttons[g, lang]
    k = _with[k, '`label` buttons', _whole[len[out.buttons]], _whole[len[buttons]]]
    if len[out.buttons] eq len[buttons]
        i = 0
        while i lt len[buttons]
            w = out.buttons[i]
            b = buttons[i]
            at = '`label` button `i`'
            k = _with[k, '`at` words', _text[w.text], b.label]
            k = _with[k, '`at` off', _text[w.disabled], _flag_text[b.disabled]]
            k = _with[k, '`at` current', _text[w.current], _flag_text[b.current]]
            k = _with[k, '`at` gap', _text[w.spread], _flag_text[b.spread]]
            k = _with[k, '`at` title', _text[w.title], b.title]
            i = i + 1
    x = 0
    while x lt width
        k = _with[k, '`label` sort `x`', _text[out.sorts[x].state], dt.grid_sort_state[g, x]]
        k = _with[k, '`label` sort `x` title', _text[out.sorts[x].title], dt.grid_sort_title[g, lang, x]]
        x = x + 1
    _with[k, '`label` placeholder', _text[out.placeholder], lang.placeholder]

fn _grid_step[g, lang, s]
    what = '`s[0]`'
    if what eq 'next'
        return dt.grid_next[g]
    if what eq 'previous'
        return dt.grid_previous[g]
    if what eq 'page'
        words = '`s[1]`'
        for b in dt.grid_buttons[g, lang]
            if b.label eq words and not b.spread
                return dt.grid_page_pressed[g, b.goes]
        return g
    if what eq 'last'
        goes = -1
        for b in dt.grid_buttons[g, lang]
            if not b.spread and b.goes gte 0 and b.label ne lang.previous and b.label ne lang.following
                goes = b.goes
        return dt.grid_page_pressed[g, goes]
    if what eq 'search'
        return dt.grid_searched[g, '`s[1]`']
    if what eq 'sort'
        return dt.grid_sort_pressed[g, int[s[1]], len[s] gt 2 and _flag[s[2]]]
    g

fn _grid_run[k, label, g, lang, run, width]
    i = 0
    for s in run.steps
        g = _grid_step[g, lang, s]
        k = _grid_held[k, '`label` step `i` (`s[0]`)', g, lang, run.out[i], width]
        i = i + 1
    k

test every_grid_answer_is_gridjss[]
    j = _reference[]
    k = _begun[]
    grid = j.gridjs
    lang = dt.grid_language[]
    rows = _grid_cells[grid.rows]
    width = len[grid.columns]
    first = dt.grid[rows, int[grid.first.limit], int[grid.first.buttons]]
    k = _grid_run[k, 'first grid', first, lang, grid.first, width]
    second = dt.grid[slice[rows, 0, int[grid.second.rows]], int[grid.second.limit], int[grid.second.buttons]]
    k = _grid_run[k, 'second grid', second, lang, grid.second, width]
    _verdict[k, 'Grid.js'] gte 3643
