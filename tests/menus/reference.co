--- Lory's menus, overlays and disclosure held, answer for answer, to what
--- cmdk 1.1.1, Radix's primitives (react-menu 2.2.1, react-tooltip 1.4.1,
--- react-toast 1.3.1 and the rest reference.mjs names), Vuetify 4.3.1 and
--- Semantic UI's css 2.4.1 answer on fixed inputs: reference.mjs beside
--- this file ran the libraries and wrote reference.json. Run from the
--- repository's root:
---
---     crow test tests/menus/reference.co
---     crow test --compiled tests/menus/reference.co
---
--- A score is held when Lory's float is cmdk's, or differs from it by no
--- more than 2^-50 of it (a score is a product of factors under 1, so a
--- last bit may round apart); every other answer (a match, a side, a
--- point inside or out, a hull's corners, a tick) must be the library's
--- exactly. Each test logs how many answers it held and how many of the
--- scores were the same bit for bit.

use lory
use lory.menus
use lory.overlays
use lory.disclosure

--- how many answers were held, how many bit for bit, and every one not
struct Tally [held, exact, wrong]

fn _reference[]
    json[read['tests/menus/reference.json']]

fn _tally[]
    Tally[0, 0, slice[[''], 0, 0]]

fn _close[tally, what, ours, theirs]
    tally.held = tally.held + 1
    if ours eq theirs
        tally.exact = tally.exact + 1
        return tally
    if not (abs[ours - theirs] lte 2.0 ^ -50 * max[abs[theirs], 1.0])
        tally.wrong = push[tally.wrong, '`what`: Lory `ours`, the library `theirs`']
    tally

fn _same[tally, what, ours, theirs]
    tally.held = tally.held + 1
    if ours eq theirs
        tally.exact = tally.exact + 1
        return tally
    tally.wrong = push[tally.wrong, '`what`: Lory `ours`, the library `theirs`']
    tally

fn _told[tally, group]
    log['`group`: `tally.held` held, `tally.exact` the same bit for bit']
    len[tally.wrong] eq 0

fn _wrongs[tally]
    join[slice[tally.wrong, 0, 20], '\n']

fn _numbers_of[parsed]
    out = slice[[0.0], 0, 0]
    for v in parsed
        out = push[out, 0.0 + v]
    out

fn _texts_of[parsed]
    out = slice[[''], 0, 0]
    for v in parsed
        out = push[out, str[v]]
    out

fn _flat_words[xs]
    out = slice[[''], 0, 0]
    for x in xs
        out = push[out, fmt[x]]
    join[out, ' ']

test the_constants_are_the_libraries_own[]
    j = _reference[]
    want = map['' = 0.0]
    for one in j['constants']
        want[str[one['what']]] = 0.0 + one['value']
    t = _tally[]
    t = _same[t, 'submenu_delay', menus.submenu_delay[], want['submenu_delay']]
    t = _same[t, 'grace_bleed', menus.grace_bleed[], want['grace_bleed']]
    t = _same[t, 'grace_time', menus.grace_time[], want['grace_time']]
    t = _same[t, 'typeahead_time', menus.typeahead_time[], want['typeahead_time']]
    t = _same[t, 'long_press', menus.long_press[], want['long_press']]
    t = _same[t, 'nav_delay', menus.nav_delay[], want['nav_delay']]
    t = _same[t, 'nav_skip_delay', menus.nav_skip_delay[], want['nav_skip_delay']]
    t = _same[t, 'nav_close_delay', menus.nav_close_delay[], want['nav_close_delay']]
    t = _same[t, 'tip_delay', overlays.tip_delay[], want['tip_delay']]
    t = _same[t, 'tip_skip_delay', overlays.tip_skip_delay[], want['tip_skip_delay']]
    t = _same[t, 'tip_padding', overlays.tip_padding[], want['tip_padding']]
    t = _same[t, 'card_open_delay', overlays.card_open_delay[], want['card_open_delay']]
    t = _same[t, 'card_close_delay', overlays.card_close_delay[], want['card_close_delay']]
    t = _same[t, 'toast_time', overlays.toast_time[], want['toast_time']]
    t = _same[t, 'swipe_threshold', overlays.swipe_threshold[], want['swipe_threshold']]
    t = _same[t, 'swipe_start touch', overlays.swipe_start['touch'], want['swipe_start_touch']]
    t = _same[t, 'swipe_start mouse', overlays.swipe_start['mouse'], want['swipe_start_mouse']]
    t = _same[t, 'snack_gap', overlays.snack_gap[], want['snack_gap']]
    t = _same[t, 'snack_time', overlays.notice['n', 'Saved'].lasts, want['snack_time']]
    t = _same[t, 'sheet_time', overlays.sheet_time[], want['sheet_seconds'] * 1000.0]
    t = _same[t, 'dim_time', overlays.dim_time[], want['dim_seconds'] * 1000.0]
    t = _same[t, 'dim_depth', overlays.dim_depth[], want['dim_depth']]
    t = _same[t, 'toast_hotkey', overlays.toast_hotkey[], str[j['hotkey']]]
    assert[_told[t, 'constants'], _wrongs[t]]
    len[j['constants']] eq 22

test command_scores_are_cmdks[]
    j = _reference[]
    queries = _texts_of[j['queries']]
    t = _tally[]
    i = 0
    for cmd in j['commands']
        words = str[cmd[0]]
        keywords = str[cmd[1]]
        theirs = _numbers_of[j['scores'][i]]
        k = 0
        while k lt len[queries]
            q = queries[k]
            t = _close[t, '`words` for `q`', menus.command_score[words, q, keywords], theirs[k]]
            k = k + 1
        i = i + 1
    assert[_told[t, 'cmdk scores'], _wrongs[t]]
    t.held eq 720

test typing_ahead_finds_what_radix_finds[]
    j = _reference[]
    t = _tally[]
    for one in j['matches']
        names = _texts_of[one[0]]
        search = str[one[1]]
        current = str[one[2]]
        t = _same[t, '`search` from `current`', menus.next_match[names, search, current], str[one[3]]]
    assert[_told[t, 'Radix typeahead'], _wrongs[t]]
    t.held eq 440

test a_submenus_grace_area_and_the_points_in_it_are_radixs[]
    j = _reference[]
    t = _tally[]
    for g in j['graces']
        x = 0.0 + g['x']
        y = 0.0 + g['y']
        box = _numbers_of[g['box']]
        right = 0 + g['right'] eq 1
        area = menus.grace_area[x, y, box, right]
        t = _same[t, 'area from `x`, `y`', _flat_words[area], _flat_words[_numbers_of[g['area']]]]
        for p in g['points']
            px = 0.0 + p[0]
            py = 0.0 + p[1]
            t = _same[t, '`px`, `py` in the area from `x`, `y`', menus.inside_polygon[px, py, area], 0 + p[2] eq 1]
    assert[_told[t, 'Radix submenu grace'], _wrongs[t]]
    t.held eq 1264

test a_tooltips_exit_side_padded_points_and_hull_are_radixs[]
    j = _reference[]
    t = _tally[]
    trigger = [100.0, 100.0, 120.0, 40.0]
    for one in j['sides']
        x = 0.0 + one[0]
        y = 0.0 + one[1]
        side = overlays.exit_side[x, y, trigger]
        t = _same[t, 'side at `x`, `y`', side, str[one[2]]]
        t = _same[t, 'padded at `x`, `y`', _flat_words[overlays.padded_exit[x, y, side]], _flat_words[_numbers_of[one[3]]]]
    for one in j['hulls']
        x = 0.0 + one['x']
        y = 0.0 + one['y']
        ours = overlays.grace_hull[x, y, trigger, _numbers_of[one['to']]]
        t = _same[t, 'grace hull from `x`, `y`', _flat_words[ours], _flat_words[_numbers_of[one['hull']]]]
    k = 0
    for one in j['sets']
        t = _same[t, 'hull `k`', _flat_words[overlays.hull[_numbers_of[one['points']]]], _flat_words[_numbers_of[one['hull']]]]
        k = k + 1
    assert[_told[t, 'Radix tooltip grace'], _wrongs[t]]
    t.held eq 44

test a_toast_swipe_goes_past_its_threshold_as_radixs_does[]
    j = _reference[]
    t = _tally[]
    for one in j['swipes']
        dx = 0.0 + one[0]
        dy = 0.0 + one[1]
        way = str[one[2]]
        threshold = 0.0 + one[3]
        t = _same[t, '`dx`, `dy` `way` past `threshold`', overlays.swiped_past[dx, dy, way, threshold], 0 + one[4] eq 1]
    assert[_told[t, 'Radix swipes'], _wrongs[t]]
    t.held eq 96

--- the reference's tree, its twigs set aside as `off` says
fn _twig[id, kids, off]
    if len[kids] eq 0
        return disclosure.leaf[id, id, off = id in off]
    disclosure.branch[id, id, kids, off = id in off]

fn _vuetify_tree[off]
    a = _twig['a', [_twig['a1', [], off], _twig['a2', [], off]], off]
    b2 = _twig['b2', [_twig['b2x', [], off], _twig['b2y', [], off]], off]
    b = _twig['b', [_twig['b1', [], off], b2, _twig['b3', [], off]], off]
    c = _twig['c', [_twig['c1', [], off]], off]
    [_twig['root', [a, b, c], off], _twig['d', [], off]]

fn _place[lines, id]
    i = 0
    while i lt len[lines]
        if lines[i].id eq id
            return i
        i = i + 1
    -1

test ticks_follow_vuetifys_classic_choosing[]
    j = _reference[]
    order = _texts_of[j['vuetify']['order']]
    t = _tally[]
    r = 0
    for run in j['vuetify']['runs']
        off = _texts_of[run['off']]
        lines = disclosure.flat[_vuetify_tree[off]]
        len[lines] eq len[order]
        ticks = map['' = 'off']
        for step in run['steps']
            id = str[step['id']]
            on = 0 + step['value'] eq 1
            ticks = disclosure.ticked_after[lines, ticks, _place[lines, id], on]
            theirs = _texts_of[step['ticks']]
            k = 0
            while k lt len[order]
                ours = 'off'
                if order[k] in ticks
                    ours = ticks[order[k]]
                t = _same[t, 'run `r`, after `id`: `order[k]`', ours, theirs[k]]
                k = k + 1
            ticked = slice[[''], 0, 0]
            for l in lines
                if l.under eq 0 and (l.id in ticks)
                    if ticks[l.id] eq 'on'
                        ticked = push[ticked, l.id]
            t = _same[t, 'run `r`, after `id`: out', join[sort[ticked], ' '], join[_texts_of[step['out']], ' ']]
        r = r + 1
    assert[_told[t, 'Vuetify classic'], _wrongs[t]]
    t.held eq 266
