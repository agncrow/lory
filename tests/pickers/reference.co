--- Lory's calendar held to date-fns: reference.json is what date-fns 4.1.0
--- (the date library react-datepicker 9.1.0 stands on) answered in 9,732
--- cases, written by reference.mjs, and `lory.calendar` must answer the
--- same, number for number and word for word: the days a month's calendar
--- shows from each first day of the week, weeks of the year by ISO's rule
--- and by a locale's, months and years added, where weeks and quarters
--- begin and end, the days between two days and the days from one to
--- another, dates written by a pattern in five locales and read back, and
--- what an instant reads as in ten zones with where their days begin. Run
--- from the repository's root: `crow test tests/pickers/reference.co`.
use lory.calendar

fn _reference[]
    json[read['tests/pickers/reference.json']]

--- a whole number the reference holds, read as one
fn _int[v]
    n = int[v]
    if not n.ok
        return -1000000
    n

--- a day or a moment the reference writes (`2024-03-05`,
--- `2024-03-05T14:07:09`, `2024-03-10T05:00:00.000Z`), read in UTC
fn _at[words]
    t = moment[words]
    if not t.ok
        return moment[0]
    t

fn _day_words[t]
    calendar.format[t, 'yyyy-MM-dd', calendar.locale['en-US']]

fn _stamp[t]
    calendar.format[t, 'yyyy-MM-dd\'T\'HH:mm:ss', calendar.locale['en-US']]

--- the locale of that name among those made already
fn _pick[code, locs]
    i = 0
    while i lt len[locs]
        if locs[i].name eq code
            return locs[i]
        i = i + 1
    locs[0]

fn grid_differences[cases]
    out = []
    for k in cases
        days = calendar.month_days[_int[k.year], _int[k.month], _int[k.starts], false]
        n = len[days]
        if n ne _int[k.days] or days[0] ne _at['`k.first`'] or days[n - 1] ne _at['`k.last`']
            out = push[out, '`k.year`-`k.month` from day `k.starts`: date-fns `k.first` to `k.last` (`k.days`); Lory `_day_words[days[0]]` to `_day_words[days[n - 1]]` (`n`)']
    out

fn iso_week_differences[cases]
    out = []
    for k in cases
        t = _at['`k.date`']
        if calendar.iso_week[t] ne _int[k.week] or calendar.iso_week_year[t] ne _int[k.year]
            out = push[out, '`k.date`: date-fns week `k.week` of `k.year`; Lory `calendar.iso_week[t]` of `calendar.iso_week_year[t]`']
    out

fn week_differences[cases]
    out = []
    for k in cases
        t = _at['`k.date`']
        from_day = _int[k.starts]
        holds = _int[k.contains]
        w = calendar.week[t, from_day, holds]
        y = calendar.week_year[t, from_day, holds]
        if w ne _int[k.week] or y ne _int[k.year]
            out = push[out, '`k.date` from day `from_day` holding `holds`: date-fns week `k.week` of `k.year`; Lory `w` of `y`']
    out

fn month_differences[cases, years]
    out = []
    for k in cases
        t = _at['`k.date`']
        n = _int[k.n]
        got = calendar.add_months[t, n]
        if years
            got = calendar.add_years[t, n]
        if got ne _at['`k.result`']
            out = push[out, '`k.date` and `n` (years `years`): date-fns `k.result`; Lory `_day_words[got]`']
    out

fn week_end_differences[cases]
    out = []
    for k in cases
        t = _at['`k.date`']
        from_day = _int[k.starts]
        a = calendar.start_of_week[t, from_day]
        b = calendar.end_of_week[t, from_day]
        if a ne _at['`k.start`'] or b ne _at['`k.end`']
            out = push[out, '`k.date` from day `from_day`: date-fns `k.start` to `k.end`; Lory `_day_words[a]` to `_day_words[b]`']
    out

fn quarter_differences[cases]
    out = []
    for k in cases
        t = _at['`k.date`']
        q = calendar.quarter[t]
        a = calendar.start_of_quarter[t]
        b = calendar.end_of_quarter[t]
        if q ne _int[k.quarter] or a ne _at['`k.start`'] or b ne _at['`k.end`']
            out = push[out, '`k.date`: date-fns quarter `k.quarter` `k.start` to `k.end`; Lory `q` `_day_words[a]` to `_day_words[b]`']
    out

fn difference_differences[cases]
    out = []
    for k in cases
        n = calendar.days_between[_at['`k.later`'], _at['`k.earlier`']]
        if n ne _int[k.days]
            out = push[out, '`k.later` after `k.earlier`: date-fns `k.days` days; Lory `n`']
    out

fn interval_differences[cases]
    out = []
    for k in cases
        days = calendar.each_day[_at['`k.start`'], _at['`k.end`']]
        theirs = for w in k.days
            '`w`'
        ours = for t in days
            _day_words[t]
        if len[days] ne _int[k.count] or (len[theirs] gt 0 and join[theirs, ' '] ne join[ours, ' '])
            out = push[out, '`k.start` to `k.end`: date-fns `k.count` days; Lory `len[days]`']
    out

fn format_differences[cases]
    locs = for c in calendar.locales[]
        calendar.locale[c]
    out = []
    for k in cases
        loc = _pick['`k.locale`', locs]
        words = calendar.format[_at['`k.at`'], '`k.pattern`', loc]
        if words ne '`k.text`'
            out = push[out, '`k.at` by `k.pattern` in `k.locale`: date-fns `k.text`; Lory `words`']
    out

fn parse_differences[cases]
    locs = for c in calendar.locales[]
        calendar.locale[c]
    out = []
    for k in cases
        loc = _pick['`k.locale`', locs]
        got = calendar.parse['`k.text`', '`k.pattern`', loc, _at['`k.reference`'], 'UTC']
        if k.result.ok
            if not got.ok
                out = push[out, '\'`k.text`\' by `k.pattern` in `k.locale` from `k.reference`: date-fns `k.result`; Lory refused it: `got.reason`']
            else if got ne _at['`k.result`']
                out = push[out, '\'`k.text`\' by `k.pattern` in `k.locale` from `k.reference`: date-fns `k.result`; Lory `_stamp[got]`']
        else if got.ok
            out = push[out, '\'`k.text`\' by `k.pattern` in `k.locale` from `k.reference`: date-fns refused it; Lory `_stamp[got]`']
    out

fn locale_differences[cases]
    out = []
    for k in cases
        loc = calendar.locale['`k.code`']
        if loc.name ne '`k.code`' or loc.week_start ne _int[k.starts] or loc.first_holds ne _int[k.contains]
            out = push[out, '`k.code`: date-fns weeks from day `k.starts` holding `k.contains`; Lory `loc.name` from `loc.week_start` holding `loc.first_holds`']
    out

fn zone_differences[cases]
    en = calendar.locale['en-US']
    out = []
    for k in cases
        zone = '`k.zone`'
        i = 0
        while i lt len[k.instants]
            shown = calendar.format[calendar.in_zone[_at['`k.instants[i]`'], zone], 'yyyy-MM-dd\'T\'HH:mm:ss xxx', en]
            if shown ne '`k.shown[i]`'
                out = push[out, '`k.instants[i]` in `zone`: date-fns `k.shown[i]`; Lory `shown`']
            i = i + 1
        j = 0
        while j lt len[k.days]
            d = _at['`k.days[j]`']
            begins = calendar.day_start[d, zone]
            hours = calendar.hours_in_day[d, zone]
            if begins ne _at['`k.midnights[j].at`'] or hours ne _int[k.midnights[j].hours]
                out = push[out, '`k.days[j]` in `zone`: date-fns begins `k.midnights[j].at` with `k.midnights[j].hours` hours; Lory `begins` with `hours`']
            j = j + 1
    out

--- the first few differences, as text, so a failing truth shows them
fn _first[wrong]
    '`slice[wrong, 0, min[4, len[wrong]]]`'

test the_reference_names_date_fns_and_its_version[]
    j = _reference[]
    '`j.library`' eq 'date-fns'
    '`j.version`' eq '4.1.0'

test month_grids_hold_the_days_date_fns_shows_from_each_first_weekday[]
    j = _reference[]
    len[j.grids] eq 924
    wrong = grid_differences[j.grids]
    _first[wrong] eq '[]'
    len[wrong] eq 0

test weeks_of_the_year_are_numbered_as_date_fns_numbers_them[]
    j = _reference[]
    len[j.iso_weeks] eq 272
    len[j.weeks] eq 2352
    len[j.locales] eq 5
    iso = iso_week_differences[j.iso_weeks]
    _first[iso] eq '[]'
    by_locale = week_differences[j.weeks]
    _first[by_locale] eq '[]'
    begins = locale_differences[j.locales]
    _first[begins] eq '[]'
    len[iso] + len[by_locale] + len[begins] eq 0

test months_and_years_added_keep_the_day_or_take_the_months_last[]
    j = _reference[]
    len[j.months] eq 357
    len[j.years] eq 88
    m = month_differences[j.months, false]
    _first[m] eq '[]'
    y = month_differences[j.years, true]
    _first[y] eq '[]'
    len[m] + len[y] eq 0

test weeks_and_quarters_begin_and_end_where_date_fns_says[]
    j = _reference[]
    len[j.week_ends] eq 203
    len[j.quarters] eq 75
    w = week_end_differences[j.week_ends]
    _first[w] eq '[]'
    q = quarter_differences[j.quarters]
    _first[q] eq '[]'
    len[w] + len[q] eq 0

test days_between_and_days_from_one_to_another_are_counted_alike[]
    j = _reference[]
    len[j.differences] eq 109
    len[j.intervals] eq 9
    d = difference_differences[j.differences]
    _first[d] eq '[]'
    e = interval_differences[j.intervals]
    _first[e] eq '[]'
    len[d] + len[e] eq 0

test dates_are_written_word_for_word_in_five_locales[]
    j = _reference[]
    len[j.formats] eq 4080
    wrong = format_differences[j.formats]
    _first[wrong] eq '[]'
    len[wrong] eq 0

test words_are_read_back_or_refused_as_date_fns_reads_them[]
    j = _reference[]
    len[j.parses] eq 1248
    wrong = parse_differences[j.parses]
    _first[wrong] eq '[]'
    len[wrong] eq 0

test instants_and_days_read_in_ten_zones_as_date_fns_reads_them[]
    j = _reference[]
    len[j.zones] eq 10
    wrong = zone_differences[j.zones]
    _first[wrong] eq '[]'
    len[wrong] eq 0
