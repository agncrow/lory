forget['map.tree']
forget['map.tree.layers']
held_map = map.keep[map.add_marker[map.at[map.of['tree'], 10.0, 10.0, 3.0], 'here', 10.0, 10.0, 'Here']]
tree = gui.column[[gui.drawn['tree', 0.0, 400.0, 300.0, map.painter]]]
first_shown = gui.show[_frame[0.0, nothing, nothing, nothing], tree]
inside_map = map.point_on[map.of['tree'], 10.0, 10.0]
pressed_shown = gui.show[_frame[16.0, _press[inside_map.x, inside_map.y - 20.0], nothing, nothing], tree]
events_told = slice[[''], 0, 0]
for ev in pressed_shown.events
    events_told = push[events_told, '`ev.id`:`ev.act`:`ev.words`:`ev.num`']
tree_map = map.of['tree']
listed_events = join[events_told, ' ']
log['in a tree: box `tree_map.box.x` `tree_map.box.y` `tree_map.box.w` `tree_map.box.h`, events `listed_events`, drawn `len[pressed_shown.canvas.verts]` `sum[pressed_shown.canvas.verts]`']
