--- The reactive-state examples (examples/reactive) driven through the
--- steps of tests/reactive/steps.json, each step's snapshot written out a
--- line, to diff the interpreter's run against the compiled program's
--- (tests/modes.sh): the two runs write the same lines only when every
--- part computes the same in both modes. Run from the repository's root:
---
---     bash tests/modes.sh crow tests/modes/reactive.co

use lory
use lory.gui
use examples.reactive.counter
use examples.reactive.store
use examples.reactive.styled
use examples.reactive.routing
use examples.reactive.context
use examples.reactive.todos
use examples.reactive.forms
use examples.reactive.animations
use examples.reactive.clock
use examples.reactive.sketch
use examples.reactive.scoreboard
use examples.reactive.resource
use examples.reactive.suspense

fn _steps[]
    json[read['tests/reactive/steps.json']]

--- ---- frames as the page hands them ----

--- a page 1000 by 900 at `t` ms, with the input, the pointers and what the
--- page answered (JSON lists)
fn _page[t, given, pointers, said]
    json['{"t": `t`, "width": 1000, "height": 900, "ratio": 1, "xr": false, "views": [{"eye": "none", "x": 0, "y": 0, "width": 1000, "height": 900, "projection": [], "camera": []}], "input": `given`, "pointers": `pointers`, "controllers": [], "said": `said`}']

fn _press[x, y]
    '{"type": "down", "device": "mouse", "id": 1, "x": `x`, "y": `y`, "button": 0}, {"type": "up", "device": "mouse", "id": 1, "x": `x`, "y": `y`, "button": 0}'

fn _moved_to[x, y]
    '{"type": "move", "device": "mouse", "id": 1, "x": `x`, "y": `y`, "button": 0}'

fn _key[name, code, ctrl]
    '{"type": "key", "key": "`name`", "code": "`code`", "ctrl": `ctrl`}'

fn _typed[words]
    '{"type": "text", "text": `encode[words]`}'

fn _standing[x, y]
    '[{"x": `x`, "y": `y`, "down": false}]'

--- a frame of a replay: its time and the step whose input it carries
--- (-1: none, a frame drawn as time goes on or as the reader looks)
struct Frame [t, step]

fn _no_frames[]
    slice[[Frame[0.0, 0]], 0, 0]

--- a parsed field of a step as text, and as a number
fn _word[j, key]
    v = j[key]
    '`v`'

fn _number[j, key]
    0.0 + j[key]

--- where nothing is drawn: a press there lets the focus go
fn _nowhere[]
    [999.0, 899.0]

--- the frames step `i` makes from `at`: a wait's on the 16 ms grid to its
--- end, a jump's one at its end, and for anything the reader does a frame
--- as they look (whose boxes are where they aim: what the last step
--- changed is drawn first) and the frame of what they do
fn _frames_of[st, i, at]
    act = _word[st, 'do']
    out = _no_frames[]
    if act eq 'wait'
        end = at + _number[st, 'ms']
        t = at
        while t lt end
            t = min[end, (floor[t / 16.0] + 1) * 16.0]
            out = push[out, Frame[t, -1]]
        if len[out] eq 0
            out = push[out, Frame[at, -1]]
        return out
    if act eq 'jump'
        return push[out, Frame[at + _number[st, 'ms'], -1]]
    if act eq 'blur' or act eq 'key' or act eq 'dark' or act eq 'reload'
        return push[out, Frame[at, i]]
    push[push[out, Frame[at, -1]], Frame[at, i]]

--- a frame's input and pointers (JSON lists), and the control the step
--- named that the example does not show ('' where none)
struct Input [given, pointers, missing]

fn _idle[]
    Input['[]', '[]', '']

--- the input of a step, its control found in the boxes of the frame the
--- reader looked at (its id the step's name after the example's prefix): a
--- press a mouse's down and up at its middle; typing a press at a field's
--- end and the text; setting (and picking, and going to an address) a
--- press, Ctrl+A and the text or a Backspace, an address then Enter;
--- clearing a press, Ctrl+A and Backspace; a blur a press where nothing
--- is; a key the key
fn _input_of[st, boxes, prefix]
    act = _word[st, 'do']
    far = _nowhere[]
    if act eq 'blur'
        pressed = _press[far[0], far[1]]
        return Input['[`pressed`]', _standing[far[0], far[1]], '']
    if act eq 'key'
        name = _word[st, 'key']
        typed_key = _key[name, name, false]
        return Input['[`typed_key`]', '[]', '']
    target = ''
    words = ''
    how = act
    if act eq 'press'
        target = _word[st, 'on']
    else if act eq 'pick'
        target = _word[st, 'on']
        words = _word[st, 'value']
        how = 'set'
    else if act eq 'go'
        target = 'address'
        words = _word[st, 'to']
    else
        target = _word[st, 'into']
        if 'text' in st
            words = _word[st, 'text']
    id = '`prefix``target`'
    if not (id in boxes)
        return Input['[]', '[]', target]
    b = boxes[id]
    x = b[0] + b[2] / 2.0
    y = b[1] + b[3] / 2.0
    if how ne 'press'
        --- (a field pressed past its words: the caret stands at their end)
        x = b[0] + b[2] - 4.0
    pressed = _press[x, y]
    at_it = _standing[x, y]
    if how eq 'press' or how eq 'focus'
        return Input['[`pressed`]', at_it, '']
    typed = _typed[words]
    if how eq 'type'
        return Input['[`pressed`, `typed`]', at_it, '']
    every = _key['a', 'KeyA', true]
    gone = _key['Backspace', 'Backspace', false]
    put = gone
    if words ne '' and how ne 'clear'
        put = typed
    if how eq 'go'
        enter = _key['Enter', 'Enter', false]
        return Input['[`pressed`, `every`, `put`, `enter`]', at_it, '']
    Input['[`pressed`, `every`, `put`]', at_it, '']

--- a step's snapshot, with the control it named that the example did not
--- show marked
fn _marked[seen, missing]
    if missing eq ''
        return seen
    '{"missing": `encode[missing]`, `slice[seen, 1, len[seen]]`'

--- ---- the examples replayed ----

fn _counter_seen[steps]
    gui.unfocus[]
    s = counter.fresh[0.0]
    at = 0.0
    boxes = map['' = [0.0]]
    out = slice[[''], 0, 0]
    i = 0
    while i lt len[steps]
        missing = ''
        for f in _frames_of[steps[i], i, at]
            at = f.t
            put = _idle[]
            if f.step gte 0
                put = _input_of[steps[f.step], boxes, 'counter.']
                missing = put.missing
            s = counter.before[s, at]
            c = lory.begin[_page[at, put.given, put.pointers, '[]']]
            shown = gui.show_at[c, counter.tree[s, at, false], 0.0, 0.0, 1000.0, gui.light[]]
            s = counter.after[s, shown, at]
            boxes = shown.boxes
        out = push[out, _marked[counter.seen[s, at], missing]]
        i = i + 1
    out

