--- ---- written out ----

ex = _steps[]
for line in _counter_seen[ex.counter.steps]
    log['counter `line`']
for line in _store_seen[ex.store.steps]
    log['store `line`']
for line in _styled_seen[ex.styled.steps]
    log['styled `line`']
for line in _routing_seen[ex.routing.steps]
    log['routing `line`']
for line in _context_seen[ex.context.steps]
    log['context `line`']
for line in _todos_seen[ex.todos.steps]
    log['todos `line`']
for line in _todos_seen[ex.todos.edges]
    log['todos edges `line`']
for line in _forms_seen[ex.forms.steps]
    log['forms `line`']
for line in _animations_seen[ex.animations.steps, int[ex.animations.seed]]
    log['animations `line`']
for line in _clock_seen[ex.clock.steps, _clock_base[]]
    log['clock `line`']
for line in _sketch_seen[ex.sketch.steps, int[ex.sketch.seed]]
    log['sketch `line`']
for line in _scoreboard_seen[ex.scoreboard.steps]
    log['scoreboard `line`']
for line in _resource_seen[ex.resource.steps]
    log['resource `line`']
for line in _suspense_seen[ex.suspense.steps, int[ex.suspense.seed]]
    log['suspense `line`']
