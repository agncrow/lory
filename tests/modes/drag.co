--- Everything lory.drag computes, written out, to diff the interpreter's
--- run against the compiled program's: items dragged within a list and
--- across to another (what was told, frame by frame, the lists' orders at
--- the end and the dragged picture's box half way), a spring and a throw's
--- glide sampled through lory.drag's release, the elastic pull, and a free
--- control thrown, a card swiped and a pinch, frame by frame. Every number
--- is written with 17 decimals, so the two runs write the same line only
--- when every bit is the same. Run from the repository's root:
---
---     tests/modes.sh crow tests/modes/drag.co

use memory
use lory
use lory.gui
use lory.drag
use lory.motion

fn _spaced[xs]
    join[xs, ' ']

fn _digits[x]
    fmt[x, decimals = 17]

fn _box_words[b]
    '`_digits[0.0 + b[0]]` `_digits[0.0 + b[1]]` `_digits[0.0 + b[2]]` `_digits[0.0 + b[3]]`'

--- a frame of the scenario at `t` ms, with its events
fn _frame[t, given]
    lory.begin[json['{"t": `t`, "width": 900, "height": 700, "ratio": 1, "xr": false, "views": [{"eye": "none", "x": 0, "y": 0, "width": 900, "height": 700, "projection": [], "camera": []}], "input": `given`, "pointers": [], "controllers": [], "said": []}']]

fn _pointer[on, x, y]
    '{"type": "`on`", "device": "mouse", "id": 1, "x": `x`, "y": `y`, "button": 0}'

fn _mouse[on, x, y]
    p = _pointer[on, x, y]
    '[`p`]'

--- two lists of one group, `a` and `b`, holding the items `lists` names
fn _two_lists[lists]
    out = slice[[gui.space[0.0]], 0, 0]
    for id in ['a', 'b']
        kids = slice[[gui.space[0.0]], 0, 0]
        for it in lists[id]
            kids = push[kids, gui.item[it, [gui.space[28.0]]]]
        n = drag.grouped[drag.list[id, kids, gap = 0.0], 'shared']
        n = drag.animated[n, 150.0]
        out = push[out, gui.sized[n, 200.0]]
    gui.row[out, gap = 20.0]

--- an item pressed, moved in eight steps to `dy` below the middle of the
--- item `onto` and let go, then the frames after: what was told at each
--- frame, the picture dragged half way, and the orders at the end
fn _dragged[name, item, onto, dy]
    drag.forget[]
    gui.unfocus[]
    lists = map['a' = ['a1', 'a2', 'a3', 'a4'], 'b' = ['b1', 'b2']]
    first = drag.show[_frame[0, '[]'], _two_lists[lists]]
    b = first.boxes[item]
    x = 0.0 + b[0] + b[2] / 2.0
    y = 0.0 + b[1] + b[3] / 2.0
    o = first.boxes[onto]
    tx = 0.0 + o[0] + o[2] / 2.0
    ty = 0.0 + o[1] + o[3] / 2.0 + dy
    steps = [_mouse['down', x, y]]
    k = 1
    while k lte 8
        steps = push[steps, _mouse['move', x + (tx - x) * k / 8.0, y + (ty - y) * k / 8.0]]
        k = k + 1
    steps = push[steps, _mouse['up', tx, ty]]
    k = 0
    while k lt 12
        steps = push[steps, '[]']
        k = k + 1
    half = 5
    i = 0
    while i lt len[steps]
        shown = drag.show[_frame[16 * (i + 1), steps[i]], _two_lists[lists]]
        words = []
        for told in shown.told
            words = push[words, '`told.act`:`told.list`:`told.item`:`told.old_index`:`told.new_index`']
            lists = drag.after[lists, told]
        if len[words] gt 0
            log['`name` `i` `_spaced[words]`']
        if i eq half and 'drag:image' in shown.boxes
            log['`name` picture `_box_words[shown.boxes[\'drag:image\']]`']
        i = i + 1
    for id in ['a', 'b']
        log['`name` order `id` `_spaced[lists[id]]`']
    true

--- every eighth of a curve's samples, and the last, on one line
fn _curve_line[name, words]
    kept = []
    j = 0
    while j lt len[words]
        if j % 8 eq 0 or j eq len[words] - 1
            kept = push[kept, words[j]]
        j = j + 1
    log['curve `name` `_spaced[kept]`']
    true

--- a spring and two glides sampled every 16 ms for two seconds
fn _curves[]
    sp = motion.spring[180.0, 12.0, 1.0]
    words = []
    t = 0.0
    while t lte 2000.0
        words = push[words, _digits[motion.spring_sample[sp, 0.0, 100.0, 0.0, t].value]]
        t = t + 16.0
    _curve_line['spring', words]
    for given in [[0.0, 800.0], [50.0, -1200.0]]
        th = drag.released[given[0], given[1], low = -100.0, high = 300.0]
        gl = motion.glide[th]
        words = []
        t = 0.0
        while t lte 2000.0
            gl = motion.glided[th, gl, t]
            words = push[words, _digits[gl.value]]
            t = t + 16.0
        _curve_line['glide `_digits[given[1]]`', words]
    true

fn _thrown[]
    drag.free['ball', gui.sized[gui.panel[[gui.space[40.0]]], 80.0], left = -100.0, right = 300.0, top = -50.0, bottom = 50.0]

--- a control thrown: where it is each frame until it rests
fn _throw[]
    drag.forget[]
    first = drag.show[_frame[0, '[]'], _thrown[]]
    b = first.boxes['ball']
    x = 0.0 + b[0] + 20.0
    y = 0.0 + b[1] + 20.0
    drag.show[_frame[16, _mouse['down', x, y]], _thrown[]]
    drag.show[_frame[32, _mouse['move', x + 15.0, y + 4.0]], _thrown[]]
    drag.show[_frame[48, _mouse['move', x + 45.0, y + 9.0]], _thrown[]]
    drag.show[_frame[64, _mouse['move', x + 80.0, y + 12.0]], _thrown[]]
    drag.show[_frame[80, _mouse['up', x + 80.0, y + 12.0]], _thrown[]]
    t = 96
    while t lt 2500
        shown = drag.show[_frame[t, '[]'], _thrown[]]
        p = drag.place_of['ball']
        if t % 160 eq 0
            log['throw `t` `_digits[p[0]]` `_digits[p[1]]`']
        for td in shown.told
            log['throw `t` told `td.act`']
        t = t + 16
    true

fn _deck[]
    kids = []
    for id in ['one', 'two', 'three']
        n = gui.sized[gui.panel[[gui.text[id], gui.space[120.0]]], 260.0]
        n.id = id
        kids = push[kids, n]
    drag.cards['deck', kids]

--- a card swiped: where it is each frame until it is gone
fn _swipe[]
    drag.forget[]
    first = drag.show[_frame[0, '[]'], _deck[]]
    b = first.boxes['deck']
    x = 0.0 + b[0] + 100.0
    y = 0.0 + b[1] + 60.0
    drag.show[_frame[16, _mouse['down', x, y]], _deck[]]
    drag.show[_frame[32, _mouse['move', x - 30.0, y]], _deck[]]
    drag.show[_frame[48, _mouse['move', x - 70.0, y]], _deck[]]
    drag.show[_frame[64, _mouse['up', x - 70.0, y]], _deck[]]
    t = 80
    while t lt 1500
        shown = drag.show[_frame[t, '[]'], _deck[]]
        if t % 80 eq 0
            at = drag.place_of['deck']
            log['swipe `t` `_digits[at[0]]`']
        for td in shown.told
            log['swipe `t` told `td.act` `td.to`']
        t = t + 16
    true

fn _photo[]
    gui.column[[drag.pinch['photo', gui.sized[gui.panel[[gui.space[200.0]]], 300.0], 232.0]]]

fn _touch[on, id, x, y]
    '{"type": "`on`", "device": "touch", "id": `id`, "x": `x`, "y": `y`, "button": 0}'

--- a pinch: the view at each step of two fingers spreading and turning
fn _pinch[]
    drag.forget[]
    first = drag.show[_frame[0, '[]'], _photo[]]
    b = first.boxes['photo']
    cx = 0.0 + b[0] + b[2] / 2.0
    cy = 0.0 + b[1] + b[3] / 2.0
    one = _touch['down', 1, cx - 30.0, cy + 10.0]
    two = _touch['down', 2, cx + 10.0, cy - 5.0]
    drag.show[_frame[16, '[`one`, `two`]'], _photo[]]
    i = 1
    while i lte 6
        a = 0.3 * i
        r = 20.0 + 9.0 * i
        m1 = _touch['move', 1, cx - 10.0 - r * cos[a], cy + 2.0 - r * sin[a]]
        m2 = _touch['move', 2, cx - 10.0 + r * cos[a], cy + 2.0 + r * sin[a]]
        drag.show[_frame[16 + 16 * i, '[`m1`, `m2`]'], _photo[]]
        v = drag.view_of['photo']
        log['pinch `i` `_digits[v[0]]` `_digits[v[1]]` `_digits[v[2]]` `_digits[v[3]]`']
        i = i + 1
    true

_dragged['within', 'a1', 'a3', 6.0]
_dragged['across', 'a2', 'b2', 10.0]
_curves[]
words = []
for x in [-250.0, -120.0, -100.0, -40.0, 0.0, 60.0, 100.0, 140.0, 400.0]
    words = push[words, _digits[drag.pulled[x, -100.0, 100.0, 0.35]]]
log['elastic `_spaced[words]`']
_throw[]
_swipe[]
_pinch[]
