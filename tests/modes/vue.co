--- The Vue examples as the parity tests drive them, everything each
--- shows at each step written out, with the Cells formulas and the
--- Markdown pages worked out on their own: to diff the interpreter's run
--- against the compiled program's. Run from the repository's root:
--- `tests/modes.sh crow tests/modes/vue.co`.
use lory
use lory.gui
use tests.vue.driver
use examples.vue.gallery
use examples.vue.editor
use examples.vue.formulas

fn _one_line[words]
    join[split[words, '\n'], '\\n']

fn _keys_of[seen]
    out = slice[[''], 0, 0]
    for k in keys[seen]
        out = push[out, '`k`']
    out

--- every field the example shows at every step of its script
fn _written[slug]
    steps = driver.reference[]['examples'][slug]
    last = driver.started[slug]
    i = 0
    while i lt len[steps]
        step = steps[i]
        what = step['do']
        act = '`what`'
        if act ne 'start'
            driver.performed[slug, step, last]
            last = driver.idle[0.0 + step['at']]
        seen = gallery.seen_now[last.canvas]
        for key in _keys_of[step['seen']]
            got = '(nothing)'
            if key in seen
                got = seen[key]
            log['`slug` `i` `key` `_one_line[got]`']
        i = i + 1
    slug

for slug in gallery.order[]
    _written[slug]

for m in driver.reference[]['markdown']
    a = m['source']
    source = '`a`'
    log['markdown `_one_line[source]` `editor.structure[source]`']

sheet = slice[[['']], 0, 0]
for c in range[formulas.columns[]]
    col = slice[[''], 0, 0]
    for r in range[formulas.rows[]]
        col = push[col, '']
    sheet = push[sheet, col]
first = sheet[0]
first[0] = '7'
first[1] = '=A0*A0'
first[2] = '=D2'
sheet[0] = first
for formula in ['=A0+A1', '=Math.sqrt(A1)/3', '=A0 ** 0.5', '=(A0 > 5) + "x"', '=~A0 | 0x0f', '=A2', '=Math.hypot(3, 4)', '=Math.cbrt(-27)', '=1e21', '=0.1+0.2', '=-0', '=foo(', '=A0 ?? 1', '=typeof Math', '=Math', '=isNaN("a")']
    log['cell `formula` `formulas.cell_shown[sheet, formula]`']
