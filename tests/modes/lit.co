--- What Lory's Lit examples (examples/lit) show, written out, to diff the
--- interpreter's run against the compiled program's: every example
--- opened and taken through the steps tests/lit/reference.json names,
--- with the words, fields, boxes and looks shown after each step, and
--- for motion the animations started and what each element showed. Run
--- from the repository's root: `tests/modes.sh crow tests/modes/lit.co`.
use lory
use lory.gui
use examples.lit.shared
use examples.lit.gallery
use examples.lit.transitions

fn _numbers[j]
    out = shared.no_numbers[]
    for x in j
        out = push[out, 0.0 + x]
    out

fn _words[j]
    out = shared.no_words[]
    for x in j
        out = push[out, '`x`']
    out

fn _digits[x]
    floor[x * 10000.0 + 0.5] / 10000.0

fn _truth[b]
    if b
        return 'on'
    'off'

--- the event of Lory's a step is, as tests/lit/reference.co tells one
fn _event_of[name, step, before]
    what = '`step[0]`'
    id = '`step[1]`'
    if what eq 'type' or what eq 'pick'
        return gui.Event[id, 'edit', '`step[2]`', 0.0]
    if what eq 'commit'
        value = ''
        if id in before.fields
            value = before.fields[id]
        return gui.Event[id, 'submit', value, 0.0]
    if what eq 'check'
        on = 1.0
        if id in before.checks and before.checks[id]
            on = 0.0
        return gui.Event[id, 'toggle', '', on]
    if gallery.moving[name] and name ne 'motion-circle' and name ne 'motion-todos'
        return gui.Event['stage', 'press', id, 0.0]
    gui.Event[id, 'press', '', 0.0]

fn _served[s, t, npm]
    asking = gallery.request_of[s, t]
    if asking[0] eq ''
        return s
    s = gallery.asked[s]
    name = slice[asking[1], len['https://registry.npmjs.org/'], len[asking[1]]]
    if name in npm
        return gallery.heard[s, asking[0], 200, encode[npm[name]]]
    gallery.heard[s, asking[0], 404, 'Not found']

fn _facts_written[label, f]
    log['`label` words `join[f.words, \' \']`']
    for id in sort[keys[f.fields]]
        if id ne ''
            log['`label` field `id` `f.fields[id]`']
    for id in sort[keys[f.checks]]
        if id ne ''
            log['`label` box `id` `_truth[f.checks[id]]`']
    log['`label` off `join[f.off, \' \']`']
    for id in sort[keys[f.looks]]
        if id ne ''
            log['`label` look `id` `f.looks[id]`']

reference = json[read['tests/lit/reference.json']]
for name in gallery.names[]
    j = reference.examples[name]
    s = gallery.opened[name, _numbers[j.draws], '2026-11-14', 43200.0]
    if name eq 'motion-list'
        s = shared.set_list[s, 'orders', _words[j.orders]]
    t = 0.0
    i = 0
    for step in j.steps
        what = '`step.do[0]`'
        before = gallery.facts[s, t]
        if what eq 'wait'
            t = 0.0 + step.at
        else if what ne 'open'
            if not (what eq 'press' and '`step.do[1]`' in before.off)
                s = gallery.answered[s, _event_of[name, step.do, before], t]
        s = _served[s, t, reference.npm]
        label = '`name` `i` `what` `t`'
        _facts_written[label, gallery.facts[s, t]]
        if gallery.moving[name]
            for seen in transitions.seen_all[s, t]
                log['`label` seen `seen.id` `_digits[seen.opacity]` `_digits[seen.left]` `_truth[seen.moving]`']
        i = i + 1
    if gallery.moving[name]
        for one in transitions.started_of[gallery.ticked[s, t]]
            log['`name` started `one`']

--- every example drawn beside the menu: where its first box lies
for name in gallery.names[]
    s = gallery.opened[name, shared.no_numbers[], '2026-11-14', 43200.0]
    shown = gallery.shown_on[shared.blank_canvas[], s, 0.0]
    b = shown.boxes['menu-`name`']
    log['`name` drawn `len[keys[shown.boxes]]` boxes, its entry at `_digits[b[0]]` `_digits[b[1]]` `_digits[b[2]]` `_digits[b[3]]`']
