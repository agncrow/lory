--- Lory's layers held to Floating UI's placing: placement.json is where
--- @floating-ui/core 1.7.5 put a layer against its control in 1,200 cases
--- (placement.mjs ran it, set up as Radix sets it up: offset, shift with
--- its limit, flip), and `gui.anchored` must put it at the same point, on
--- the same side and alignment. Run from the repository's root:
--- `crow test tests/gui/placement.co`.
use lory.gui

--- the cases where Lory's place differs from Floating UI's, as text
fn differences[cases]
    out = []
    for k in cases
        a = k.anchor
        got = gui.anchored[0.0 + a[0], 0.0 + a[1], 0.0 + a[2], 0.0 + a[3], 0.0 + k.size[0], 0.0 + k.size[1], '`k.side`', '`k.align`', 0.0 + k.gap, 900.0, 700.0, 0.0 + k.margin]
        if got.x ne 0.0 + k.x or got.y ne 0.0 + k.y or got.side ne '`k.placed_side`' or got.align ne '`k.placed_align`'
            out = push[out, '`k.side` `k.align` at `a` sized `k.size`: Floating UI `k.x`, `k.y` `k.placed_side` `k.placed_align`; Lory `got.x`, `got.y` `got.side` `got.align`']
    out

test every_layer_stands_where_floating_ui_puts_it[]
    j = json[read['tests/gui/placement.json']]
    len[j.cases] eq 1200
    wrong = differences[j.cases]
    '`slice[wrong, 0, min[4, len[wrong]]]`' eq '[]'
    len[wrong] eq 0
