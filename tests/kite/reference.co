--- Kite's indicators held to klinecharts' own answers: reference.json is
--- what klinecharts computed over 300 bars (reference.py ran it), and each
--- of Kite's values must be the same float, or none where klinecharts had
--- none. Run from the repository's root: `crow test tests/kite/reference.co`.
use kite.indicators

fn _floats[j]
    out = for x in j
        0.0 + x
    out

fn _bars[j]
    t = []
    o = []
    h = []
    l = []
    c = []
    v = []
    turn = []
    for b in j
        t = push[t, 0.0 + b.timestamp]
        o = push[o, 0.0 + b.open]
        h = push[h, 0.0 + b.high]
        l = push[l, 0.0 + b.low]
        c = push[c, 0.0 + b.close]
        v = push[v, 0.0 + b.volume]
        turn = push[turn, 0.0 + b.turnover]
    indicators.Bars[t, o, h, l, c, v, turn]

--- the places where Kite's values differ from klinecharts', as text
fn differences[name, params, want, got]
    out = []
    for key in keys[want]
        if not (key in got)
            out = push[out, '`name` `params`: no values for `key`']
        else
            mine = got[key]
            theirs = want[key]
            for i in range[len[theirs]]
                if not theirs[i].ok
                    if not indicators.is_none[mine[i]]
                        out = push[out, '`name` `params` `key`[`i`]: klinecharts has none, Kite has `mine[i]`']
                else
                    e = 0.0 + theirs[i]
                    if mine[i] ne e
                        out = push[out, '`name` `params` `key`[`i`]: klinecharts has `e`, Kite has `mine[i]`']
    out

test every_indicator_is_klinecharts_to_the_last_bit[]
    j = json[read['tests/kite/reference.json']]
    b = _bars[j.bars]
    wrong = []
    for case in j.indicators
        name = '`case.name`'
        params = _floats[case.params]
        got = indicators.calc[name, params, b]
        want = map[]
        for key in keys[case.values]
            want[key] = case.values[key]
        found = differences[name, params, want, got]
        for f in found
            if len[wrong] lt 40
                wrong = push[wrong, f]
    assert[len[wrong] eq 0, join[wrong, '\n']]
