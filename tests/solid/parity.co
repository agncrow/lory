fn _clock_seen[steps, base]
    s = clock.based[clock.fresh[0.0], base]
    at = 0.0
    out = slice[[''], 0, 0]
    i = 0
    while i lt len[steps]
        for f in _frames_of[steps[i], i, at]
            at = f.t
            s = clock.before[s, at]
            c = lory.begin[_page[at, '[]', '[]', '[]']]
            shown = gui.show_at[c, clock.tree[s, at, false], 0.0, 0.0, 1000.0, gui.light[]]
            s = clock.after[s, shown, at]
        out = push[out, clock.seen[s, at]]
        i = i + 1
    out

--- the milliseconds from midnight to the reference's fake epoch (15:00:30
--- on its page's clock)
fn _clock_base[]
    (15.0 * 3600.0 + 30.0) * 1000.0

fn _sketch_seen[steps, seed]
    gui.unfocus[]
    s = sketch.seeded[sketch.fresh[0.0], seed]
    dark = false
    at = 0.0
    boxes = map['' = [0.0]]
    out = slice[[''], 0, 0]
    i = 0
    while i lt len[steps]
        missing = ''
        for f in _frames_of[steps[i], i, at]
            at = f.t
            put = _idle[]
            if f.step gte 0
                st = steps[f.step]
                act = _word[st, 'do']
                if act eq 'dark'
                    dark = _word[st, 'on'] eq 'true'
                else if act eq 'hover'
                    put = _hovered[s, st, boxes]
                else
                    put = _input_of[st, boxes, 'sketch.']
                missing = put.missing
            s = sketch.themed[sketch.before[s, at], dark]
            c = lory.begin[_page[at, put.given, put.pointers, '[]']]
            shown = gui.show_at[c, sketch.tree[s, at, dark], 0.0, 0.0, 1000.0, gui.light[]]
            s = sketch.after[s, shown, at]
            boxes = shown.boxes
        out = push[out, _marked[sketch.seen[s, at], missing]]
        i = i + 1
    out

--- a hover over a cell of the grid: the pointer moved to the cell's
--- middle, and away to where nothing is
fn _hovered[s, st, boxes]
    if not ('sketch.grid' in boxes)
        return Input['[]', '[]', 'grid']
    b = boxes['sketch.grid']
    p = sketch.spot[s, int[st.index]]
    far = _nowhere[]
    into = _moved_to[b[0] + p[0], b[1] + p[1]]
    away = _moved_to[far[0], far[1]]
    Input['[`into`, `away`]', _standing[far[0], far[1]], '']

--- the hyperscript todos held as far as its page follows its store: the
--- published example stops showing what its store holds at its first
--- change (Solid 1.9's `h` reads its value and its list once), so each
--- step is held until the first whose page parts from its store, that
--- one by its store alone
fn _held_while_shown[name, seen, solid, skip]
    out = slice[[''], 0, 0]
    if len[seen] ne len[solid]
        return push[out, '`name`: `len[seen]` snapshots where Solid has `len[solid]`']
    i = 0
    while i lt len[seen]
        b = solid[i]
        a = json[seen[i]]
        page = encode[b.rows]
        kept = encode[b.saved]
        if '`b.new`' ne '`b.stored_new`' or page ne kept
            d = _parted[a.saved, b.saved, 0.001, skip, '`name` step `i`.saved']
            if d ne ''
                out = push[out, d]
            return out
        d = _parted[a, b, 0.001, skip, '`name` step `i`']
        if d ne ''
            out = push[out, d]
        i = i + 1
    out

--- the hyperscript todos' steps held by `_held_while_shown`
fn _shown_steps[solid]
    i = 0
    while i lt len[solid]
        b = solid[i]
        page = encode[b.rows]
        kept = encode[b.saved]
        if '`b.new`' ne '`b.stored_new`' or page ne kept
            return i + 1
        i = i + 1
    len[solid]

fn _scoreboard_seen[steps]
    gui.unfocus[]
    s = scoreboard.fresh[0.0]
    at = 0.0
    boxes = map['' = [0.0]]
    out = slice[[''], 0, 0]
    i = 0
    while i lt len[steps]
        missing = ''
        for f in _frames_of[steps[i], i, at]
            at = f.t
            put = _idle[]
            if f.step gte 0
                put = _input_of[steps[f.step], boxes, 'scoreboard.']
                missing = put.missing
            s = scoreboard.before[s, at]
            c = lory.begin[_page[at, put.given, put.pointers, '[]']]
            shown = gui.show_at[c, scoreboard.tree[s, at, false], 0.0, 0.0, 1000.0, gui.light[]]
            s = scoreboard.after[s, shown, at]
            boxes = shown.boxes
        out = push[out, _marked[scoreboard.seen[s, at], missing]]
        i = i + 1
    out

--- an asking out to the made-up swapi.dev: its id, where it went and when
--- its answer comes (300 ms after, as the reference's fetch answers)
struct Out [id, url, due]

fn _no_outs[]
    slice[[Out['', '', 0.0]], 0, 0]

--- the canned answer to an asking, as the reference's fetch gives it: the
--- person its url names, or the answer for one it does not have
fn _canned_for[url]
    ref = _reference[].reference
    key = slice[url, len['https://swapi.dev/api/people/'], len[url] - 1]
    if key in ref.canned
        return '`ref.canned[key]`'
    '`ref.missing`'

fn _resource_seen[steps]
    gui.unfocus[]
    s = resource.fresh[0.0]
    at = 0.0
    boxes = map['' = [0.0]]
    outs = _no_outs[]
    out = slice[[''], 0, 0]
    i = 0
    while i lt len[steps]
        missing = ''
        for f in _frames_of[steps[i], i, at]
            at = f.t
            put = _idle[]
            if f.step gte 0
                put = _input_of[steps[f.step], boxes, 'resource.']
                missing = put.missing
            came = for o in outs
                if o.due lte at
                    '{"what": "answer", "id": `encode[o.id]`, "status": 200, "body": `encode[_canned_for[o.url]]`}'
            outs = for o in outs
                if o.due gt at
                    o
            s = resource.before[s, at]
            told = join[came, ', ']
            c = lory.begin[_page[at, put.given, put.pointers, '[`told`]']]
            s = resource.heard[s, lory.said[c]]
            shown = gui.show_at[c, resource.tree[s, at, false], 0.0, 0.0, 1000.0, gui.light[]]
            s = resource.after[s, shown, at]
            for a in s.asks
                outs = push[outs, Out[a.id, a.url, at + 300.0]]
            boxes = shown.boxes
        out = push[out, _marked[resource.seen[s, at], missing]]
        i = i + 1
    out


fn _suspense_seen[steps, seed]
    gui.unfocus[]
    s = suspense.seeded[suspense.fresh[0.0], seed]
    at = 0.0
    boxes = map['' = [0.0]]
    out = slice[[''], 0, 0]
    i = 0
    while i lt len[steps]
        missing = ''
        for f in _frames_of[steps[i], i, at]
            at = f.t
            put = _idle[]
            if f.step gte 0
                put = _input_of[steps[f.step], boxes, 'suspense.']
                missing = put.missing
            s = suspense.before[s, at]
            c = lory.begin[_page[at, put.given, put.pointers, '[]']]
            shown = gui.show_at[c, suspense.tree[s, at, false], 0.0, 0.0, 1000.0, gui.light[]]
            s = suspense.after[s, shown, at]
            boxes = shown.boxes
        out = push[out, _marked[suspense.seen[s, at], missing]]
        i = i + 1
    out

