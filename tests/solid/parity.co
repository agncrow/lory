test a_snapshot_that_parts_from_solids_is_told[]
    solid = json['[{"t": 0, "text": "a", "n": 1.0, "k": null, "l": [1, 2]}]']
    len[_held['x', ['{"t": 0, "text": "a", "n": 1.0, "k": null, "l": [1, 2]}'], solid, _no_skip[], 0]] eq 0
    len[_held['x', ['{"t": 0, "text": "b", "n": 1.0, "k": null, "l": [1, 2]}'], solid, _no_skip[], 0]] eq 1
    len[_held['x', ['{"t": 0, "text": "a", "n": 1.0005, "k": null, "l": [1, 2]}'], solid, _no_skip[], 0]] eq 0
    len[_held['x', ['{"t": 0, "text": "a", "n": 1.01, "k": null, "l": [1, 2]}'], solid, _no_skip[], 0]] eq 1
    len[_held['x', ['{"t": 0, "text": "a", "n": 1.0, "k": 2, "l": [1, 2]}'], solid, _no_skip[], 0]] eq 1
    len[_held['x', ['{"t": 0, "text": "a", "n": 1.0, "k": null, "l": [1]}'], solid, _no_skip[], 0]] eq 1
    len[_held['x', ['{"t": 0, "text": "a", "n": 1.0, "l": [1, 2]}'], solid, _no_skip[], 0]] eq 1

