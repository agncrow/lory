fn _todos_seen[steps]
    gui.unfocus[]
    todos.cleared[]
    s = todos.fresh[0.0]
    at = 0.0
    boxes = map['' = [0.0]]
    out = slice[[''], 0, 0]
    i = 0
    while i lt len[steps]
        missing = ''
        for f in _frames_of[steps[i], i, at]
            at = f.t
            put = _idle[]
            if f.step gte 0 and _word[steps[f.step], 'do'] eq 'reload'
                --- (the example opened again: what it holds is read from what
                --- it kept, and the reader is in no field)
                gui.unfocus[]
                s = todos.fresh[at]
            else if f.step gte 0
                put = _input_of[steps[f.step], boxes, 'todos.']
                missing = put.missing
            s = todos.before[s, at]
            c = lory.begin[_page[at, put.given, put.pointers, '[]']]
            shown = gui.show_at[c, todos.tree[s, at, false], 0.0, 0.0, 1000.0, gui.light[]]
            s = todos.after[s, shown, at]
            boxes = shown.boxes
        out = push[out, _marked[todos.seen[s, at], missing]]
        i = i + 1
    out

fn _forms_seen[steps]
    gui.unfocus[]
    s = forms.fresh[0.0]
    at = 0.0
    boxes = map['' = [0.0]]
    out = slice[[''], 0, 0]
    i = 0
    while i lt len[steps]
        missing = ''
        for f in _frames_of[steps[i], i, at]
            at = f.t
            put = _idle[]
