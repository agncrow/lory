    gui.unfocus[]
    s = store.fresh[0.0]
    at = 0.0
    boxes = map['' = [0.0]]
    out = slice[[''], 0, 0]
    i = 0
    while i lt len[steps]
        missing = ''
        for f in _frames_of[steps[i], i, at]
            at = f.t
            put = _idle[]
            if f.step gte 0
                put = _input_of[steps[f.step], boxes, 'store.']
                missing = put.missing
            s = store.before[s, at]
            c = lory.begin[_page[at, put.given, put.pointers, '[]']]
            shown = gui.show_at[c, store.tree[s, at, false], 0.0, 0.0, 1000.0, gui.light[]]
            s = store.after[s, shown, at]
            boxes = shown.boxes
        out = push[out, _marked[store.seen[s, at], missing]]
        i = i + 1
    out

