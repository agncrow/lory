fn _animations_seen[steps, seed]
    gui.unfocus[]
    s = animations.seeded[animations.fresh[0.0], seed]
    at = 0.0
    boxes = map['' = [0.0]]
    out = slice[[''], 0, 0]
    i = 0
    while i lt len[steps]
        missing = ''
        for f in _frames_of[steps[i], i, at]
            at = f.t
            put = _idle[]
            if f.step gte 0
                put = _input_of[steps[f.step], boxes, 'animations.']
