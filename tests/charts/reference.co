--- Kite's charts held to Chart.js's own answers: reference.json is what
--- Chart.js 4.5.1 laid in headless Chrome for 46 charts (reference.py ran
--- it), and each of Kite's numbers must be Chart.js's to a millionth of a
--- pixel (of a degree, of a unit of value): every chart's area and boxes,
--- every axis's range, ticks, labels and tick pixels, every element's
--- geometry, which elements every tooltip mode picks at the pointer
--- positions it was asked about, the tooltips themselves, the legend's
--- items and what a click on one hides; and the easings, colours and
--- animations, and the decimated lines. Text is measured with the widths
--- the browser measured (reference.json's `widths`), so that the layout,
--- not the font, is what is held. Run from the repository's root:
--- `crow test tests/charts/reference.co`.
use math
use lory
use kite.charts_model
use kite.charts_scales
use kite.charts_fit
use kite.charts_layout
use kite.charts_json
use kite.charts_marks
use kite.charts_hits
use kite.charts_motion
use kite.charts_decimation

--- what a comparison found: how many numbers were held, and what differed
struct Held [count, wrong]

fn _reference[]
    json[read['tests/charts/reference.json']]

--- a pen measuring words as the browser did
fn _pen[j]
    widths = map['' = 0.0]
    w = j.widths
    for key in keys[w]
        widths[key] = _in[w, key]
    charts_model.Pen[charts_model.plain_pen[].held, widths]

fn _close[a, b]
    if b ne b
        return a ne a
    abs[a - b] lte 0.000001 * max[1.0, abs[b]]

--- a number held: counted, and noted where it differs
fn _held[h0, what, mine, theirs]
    h = h0
    h.count = h.count + 1
    if not _close[mine, theirs] and len[h.wrong] lt 60
        h.wrong = push[h.wrong, '`what`: Chart.js `theirs`, Kite `mine`']
    h

fn _held_words[h0, what, mine, theirs]
    h = h0
    h.count = h.count + 1
    if mine ne theirs and len[h.wrong] lt 60
        h.wrong = push[h.wrong, '`what`: Chart.js \'`theirs`\', Kite \'`mine`\'']
    h

--- a number read from the reference, inside its list or object (a null
--- is nan; it is read inside, as an error handed on would be the answer)
fn _at[list, i]
    v = list[i]
    if not v.ok
        return nan
    if type[v] ne 'int' and type[v] ne 'float'
        return nan
    0.0 + v

fn _in[j, key]
    v = j[key]
    if not v.ok
        return nan
    if type[v] ne 'int' and type[v] ne 'float'
        return nan
    0.0 + v

fn _words_at[list, i]
    v = list[i]
    if not v.ok
        return ''
    '`v`'

fn _words_in[j, key]
    v = j[key]
    if not v.ok
        return ''
    '`v`'

--- the chart a case describes, its axes in the order Chart.js laid them
fn _chart_of[c]
    ch = _ordered_chart[c]
    if not ch.ok
        return charts_model.chart_of['none', 'bar', slice[[''], 0, 0]]
    ch

fn _ordered_chart[c]
    ch = charts_json.chart_from['`c.name`', c.config]
    order = slice[[charts_model.axis_of['x', 'linear', 'x', 'bottom']], 0, 0]
    boxes = c.laid.boxes
    i = 0
    while i lt len[boxes]
        id = '`boxes[i]`'
        k = charts_model.axis_at[ch, id]
        if k gte 0
            order = push[order, ch.axes[k]]
        i = i + 1
    i = 0
    while i lt len[ch.axes]
        if not _in_order[order, ch.axes[i].id]
            order = push[order, ch.axes[i]]
        i = i + 1
    ch.axes = order
    ch

fn _in_order[axes, id]
    i = 0
    while i lt len[axes]
        if axes[i].id eq id
            return true
        i = i + 1
    false

fn _laid[c, pen]
    ch = _chart_of[c]
    charts_layout.laid_out[ch, 0.0 + c.width, 0.0 + c.height, pen]

--- ---- the layout ----

fn _layout_held[h0, name, laid, recorded]
    h = h0
    area = recorded.area
    i = 0
    while i lt 4
        h = _held[h, '`name` area[`i`]', laid.area[i], _at[area, i]]
        i = i + 1
    k = 0
    while k lt len[recorded.scales]
        h = _scale_held[h, name, laid, recorded.scales[k]]
        k = k + 1
    h = _legend_held[h, name, laid, recorded.legend]
    h = _heading_held[h, name, laid, 1, recorded, 'subtitle']
    h = _heading_held[h, name, laid, 2, recorded, 'title']
    h

fn _scale_at[laid, id]
    i = 0
    while i lt len[laid.scales]
        if laid.scales[i].id eq id
            return i
        i = i + 1
    -1

fn _scale_held[h0, name, laid, want]
    h = h0
    id = '`want.id`'
    k = _scale_at[laid, id]
    if k lt 0
        h.wrong = push[h.wrong, '`name`: no axis `id`']
        return h
    sc = laid.scales[k]
    what = '`name` `id`'
    box = want.box
    mine = [sc.left, sc.top, sc.right, sc.bottom, sc.width, sc.height]
    i = 0
    while i lt 6
        h = _held[h, '`what` box[`i`]', mine[i], _at[box, i]]
        i = i + 1
    h = _held[h, '`what` min', sc.min, _in[want, 'min']]
    h = _held[h, '`what` max', sc.max, _in[want, 'max']]
    if sc.form ne 'radialLinear'
        h = _held[h, '`what` rotation', sc.rotation, _in[want, 'rotation']]
        pad = want.padding
        i = 0
        while i lt 4
            h = _held[h, '`what` padding[`i`]', sc.padding[i], _at[pad, i]]
            i = i + 1
    ticks = want.ticks
    if len[sc.ticks] ne len[ticks]
        h.wrong = push[h.wrong, '`what`: Chart.js has `len[ticks]` ticks, Kite `len[sc.ticks]` (`join[sc.texts, \' \']`)']
        return h
    i = 0
    while i lt len[ticks]
        t = ticks[i]
        h = _held[h, '`what` tick `i` value', sc.ticks[i], _at[t, 0]]
        h = _held_words[h, '`what` tick `i` label', sc.texts[i], _words_at[t, 1]]
        if sc.form eq 'radialLinear'
            a = charts_model.axis_of['r', 'radialLinear', 'r', 'chartArea']
            h = _held[h, '`what` tick `i` distance', charts_fit.distance_of[sc, a, sc.ticks[i]], _at[t, 2]]
        else
            h = _held[h, '`what` tick `i` pixel', charts_scales.tick_pixel[sc, i], _at[t, 2]]
        i = i + 1
    if sc.form eq 'radialLinear'
        h = _radial_held[h, what, sc, want]
    if sc.form eq 'time' or sc.form eq 'timeseries'
        h = _held_words[h, '`what` unit', sc.unit, _words_in[want, 'unit']]
        offsets = want.offsets
        h = _held[h, '`what` offset start', sc.offsets[0], _at[offsets, 0]]
        h = _held[h, '`what` offset end', sc.offsets[1], _at[offsets, 1]]
    h

fn _radial_held[h0, what, sc, want]
    h = h0
    centre = want.center
    h = _held[h, '`what` x centre', sc.x_center, _at[centre, 0]]
    h = _held[h, '`what` y centre', sc.y_center, _at[centre, 1]]
    h = _held[h, '`what` radius', sc.drawing_area, _at[centre, 2]]
    items = want.label_items
    if len[items] ne len[sc.label_items]
        if len[items] gt 0
            h.wrong = push[h.wrong, '`what`: Chart.js has `len[items]` point labels, Kite `len[sc.label_items]`']
        return h
    i = 0
    while i lt len[items]
        it = items[i]
        mine = sc.label_items[i]
        k = 0
        while k lt 6
            h = _held[h, '`what` point label `i`[`k`]', mine[k], _at[it, k]]
            k = k + 1
        h = _held_words[h, '`what` point label `i` align', sc.label_aligns[i], _words_at[it, 6]]
        i = i + 1
    h

fn _legend_held[h0, name, laid, want]
    h = h0
    p = laid.parts[0]
    box = want.box
    mine = [p.left, p.top, p.width, p.height]
    i = 0
    while i lt 4
        h = _held[h, '`name` legend box[`i`]', mine[i], _at[box, i]]
        i = i + 1
    hits = want.hits
    if len[hits] ne len[laid.legend.hits]
        h.wrong = push[h.wrong, '`name`: Chart.js has `len[hits]` legend items, Kite `len[laid.legend.hits]`']
        return h
    i = 0
    while i lt len[hits]
        hb = hits[i]
        k = 0
        while k lt 4
            h = _held[h, '`name` legend item `i`[`k`]', laid.legend.hits[i][k], _at[hb, k]]
            k = k + 1
        i = i + 1
    h

fn _heading_held[h0, name, laid, at, recorded, key]
    h = h0
    want = recorded[key]
    if not want.ok
        return h
    p = laid.parts[at]
    mine = [p.left, p.top, p.width, p.height]
    i = 0
    while i lt 4
        h = _held[h, '`name` `p.what` box[`i`]', mine[i], _at[want, i]]
        i = i + 1
    h

--- ---- the marks ----

--- every dataset's marks held to those Chart.js placed (a curve's control
--- points only where `curves`: Chart.js leaves a hidden line's as they
--- were when it was last drawn)
fn _marks_held[h0, name, ch, laid, recorded, curves]
    h = h0
    layers = charts_marks.marked[ch, laid, false]
    sets = recorded.sets
    d = 0
    while d lt len[sets]
        want = sets[d].elements
        got = layers[d].marks
        if len[want] ne len[got]
            h.wrong = push[h.wrong, '`name` set `d`: Chart.js has `len[want]` marks, Kite `len[got]`']
        else
            j = 0
            while j lt len[want]
                h = _mark_held[h, '`name` set `d` mark `j`', got[j], want[j], curves and not ch.sets[d].hidden]
                j = j + 1
        d = d + 1
    h

fn _mark_held[h0, what, m, want, curves]
    h = h0
    kind = _words_at[want, 0]
    h = _held_words[h, '`what` kind', m.what, kind]
    if kind eq 'bar'
        mine = [m.x, m.y, m.base, m.width, m.height]
        i = 0
        while i lt 5
            h = _held[h, '`what` [`i + 1`]', mine[i], _at[want, i + 1]]
            i = i + 1
        h = _held_words[h, '`what` across', '`m.horizontal`', _words_at[want, 6]]
        h = _held_words[h, '`what` rounded', '`m.rounded`', _words_at[want, 7]]
        h = _held_words[h, '`what` skipped', m.skipped, _words_at[want, 8]]
    if kind eq 'point'
        h = _held[h, '`what` x', m.x, _at[want, 1]]
        h = _held[h, '`what` y', m.y, _at[want, 2]]
        h = _held_words[h, '`what` skip', '`m.skip`', _words_at[want, 3]]
        if curves
            mine = [m.cp1x, m.cp1y, m.cp2x, m.cp2y]
            i = 0
            while i lt 4
                h = _held[h, '`what` control [`i`]', mine[i], _at[want, i + 4]]
                i = i + 1
        h = _held[h, '`what` radius', m.radius, _at[want, 8]]
        h = _held_words[h, '`what` stop', '`m.stop`', _words_at[want, 9]]
    if kind eq 'arc'
        mine = [m.x, m.y, m.start_angle, m.end_angle, m.inner, m.outer, m.circumference]
        i = 0
        while i lt 7
            h = _held[h, '`what` [`i + 1`]', mine[i], _at[want, i + 1]]
            i = i + 1
    h

--- ---- what the pointer finds ----

--- the marks as Chart.js lists them: [dataset, place] pairs
fn _hits_words[hits]
    out = ''
    i = 0
    while i lt len[hits]
        h = hits[i]
        out = '`out`[`h.set`,`h.index`]'
        i = i + 1
    out

fn _recorded_hits[list]
    out = ''
    i = 0
    while i lt len[list]
        pair = list[i]
        out = '`out`[`pair[0]`,`pair[1]`]'
        i = i + 1
    out

--- every pick Chart.js made at each pointer position, held
fn _picks_held[h0, name, ch, laid, layers, probes]
    h = h0
    k = 0
    while k lt len[probes]
        pr = probes[k]
        x = _at[pr.at, 0]
        y = _at[pr.at, 1]
        i = 0
        while i lt len[pr.picks]
            pick = pr.picks[i]
            mode = '`pick[0]`'
            intersect = '`pick[1]`' eq 'true'
            axis = '`pick[2]`'
            mine = charts_hits.picked[ch, laid, layers, x, y, mode, intersect, axis]
            h = _held_words[h, '`name` at (`x`, `y`) `mode` `intersect` `axis`', _hits_words[mine], _recorded_hits[pick[3]]]
            i = i + 1
        k = k + 1
    h

--- every tooltip Chart.js showed, held: whether it shows, what is drawn
--- as under the pointer, its marks, words, box, caret and leaning
fn _tips_held[h0, name, ch, laid, layers, tips, pen]
    h = h0
    k = 0
    while k lt len[tips]
        want = tips[k]
        x = _at[want.at, 0]
        y = _at[want.at, 1]
        what = '`name` tip at (`x`, `y`)'
        t = charts_hits.told[ch, laid, layers, x, y, pen]
        h = _held_words[h, '`what` shown', '`t.shown`', '`want.shown`']
        active = charts_hits.hovered[ch, laid, layers, x, y]
        h = _held_words[h, '`what` active', _hits_words[active], _recorded_hits[want.active]]
        if t.shown and '`want.shown`' eq 'true'
            h = _held_words[h, '`what` marks', _hits_words[t.hits], _recorded_hits[want.points]]
            h = _held_words[h, '`what` title', join[t.title, '|'], _joined_words[want.title]]
            h = _held_words[h, '`what` lines', _lines_words[t.lines], _body_words[want.body]]
            mine = [t.x, t.y, t.width, t.height]
            i = 0
            while i lt 4
                h = _held[h, '`what` box[`i`]', mine[i], _at[want.box, i]]
                i = i + 1
            h = _held[h, '`what` caret x', t.caret_x, _at[want.caret, 0]]
            h = _held[h, '`what` caret y', t.caret_y, _at[want.caret, 1]]
            h = _held_words[h, '`what` leaning', '`t.x_align` `t.y_align`', '`want.align[0]` `want.align[1]`']
        k = k + 1
    h

fn _joined_words[list]
    out = ''
    i = 0
    while i lt len[list]
        if i gt 0
            out = '`out`|'
        out = '`out``list[i]`'
        i = i + 1
    out

fn _lines_words[lines]
    out = ''
    i = 0
    while i lt len[lines]
        out = '`out`[`lines[i]`]'
        i = i + 1
    out

fn _body_words[body]
    out = ''
    i = 0
    while i lt len[body]
        out = '`out`[`_joined_words[body[i]]`]'
        i = i + 1
    out

--- the chart after the click Chart.js recorded, held as it laid it: its
--- layout, its legend's items and its marks
fn _clicked_held[h0, name, ch, laid, clicked, pen]
    h = h0
    k = charts_hits.legend_at[laid, _at[clicked.at, 0], _at[clicked.at, 1]]
    h = _held[h, '`name` legend item clicked', 0.0 + k, _in[clicked, 'item']]
    after = charts_hits.toggled[ch, laid, k]
    laid2 = charts_layout.laid_out[after, laid.width, laid.height, pen]
    what = '`name` clicked'
    h = _layout_held[h, what, laid2, clicked.laid]
    items = clicked.laid.legend.items
    i = 0
    while i lt len[items] and i lt len[laid2.legend.items]
        h = _held_words[h, '`what` legend item `i` hidden', '`laid2.legend.items[i].hidden`', '`items[i][1]`']
        i = i + 1
    _marks_held[h, what, after, laid2, clicked.laid, false]

test every_chart_is_laid_as_chart_js_lays_it[]
    j = _reference[]
    pen = _pen[j]
    h = Held[0, []]
    i = 0
    while i lt len[j.cases]
        c = j.cases[i]
        laid = _laid[c, pen]
        h = _layout_held[h, '`c.name`', laid, c.laid]
        i = i + 1
    log['layout: `h.count` numbers held']
    assert[len[h.wrong] eq 0, join[h.wrong, '\n']]
    h.count gt 4000

test every_mark_stands_where_chart_js_puts_it[]
    j = _reference[]
    pen = _pen[j]
    h = Held[0, []]
    i = 0
    while i lt len[j.cases]
        c = j.cases[i]
        ch = _chart_of[c]
        laid = charts_layout.laid_out[ch, 0.0 + c.width, 0.0 + c.height, pen]
        h = _marks_held[h, '`c.name`', ch, laid, c.laid, true]
        i = i + 1
    log['marks: `h.count` numbers held']
    assert[len[h.wrong] eq 0, join[h.wrong, '\n']]
    h.count gt 3000

test every_mode_picks_what_chart_js_picks[]
    j = _reference[]
    pen = _pen[j]
    h = Held[0, []]
    i = 0
    while i lt len[j.cases]
        c = j.cases[i]
        ch = _chart_of[c]
        laid = charts_layout.laid_out[ch, 0.0 + c.width, 0.0 + c.height, pen]
        layers = charts_marks.marked[ch, laid, false]
        h = _picks_held[h, '`c.name`', ch, laid, layers, c.probes]
        i = i + 1
    log['picks: `h.count` held']
    assert[len[h.wrong] eq 0, join[h.wrong, '\n']]
    h.count gt 5000

test every_tooltip_says_and_stands_as_chart_js_s[]
    j = _reference[]
    pen = _pen[j]
    h = Held[0, []]
    i = 0
    while i lt len[j.cases]
        c = j.cases[i]
        ch = _chart_of[c]
        laid = charts_layout.laid_out[ch, 0.0 + c.width, 0.0 + c.height, pen]
        layers = charts_marks.marked[ch, laid, false]
        h = _tips_held[h, '`c.name`', ch, laid, layers, c.tips, pen]
        i = i + 1
    log['tooltips: `h.count` held']
    assert[len[h.wrong] eq 0, join[h.wrong, '\n']]
    h.count gt 1000

test a_click_on_the_legend_hides_what_chart_js_hides[]
    j = _reference[]
    pen = _pen[j]
    h = Held[0, []]
    i = 0
    while i lt len[j.cases]
        c = j.cases[i]
        clicked = c.clicked
        if clicked.ok
            ch = _chart_of[c]
            laid = charts_layout.laid_out[ch, 0.0 + c.width, 0.0 + c.height, pen]
            h = _clicked_held[h, '`c.name`', ch, laid, clicked, pen]
        i = i + 1
    log['clicks: `h.count` held']
    assert[len[h.wrong] eq 0, join[h.wrong, '\n']]
    h.count gt 1000

--- ---- motion ----

test every_easing_paces_as_chart_js_s[]
    j = _reference[]
    h = Held[0, []]
    names = keys[j.easings]
    k = 0
    while k lt len[names]
        name = '`names[k]`'
        paced = j.easings[name]
        i = 0
        while i lt len[paced]
            h = _held[h, '`name`(`i`/20)', charts_motion.eased[name, (0.0 + i) / 20.0], _at[paced, i]]
            i = i + 1
        k = k + 1
    log['easings: `h.count` held']
    assert[len[h.wrong] eq 0, join[h.wrong, '\n']]
    h.count eq 651

test colours_part_way_are_chart_js_s[]
    j = _reference[]
    h = Held[0, []]
    k = 0
    while k lt len[j.colours]
        row = j.colours[k]
        from = charts_model.css['`row[0]`']
        to = charts_model.css['`row[1]`']
        share = _at[row, 2]
        c = charts_motion.color_between[from, to, share]
        want = row[4]
        what = '`row[0]` to `row[1]` at `share`'
        h = _held[h, '`what` red', charts_model.byte_of[c.r], _at[want, 0]]
        h = _held[h, '`what` green', charts_model.byte_of[c.g], _at[want, 1]]
        h = _held[h, '`what` blue', charts_model.byte_of[c.b], _at[want, 2]]
        h = _held[h, '`what` alpha', c.a, _at[want, 3]]
        k = k + 1
    log['colours: `h.count` held']
    assert[len[h.wrong] eq 0, join[h.wrong, '\n']]
    h.count eq 120

--- the chart an animation case describes, its first dataset holding
--- `data` filled with `color` (where given), laid again (`again`) or for
--- the first time
fn _moving_chart[config, data, color, again]
    ch = charts_json.chart_from['moving', config]
    if len[data] gt 0
        s = ch.sets[0]
        s.ys = data
        if color ne ''
            s.fills = [charts_model.css[color]]
        ch.sets[0] = s
    ch.laid_before = again
    ch

fn _numbers_of[list]
    out = charts_model.no_numbers[]
    i = 0
    while i lt len[list]
        out = push[out, _at[list, i]]
        i = i + 1
    out

--- each sample of a run held: the marks of the first dataset, as the
--- run read them
fn _samples_held[h0, name, ch, laid, motion, start, samples]
    h = h0
    k = 0
    while k lt len[samples]
        t = _at[samples[k], 0]
        rows = samples[k][1]
        layers = charts_motion.moving[ch, laid, motion, start + t]
        marks = layers[0].marks
        i = 0
        while i lt len[rows]
            row = rows[i]
            m = marks[i]
            what = '`name` at `t` mark `i`'
            if name eq 'line_load'
                h = _held[h, '`what` x', m.x, _at[row, 0]]
                h = _held[h, '`what` y', m.y, _at[row, 1]]
            else if name eq 'doughnut_load'
                mine = [m.start_angle, m.end_angle, m.circumference, m.inner, m.outer]
                c = 0
                while c lt 5
                    h = _held[h, '`what` [`c`]', mine[c], _at[row, c]]
                    c = c + 1
            else if name eq 'polar_load'
                mine = [m.start_angle, m.end_angle, m.inner, m.outer]
                c = 0
                while c lt 4
                    h = _held[h, '`what` [`c`]', mine[c], _at[row, c]]
                    c = c + 1
            else
                mine = [m.x, m.y, m.base, m.width, m.height]
                c = 0
                while c lt 5
                    h = _held[h, '`what` [`c`]', mine[c], _at[row, c]]
                    c = c + 1
                ink = row[5]
                h = _held[h, '`what` red', charts_model.byte_of[m.fill.r], _at[ink, 0]]
                h = _held[h, '`what` green', charts_model.byte_of[m.fill.g], _at[ink, 1]]
                h = _held[h, '`what` blue', charts_model.byte_of[m.fill.b], _at[ink, 2]]
                h = _held[h, '`what` alpha', m.fill.a, _at[ink, 3]]
            i = i + 1
        k = k + 1
    h

test marks_move_as_chart_js_moves_them[]
    j = _reference[]
    pen = _pen[j]
    h = Held[0, []]
    runs = j.animations
    bars = runs[0]
    second = runs[1]
    third = runs[2]
    --- the bars' configuration was recorded as the runs left it: they
    --- started from the retarget's first data, in a translucent blue
    ch = _moving_chart[bars.config, _numbers_of[third.data[0]], 'rgba(54, 162, 235, 0.5)', false]
    laid = charts_layout.laid_out[ch, 480.0, 320.0, pen]
    to = charts_marks.marked[ch, laid, false]
    motion = charts_motion.set_out[charts_marks.marked[ch, laid, true], to, 1000000.0, ch.duration, ch.easing]
    h = _samples_held[h, 'bar_load', ch, laid, motion, 1000000.0, bars.samples]
    ch2 = _moving_chart[bars.config, _numbers_of[second.data], '`second.color`', true]
    laid2 = charts_layout.laid_out[ch2, 480.0, 320.0, pen]
    motion2 = charts_motion.retargeted[ch2, laid2, motion, charts_marks.marked[ch2, laid2, false], 1010000.0]
    h = _samples_held[h, 'bar_update', ch2, laid2, motion2, 1010000.0, second.samples]
    ch3 = _moving_chart[bars.config, _numbers_of[third.data[0]], '`second.color`', true]
    laid3 = charts_layout.laid_out[ch3, 480.0, 320.0, pen]
    motion3 = charts_motion.retargeted[ch3, laid3, motion2, charts_marks.marked[ch3, laid3, false], 1020000.0]
    ch4 = _moving_chart[bars.config, _numbers_of[third.data[1]], '`second.color`', true]
    laid4 = charts_layout.laid_out[ch4, 480.0, 320.0, pen]
    motion4 = charts_motion.retargeted[ch4, laid4, motion3, charts_marks.marked[ch4, laid4, false], 1020300.0]
    h = _samples_held[h, 'bar_retarget', ch4, laid4, motion4, 1020300.0, third.samples]
    k = 3
    while k lt len[runs]
        run = runs[k]
        name = '`run.name`'
        start = _in[run, 'start']
        c = _moving_chart[run.config, charts_model.no_numbers[], '', false]
        cl = charts_layout.laid_out[c, 480.0, 320.0, pen]
        m = charts_motion.set_out[charts_marks.marked[c, cl, true], charts_marks.marked[c, cl, false], start, c.duration, c.easing]
        h = _samples_held[h, name, c, cl, m, start, run.samples]
        k = k + 1
    log['animations: `h.count` held']
    assert[len[h.wrong] eq 0, join[h.wrong, '\n']]
    h.count gt 1000

--- ---- decimation ----

test long_lines_are_thinned_as_chart_js_thins_them[]
    j = _reference[]
    pen = _pen[j]
    h = Held[0, []]
    dec = j.decimation
    xs = charts_model.no_numbers[]
    ys = charts_model.no_numbers[]
    i = 0
    while i lt len[dec.points]
        xs = push[xs, _at[dec.points[i], 0]]
        ys = push[ys, _at[dec.points[i], 1]]
        i = i + 1
    k = 0
    while k lt len[dec.runs]
        run = dec.runs[k]
        name = '`run.name`'
        ch = charts_model.chart_of['thin', 'line', slice[[''], 0, 0]]
        ch.axes = [charts_model.axis_of['x', 'linear', 'x', 'bottom'], charts_model.axis_of['y', 'linear', 'y', 'left']]
        s = charts_model.dataset['line', 'Long', ys]
        s.xs = xs
        s.edge_width = 1.0
        s.point_radius = 0.0
        ch.sets = [s]
        ch.decimate = true
        ch.algorithm = name
        ch.samples = _in[run, 'samples']
        thin = charts_decimation.decimated[ch, 400.0]
        kept = run.kept
        got = thin.sets[0]
        if len[got.xs] ne len[kept]
            h.wrong = push[h.wrong, '`name`: Chart.js keeps `len[kept]` points, Kite `len[got.xs]`']
        else
            i = 0
            while i lt len[kept]
                h = _held[h, '`name` kept `i` x', got.xs[i], _at[kept[i], 0]]
                h = _held[h, '`name` kept `i` y', got.ys[i], _at[kept[i], 1]]
                i = i + 1
            laid = charts_layout.laid_out[thin, 400.0, 240.0, pen]
            h = _layout_held[h, name, laid, run.laid]
            h = _marks_held[h, name, thin, laid, run.laid, true]
        k = k + 1
    log['decimation: `h.count` held']
    assert[len[h.wrong] eq 0, join[h.wrong, '\n']]
    h.count gt 5000
