--- Solid's Suspense Transitions (solid-site's suspensetabs): three tabs,
--- Uno, Dos and Tres, over a page each. A page waits for its content (a
--- made-up delay of 160 to 580 ms, drawn from the random source when the
--- page is made) and says how long it waited. The first page shows
--- "Loading..." until its content comes; a tab chosen after that changes
--- nothing at once: the page shown stays and only fades (its colour
--- going to #aaa over 300 ms, eased in, after 100 ms) while the new page
--- waits, and when the new page's content comes the tabs change over to
--- it (each tab's colour and underline easing over 500 ms) and the page
--- is shown whole, its colour back at once.
---
--- Held as Solid's transition holds it: a tab chosen while another is
--- waiting replaces the one waiting (the wait is the newest page's, and
--- the fading goes on from when it began); the tab already shown, chosen
--- while another waits, ends the waiting; chosen when nothing waits, it
--- does nothing. The pages' long words are Lory's own, not the example's.
use lory
use lory.gui
use lory.motion

--- a page made: which tab (0 to 2), its delay, when it was made, and
--- whether its content has come
struct Page [tab, delay, made, ready]

--- a colour easing from `from` to `to` (each [r, g, b]) since `start`
struct Tween [from, to, start]

--- the tab shown, the page shown, the page waiting (its `tab` -1 where
--- none is), when the waiting began, the random source, and each tab's
--- colour and underline easing
struct State [tab, shown, waiting, since, seed, colors, unders]

fn names[]
    ['Uno', 'Dos', 'Tres']

fn _no_page[]
    Page[-1, 0.0, 0.0, false]

fn _ink[]
    [68.0, 68.0, 68.0]

fn _faint[]
    [170.0, 170.0, 170.0]

fn _blue[]
    [51.0, 122.0, 183.0]

fn _rule[]
    [238.0, 238.0, 238.0]

fn _still[color]
    Tween[color, color, 0.0]

fn _tweens_for[tab, chosen, other]
    out = for i in range[3]
        if i eq tab
            _still[chosen]
        else
            _still[other]
    out

fn fresh[at]
    s = State[0, _no_page[], _no_page[], -1.0, 1, _tweens_for[0, _ink[], _faint[]], _tweens_for[0, _blue[], _rule[]]]
    s = _first[s, at]
    s

fn _first[s, at]
    made = _made[s, 0, at]
    made.s.shown = made.page
    made.s

--- the example with its random source seeded, as the reference seeds it
--- (the first page is made again from it)
fn seeded[s, seed]
    s.seed = seed
    _first[s, s.shown.made]

--- ---- the random source: x = x * 48271 mod 2147483647, x / 2147483647 ----

fn next_seed[x]
    (x * 48271) % 2147483647

--- a page made for a tab at `at`, its delay the next random number's
--- share of 420 ms past 160
struct Made [s, page]

fn _made[s, tab, at]
    s.seed = next_seed[s.seed]
    r = s.seed / 2147483647.0
    Made[s, Page[tab, r * 420.0 + 160.0, at, false]]

--- ---- time ----

fn _clamped[t]
    max[0.0, min[1.0, t]]

--- a colour at `at` of its easing (CSS's `ease`, 500 ms)
fn tween_at[w, at]
    p = motion.ease_at['ease', _clamped[(at - w.start) / 500.0]]
    out = for k in range[3]
        w.from[k] + (w.to[k] - w.from[k]) * p
    out

--- the tabs changed over to `tab` at `at`: each tab eases from where it
--- is seen to its new colour
fn _changed_to[s, tab, at]
    i = 0
    while i lt 3
        to_color = _faint[]
        to_under = _rule[]
        if i eq tab
            to_color = _ink[]
            to_under = _blue[]
        s.colors[i] = Tween[tween_at[s.colors[i], at], to_color, at]
        s.unders[i] = Tween[tween_at[s.unders[i], at], to_under, at]
        i = i + 1
    s.tab = tab
    s

--- the content come of each page whose delay is over
fn before[s, at]
    if not s.shown.ready and at gte s.shown.made + s.shown.delay
        s.shown.ready = true
    if s.waiting.tab gte 0 and at gte s.waiting.made + s.waiting.delay
        s.waiting.ready = true
        s.shown = s.waiting
        s.waiting = _no_page[]
        s.since = -1.0
        s = _changed_to[s, s.shown.tab, at]
    s

--- whether a new page is waiting
fn pending[s]
    s.waiting.tab gte 0

--- a tab chosen at `at`
fn chosen[s, tab, at]
    if pending[s] and tab eq s.waiting.tab
        return s
    if tab eq s.tab
        s.waiting = _no_page[]
        s.since = -1.0
        return s
    if not pending[s]
        s.since = at
    made = _made[s, tab, at]
    s = made.s
    s.waiting = made.page
    s

fn after[s, shown, at]
    for e in shown.events
        if e.act eq 'press' and starts[e.id, 'suspense.']
            for i in range[3]
                if e.id eq 'suspense.`names[][i]`'
                    s = chosen[s, i, at]
    s

--- the page's colour: #444, fading to #aaa (300 ms, eased in, after 100
--- ms) while a new page waits
fn page_grey[s, at]
    if not pending[s]
        return 68.0
    p = _clamped[(at - s.since - 100.0) / 300.0]
    68.0 + 102.0 * motion.ease_at['ease-in', p]

fn loading[s]
    not s.shown.ready

--- what the page says of itself once its content came
fn said_of[s]
    if loading[s]
        return ''
    whole = int[floor[s.shown.delay + 0.5]]
    'This content is for page "`names[][s.shown.tab]`" after `whole`ms.'

fn _words_of[tab]
    if tab eq 0
        return 'The first page, which waited for its content as the others do. A page is made when its tab is chosen, and waits a while of its own.'
    if tab eq 1
        return 'The second page. While it waited the first stayed on the screen, faded, and the tabs did not change; they changed over once it came.'
    'The third page. Choose another tab while one waits and the newest choice is the one waited for.'

--- ---- drawn ----

fn _byte[v]
    floor[v + 0.5]

--- a tab's grey and its underline's colour packed in one number
fn _packed[grey, under]
    _byte[grey] * 16777216.0 + _byte[under[0]] * 65536.0 + _byte[under[1]] * 256.0 + _byte[under[2]]

--- a tab drawn: its name in its grey and its underline (2 px) in its
--- colour; pressed, or Enter or space typed on it, it is chosen
fn tabbed[d]
    grey = floor[d.num / 16777216.0]
    rest = d.num - grey * 16777216.0
    r = floor[rest / 65536.0]
    g = floor[(rest - r * 65536.0) / 256.0]
    b = rest - r * 65536.0 - g * 256.0
    d.c = lory.text[d.c, d.x + 10.0 * d.s, d.y + 10.0 * d.s, d.words, 16.0 * d.s, lory.rgb[grey, grey, grey]]
    d.c = lory.rect[d.c, d.x, d.y + d.h - 2.0 * d.s, d.w, 2.0 * d.s, lory.rgb[r, g, b]]
    if d.focused
        d.c = lory.round_outline[d.c, d.x, d.y, d.w, d.h, 4.0 * d.s, 2.0 * d.s, d.look.focus]
    keyed = for k in d.keys
        if k eq 'Enter' or k eq ' '
            k
    if d.pressed or len[keyed] gt 0
        d = gui.tell[d, 'press', d.words, d.num]
    d

--- a line of the page in its grey
fn greyed[d]
    d.c = lory.text[d.c, d.x, d.y, d.words, 15.0 * d.s, lory.rgb[d.num, d.num, d.num]]
    d

fn tree[s, at, dark]
    tabs = for i in range[3]
        grey = tween_at[s.colors[i], at][0]
        under = tween_at[s.unders[i], at]
        gui.drawn['suspense.`names[][i]`', _packed[grey, under], 20.0 + 9.0 * len[names[][i]], 40.0, tabbed, words = names[][i]]
    body = [gui.text['Loading...', tone = 'muted']]
    if not loading[s]
        grey = page_grey[s, at]
        tone = 'ink'
        if grey gt 119.0
            tone = 'muted'
        body = [gui.drawn['', _byte[grey], 0.0, 22.0, greyed, words = said_of[s]], gui.text[_words_of[s.shown.tab], tone = tone]]
    gui.column[[gui.row[tabs, gap = 0.0], gui.column[body, gap = 10.0]], gap = 25.0]

--- ---- what the example shows, as tests/solid/reference.json records ----

fn _rgb_seen[c]
    '[`int[_byte[c[0]]]`, `int[_byte[c[1]]]`, `int[_byte[c[2]]]`]'

fn seen[s, at]
    tabs = for i in range[3]
        '{"color": `_rgb_seen[tween_at[s.colors[i], at]]`, "under": `_rgb_seen[tween_at[s.unders[i], at]]`}'
    grey = page_grey[s, at]
    t = join[tabs, ', ']
    '{"t": `encode[at]`, "selected": `s.tab`, "pending": `encode[pending[s]]`, "color": `_rgb_seen[[grey, grey, grey]]`, "tabs": [`t`], "loader": `encode[loading[s]]`, "said": `encode[said_of[s]]`, "paragraph": `encode[not loading[s]]`}'

--- a page 1000 by 900 at `t` ms with no input, as the page hands a frame
fn _page[t]
    json['{"t": `t`, "width": 1000, "height": 900, "ratio": 1, "xr": false, "views": [{"eye": "none", "x": 0, "y": 0, "width": 1000, "height": 900, "projection": [], "camera": []}], "input": [], "pointers": [], "controllers": [], "said": []}']

test the_first_page_loads_then_says_how_long_it_waited[]
    s = seeded[fresh[0.0], 2024]
    loading[s]
    s = before[s, 192.0]
    said_of[s] eq 'This content is for page "Uno" after 179ms.'

test a_tab_chosen_waits_with_the_old_page_shown[]
    s = before[seeded[fresh[0.0], 2024], 192.0]
    s = chosen[s, 1, 592.0]
    pending[s]
    s.tab eq 0
    page_grey[s, 680.0] eq 68.0
    page_grey[s, 768.0] gt 68.0
    s = before[s, 800.0]
    not pending[s]
    s.tab eq 1
    page_grey[s, 800.0] eq 68.0

test the_tab_shown_chosen_again_does_nothing_or_ends_the_wait[]
    s = before[seeded[fresh[0.0], 2024], 192.0]
    chosen[s, 0, 300.0].seed eq s.seed
    not pending[chosen[chosen[s, 1, 300.0], 0, 320.0]]

test its_tabs_are_drawn[]
    shown = gui.show[lory.begin[_page[0.0]], tree[fresh[0.0], 0.0, false]]
    'suspense.Dos' in shown.boxes
