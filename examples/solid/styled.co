--- Solid's styled-jsx example (solid-site's styledjsx): two buttons, each
--- its own component with its own state, "Log In" on green and "Log Out"
--- on blue, the colour coming from a style the component writes from its
--- state and that reaches its own button alone. In Lory each button is
--- drawn by the program (`gui.drawn`): its painter fills it the colour its
--- own state names, so the two never share one.
---
--- (The example's second file, a form helper written for an older Solid
--- (`createState`), is imported by nothing; the helper's behaviour is the
--- Form Validation example's, in forms.co.)
use lory
use lory.gui

--- whether each button's reader is logged in
struct State [logged]

fn fresh[at]
    State[[false, false]]

fn before[s, at]
    s

fn words_of[on]
    if on
        return 'Log Out'
    'Log In'

--- the button's colour, as CSS names it: blue logged in, green not
fn rgb_of[on]
    if on
        return [0, 0, 255]
    [0, 128, 0]

--- a button filled its state's colour, its words in white; pressed (or
--- Enter or space with the focus) it says so
fn painted[d]
    on = d.num gt 0.5
    k = rgb_of[on]
    fill = lory.rgb[0.0 + k[0], 0.0 + k[1], 0.0 + k[2]]
    d.c = lory.rect[d.c, d.x, d.y, d.w, d.h, fill]
    d.c = lory.text_centered[d.c, d.x + d.w / 2.0, d.y + d.h / 2.0, d.words, 15.0 * d.s, lory.white[]]
    keyed = false
    for k2 in d.keys
        if k2 eq 'Enter' or k2 eq ' '
            keyed = true
    if d.pressed or keyed
        d = gui.tell[d, 'press', d.words, d.num]
    d

fn _button[s, i]
    on = s.logged[i]
    v = 0.0
    if on
        v = 1.0
    gui.drawn['styled.button`i`', v, 110.0, 58.0, painted, words = words_of[on]]

fn tree[s, at, dark]
    gui.row[[_button[s, 0], _button[s, 1]], gap = 20.0]

fn after[s, shown, at]
    for e in shown.events
        for i in range[2]
            if e.id eq 'styled.button`i`' and e.act eq 'press'
                s.logged[i] = not s.logged[i]
    s

fn seen[s, at]
    parts = slice[[''], 0, 0]
    for i in range[2]
        words = words_of[s.logged[i]]
        parts = push[parts, '{"words": `encode[words]`, "color": `encode[rgb_of[s.logged[i]]]`}']
    body = join[parts, ', ']
    '{"t": `encode[at]`, "buttons": [`body`]}'

--- a page 1000 by 900 at `t` ms with no input, as the page hands a frame
fn _page[t]
    json['{"t": `t`, "width": 1000, "height": 900, "ratio": 1, "xr": false, "views": [{"eye": "none", "x": 0, "y": 0, "width": 1000, "height": 900, "projection": [], "camera": []}], "input": [], "pointers": [], "controllers": [], "said": []}']

test each_button_is_drawn_in_its_own_colour[]
    shown = gui.show[lory.begin[_page[0.0]], tree[fresh[0.0], 0.0, false]]
    'styled.button0' in shown.boxes
    'styled.button1' in shown.boxes
    rgb_of[false] eq [0, 128, 0]
    rgb_of[true] eq [0, 0, 255]
