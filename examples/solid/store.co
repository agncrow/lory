--- Solid's counter store with context (solid-site's counterstore
--- example): a count of 7 held by a provider and read, with the two
--- actions that move it, by a component nested two deep, whose "+" and
--- "-" change the one count every reader of it shows. In Lory the
--- provider is the record the program keeps, and the nested component a
--- view handed what the provider gives (the count and its actions' ids):
--- no component between them need know of it.
use lory
use lory.gui

--- the provider's count
struct State [count]

fn fresh[at]
    State[7]

--- what the provider hands down: the count and the ids its actions answer
struct Given [count, more, less]

fn _provided[s]
    Given[s.count, 'store.more', 'store.less']

--- the component nested in the middle one: the count and its two buttons
fn _nested[given]
    gui.column[[gui.text['`given.count`', 18.0], gui.row[[gui.button[given.more, '+'], gui.button[given.less, '-']]]]]

fn _middle[given]
    _nested[given]

fn before[s, at]
    s

fn tree[s, at, dark]
    _middle[_provided[s]]

fn after[s, shown, at]
    for e in shown.events
        if e.id eq 'store.more' and e.act eq 'press'
            s.count = s.count + 1
        if e.id eq 'store.less' and e.act eq 'press'
            s.count = s.count - 1
    s

fn seen[s, at]
    words = '`s.count`'
    '{"t": `encode[at]`, "count": `encode[words]`}'

--- a page 1000 by 900 at `t` ms with no input, as the page hands a frame
fn _page[t]
    json['{"t": `t`, "width": 1000, "height": 900, "ratio": 1, "xr": false, "views": [{"eye": "none", "x": 0, "y": 0, "width": 1000, "height": 900, "projection": [], "camera": []}], "input": [], "pointers": [], "controllers": [], "said": []}']

test its_two_buttons_are_drawn[]
    shown = gui.show[lory.begin[_page[0.0]], tree[fresh[0.0], 0.0, false]]
    'store.more' in shown.boxes
    'store.less' in shown.boxes
