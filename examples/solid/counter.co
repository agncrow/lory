--- Solid's Counter (solidjs.com/examples/counter): words that count the
--- seconds since the example was opened, "Count value is N", the number
--- moved on by a timer every 1000 ms. Solid's timer is an interval that
--- the component clears when it goes; Lory's is the frame's time read
--- against the moment the example was opened, which goes with the state.
use lory
use lory.gui

--- when the example was opened (the frame's time, ms) and the count shown
struct State [since, count]

fn fresh[at]
    State[at, 0]

--- the count at the frame's time: one more at each whole second since the
--- example was opened (a timer due at a frame's time has run by it)
fn before[s, at]
    s.count = int[floor[(at - s.since) / 1000.0]]
    s

fn words_of[s]
    'Count value is `s.count`'

fn tree[s, at, dark]
    gui.column[[gui.text[words_of[s], 18.0]]]

--- nothing the reader does moves it
fn after[s, shown, at]
    s

--- what the example shows, as tests/solid/reference.json records Solid's
fn seen[s, at]
    words = words_of[s]
    '{"t": `encode[at]`, "text": `encode[words]`}'

test the_count_moves_on_at_each_whole_second[]
    s = fresh[500.0]
    before[s, 1499.0].count eq 0
    before[s, 1500.0].count eq 1
    words_of[before[s, 3600.0]] eq 'Count value is 3'

--- a page 1000 by 900 at `t` ms with no input, as the page hands a frame
fn _page[t]
    json['{"t": `t`, "width": 1000, "height": 900, "ratio": 1, "xr": false, "views": [{"eye": "none", "x": 0, "y": 0, "width": 1000, "height": 900, "projection": [], "camera": []}], "input": [], "pointers": [], "controllers": [], "said": []}']

test its_words_are_drawn[]
    shown = gui.show[lory.begin[_page[0.0]], tree[fresh[0.0], 0.0, false]]
    len[shown.events] eq 0
