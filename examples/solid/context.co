--- Solid's Context example (solid-site's context): a theme, a colour and
--- a title, given by a provider and read by the component under it, which
--- shows the title in a heading of the theme's colour and a colour picker
--- that changes the theme, and with it every reader of it. Here the
--- provider is the record the program keeps, and the reader the view it is
--- handed to. Lory has no colour picker of its own, so the picker is a
--- field of the colour's `#rrggbb`, taken as it is typed once it is a
--- whole colour (as a picker tells its input), beside a swatch of it and
--- a few colours to press. The heading is drawn by the program
--- (`gui.drawn`), since Lory's words come only in its look's tones.
use lory
use lory.gui

--- the theme the provider gives
struct State [color, title]

fn fresh[at]
    State['#335d92', 'Context Example']

fn before[s, at]
    s

--- whether text is a whole colour, `#` and six hexadecimal digits
fn whole[code]
    if len[code] ne 7 or not starts[code, '#']
        return false
    digits = '0123456789abcdef'
    odd = for ch in split[lower[slice[code, 1, 7]], '']
        if not (ch in digits)
            ch
    len[odd] eq 0

--- the colours offered beside the field
fn offered[]
    ['#335d92', '#d1495b', '#00798c', '#edae49']

--- a colour as one number, red's 65536s, green's 256s and blue's own: how
--- a painter is handed it
fn packed[code]
    k = lory.hex[code]
    floor[k.r * 255.0 + 0.5] * 65536.0 + floor[k.g * 255.0 + 0.5] * 256.0 + floor[k.b * 255.0 + 0.5]

fn _unpacked[n]
    r = floor[n / 65536.0]
    g = floor[(n - r * 65536.0) / 256.0]
    b = n - r * 65536.0 - g * 256.0
    lory.rgb[r, g, b]

--- the title drawn in the theme's colour, as large as a page's heading
fn titled[d]
    d.c = lory.text[d.c, d.x, d.y + 2.0 * d.s, d.words, 32.0 * d.s, _unpacked[d.num]]
    d

--- a swatch of a colour, its edge the focus ring's while it has the
--- focus: pressed, or Enter or space typed on it, it is chosen
fn swatched[d]
    edge = d.look.edge
    if d.focused
        edge = d.look.focus
    d.c = lory.round_rect[d.c, d.x, d.y, d.w, d.h, 6.0 * d.s, _unpacked[d.num]]
    d.c = lory.round_outline[d.c, d.x, d.y, d.w, d.h, 6.0 * d.s, 2.0 * d.s, edge]
    keyed = for k in d.keys
        if k eq 'Enter' or k eq ' '
            k
    if d.pressed or len[keyed] gt 0
        d = gui.tell[d, 'press', d.words, d.num]
    d

fn _offer[code, i]
    gui.drawn['context.offer`i`', packed[code], 28.0, 28.0, swatched, words = code]

fn tree[s, at, dark]
    heading = gui.drawn['', packed[s.color], 0.0, 46.0, titled, words = s.title]
    offers = for i in range[len[offered[]]]
        _offer[offered[][i], i]
    swatch = gui.drawn['', packed[s.color], 28.0, 28.0, swatched]
    picker = gui.row[[swatch, gui.sized[gui.field['context.color', s.color, hint = '#rrggbb'], 120.0], gui.label['Change color theme']]]
    gui.column[[heading, picker, gui.row[offers, gap = 8.0]], gap = 14.0]

--- a whole colour typed in the field, or one pressed, is the theme's
fn after[s, shown, at]
    for e in shown.events
        if e.id eq 'context.color' and (e.act eq 'edit' or e.act eq 'submit')
            if whole[e.words]
                s.color = lower[e.words]
        if e.act eq 'press' and starts[e.id, 'context.offer']
            s.color = e.words
    s

--- what the example shows, as tests/solid/reference.json records Solid's
--- (the picker holds the theme's colour)
fn seen[s, at]
    '{"t": `encode[at]`, "title": `encode[s.title]`, "color": `encode[s.color]`, "picker": `encode[s.color]`}'

test a_colour_is_whole_once_its_six_digits_are_typed[]
    whole['#335d92']
    whole['#FF00aa']
    not whole['#33']
    not whole['#33zz92']
    not whole['335d92a']

test a_colour_reaches_a_painter_whole[]
    k = _unpacked[packed['#335d92']]
    floor[k.r * 255.0 + 0.5] eq 51.0
    floor[k.g * 255.0 + 0.5] eq 93.0
    floor[k.b * 255.0 + 0.5] eq 146.0

--- a page 1000 by 900 at `t` ms with no input, as the page hands a frame
fn _page[t]
    json['{"t": `t`, "width": 1000, "height": 900, "ratio": 1, "xr": false, "views": [{"eye": "none", "x": 0, "y": 0, "width": 1000, "height": 900, "projection": [], "camera": []}], "input": [], "pointers": [], "controllers": [], "said": []}']

test its_picker_and_offers_are_drawn[]
    shown = gui.show[lory.begin[_page[0.0]], tree[fresh[0.0], 0.0, false]]
    'context.color' in shown.boxes
    'context.offer0' in shown.boxes
