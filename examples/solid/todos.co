--- Solid's Simple Todos, which the examples write three ways: in JSX
--- (solid-site's todos), in template literals (simpletodos) and in
--- hyperscript (simpletodoshyperscript). They are one behaviour, so here
--- they are one program, held to all three (tests/solid/parity.co). A
--- title typed and "+" pressed adds a todo, not done, and empties the
--- field; each todo has a box ticked when it is done, its title in a field
--- of its own and an "x" that takes it away. A title edited in its row is
--- taken when the reader leaves the field or presses Enter in it, as a
--- page's `change` is told. As the JSX writes it, an empty title is not
--- added (its field is `required`, and the reader is put back in it), and
--- Enter in the new title's field adds it, as a form is submitted.
---
--- Solid's keeps the list in the page's local storage, so it outlives a
--- reload of the page. Lory has no storage of its own: the list is kept in
--- Crow's process memory, written at every change and read as the
--- example opens, so it outlives the example being closed and opened
--- again (another example chosen and this one again), not a reload of
--- the page.
use memory
use lory
use lory.gui

--- a todo: its title and whether it is done
struct Todo [title, done]

--- what is kept of the list while the page lasts
struct Kept [rows]

--- the list; the new todo's title as typed; the row whose title is being
--- edited (-1: none) with its words so far; and the field the reader is
--- in ('' for none), as the presses and Tab have moved it
struct State [rows, typed, editing, draft, focus]

fn _no_rows[]
    slice[[Todo['', false]], 0, 0]

--- the list as it was last kept, and the list kept
fn kept[]
    recall['solid todos', Kept[_no_rows[]]].rows

fn _keep[rows]
    remember['solid todos', Kept[rows]]

--- the kept list emptied, as a page's storage is cleared
fn cleared[]
    _keep[_no_rows[]]

fn fresh[at]
    State[kept[], '', -1, '', '']

fn before[s, at]
    s

--- the list with a todo of that title added, not done
fn added[rows, title]
    push[rows, Todo[title, false]]

--- the list without its todo at `i`
fn removed[rows, i]
    concat[slice[rows, 0, i], slice[rows, i + 1, len[rows]]]

--- the title a row shows: the words typed in it while it is edited
fn shown_title[s, i]
    if s.editing eq i
        return s.draft
    s.rows[i].title

fn _title_id[i]
    'todos.row`i`.title'

--- the field at a point of the page (CSS pixels), '' where none is
fn _field_at[s, boxes, x, y]
    ids = for i in range[len[s.rows]]
        _title_id[i]
    ids = push[ids, 'todos.new']
    at = for id in ids
        if id in boxes
            b = boxes[id]
            if x gte b[0] and x lt b[0] + b[2] and y gte b[1] and y lt b[1] + b[3]
                id
    if len[at] eq 0
        return ''
    at[0]

--- the row's edited title taken, where it is not what the row holds
fn _taken[s]
    if s.editing gte 0 and s.editing lt len[s.rows]
        if s.draft ne s.rows[s.editing].title
            s.rows[s.editing].title = s.draft
            _keep[s.rows]
    s

--- the reader moved into the field `id` ('' for none): the field left
--- gives up its edit, and a row's title entered is the one edited
fn _moved_to[s, id]
    if id eq s.focus
        return s
    s = _taken[s]
    s.editing = -1
    s.draft = ''
    s.focus = id
    i = 0
    while i lt len[s.rows]
        if id eq _title_id[i]
            s.editing = i
            s.draft = s.rows[i].title
        i = i + 1
    s

--- the new title added, where there is one: emptied after; an empty one
--- is refused and the reader put in its field
fn _submitted[s, in_field]
    if s.typed eq ''
        gui.focus['todos.new', '']
        s = _moved_to[s, 'todos.new']
        return s
    s.rows = added[s.rows, s.typed]
    s.typed = ''
    _keep[s.rows]
    if in_field
        gui.focus['todos.new', '']
    s

fn _row[s, i]
    todo = s.rows[i]
    done = gui.checkbox['todos.row`i`.done', '', todo.done]
    title = gui.sized[gui.field[_title_id[i], todo.title], 220.0]
    gui.row[[done, title, gui.button['todos.row`i`.remove', 'x']], gap = 6.0]

fn tree[s, at, dark]
    rows = for i in range[len[s.rows]]
        _row[s, i]
    adder = gui.row[[gui.sized[gui.field['todos.new', s.typed, hint = 'a new todo, then +'], 240.0], gui.button['todos.add', '+']], gap = 6.0]
    gui.column[concat[[gui.text['Todos', 19.0], adder], rows], gap = 8.0]

fn after[s, shown, at]
    c = shown.canvas
    k = lory.px[c]
    --- (where the reader is, as presses and Tab moved them: a field left
    --- is a field's `change`)
    for e in lory.events[c]
        if e.on eq 'down'
            s = _moved_to[s, _field_at[s, shown.boxes, e.x / k, e.y / k]]
        if e.on eq 'key' and e.key eq 'Tab'
            s = _moved_to[s, '']
    gone = -1
    for e in shown.events
        if e.id eq 'todos.new' and e.act eq 'edit'
            s.typed = e.words
        if e.id eq 'todos.new' and e.act eq 'submit'
            s = _submitted[s, true]
        if e.id eq 'todos.add' and e.act eq 'press'
            s = _submitted[s, false]
        i = 0
        while i lt len[s.rows]
            if e.id eq _title_id[i] and e.act eq 'edit'
                s.editing = i
                s.draft = e.words
                s.focus = e.id
            if e.id eq _title_id[i] and e.act eq 'submit'
                s = _taken[s]
            if e.id eq 'todos.row`i`.done' and e.act eq 'toggle'
                s.rows[i].done = e.num gt 0.5
                _keep[s.rows]
            if e.id eq 'todos.row`i`.remove' and e.act eq 'press'
                gone = i
            i = i + 1
    if gone gte 0
        s.rows = removed[s.rows, gone]
        s.editing = -1
        s.draft = ''
        _keep[s.rows]
    s

fn _rows_text[rows]
    parts = for r in rows
        '{"done": `encode[r.done]`, "title": `encode[r.title]`}'
    body = join[parts, ', ']
    '[`body`]'

--- what the example shows, as tests/solid/reference.json records Solid's:
--- the new title, each row as shown, the list as kept, and no new title
--- kept (the JSX keeps none)
fn seen[s, at]
    shown = for i in range[len[s.rows]]
        Todo[shown_title[s, i], s.rows[i].done]
    rows = _rows_text[shown]
    saved = _rows_text[kept[]]
    '{"t": `encode[at]`, "new": `encode[s.typed]`, "rows": `rows`, "saved": `saved`, "stored_new": null}'

--- a page 1000 by 900 at `t` ms with no input, as the page hands a frame
fn _page[t]
    json['{"t": `t`, "width": 1000, "height": 900, "ratio": 1, "xr": false, "views": [{"eye": "none", "x": 0, "y": 0, "width": 1000, "height": 900, "projection": [], "camera": []}], "input": [], "pointers": [], "controllers": [], "said": []}']

test a_todo_is_added_and_taken_away[]
    rows = added[added[_no_rows[], 'a'], 'b']
    len[rows] eq 2
    removed[rows, 0][0].title eq 'b'
    len[removed[rows, 1]] eq 1

test an_empty_title_is_not_added[]
    _keep[_no_rows[]]
    s = _submitted[fresh[0.0], false]
    len[s.rows] eq 0
    s.focus eq 'todos.new'

test a_rows_edit_is_taken_when_its_field_is_left[]
    _keep[added[_no_rows[], 'b']]
    s = _moved_to[fresh[0.0], 'todos.row0.title']
    s.draft = 'bc'
    shown_title[s, 0] eq 'bc'
    kept[][0].title eq 'b'
    s = _moved_to[s, '']
    s.rows[0].title eq 'bc'
    kept[][0].title eq 'bc'
    _keep[_no_rows[]]

test its_rows_are_drawn[]
    _keep[added[_no_rows[], 'a']]
    gui.unfocus[]
    shown = gui.show[lory.begin[_page[0.0]], tree[fresh[0.0], 0.0, false]]
    'todos.row0.title' in shown.boxes
    'todos.add' in shown.boxes
    _keep[_no_rows[]]
