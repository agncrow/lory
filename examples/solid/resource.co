--- Solid's Async Resource (solid-site's asyncresource): a number field
--- names a person, and each time its words change the person is asked of
--- swapi.dev's people (`https://swapi.dev/api/people/<words>/`). While
--- the latest asking is out "Loading..." stands beside the field; when
--- its answer comes it is shown whole as JSON, two spaces a level, as
--- `JSON.stringify(user, null, 2)` writes it. An answer to an earlier
--- asking, come after a later one was sent, is not shown (only the
--- latest is), and the answer shown stays until the next one comes.
---
--- Lory's page does the asking: the part says what to ask (`asks`, each
--- with an id) and the program hands it to `lory.request`; the page's
--- answers come back in a later frame's `lory.said` and are handed to
--- `heard`. The field's words are asked as they are, an empty field too
--- (`people//`), as the example asks them; before anything is typed
--- nothing is asked.
use lory
use lory.gui

--- an asking: its id (the count of askings so far) and where it went
struct Ask [id, url]

--- the field's words (`typed` false until something was typed), the
--- askings sent (every url, in order), the askings this frame is to send,
--- the id of the latest, whether it is still out, and the answer shown
--- (as JSON's words, '' before any)
struct State [typed, words, asked, asks, latest, loading, shown]

fn _no_asks[]
    slice[[Ask['', '']], 0, 0]

fn fresh[at]
    State[false, '', slice[[''], 0, 0], _no_asks[], '', false, '']

--- the askings handed out are gone at the frame's start
fn before[s, at]
    s.asks = _no_asks[]
    s

--- where a person's words are asked
fn url_of[words]
    'https://swapi.dev/api/people/`words`/'

--- the person asked again with the field's new words
fn asked_for[s, words]
    if s.typed and words eq s.words
        return s
    s.typed = true
    s.words = words
    id = 'resource.`len[s.asked]`'
    s.asked = push[s.asked, url_of[words]]
    s.asks = push[s.asks, Ask[id, url_of[words]]]
    s.latest = id
    s.loading = true
    s

fn after[s, shown, at]
    for e in shown.events
        if e.id eq 'resource.id' and e.act eq 'edit'
            s = asked_for[s, e.words]
    s

--- the page's answers taken up (what `lory.said` holds: each with `what`
--- 'answer', the `id` its asking kept, and its `status` and `body`, or
--- `failed`): only the latest asking's is shown; one that failed stops
--- the loading and leaves the last answer standing
fn heard[s, said]
    for back in said
        if '`back.what`' eq 'answer' and '`back.id`' eq s.latest
            s.loading = false
            if not ('failed' in back)
                s.shown = pretty['`back.body`']
    s

--- ---- JSON written two spaces a level ----

--- JSON's words written again as `JSON.stringify(v, null, 2)` writes
--- them: each member and item on a line of its own, indented two spaces a
--- level, `": "` after a key, and an empty list or object kept `[]`/`{}`
fn pretty[words]
    chars = split[words, '']
    out = ''
    depth = 0
    inside = false
    escaped = false
    i = 0
    while i lt len[chars]
        ch = chars[i]
        if inside
            out = '`out``ch`'
            if escaped
                escaped = false
            else if ch eq '\\'
                escaped = true
            else if ch eq '"'
                inside = false
        else if ch eq '"'
            inside = true
            out = '`out``ch`'
        else if ch eq '{' or ch eq '['
            j = _next_solid[chars, i + 1]
            if j lt len[chars] and (chars[j] eq '}' or chars[j] eq ']')
                out = '`out``ch``chars[j]`'
                i = j
            else
                depth = depth + 1
                out = '`out``ch`\n`_indent[depth]`'
        else if ch eq '}' or ch eq ']'
            depth = depth - 1
            out = '`out`\n`_indent[depth]``ch`'
        else if ch eq ','
            out = '`out`,\n`_indent[depth]`'
        else if ch eq ':'
            out = '`out`: '
        else if not (ch eq ' ' or ch eq '\n' or ch eq '\t' or ch eq '\r')
            out = '`out``ch`'
        i = i + 1
    out

fn _next_solid[chars, i]
    j = i
    while j lt len[chars] and (chars[j] eq ' ' or chars[j] eq '\n' or chars[j] eq '\t' or chars[j] eq '\r')
        j = j + 1
    j

fn _indent[depth]
    out = ''
    for k in range[depth]
        out = '`out`  '
    out

--- ---- drawn ----

fn loading_words[s]
    if s.loading
        return 'Loading...'
    ''

fn tree[s, at, dark]
    field = gui.sized[gui.field['resource.id', s.words, kind = 'number', hint = 'Enter Numeric Id'], 180.0]
    lines = for line in split[s.shown, '\n']
        gui.text[line, size = 13.0]
    if s.shown eq ''
        lines = slice[lines, 0, 0]
    top = gui.row[[field, gui.text[loading_words[s], tone = 'muted']], gap = 10.0]
    gui.column[[top, gui.column[lines, gap = 0.0]], gap = 12.0]

--- ---- what the example shows, as tests/solid/reference.json records ----

fn seen[s, at]
    '{"t": `encode[at]`, "loading": `encode[loading_words[s]]`, "shown": `encode[s.shown]`, "asked": `encode[s.asked]`}'

--- a page 1000 by 900 at `t` ms with no input, as the page hands a frame
fn _page[t]
    json['{"t": `t`, "width": 1000, "height": 900, "ratio": 1, "xr": false, "views": [{"eye": "none", "x": 0, "y": 0, "width": 1000, "height": 900, "projection": [], "camera": []}], "input": [], "pointers": [], "controllers": [], "said": []}']

test json_is_written_two_spaces_a_level[]
    pretty['{"a":1,"b":[],"c":["x","y, z"],"d":{"e":null}}'] eq '{\n  "a": 1,\n  "b": [],\n  "c": [\n    "x",\n    "y, z"\n  ],\n  "d": {\n    "e": null\n  }\n}'
    pretty['{}'] eq '{}'

test only_the_latest_answer_is_shown[]
    s = asked_for[fresh[0.0], '1']
    first = s.latest
    s = asked_for[before[s, 16.0], '12']
    len[s.asks] eq 1
    s.asked eq ['https://swapi.dev/api/people/1/', 'https://swapi.dev/api/people/12/']
    s = heard[s, json['[{"what": "answer", "id": "`first`", "status": 200, "body": "{\\"name\\":\\"Luke\\"}"}]']]
    s.loading
    s = heard[s, json['[{"what": "answer", "id": "`s.latest`", "status": 200, "body": "{\\"name\\":\\"Tarkin\\"}"}]']]
    not s.loading
    s.shown eq '{\n  "name": "Tarkin"\n}'

test words_unchanged_are_not_asked_again[]
    s = asked_for[asked_for[fresh[0.0], ''], '']
    len[s.asked] eq 1

test its_field_is_drawn[]
    shown = gui.show[lory.begin[_page[0.0]], tree[fresh[0.0], 0.0, false]]
    'resource.id' in shown.boxes
