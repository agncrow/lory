--- Solid's Etch A Sketch (solid-site's ethasketch): a square grid 500 px
--- across, as many cells a side as a number field says (10 at first, kept
--- from 0 to 100; a field holding no number shows none and a word
--- instead). The pointer entering a cell paints it a random colour, and
--- 500 ms later that cell is cleared again. In a headset the ray is the
--- pointer: drawn across the grid, it paints each cell it enters.
---
--- Held as the browser holds the example: the random colour is the
--- example's (`#` and a random number below 16777215 written in
--- hexadecimal, not padded, so one of five digits is no colour and paints
--- nothing); each cell's clearing is its own timer, made as it was
--- entered, which clears the cell it was made for even after it was
--- painted again (and nothing, once that cell has gone); a cell kept by
--- the grid's getting smaller keeps its colour (Solid's `Index` keeps
--- the cells it has); the field shows the side as the example sets it
--- (150 becomes 100, -4 becomes 0); and a cell's width is laid as
--- Chrome lays it, to a 64th of a pixel. The random source is seeded.
use memory
use lory
use lory.gui

--- a cell's paint: the cell, the cells' making it belongs to, and its
--- colour (red, green, blue 0 to 255, and opacity)
struct Paint [cell, made, r, g, b, a]

--- a cell's clearing, due at `due`, for the cell of that making
struct Clearing [cell, made, due]

--- the cells made together: from `from` up to `upto`, the making `made`
struct Making [from, upto, made]

--- the side (`known` false where the field holds no number); the field's
--- words as the example sets them; the makings of the cells there are;
--- the paints and the clearings waiting; the cell the pointer is in (-1:
--- none); the random source; how many makings there have been; and
--- whether the page is dark
struct State [side, known, words, makings, paints, clearings, inside, seed, made, dark]

fn _no_paints[]
    slice[[Paint[0, 0, 0, 0, 0, 1.0]], 0, 0]

fn _no_clearings[]
    slice[[Clearing[0, 0, 0.0]], 0, 0]

fn fresh[at]
    State[10.0, true, '10', [Making[0, 100, 1]], _no_paints[], _no_clearings[], -1, 1 + int[floor[at]] % 2147483646, 1, false]

fn seeded[s, seed]
    s.seed = seed
    s

--- the example shown in the page's dark look or its light one
fn themed[s, dark]
    s.dark = dark
    s

--- ---- the random source: x = x * 48271 mod 2147483647, x / 2147483647 ----

fn next_seed[x]
    (x * 48271) % 2147483647

fn unit_of[x]
    x / 2147483647.0

--- ---- the grid ----

--- how many cells there are: the side squared, its whole part, as a list
--- of that length is made
fn count_of[s]
    if not s.known or s.side lte 0.0
        return 0
    int[floor[s.side * s.side]]

--- a cell's width as Chrome lays it: 500 px over the side, cut to a 64th
fn cell_size[s]
    if count_of[s] eq 0
        return 0.0
    floor[500.0 / s.side * 64.0] / 64.0

--- the cells a row holds, as the grid lays them
fn across[s]
    n = count_of[s]
    if n eq 0
        return 0
    int[floor[sqrt[0.0 + n] + 0.5]]

--- where a cell's middle stands in the grid (CSS pixels from its corner)
fn spot[s, cell]
    k = max[1, int[floor[s.side]]]
    size = cell_size[s]
    [(cell % k + 0.5) * size, (cell / k + 0.5) * size]

--- the cell at a point of the grid, -1 where none is
fn cell_at[s, x, y]
    size = cell_size[s]
    k = int[floor[s.side]]
    if size lte 0.0 or x lt 0.0 or y lt 0.0 or k lt 1
        return -1
    col = int[floor[x / size]]
    row = int[floor[y / size]]
    cell = row * k + col
    if col gte k or cell gte count_of[s]
        return -1
    cell

--- the making a cell belongs to (0: no such cell)
fn _made_of[s, cell]
    out = for m in s.makings
        if cell gte m.from and cell lt m.upto
            m.made
    if len[out] eq 0
        return 0
    out[0]

--- the grid of `before` cells made `after`: cells kept where there were
--- some, new ones made past them, and the paints of cells gone dropped
fn _regrown[s, before, after]
    if after lt before
        kept = for m in s.makings
            if m.from lt after
                Making[m.from, min[m.upto, after], m.made]
        s.makings = kept
    if after gt before
        s.made = s.made + 1
        s.makings = push[s.makings, Making[before, after, s.made]]
    paints = for p in s.paints
        if p.cell lt after
            p
    s.paints = paints
    s

--- ---- the field ----

fn _digits[t]
    if t eq ''
        return false
    odd = for ch in split[t, '']
        if not (ch in '0123456789')
            ch
    len[odd] eq 0

--- the number a number field holds, as the browser reads its words (a
--- sign, digits with a point between them, an exponent), or none
struct Reading [known, value]

fn read_number[words]
    t = words
    body = t
    if starts[body, '-']
        body = slice[body, 1, len[body]]
    mantissa = body
    exponent = ''
    if 'e' in lower[body]
        parts = split[replace[body, 'E', 'e'], 'e']
        if len[parts] ne 2
            return Reading[false, 0.0]
        mantissa = parts[0]
        exponent = parts[1]
        if starts[exponent, '-'] or starts[exponent, '+']
            exponent = slice[exponent, 1, len[exponent]]
        if not _digits[exponent]
            return Reading[false, 0.0]
    whole = mantissa
    part = ''
    if '.' in mantissa
        halves = split[mantissa, '.']
        if len[halves] ne 2
            return Reading[false, 0.0]
        whole = halves[0]
        part = halves[1]
        if not _digits[part]
            return Reading[false, 0.0]
    if whole ne '' and not _digits[whole]
        return Reading[false, 0.0]
    if whole eq '' and part eq ''
        return Reading[false, 0.0]
    v = float[t]
    if not v.ok
        return Reading[false, 0.0]
    Reading[true, v]

--- a number written as JavaScript writes it into a field
fn written[v]
    if v eq floor[v]
        return '`int[v]`'
    '`v`'

--- the side taken from the field's words: none where they are no number,
--- else kept from 0 to 100; the field's words set anew where the side
--- changed (a side of no number always changes, as it equals nothing)
fn _sided[s, words]
    got = read_number[words]
    before = count_of[s]
    changed = true
    if got.known
        v = min[max[got.value, 0.0], 100.0]
        changed = not s.known or v ne s.side
        s.known = true
        s.side = v
    else
        s.known = false
    if changed
        s.words = ''
        if s.known
            s.words = written[s.side]
        gui.focus['sketch.side', s.words]
    _regrown[s, before, count_of[s]]

--- ---- painting ----

fn _hex_value[ch]
    digits = split['0123456789abcdef', '']
    out = for i in range[16]
        if digits[i] eq ch
            i
    out[0]

--- a colour the example writes, as the browser reads it: three, four or
--- six hexadecimal digits are one; any other number of them is none
struct Hue [known, r, g, b, a]

fn color_of[hex]
    chars = split[hex, '']
    n = len[chars]
    if n eq 6
        return Hue[true, _hex_value[chars[0]] * 16 + _hex_value[chars[1]], _hex_value[chars[2]] * 16 + _hex_value[chars[3]], _hex_value[chars[4]] * 16 + _hex_value[chars[5]], 1.0]
    if n eq 3 or n eq 4
        a = 1.0
        if n eq 4
            a = (_hex_value[chars[3]] * 17) / 255.0
        return Hue[true, _hex_value[chars[0]] * 17, _hex_value[chars[1]] * 17, _hex_value[chars[2]] * 17, a]
    Hue[false, 0, 0, 0, 1.0]

--- a number written in hexadecimal, as JavaScript's `toString(16)`
fn hex_of[n]
    if n eq 0
        return '0'
    digits = split['0123456789abcdef', '']
    out = ''
    k = n
    while k gt 0
        out = '`digits[k % 16]``out`'
        k = k / 16
    out

--- the cell entered at `at`: painted the random colour (where it is one),
--- and its clearing set for 500 ms on
fn _entered[s, cell, at]
    s.seed = next_seed[s.seed]
    hex = hex_of[int[floor[unit_of[s.seed] * 16777215.0]]]
    k = color_of[hex]
    made = _made_of[s, cell]
    if k.known
        kept = for p in s.paints
            if p.cell ne cell
                p
        s.paints = push[kept, Paint[cell, made, k.r, k.g, k.b, k.a]]
    s.clearings = push[s.clearings, Clearing[cell, made, at + 500.0]]
    s

--- the clearings due by `at`, in the order they were set: each clears
--- its cell where that cell is still the one it was set for
fn before[s, at]
    due = for w in s.clearings
        if w.due lte at
            w
    if len[due] eq 0
        return s
    waiting = for w in s.clearings
        if w.due gt at
            w
    s.clearings = waiting
    for w in due
        kept = for p in s.paints
            if not (p.cell eq w.cell and p.made eq w.made)
                p
        s.paints = kept
    s

--- the pointer's way across the grid this frame: each cell it enters is
--- painted
fn _crossed[s, shown, at]
    if not ('sketch.grid' in shown.boxes)
        s.inside = -1
        return s
    b = shown.boxes['sketch.grid']
    c = shown.canvas
    k = lory.px[c]
    xs = slice[[0.0], 0, 0]
    ys = slice[[0.0], 0, 0]
    for e in lory.events[c]
        if e.on eq 'move' or e.on eq 'down' or e.on eq 'up'
            xs = push[xs, e.x / k]
            ys = push[ys, e.y / k]
    if lory.pointing[c]
        xs = push[xs, lory.pointer_x[c] / k]
        ys = push[ys, lory.pointer_y[c] / k]
    else
        xs = push[xs, -1.0]
        ys = push[ys, -1.0]
    i = 0
    while i lt len[xs]
        cell = -1
        if xs[i] gte b[0] and ys[i] gte b[1] and xs[i] lt b[0] + b[2] and ys[i] lt b[1] + b[3]
            cell = cell_at[s, xs[i] - b[0], ys[i] - b[1]]
        if cell ne s.inside
            s.inside = cell
            if cell gte 0
                s = _entered[s, cell, at]
        i = i + 1
    s

fn after[s, shown, at]
    for e in shown.events
        if e.id eq 'sketch.side' and e.act eq 'edit'
            s = _sided[s, e.words]
    _crossed[s, shown, at]

--- ---- drawn ----

--- the cells' edge colour: near black, near white on a dark page
fn edge_of[s]
    if s.dark
        return [239, 239, 239]
    [31, 31, 31]

--- the grid as its painter reads it (kept in process memory as the tree
--- is made, since a painter is handed only numbers and words): the cells
--- a row holds, a cell's width, the edge's colour and the paints
struct Grid [across, size, edge, paints]

fn _grid_of[s]
    Grid[across[s], cell_size[s], edge_of[s], s.paints]

fn _no_grid[]
    Grid[0, 0.0, [0, 0, 0], _no_paints[]]

--- the grid drawn: each painted cell its colour, and the lines between
--- the cells in the edge's colour
fn gridded[d]
    g = recall['solid sketch', _no_grid[]]
    n = g.across
    size = g.size * d.s
    edge = lory.rgb[0.0 + g.edge[0], 0.0 + g.edge[1], 0.0 + g.edge[2]]
    if n gt 0
        for p in g.paints
            x = d.x + (p.cell % n) * size
            y = d.y + (p.cell / n) * size
            d.c = lory.rect[d.c, x, y, size, size, lory.rgba[0.0 + p.r, 0.0 + p.g, 0.0 + p.b, p.a]]
        wide = n * size
        for j in range[n + 1]
            d.c = lory.rect[d.c, d.x + j * size - 0.5 * d.s, d.y, 1.0 * d.s, wide, edge]
            d.c = lory.rect[d.c, d.x, d.y + j * size - 0.5 * d.s, wide, 1.0 * d.s, edge]
    d

fn tree[s, at, dark]
    field = gui.row[[gui.label['Grid side length'], gui.sized[gui.field['sketch.side', s.words, kind = 'number'], 120.0]]]
    remember['solid sketch', _grid_of[s]]
    grid = gui.drawn['sketch.grid', 0.0, 500.0, 500.0, gridded]
    if count_of[s] eq 0
        grid = gui.text['Input a grid side length.']
    gui.column[[field, grid], gap = 12.0]

--- ---- what the example shows, as tests/solid/reference.json records ----

--- an opacity as the browser writes it: the fewest places, up to three,
--- that keep its 255ths
fn _alpha_text[a]
    k = int[floor[a * 255.0 + 0.5]]
    two = floor[a * 100.0 + 0.5] / 100.0
    if int[floor[two * 255.0 + 0.5]] eq k
        return '`two`'
    '`floor[a * 1000.0 + 0.5] / 1000.0`'

fn css_color[p]
    if p.a lt 1.0
        return 'rgba(`p.r`, `p.g`, `p.b`, `_alpha_text[p.a]`)'
    'rgb(`p.r`, `p.g`, `p.b`)'

fn seen[s, at]
    n = count_of[s]
    painted = slice[[''], 0, 0]
    cells = for p in s.paints
        p.cell
    for cell in sort[cells]
        for p in s.paints
            if p.cell eq cell
                painted = push[painted, '[`cell`, `encode[css_color[p]]`]']
    colored = join[painted, ', ']
    size = cell_size[s]
    wide = size * across[s]
    fallback = ''
    outline = ''
    if n eq 0
        fallback = 'Input a grid side length.'
    else
        e = edge_of[s]
        outline = 'rgb(`e[0]`, `e[1]`, `e[2]`)'
    '{"t": `encode[at]`, "side": `encode[s.words]`, "cells": `n`, "size": `encode[size]`, "wide": `encode[wide]`, "colored": [`colored`], "fallback": `encode[fallback]`, "outline": `encode[outline]`}'

--- a page 1000 by 900 at `t` ms with no input, as the page hands a frame
fn _page[t]
    json['{"t": `t`, "width": 1000, "height": 900, "ratio": 1, "xr": false, "views": [{"eye": "none", "x": 0, "y": 0, "width": 1000, "height": 900, "projection": [], "camera": []}], "input": [], "pointers": [], "controllers": [], "said": []}']

test a_cell_is_laid_as_chrome_lays_it[]
    s = fresh[0.0]
    cell_size[s] eq 50.0
    s.side = 3.0
    cell_size[s] eq 166.65625
    across[s] eq 3

test a_number_field_reads_as_the_browser_reads_it[]
    read_number['150'].value eq 150.0
    read_number['-4'].value eq -4.0
    read_number['.5'].known
    read_number['1e2'].value eq 100.0
    not read_number[''].known
    not read_number['5.'].known
    not read_number['-'].known

test a_colour_of_five_digits_is_none[]
    not color_of['4789c'].known
    color_of['11f97a'].g eq 249
    color_of['abc'].r eq 170
    css_color[Paint[0, 0, 170, 187, 204, (13 * 17) / 255.0]] eq 'rgba(170, 187, 204, 0.867)'
    hex_of[255] eq 'ff'

test a_cells_clearing_clears_the_cell_it_was_set_for[]
    s = seeded[fresh[0.0], 777]
    s = _entered[s, 1, 0.0]
    s = _entered[s, 1, 100.0]
    len[s.clearings] eq 2
    s = before[s, 500.0]
    len[s.paints] eq 0
    len[s.clearings] eq 1

test its_grid_is_drawn[]
    shown = gui.show[lory.begin[_page[0.0]], tree[fresh[0.0], 0.0, false]]
    shown.boxes['sketch.grid'][2] eq 500.0

test the_pointer_paints_a_cell_it_enters[]
    s = seeded[fresh[0.0], 777]
    shown = gui.show[lory.begin[_page[0.0]], tree[s, 0.0, false]]
    s = after[s, shown, 0.0]
    s.inside eq -1
