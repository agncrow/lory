--- Lit's playground, Template concepts, drawn by Lory: the kinds of
--- expression a template holds, a branch, a list, children slotted into a
--- component, components made of components, and templates made of
--- smaller templates.
---
--- Where Lit's expression stands decides what it binds (a child, an
--- attribute, a boolean attribute, a property, an event). In Lory each is
--- an argument of the control it belongs to: words are a text's, `?disabled`
--- is `gui.disabled`, `.valueAsNumber` is a field's value, `@click` is the
--- example's answer to the button's `press`. A slot is a component's
--- `kids`; a template made of templates is a function calling functions.

use lory
use lory.gui
use shared

--- ---- Expression types ----

--- each kind of expression in turn: words, an attribute (an ARIA label,
--- which a canvas has no reader for), a boolean attribute turning a field
--- off, a property setting a number field, and an event: Click turns the
--- field off and on again
fn expressions_view[s, t]
    editing = not shared.flag_of[s, 'not-editing']
    typed = gui.sized[gui.field['expr-text', shared.words_of[s, 'expr-text', '']], 200.0]
    if not editing
        typed = gui.disabled[typed]
    number = gui.sized[gui.field['expr-number', shared.words_of[s, 'expr-number', '7'], kind = 'number'], 120.0]
    gui.column[[gui.text['Child expression: Text in child expression.'], gui.text['Attribute expression.'], gui.row[[gui.text['Boolean attribute expression.'], typed]], gui.row[[gui.text['Property expression.'], number]], gui.row[[gui.text['Event listener expression.'], gui.button['expr-click', 'Click']]]]]

fn expressions_answered[s, e, t]
    if e.id eq 'expr-click' and e.act eq 'press'
        return shared.set_flag[s, 'not-editing', not shared.flag_of[s, 'not-editing']]
    if (e.id eq 'expr-text' or e.id eq 'expr-number') and e.act eq 'edit'
        return shared.set_words[s, e.id, e.words]
    s

--- ---- Conditional templates ----

--- one of two paragraphs, as a condition the button turns says
fn templates_conditional_view[s, t]
    shown = 'Render some HTML if condition is true.'
    if shared.flag_of[s, 'false']
        shown = 'Render some other HTML if condition is false.'
    gui.column[[gui.text['Render content conditionally:'], gui.text[shown], gui.button['cond-toggle', 'Toggle condition']]]

fn templates_conditional_answered[s, e, t]
    if e.id eq 'cond-toggle' and e.act eq 'press'
        return shared.set_flag[s, 'false', not shared.flag_of[s, 'false']]
    s

--- ---- Repeating templates ----

--- a list of three, each entry its place and its words
fn repeating_view[s, t]
    rows = [gui.text['Render a list:']]
    items = ['Peas', 'Carrots', 'Tomatoes']
    i = 0
    while i lt len[items]
        rows = push[rows, shared.entry[[gui.text['`i`: `items[i]`']]]]
        i = i + 1
    gui.column[rows]

--- ---- Slotting children ----

--- children handed to a component, each drawn in the slot's look (a blue
--- edge and 6 pixels inside it, `::slotted(*)`): one child, then three
fn slotting_view[s, t]
    one = _slotted[['Render me'], 'slot-1']
    three = _slotted[['Render me', 'Me too', 'Me three'], 'slot-2']
    gui.column[[gui.text['Use the slot element to render children'], one, gui.text['Arbitarily many  children may populate a single slot'], three]]

--- the component: its slot, and what was slotted into it
fn _slotted[children, name]
    kids = []
    i = 0
    while i lt len[children]
        kids = push[kids, shared.inked['', children[i], 'name=`name`-`i`;border=#0000ff;line=1;pad=6;block=1']]
        i = i + 1
    gui.column[kids, gap = 16.0]

--- ---- Element composition ----

--- a page made of three components: a header, an article, a footer
fn element_composition_view[s, t]
    gui.column[[_header['Element composition'], _article['Manage complexity by building large, complex components out of smaller, simpler components that do one thing well.'], gui.space[40.0], shared.inked['', 'THE END', 'name=footer;align=center;block=1']]]

fn _header[words]
    shared.inked['', words, 'name=title;tag=h1;size=32;weight=700;align=center;block=1']

--- (its padding told to the tests by a mark of no size that names it)
fn _article[words]
    pad = 20.0
    gui.column[[shared.inked['', '', 'name=article;pad=`pad`;wide=0;tall=0'], gui.text[words]], pad = pad]

--- ---- Template composition ----

--- a page whose template is two smaller ones, each a function of the
--- article it shows
fn template_composition_view[s, t]
    gui.column[[_header['Template composition'], gui.text['Defining partial templates as instance methods breaks the template into manageable pieces—and allows a subclass to override individual parts of the template.']]]

--- the part's trees shown on a canvas
fn shown_on[c, s, t]
    gui.show[c, expressions_view[s, t]]
