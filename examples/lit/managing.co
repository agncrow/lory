--- Lit's playground, Managing Data, drawn by Lory: a task that fetches
--- a package's facts from npm (@lit/task), context handed down without
--- being passed through every component (@lit/context), and a count kept
--- in a signal and shown by every instance (@lit-labs/signals).
---
--- A task is the example's state: its status (initial, pending, complete
--- or error), the run it is on and what it answered; the request goes out
--- through `lory.request` and its answer comes back in a frame's `said`.
--- Context is a value handed to the functions below the one that holds
--- it. A signal is one value of the example's state that every instance
--- reads.

use lory
use lory.gui
use shared

--- ---- Async Tasks ----

--- npm's registry, where the task fetches a package's facts
fn registry[name]
    'https://registry.npmjs.org/`name`'

--- the name typed in, the name the task ran for, and what its status
--- shows: initial (no name), pending (a second's delay and the fetch),
--- complete (the package's description and its tags) or an error
fn async_task_view[s, t]
    name = shared.words_of[s, 'name', 'lit']
    typed = shared.words_of[s, 'typed', name]
    status = task_status[s]
    shown = [gui.text['Enter a package name to display its npm info']]
    if status eq 'pending'
        shown = [gui.text['Loading npm info for `name`']]
    if status eq 'error'
        shown = [shared.inked['', 'Error:', 'name=task-error;color=#ff0000']]
    if status eq 'complete'
        shown = _package_shown[shared.words_of[s, 'answer', '{}']]
    rows = [gui.row[[gui.text['Enter a package name:'], gui.sized[gui.field['task-name', typed], 200.0]]], gui.row[[shared.titled[1, name, '', 'block=0;wide=360'], shared.inked['', '', 'name=task-logo;wide=60;tall=38;bg=#cb3837']], justify = 'between']]
    for n in shown
        rows = push[rows, n]
    gui.panel[rows]

--- what the task is doing: `initial` with no name, else `pending` until
--- its answer is in, then `complete` or `error`
fn task_status[s]
    shared.words_of[s, 'status', 'pending']

--- the package's facts as npm answers them: its description, and a line
--- for each of its tags with the version it names
fn _package_shown[body]
    j = json[body]
    if not j.ok
        return [gui.text['']]
    rows = [shared.titled[3, '`j.description`', '', ''], shared.titled[4, 'dist-tags:', '', '']]
    tags = j['dist-tags']
    if not tags.ok
        return rows
    for tag in keys[tags]
        version = tags[tag]
        rows = push[rows, shared.entry[[gui.text['`tag`: `version`']]]]
    rows

--- the request the task waits to make (its id and address), or none: a
--- run's request goes out a second after it began, once
fn task_request[s, t]
    if task_status[s] ne 'pending' or shared.flag_of[s, 'asked']
        return ['', '']
    if t lt shared.number_of[s, 'since'] + 1000.0
        return ['', '']
    run = int[shared.number_of[s, 'run']]
    ['task-`run`', registry[shared.words_of[s, 'name', 'lit']]]

--- the task after its request went out
fn task_asked[s]
    shared.set_flag[s, 'asked', true]

--- the task after an answer: the one of its current run completes it
--- (or fails it, any status but 200); an older run's is ignored, as an
--- aborted run's is
fn task_heard[s, id, status, body]
    run = int[shared.number_of[s, 'run']]
    if id ne 'task-`run`' or task_status[s] ne 'pending'
        return s
    if status eq 200
        s = shared.set_words[s, 'answer', body]
        return shared.set_words[s, 'status', 'complete']
    shared.set_words[s, 'status', 'error']

fn async_task_answered[s, e, t]
    name = shared.words_of[s, 'name', 'lit']
    if e.id eq 'task-name' and e.act eq 'edit'
        return shared.set_words[s, 'typed', e.words]
    if e.id eq 'task-name' and e.act eq 'submit'
        typed = shared.words_of[s, 'typed', name]
        if typed eq name
            return s
        s = shared.set_words[s, 'name', typed]
        s = shared.set_number[s, 'run', shared.number_of[s, 'run'] + 1.0]
        s = shared.set_flag[s, 'asked', false]
        if typed eq ''
            return shared.set_words[s, 'status', 'initial']
        s = shared.set_number[s, 'since', t]
        return shared.set_words[s, 'status', 'pending']
    s

--- ---- Context Basics ----

--- two providers, each handing its data to the consumer inside it
fn context_basics_view[s, t]
    gui.column[[shared.titled[3, 'Basic Context Example', '', ''], gui.text['The <consumer-el> receives its data from <provider-el> without property drilling.'], shared.rule[], _provider['Initial'], shared.rule[], _provider['specified from attribute'], shared.rule[], gui.text['Checkout our Context documentation!']]]

--- a provider: its data shown, and handed to what is slotted in it
fn _provider[data]
    gui.panel[[shared.titled[3, 'Provider\'s data: `data`', '', ''], gui.panel[[_consumer[data]]]]]

--- a consumer: the data of the provider nearest above it
fn _consumer[data]
    shared.titled[3, 'Consumer data: `data`', '', '']

--- ---- Context Consume and Provide ----

--- sections that each provide one more than the level they were given: a
--- heading takes its tag (h1 to h5) and colour from the level of the
--- section it stands in
fn context_provide_view[s, t]
    rows = [gui.text['Example inspired by: https://react.dev/learn/passing-data-deeply-with-context']]
    levels = [0, 1, 1, 2, 2, 3, 1, 2, 3, 3, 0, 1, 2, 3, 4, 1, 2, 3]
    colours = ['#0000ff', '#ffa500', '#008000', '#800080']
    i = 0
    while i lt len[levels]
        level = levels[i]
        rows = push[rows, shared.titled[level + 1, 'Heading level `level + 1`', 'ctx-`i`', 'color=`colours[level % 4]`;align=center']]
        i = i + 1
    gui.column[rows]

--- ---- Signals ----

--- two instances of a counter whose count is one signal: either's
--- Increment shows in both
fn signals_view[s, t]
    count = int[shared.number_of[s, 'count']]
    gui.column[[_counter['Instance 1', 'sig-inc-1', count], _counter['Instance 2', 'sig-inc-2', count]]]

fn _counter[title, id, count]
    gui.panel[[shared.titled[2, title, '', ''], gui.text['count = `count`'], gui.button[id, 'Increment']]]

fn signals_answered[s, e, t]
    if e.act eq 'press' and (e.id eq 'sig-inc-1' or e.id eq 'sig-inc-2')
        return shared.set_number[s, 'count', shared.number_of[s, 'count'] + 1.0]
    s

--- the part's trees shown on a canvas
fn shown_on[c, s, t]
    gui.show[c, signals_view[s, t]]
