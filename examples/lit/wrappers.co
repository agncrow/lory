--- Lit's playground, @lit/react, drawn by Lory: a Lit element used from
--- React with a property set, events listened to, children projected into
--- named slots, and an element driven through a ref.
---
--- @lit/react is a wrapper that turns React's props into an element's
--- properties and its events into React's callbacks. Lory has no DOM and
--- no second framework to wrap for: the "element" is a function and the
--- "React app" is the example that calls it, its props the arguments, its
--- events the events the example answers. What each example shows is
--- kept: the greeting, the roulette and its messages, the slots' order,
--- the player played and paused from outside.

use math
use memory
use lory
use lory.gui
use shared

--- ---- Basics ----

--- `<DemoGreeting name="React" />`: the greeting in a boxed paragraph
fn react_basics_view[s, t]
    gui.column[[shared.inked['', 'Hello, React!', 'name=react-greeting;border=#808080;line=1;bg=#ffffff;color=#000000;pad=16'], gui.text['Checkout our React framework docs!']]]

--- ---- React events ----

--- a roulette loaded with a number from 1 to 6: Click counts, and fires
--- (and is off) when the count reaches it; Reset loads it again. The app
--- shows its message by the two events the element sends, pop and reset.
fn react_events_view[s, t]
    count = int[shared.number_of[s, 'count']]
    fired = shared.flag_of[s, 'fired']
    click = gui.button['roulette-click', 'Click']
    if fired
        click = gui.disabled[click]
    message = '😬'
    if shared.flag_of[s, 'popped']
        message = '🎉'
    gui.column[[shared.titled[1, 'Let\'s play Click Roulette!', '', ''], gui.panel[[gui.text['Clicked: `count`'], gui.row[[click, gui.button['roulette-reset', 'Reset']]]]], gui.text[message]]]

--- the roulette as it opens: loaded from its first chance
fn react_events_opened[s]
    drawn = shared.chance[s]
    shared.set_number[drawn.s, 'loaded', floor[drawn.value * 6.0] + 1.0]

fn react_events_answered[s, ev, t]
    if ev.id eq 'roulette-click' and ev.act eq 'press'
        if shared.flag_of[s, 'fired']
            return s
        count = shared.number_of[s, 'count'] + 1.0
        s = shared.set_number[s, 'count', count]
        if count eq shared.number_of[s, 'loaded']
            s = shared.set_flag[s, 'fired', true]
            return shared.set_flag[s, 'popped', true]
        return s
    if ev.id eq 'roulette-reset' and ev.act eq 'press'
        s = shared.set_number[s, 'count', 0.0]
        s = shared.set_flag[s, 'fired', false]
        s = shared.set_flag[s, 'popped', false]
        return react_events_opened[s]
    s

--- ---- Slots ----

--- children projected by their slot names: the head slot's, the default
--- slot's (those with no name), then the tail slot's two, in the order the
--- app gave them
fn react_slots_view[s, t]
    head = gui.panel[[gui.text['This element will be projected onto the "head" slot.']]]
    middle = gui.panel[[gui.text['Elements without a slot attribute will be projected onto the default slot.']]]
    tail = gui.panel[[gui.text['This element will be projected onto the "tail" slot.'], gui.text['React Components must be a descendant of an element with a slot attribute otherwise they will be projected onto the default slot.']]]
    gui.panel[[gui.text['slot="head"'], head, gui.text['default slot'], middle, gui.text['slot="tail"'], tail]]

--- ---- Refs ----

--- a player of flying triangles that keeps its own state (playing or not),
--- driven from outside by play and pause through a ref, and telling its
--- state back by an event the app shows in its buttons; a press on the
--- player plays or pauses it too
fn react_refs_view[s, t]
    playing = shared.flag_of[s, 'playing']
    hint = 'click to play'
    on = 0.0
    if playing
        hint = 'click to pause'
        on = 1.0
    play = gui.button['tri-play', 'play']
    pause = gui.button['tri-pause', 'pause']
    if playing
        play = gui.disabled[play]
    else
        pause = gui.disabled[pause]
    gui.column[[gui.drawn['tri-canvas', on, 300.0, 300.0, _triangles_painted, 0.0, 1.0, 'name=tri-canvas|`hint`'], gui.row[[play, pause]]]]

fn react_refs_answered[s, ev, t]
    playing = shared.flag_of[s, 'playing']
    if ev.act ne 'press'
        return s
    if ev.id eq 'tri-play'
        return shared.set_flag[s, 'playing', true]
    if ev.id eq 'tri-pause'
        return shared.set_flag[s, 'playing', false]
    if ev.id eq 'tri-canvas'
        return shared.set_flag[s, 'playing', not playing]
    s

--- three triangles wandering over a gray ground, their headings turning
--- with the time (a wander of Lory's own: what is held is the player's
--- state, not its pictures), and the hint over them
fn _triangles_painted[d]
    s = d.s
    c = d.c
    c = lory.rect[c, d.x, d.y, d.w, d.h, lory.hex['#343434']]
    c = lory.rect[c, d.x + 5.0 * s, d.y + 5.0 * s, d.w - 10.0 * s, d.h - 10.0 * s, lory.hex['#dedede']]
    clock = recall['lory_lit/triangles', shared.Box[0.0, 0.0, 0.0, 0.0]]
    now_at = lory.time[c]
    if d.num gt 0.5 and clock.w gt 0.0
        clock.x = clock.x + min[100.0, now_at - clock.y]
    clock.y = now_at
    clock.w = 1.0
    remember['lory_lit/triangles', clock]
    k = 0.0
    while k lt 3.0
        a = clock.x / (900.0 + 300.0 * k) + 2.1 * k
        x = d.x + d.w * (0.5 + 0.35 * cos[a * (1.0 + 0.2 * k)])
        y = d.y + d.h * (0.5 + 0.35 * sin[a * (1.3 - 0.1 * k)])
        r = 10.0 * s
        c = lory.triangle[c, x, y + r, x - r, y - r, x + r, y - r, lory.hex['#8fa3dc']]
        k = k + 1.0
    hint = split[d.words, '|'][1]
    c = lory.text_centered[c, d.x + d.w / 2.0, d.y + d.h / 2.0, hint, 15.0 * s, lory.Color[0.0, 0.0, 0.0, 0.4]]
    d.c = c
    if d.pressed
        return gui.tell[d, 'press', '', 0.0]
    d

fn _painters_known[]
    _triangles_painted[shared.blank_drawn[]]

--- the part's trees shown on a canvas
fn shown_on[c, s, t]
    gui.show[c, react_refs_view[s, t]]
