--- Small apps: twenty small programs in three groups (Basics, Everyday
--- apps and Classic tasks), a menu of them and beside it the one chosen,
--- drawn by Lory and answering the reader. Each app is a module beside
--- this one (gallery.co says what each has).
---
---     crow build --target web main.co
use sys
use lory
use lory.gui
use gallery

fn draw[frame]
    shown = gallery.framed[frame]
    lory.end[shown.canvas]

sys.frames[draw]

fn screen[t, given]
    json['{"t": `t`, "width": 1100, "height": 800, "ratio": 1, "xr": false, "views": [{"eye": "none", "x": 0, "y": 0, "width": 1100, "height": 800, "projection": [], "camera": []}], "input": `given`, "pointers": [], "controllers": [], "said": []}']

fn press_at[x, y]
    '[{"type": "down", "device": "mouse", "id": 1, "x": `x`, "y": `y`, "button": 0}, {"type": "up", "device": "mouse", "id": 1, "x": `x`, "y": `y`, "button": 0}]'

test the_menu_holds_the_twenty_apps_in_three_groups[]
    first = gallery.framed[screen[0, '[]']]
    count = 0
    for slug in gallery.order[]
        if 'menu:`slug`' in first.boxes
            count = count + 1
    count eq len[gallery.order[]]

test a_press_in_the_menu_starts_the_example_pressed[]
    first = gallery.framed[screen[0, '[]']]
    b = first.boxes['menu:counter']
    gallery.framed[screen[10, press_at[b[0] + 10.0, b[1] + 10.0]]]
    gallery.chosen[] eq 'counter'
    shown = gallery.framed[screen[20, '[]']]
    button = shown.boxes['counter:count']
    gallery.framed[screen[30, press_at[button[0] + 5.0, button[1] + 5.0]]]
    seen = gallery.seen_now[shown.canvas]
    seen['count'] eq '1'
