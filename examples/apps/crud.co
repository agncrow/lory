--- CRUD: names (surname, then name) in a list filtered by the start of
--- the surname; the one chosen fills the fields, and Create, Update and
--- Delete change the list as the fields say.
use lory
use lory.gui
use common

struct Crud [names, selected, prefix, first, last]

fn fresh[]
    Crud[['Emil, Hans', 'Mustermann, Max', 'Tisch, Roman'], '', '', '', '']

fn ticked[s, c]
    s

--- the names whose start is the prefix (in either case)
fn filtered[s]
    want = lower[s.prefix]
    out = slice[[''], 0, 0]
    for n in s.names
        if starts[lower[n], want]
            out = push[out, n]
    out

fn controls[s, c, room]
    rows = slice[[gui.space[0.0]], 0, 0]
    for n in filtered[s]
        rows = push[rows, gui.item['crud:names:`n`', [gui.text[n]], chosen = n eq s.selected, words = n]]
    list = common.named[gui.sized[gui.panel[[gui.scroll['crud:list', 5.0 * 32.0 + 4.0 * 2.0, rows]], gap = 0.0, pad = 2.0], 224.0], 'crud:names']
    fields = gui.column[[gui.row[[gui.sized[gui.text['Name:'], 70.0], gui.field['crud:first', s.first]], gap = 8.0], gui.row[[gui.sized[gui.text['Surname:'], 70.0], gui.field['crud:last', s.last]], gap = 8.0]], gap = 10.0]
    buttons = gui.row[[gui.button['crud:create', 'Create'], gui.button['crud:update', 'Update'], gui.button['crud:delete', 'Delete']], gap = 6.0]
    gui.column[[gui.sized[gui.field['crud:prefix', s.prefix, hint = 'Filter prefix'], 224.0], gui.row[[list, fields], gap = 16.0, align = 'start'], buttons], gap = 12.0]

--- the choice changed: the fields filled from it (the surname before
--- ', ', the name after it: a name of no ', ' fills the surname alone)
fn _chosen[s, name]
    if name eq s.selected
        return s
    s.selected = name
    parts = split[name, ', ']
    s.last = parts[0]
    s.first = ''
    if len[parts] gt 1
        s.first = parts[1]
    s

fn _valid[s]
    trim[s.first] ne '' and trim[s.last] ne ''

fn _place[names, name]
    i = 0
    while i lt len[names]
        if names[i] eq name
            return i
        i = i + 1
    -1

fn handled[s, shown, c]
    for ev in shown.events
        if ev.id eq 'crud:prefix' and ev.act eq 'edit'
            s.prefix = ev.words
        if ev.id eq 'crud:first' and ev.act eq 'edit'
            s.first = ev.words
        if ev.id eq 'crud:last' and ev.act eq 'edit'
            s.last = ev.words
        if starts[ev.id, 'crud:names:'] and ev.act eq 'press'
            s = _chosen[s, ev.words]
        if ev.id eq 'crud:create' and ev.act eq 'press' and _valid[s]
            whole = '`s.last`, `s.first`'
            if not (whole in s.names)
                s.names = push[s.names, whole]
                s.first = ''
                s.last = ''
        if ev.id eq 'crud:update' and ev.act eq 'press' and _valid[s] and s.selected ne ''
            i = _place[s.names, s.selected]
            whole = '`s.last`, `s.first`'
            if i gte 0
                names = s.names
                names[i] = whole
                s.names = names
            s = _chosen[s, whole]
        if ev.id eq 'crud:delete' and ev.act eq 'press' and s.selected ne ''
            i = _place[s.names, s.selected]
            --- (a name not in the list takes the last away)
            if i lt 0
                i = len[s.names] - 1
            if i gte 0
                kept = slice[[''], 0, 0]
                j = 0
                while j lt len[s.names]
                    if j ne i
                        kept = push[kept, s.names[j]]
                    j = j + 1
                s.names = kept
            s.selected = ''
            s.first = ''
            s.last = ''
    s

fn seen[s, tree]
    out = map['' = '']
    list = common.node_by[tree, 'crud:names']
    shown = slice[[''], 0, 0]
    picked = ''
    for n in common.nodes_of[list]
        if n.tag eq 'item'
            shown = push[shown, n.words]
            if n.num gt 0.5
                picked = n.words
    out['names'] = join[shown, '\n']
    out['selected'] = picked
    out['first'] = common.words_by[tree, 'crud:first']
    out['last'] = common.words_by[tree, 'crud:last']
    out['prefix'] = common.words_by[tree, 'crud:prefix']
    out

--- (a tree shown here, though nothing calls this, lets Crow type the
--- painters this module hands to gui: a function held in a node is typed
--- where a call reaches it, and in a module imported by the one that
--- shows the page no call does)
fn _painters_typed[frame]
    gui.show_at[lory.begin[frame], gui.space[0.0], 0.0, 0.0, 10.0, gui.light[]]
