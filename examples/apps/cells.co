--- Spreadsheet: a sheet of 5 columns (A to E) and 20 rows (0 to 19). A cell
--- shows its words, or what its formula (`=` and an expression over
--- other cells, formulas.co) comes to; pressed, it becomes a field holding what was written
--- in it, entered (trimmed) by Enter or by the focus leaving it. Its tip
--- is what was written in it. The rows scroll under the column heads.
use lory
use lory.gui
use common
use formulas

--- what is written in each cell (by column, then row), what each shows,
--- the cell being written in ('' for none, else its name) and what its
--- field holds
struct Cells [written, shown, editing, draft]

fn _blank_sheet[]
    out = slice[[['']], 0, 0]
    c = 0
    while c lt formulas.columns[]
        col = slice[[''], 0, 0]
        r = 0
        while r lt formulas.rows[]
            col = push[col, '']
            r = r + 1
        out = push[out, col]
        c = c + 1
    out

fn fresh[]
    Cells[_blank_sheet[], _blank_sheet[], '', '']

fn ticked[s, c]
    s

--- a cell's name: its column's letter and its row
fn name_of[col, row]
    '`char[65 + col]``row`'

fn _column_of[name]
    code[slice[name, 0, 1]] - 65

fn _row_of[name]
    n = int[slice[name, 1, len[name]]]
    if not n.ok
        return 0
    n

fn _id[name]
    'cells:cell:`name`'

--- what every cell shows, worked out anew from what is written (each
--- time a cell changes)
fn worked[s]
    out = _blank_sheet[]
    c = 0
    while c lt formulas.columns[]
        col = out[c]
        r = 0
        while r lt formulas.rows[]
            col[r] = formulas.cell_shown[s.written, s.written[c][r]]
            r = r + 1
        out[c] = col
        c = c + 1
    s.shown = out
    s

fn _head_wide[]
    25.0

fn _cell_wide[room]
    max[60.0, (room.wide - _head_wide[]) / 5.0]

fn _head[words, wide]
    gui.sized[gui.panel[[gui.text[words, tone = 'muted']], pad = 4.0], wide]

fn _cell[s, col, row, wide]
    name = name_of[col, row]
    raw = s.written[col][row]
    if s.editing eq name
        return gui.sized[gui.field[_id[name], s.draft], wide]
    words = common.with_id[gui.text[s.shown[col][row]], 'cells:words:`name`']
    if raw ne ''
        words = gui.tip[words, raw]
    gui.sized[gui.item[_id[name], [words], words = s.shown[col][row]], wide]

fn controls[s, c, room]
    wide = _cell_wide[room]
    heads = [_head['', _head_wide[]]]
    col = 0
    while col lt formulas.columns[]
        heads = push[heads, _head['`char[65 + col]`', wide]]
        col = col + 1
    rows = slice[[gui.space[0.0]], 0, 0]
    row = 0
    while row lt formulas.rows[]
        line = [_head['`row`', _head_wide[]]]
        col = 0
        while col lt formulas.columns[]
            line = push[line, _cell[s, col, row, wide]]
            col = col + 1
        rows = push[rows, gui.row[line, gap = 1.0]]
        row = row + 1
    sheet = gui.scroll['cells:sheet', max[120.0, room.tall - 40.0], [gui.column[rows, gap = 1.0]]]
    gui.column[[gui.row[heads, gap = 1.0], sheet], gap = 1.0]

--- the cell written in entered: what its field holds, trimmed, written
--- in it, and the sheet worked out anew
fn entered[s]
    if s.editing eq ''
        return s
    name = s.editing
    written = s.written
    col = written[_column_of[name]]
    col[_row_of[name]] = trim[s.draft]
    written[_column_of[name]] = col
    s.written = written
    s.editing = ''
    s.draft = ''
    worked[s]

fn handled[s, shown, c]
    --- (the field loses the focus to a press outside it or Tab: what it
    --- holds is entered, as its blur enters it)
    if s.editing ne '' and common.left_box[c, common.box_of[shown, _id[s.editing]]]
        s = entered[s]
        gui.unfocus[]
    for ev in shown.events
        if s.editing ne '' and ev.id eq _id[s.editing] and ev.act eq 'edit'
            s.draft = ev.words
        if s.editing ne '' and ev.id eq _id[s.editing] and ev.act eq 'submit'
            s = entered[s]
            gui.unfocus[]
        if starts[ev.id, 'cells:cell:'] and ev.act eq 'press'
            name = slice[ev.id, 11, len[ev.id]]
            if name ne s.editing
                s = entered[s]
                s.editing = name
                s.draft = s.written[_column_of[name]][_row_of[name]]
                gui.focus[ev.id, s.draft]
    s

fn seen[s, tree]
    out = map['' = '']
    shown = slice[[''], 0, 0]
    editing = ''
    row = 0
    while row lt formulas.rows[]
        col = 0
        while col lt formulas.columns[]
            name = name_of[col, row]
            n = common.node_by[tree, _id[name]]
            if n.tag eq 'field'
                editing = name
            else if n.words ne ''
                shown = push[shown, '`name`=`n.words`']
            col = col + 1
        row = row + 1
    out['cells'] = join[shown, '\n']
    out['editing'] = editing
    out

--- (a tree shown here, though nothing calls this, lets Crow type the
--- painters this module hands to gui: a function held in a node is typed
--- where a call reaches it, and in a module imported by the one that
--- shows the page no call does)
fn _painters_typed[frame]
    gui.show_at[lory.begin[frame], gui.space[0.0], 0.0, 0.0, 10.0, gui.light[]]
