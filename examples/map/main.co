--- Lory's map: the world in OpenStreetMap's tiles, and over it shapes of
--- our own (a ring about Paris with its middle cut out, a triangle of
--- three cities, three zones filled by their rank, a dashed road south,
--- a circle of 25 km about London), markers whose popups say what they
--- are (Lima's is a pin of Lory's icons), the cafés of a made-up survey of Tokyo in clusters and a made-up
--- count about Sydney as heat. Drag it and let it go, turn the wheel,
--- double click, press + or - or the arrows, draw a box with Shift, pinch
--- it on a phone; the buttons above it fly it to a city.
use sys
use math
use lory
use lory.gui
use map

--- the shapes drawn over the tiles: GeoJSON written for this example
fn shapes[]
    '{"type": "FeatureCollection", "features": [{"type": "Feature", "id": "ring", "properties": {"name": "A ring about Paris"}, "geometry": {"type": "Polygon", "coordinates": [[[2.20, 48.78], [2.50, 48.78], [2.50, 48.95], [2.20, 48.95], [2.20, 48.78]], [[2.29, 48.83], [2.29, 48.89], [2.40, 48.89], [2.40, 48.83], [2.29, 48.83]]]}}, {"type": "Feature", "id": "triangle", "properties": {"name": "Paris, London and Brussels"}, "geometry": {"type": "Polygon", "coordinates": [[[2.3522, 48.8566], [-0.1278, 51.5074], [4.3517, 50.8503], [2.3522, 48.8566]]]}}]}'

--- three made-up zones east of Paris, each with a rank to be filled by
fn zones[]
    '{"type": "FeatureCollection", "features": [{"type": "Feature", "id": "zone-1", "properties": {"rank": 1}, "geometry": {"type": "Polygon", "coordinates": [[[3.0, 48.6], [3.6, 48.6], [3.6, 49.0], [3.0, 49.0], [3.0, 48.6]]]}}, {"type": "Feature", "id": "zone-2", "properties": {"rank": 2}, "geometry": {"type": "Polygon", "coordinates": [[[3.6, 48.6], [4.2, 48.6], [4.2, 49.0], [3.6, 49.0], [3.6, 48.6]]]}}, {"type": "Feature", "id": "zone-3", "properties": {"rank": 3}, "geometry": {"type": "Polygon", "coordinates": [[[4.2, 48.6], [4.8, 48.6], [4.8, 49.0], [4.2, 49.0], [4.2, 48.6]]]}}]}'

--- a road from Paris to Marseille by Lyon
fn road[]
    '{"type": "LineString", "coordinates": [[2.3522, 48.8566], [4.8357, 45.7640], [5.3698, 43.2965]]}'

--- a city a button flies to: its name, its place and the zoom it is
--- seen at
struct City [name, lat, lng, zoom]

--- the cities the buttons fly to
fn cities[]
    [City['Paris', 48.8566, 2.3522, 9.0], City['London', 51.5074, -0.1278, 9.0], City['Tokyo', 35.6762, 139.6503, 9.0], City['Sydney', -33.8688, 151.2093, 10.0], City['Lima', -12.0464, -77.0428, 11.0]]

--- the map set up: its view, its tiles, its shapes and markers, and the
--- points clustered and spread as heat
fn made[m]
    m = map.at[m, 30.0, 10.0, 2.0]
    m = map.tiles[m, map.openstreetmap[]]
    edge = map.filled[map.stroke[map.style[], '#2f6f8f', 2.0], '#5fb3d4', 0.3]
    m = map.add_geojson[m, 'shapes', shapes[], edge]
    m = map.bind_tooltip[m, 'ring', 'A ring about Paris, its middle cut out']
    m = map.bind_popup[m, 'triangle', 'Paris, London and Brussels: a triangle of three capitals']
    m = map.add_geojson[m, 'zones', zones[], map.filled[map.stroke[map.style[], '#8a4b2a', 1.0], '#cccccc', 0.6]]
    m = map.fill_steps[m, 'zones', 'rank', '#cccccc', [1.0, 2.0, 3.0], ['#fde0c5', '#f59e72', '#d0573b']]
    m = map.add_geojson[m, 'roads', road[], map.dashes[map.stroke[map.style[], '#c0392b', 3.0], 8.0, 6.0]]
    m = map.add_circle[m, 'london-25km', 51.5074, -0.1278, 25000.0, map.filled[map.stroke[map.style[], '#6c3fb5', 2.0], '#9b7fd6', 0.2]]
    m = map.bind_tooltip[m, 'london-25km', '25 km about London']
    m = map.add_marker[m, 'paris', 48.8566, 2.3522, 'Paris. The ring, the triangle and the zones are drawn about it.']
    m = map.add_marker[m, 'london', 51.5074, -0.1278, 'London, in a circle of 25 km']
    m = map.add_marker[m, 'tokyo', 35.6762, 139.6503, 'Tokyo, among the clustered cafés of a made-up survey']
    m = map.add_marker[m, 'sydney', -33.8688, 151.2093, 'Sydney, under the heat of a made-up count']
    m = map.add_point[m, 'markers', 'lima', -12.0464, -77.0428, map.glyph[map.style[], 'map-pin-filled', 30.0, '#d6336c']]
    m = map.bind_popup[m, 'lima', 'Lima, marked by a pin of Lory icons']
    for i in range[80]
        x = 0.0 + i
        m = map.add_point[m, 'cafes', 'cafe-`i`', 35.6762 + sin[x * 2.3] * 0.3 + sin[x * 0.71] * 0.08, 139.6503 + cos[x * 1.7] * 0.4, map.filled[map.circles[map.stroke[map.style[], '#ffffff', 1.0], 6.0], '#e67e22', 0.9]]
    m = map.cluster[m, 'cafes', 60.0]
    for i in range[60]
        x = 0.0 + i
        m = map.add_point[m, 'count', 'count-`i`', -33.8688 + sin[x * 1.1] * 0.15 + sin[x * 0.37] * 0.05, 151.2093 + cos[x * 1.9] * 0.2, map.style[]]
    m = map.heat[m, 'count', 30.0]
    m

--- the row of buttons above the map, and its zoom
fn bar[m]
    buttons = for city in cities[]
        gui.button[city.name, city.name]
    kids = push[buttons, gui.button['World', 'World']]
    gui.row[push[kids, gui.note['zoom `fmt[m.zoom, decimals = 1]`']]]

--- the map flown where a pressed button says
fn flown[m, told]
    if told.act ne 'press'
        return m
    if told.id eq 'World'
        return map.fly_to[m, 30.0, 10.0, 2.0]
    for city in cities[]
        if city.name eq told.id
            return map.fly_to[m, city.lat, city.lng, city.zoom]
    m

--- the page drawn: the buttons, and the map under them filling the rest;
--- the buttons' boxes and what was pressed on them answered
fn page[c]
    c = lory.clear[c, gui.light[].page]
    m = map.of['world']
    if not m.made
        m = made[m]
    s = lory.px[c]
    shown = gui.show_at[c, bar[m], 12.0, 10.0, lory.width[c] / s - 24.0, gui.light[]]
    for told in shown.events
        m = flown[m, told]
    top = 56.0 * s
    shown.canvas = map.show[shown.canvas, m, 0.0, top, lory.width[c], lory.height[c] - top]
    shown

fn draw[frame]
    lory.end[page[lory.begin[frame]].canvas]

sys.frames[draw]

--- a frame 900 by 700 at time `t`, with the input given and what the
--- page said
fn screen[t, given, said]
    lory.begin[json['{"t": `t`, "width": 900, "height": 700, "ratio": 1, "xr": false, "views": [{"eye": "none", "x": 0, "y": 0, "width": 900, "height": 700, "projection": [], "camera": []}], "input": `given`, "pointers": [], "controllers": [], "said": `said`}']]

--- a press and its release at a place
fn press[x, y]
    '[{"type": "down", "device": "mouse", "id": 1, "x": `x`, "y": `y`, "button": 0}, {"type": "up", "device": "mouse", "id": 1, "x": `x`, "y": `y`, "button": 0}]'

test the_world_is_shown_in_openstreetmap_s_tiles[]
    map.forget_map['world']
    shown = page[screen[0.0, '[]', '[]']]
    tiles_at = '=https://tile.openstreetmap.org/2/'
    asked = for a in shown.canvas.asks
        if len[a] gt 2 and a[1] eq '@image' and slice[a[2], 0, len[tiles_at]] eq tiles_at
            1
        else
            0
    sum[asked] gt 8
    m = map.of['world']
    m.zoom eq 2.0
    m.box.y eq 56.0
    m.box.h eq 644.0

test a_button_flies_the_map_to_its_city[]
    map.forget_map['world']
    first = page[screen[0.0, '[]', '[]']]
    b = first.boxes['Tokyo']
    pressed = page[screen[16.0, press[b[0] + b[2] / 2.0, b[1] + b[3] / 2.0], '[]']]
    m = map.of['world']
    m.motion.how eq 'fly'
    m.motion.lat1 eq 35.6762
    landed = page[screen[30000.0, '[]', '[]']]
    m = map.of['world']
    not map.moving[m]
    m.lat eq 35.6762
    m.lng eq 139.6503
    m.zoom eq 9.0

test the_cafes_of_tokyo_are_clustered_and_a_marker_opens_its_popup[]
    map.forget_map['world']
    m = map.keep[map.at[made[map.of['world']], 35.6762, 139.6503, 9.0]]
    first = page[screen[0.0, '[]', '[]']]
    at = map.point_on[map.of['world'], 35.6762, 139.6503]
    pressed = page[screen[16.0, press[at.x, at.y - 20.0], '[]']]
    m = map.of['world']
    m.popup.shown
    m.popup.owner eq 'tokyo'
