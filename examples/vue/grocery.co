--- Simple Component: a numbered list, each entry drawn by a component of
--- its own (here, a function that makes a node from an entry).
use lory
use lory.gui
use common

struct Todo [id, words]

struct Grocery [items]

fn fresh[]
    Grocery[[Todo[0, 'Vegetables'], Todo[1, 'Cheese'], Todo[2, 'Whatever else humans are supposed to eat']]]

fn ticked[s, c]
    s

--- the component: one entry of the list, its number beside it
fn todo_item[todo, place]
    gui.row[[gui.text['`place`.', tone = 'muted'], common.named[gui.text[todo.words], 'simple-component:item:`todo.id`']], gap = 8.0]

fn controls[s, c, room]
    rows = slice[[gui.space[0.0]], 0, 0]
    i = 0
    while i lt len[s.items]
        rows = push[rows, todo_item[s.items[i], i + 1]]
        i = i + 1
    gui.column[rows, gap = 6.0]

fn handled[s, shown, c]
    s

fn seen[s, tree]
    out = map['' = '']
    words = slice[[''], 0, 0]
    for todo in s.items
        words = push[words, common.words_by[tree, 'simple-component:item:`todo.id`']]
    out['items'] = join[words, '\n']
    out

--- (a tree shown here, though nothing calls this, lets Crow type the
--- painters this module hands to gui: a function held in a node is typed
--- where a call reaches it, and in a module imported by the one that
--- shows the page no call does)
fn _painters_typed[frame]
    gui.show_at[lory.begin[frame], gui.space[0.0], 0.0, 0.0, 10.0, gui.light[]]
