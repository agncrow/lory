        return circles.seen[recall['vue.circle-drawer', circles.fresh[]], tree]
    if slug eq 'cells'
        return cells.seen[recall['vue.cells', cells.fresh[]], tree]
    map['' = '']

--- the requests the example asks to be sent, sent (Fetching Data's)
fn _sent[slug, c]
    if slug eq 'fetching-data'
        s = recall['vue.fetching-data', commits.fresh_at[0]]
        for ask in s.asks
            c = lory.request[c, ask[0], 'GET', ask[1], '']
        s.asks = slice[s.asks, 0, 0]
        for address in s.copies
            c = lory.copy[c, address]
        s.copies = slice[s.copies, 0, 0]
        remember['vue.fetching-data', s]
    c

--- the requests Fetching Data has sent, each its name and address
fn asked[]
    s = recall['vue.fetching-data', commits.fresh_at[0]]
    s.sent

--- ---- the page ----

--- the day the Flight Booker starts from: the one given (a test's), or
--- today's in UTC (Crow reads no machine's time zone, where Vue's page
--- takes the reader's own day)
struct Day [words]

fn today_of[c]
    given = recall['vue.today', Day['']]
    if given.words ne ''
        return given.words
    t = '`now[]`'
    slice[t, 0, 10]

--- the day the Flight Booker starts from, given
fn dated[day]
    remember['vue.today', Day[day]]
    day

--- the example chosen
fn chosen[]
    recall['vue.gallery', _fresh[]].chosen

--- the menu: the examples under their groups' names, the chosen one marked
fn _menu[g]
    rows = slice[[gui.space[0.0]], 0, 0]
    group = ''
    for slug in order[]
        if group_of[slug] ne group
            group = group_of[slug]
            rows = push[rows, gui.note[group]]
        rows = push[rows, gui.item['menu:`slug`', [gui.text[title_of[slug]]], chosen = slug eq g.chosen, words = slug]]
    rows

--- the room the page gives the chosen example, in CSS pixels
fn _menu_wide[]
    220.0

fn _header_tall[]
    74.0

fn room_of[c]
    s = lory.px[c]
    wide = lory.width[c] / s - 48.0
    tall = lory.height[c] / s - 48.0
    body = max[320.0, wide - _menu_wide[] - 16.0]
    common.Room[body - 40.0, max[200.0, tall - 40.0 - _header_tall[]]]

--- the whole page: the menu, and beside it the chosen example under its
--- title and a line on what it shows
fn page_of[g, c]
    s = lory.px[c]
    tall = lory.height[c] / s - 48.0
    room = room_of[c]
    menu = gui.sized[gui.panel[[gui.scroll['menu', tall - 32.0, _menu[g]]], pad = 16.0], _menu_wide[]]
    inner = _controls[g.chosen, c, room]
    content = inner
    if not _scrolls_itself[g.chosen]
        content = gui.scroll['vue:body', room.tall, [inner]]
    header = gui.column[[common.titled['', title_of[g.chosen], 20.0, c], gui.note[note_of[g.chosen]]], gap = 6.0]
    body = gui.sized[gui.panel[[header, gui.divider[], content], gap = 12.0, pad = 20.0], room.wide + 40.0]
    gui.row[[menu, body], gap = 16.0, align = 'start']

--- the example's tree alone, as this frame would draw it
fn example_of[c]
    g = recall['vue.gallery', _fresh[]]
    _controls[g.chosen, c, room_of[c]]

--- the page's tree, as this frame would draw it
fn tree_now[c]
    page_of[recall['vue.gallery', _fresh[]], c]

--- what the chosen example shows, as the tests read it
fn seen_now[c]
    g = recall['vue.gallery', _fresh[]]
    _seen[g.chosen, _controls[g.chosen, c, room_of[c]]]

--- the look the page is drawn in: Vue's examples' light page on a
--- screen, the dark one in a headset (where light panels glare)
fn look_of[c]
    if c.xr
        return gui.dark[]
    gui.light[]

--- the example of that name started, as a press on it in the menu starts
--- it (its state afresh; the focus let go)
fn start[slug, c]
    g = recall['vue.gallery', _fresh[]]
    g.chosen = slug
    g.mounts = g.mounts + 1
    remember['vue.gallery', g]
    gui.unfocus[]
    _started[slug, c]

--- one frame: the chosen example moved on by the frame, the page drawn,
--- and what the reader did answered (a press in the menu starts the
--- example pressed)
fn framed[frame]
    c = lory.begin[frame]
    g = recall['vue.gallery', _fresh[]]
    _ticked[g.chosen, c]
    look = look_of[c]
    --- (in a headset that shows the room, nothing is drawn behind the
    --- panels: the room is seen there)
    if not lory.seen_through[c]
        c = lory.clear[c, look.page]
    tree = page_of[g, c]
    shown = gui.show_at[c, tree, 24.0, 24.0, lory.width[c] / lory.px[c] - 48.0, look]
    picked = ''
    for ev in shown.events
        if ev.act eq 'press' and starts[ev.id, 'menu:']
            picked = slice[ev.id, 5, len[ev.id]]
    if picked ne ''
        if picked ne g.chosen
            start[picked, shown.canvas]
    else
        _handled[g.chosen, shown, shown.canvas]
    g = recall['vue.gallery', _fresh[]]
    shown.canvas = _sent[g.chosen, shown.canvas]
    shown

