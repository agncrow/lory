--- The gallery of Vue's examples: a menu of the twenty in Vue's three
--- groups (Basic, Practical and the 7 GUIs) beside the one chosen. Each
--- example is a module of its own beside this one, with the same five
--- functions: `fresh[]` (its state as it starts), `ticked[s, c]` (the
--- state moved on by the frame's time and what the page answered, before
--- it is drawn), `controls[s, c, room]` (its tree), `handled[s, shown,
--- c]` (the state after what the reader did) and `seen[s, tree]` (what
--- it shows, as the tests read it). Its state is kept under
--- `vue.<name>` (`use memory`); choosing an example starts it afresh.
use memory
use lory
use lory.gui
use common
use hello
use handling
use bindings
use conditionals
use inputs
use grocery
use editor
use commits
use datagrid
use treeview
use radar
use dialog
use transitions
use counter
use temperature
use flights
use timer
use crud
use circles
use cells

--- the example chosen, and how many times one was started (a request's
--- name carries it, so an answer to one started before is told apart)
struct Gallery [chosen, mounts]

fn _fresh[]
    Gallery['hello-world', 0]

--- the examples' names, in the menu's order
fn order[]
    ['hello-world', 'handling-input', 'attribute-bindings', 'conditionals-and-loops', 'form-bindings', 'simple-component', 'markdown', 'fetching-data', 'grid', 'tree', 'svg', 'modal', 'list-transition', 'counter', 'temperature-converter', 'flight-booker', 'timer', 'crud', 'circle-drawer', 'cells']

fn title_of[slug]
    if slug eq 'hello-world'
        return 'Hello World'
    if slug eq 'handling-input'
        return 'Handling User Input'
    if slug eq 'attribute-bindings'
        return 'Attribute Bindings'
    if slug eq 'conditionals-and-loops'
        return 'Conditionals and Loops'
    if slug eq 'form-bindings'
        return 'Form Bindings'
    if slug eq 'simple-component'
        return 'Simple Component'
    if slug eq 'markdown'
        return 'Markdown Editor'
    if slug eq 'fetching-data'
        return 'Fetching Data'
    if slug eq 'grid'
        return 'Grid with Sort and Filter'
    if slug eq 'tree'
        return 'Tree View'
    if slug eq 'svg'
        return 'SVG Graph'
    if slug eq 'modal'
        return 'Modal with Transitions'
    if slug eq 'list-transition'
        return 'List with Transitions'
    if slug eq 'counter'
        return 'Counter'
    if slug eq 'temperature-converter'
        return 'Temperature Converter'
    if slug eq 'flight-booker'
        return 'Flight Booker'
    if slug eq 'timer'
        return 'Timer'
    if slug eq 'crud'
        return 'CRUD'
    if slug eq 'circle-drawer'
        return 'Circle Drawer'
    if slug eq 'cells'
        return 'Cells'
    slug

fn note_of[slug]
    if slug eq 'hello-world'
        return 'A heading bound to the message the example holds.'
    if slug eq 'handling-input'
        return 'Buttons that change the message, and a link whose press is held back.'
    if slug eq 'attribute-bindings'
        return 'A title, a class and a style, each bound to a value a press changes.'
    if slug eq 'conditionals-and-loops'
        return 'A list drawn while it is shown and holds numbers, and words in its place.'
    if slug eq 'form-bindings'
        return 'Every kind of input bound to a value the page shows under it.'
    if slug eq 'simple-component'
        return 'A list whose entries are each drawn by a component of their own.'
    if slug eq 'markdown'
        return 'Markdown typed on the left, drawn on the right a tenth of a second after the typing stops.'
    if slug eq 'fetching-data'
        return 'The latest commits of Vue\'s core on the branch chosen, asked of GitHub.'
    if slug eq 'grid'
        return 'A table sorted by the column pressed and filtered by the words searched.'
    if slug eq 'tree'
        return 'Folders opened by a press; a double press makes an entry a folder.'
    if slug eq 'svg'
        return 'A polygon drawn from the stats, each moved by its slider.'
    if slug eq 'modal'
        return 'A dialog that fades and shrinks in over the dimmed page, and out again.'
    if slug eq 'list-transition'
        return 'Entries that slide in, fade out and move to their new places.'
    if slug eq 'counter'
        return 'A number and a button that counts it up.'
    if slug eq 'temperature-converter'
        return 'Celsius and Fahrenheit, each worked out from the other as it is entered.'
    if slug eq 'flight-booker'
        return 'A one-way or a return flight, booked only when its dates make sense.'
    if slug eq 'timer'
        return 'Time going by until the duration, which a slider sets.'
    if slug eq 'crud'
        return 'Names created, updated and deleted, filtered by the start of the surname.'
    if slug eq 'circle-drawer'
        return 'Circles drawn by a press, their radius set from a right press, undone and redone.'
    if slug eq 'cells'
        return 'A sheet whose cells hold numbers, words or formulas over other cells.'
    ''

fn group_of[slug]
    if slug eq 'hello-world'
        return 'Basic'
    if slug eq 'handling-input'
        return 'Basic'
    if slug eq 'attribute-bindings'
        return 'Basic'
    if slug eq 'conditionals-and-loops'
        return 'Basic'
    if slug eq 'form-bindings'
        return 'Basic'
    if slug eq 'simple-component'
        return 'Basic'
    if slug eq 'markdown'
        return 'Practical'
    if slug eq 'fetching-data'
        return 'Practical'
    if slug eq 'grid'
        return 'Practical'
    if slug eq 'tree'
        return 'Practical'
    if slug eq 'svg'
        return 'Practical'
    if slug eq 'modal'
        return 'Practical'
    if slug eq 'list-transition'
        return 'Practical'
    if slug eq 'counter'
        return '7 GUIs'
    if slug eq 'temperature-converter'
        return '7 GUIs'
    if slug eq 'flight-booker'
        return '7 GUIs'
    if slug eq 'timer'
        return '7 GUIs'
    if slug eq 'crud'
        return '7 GUIs'
    if slug eq 'circle-drawer'
        return '7 GUIs'
    if slug eq 'cells'
        return '7 GUIs'
    ''

--- whether the example scrolls what it holds itself (a sheet, an editor
--- and its preview), so the page around it does not
fn _scrolls_itself[slug]
    slug in ['cells', '']

--- ---- each example, by its name ----

--- the example started: its state afresh, moved on to the frame
fn _started[slug, c]
    if slug eq 'hello-world'
        remember['vue.hello-world', hello.ticked[hello.fresh[], c]]
    if slug eq 'handling-input'
        remember['vue.handling-input', handling.ticked[handling.fresh[], c]]
    if slug eq 'attribute-bindings'
        remember['vue.attribute-bindings', bindings.ticked[bindings.fresh[], c]]
    if slug eq 'conditionals-and-loops'
        remember['vue.conditionals-and-loops', conditionals.ticked[conditionals.fresh[], c]]
    if slug eq 'form-bindings'
        remember['vue.form-bindings', inputs.ticked[inputs.fresh[], c]]
    if slug eq 'simple-component'
        remember['vue.simple-component', grocery.ticked[grocery.fresh[], c]]
    if slug eq 'markdown'
        remember['vue.markdown', editor.ticked[editor.fresh[], c]]
    if slug eq 'fetching-data'
        g = recall['vue.gallery', _fresh[]]
        remember['vue.fetching-data', commits.ticked[commits.fresh_at[g.mounts], c]]
    if slug eq 'grid'
        remember['vue.grid', datagrid.ticked[datagrid.fresh[], c]]
    if slug eq 'tree'
        remember['vue.tree', treeview.ticked[treeview.fresh[], c]]
    if slug eq 'svg'
        remember['vue.svg', radar.ticked[radar.fresh[], c]]
    if slug eq 'modal'
        remember['vue.modal', dialog.ticked[dialog.fresh[], c]]
    if slug eq 'list-transition'
        remember['vue.list-transition', transitions.ticked[transitions.fresh[], c]]
    if slug eq 'counter'
        remember['vue.counter', counter.ticked[counter.fresh[], c]]
    if slug eq 'temperature-converter'
        remember['vue.temperature-converter', temperature.ticked[temperature.fresh[], c]]
    if slug eq 'flight-booker'
        remember['vue.flight-booker', flights.ticked[flights.fresh_on[today_of[c]], c]]
    if slug eq 'timer'
        remember['vue.timer', timer.ticked[timer.fresh[], c]]
    if slug eq 'crud'
        remember['vue.crud', crud.ticked[crud.fresh[], c]]
    if slug eq 'circle-drawer'
        remember['vue.circle-drawer', circles.ticked[circles.fresh[], c]]
    if slug eq 'cells'
        remember['vue.cells', cells.ticked[cells.fresh[], c]]
    slug

