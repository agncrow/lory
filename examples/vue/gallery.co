    if slug eq 'markdown'
        return editor.seen[recall['vue.markdown', editor.fresh[]], tree]
    if slug eq 'fetching-data'
        return commits.seen[recall['vue.fetching-data', commits.fresh_at[0]], tree]
    if slug eq 'grid'
        return datagrid.seen[recall['vue.grid', datagrid.fresh[]], tree]
