--- SVG Graph: a polygon over a circle, one corner for each stat, as far
--- from the middle as the stat's value (0 to 100), its label just past
--- it; a slider and an `X` for each stat; a field and "Add a Stat" (a
--- new stat of 100; Enter in the field adds too); and the stats written
--- out as JSON. Three are the fewest kept: "Can't delete more!". As
--- Vue's `v-model` on a range does, a slider moved leaves its value as
--- words (`"50"`), which the JSON shows.
use math
use lory
use lory.gui
use common

--- a stat: its label, its value, and whether the value is held as words
struct Stat [label, value, worded]

--- the stats, the new label typed, and the alert standing ('' for none)
struct Radar [stats, label, alert]

fn fresh[]
    stats = slice[[Stat['', 0.0, false]], 0, 0]
    for l in ['A', 'B', 'C', 'D', 'E', 'F']
        stats = push[stats, Stat[l, 100.0, false]]
    Radar[stats, '', '']

fn ticked[s, c]
    s

--- `valueToPoint`: the point `value` along the axis of the `index`th of
--- `total`, in the graph's 200 by 200
fn point_x[value, index, total]
    x = 0.0
    y = 0.0 - value * 0.8
    angle = ((pi * 2.0) / float[total]) * float[index]
    x * cos[angle] - y * sin[angle] + 100.0

fn point_y[value, index, total]
    x = 0.0
    y = 0.0 - value * 0.8
    angle = ((pi * 2.0) / float[total]) * float[index]
    x * sin[angle] + y * cos[angle] + 100.0

--- the polygon's `points`, as Vue writes them
fn points_of[stats]
    out = slice[[''], 0, 0]
    total = len[stats]
    i = 0
    for st in stats
        out = push[out, '`common.js_number[point_x[st.value, i, total]]`,`common.js_number[point_y[st.value, i, total]]`']
        i = i + 1
    join[out, ' ']

--- each label with its `x` and `y`
fn labels_of[stats]
    out = slice[[''], 0, 0]
    total = len[stats]
    i = 0
    for st in stats
        v = st.value + 10.0
        out = push[out, '`st.label` `common.js_number[point_x[v, i, total]]` `common.js_number[point_y[v, i, total]]`']
        i = i + 1
    join[out, '\n']

--- a stat's value as `{{ }}` shows it
fn value_words[st]
    common.js_number[st.value]

--- the stats as `{{ stats }}` writes them (JSON, two spaces deep)
fn raw_of[stats]
    lines = ['[']
    i = 0
    for st in stats
        v = value_words[st]
        if st.worded
            v = common.json_quoted[v]
        lines = push[lines, '  {']
        lines = push[lines, '    "label": `common.json_quoted[st.label]`,']
        lines = push[lines, '    "value": `v`']
        last = '  },'
        if i eq len[stats] - 1
            last = '  }'
        lines = push[lines, last]
        i = i + 1
    lines = push[lines, ']']
    join[lines, '\n']

--- the graph, drawn from the stats the gallery holds for it
fn _graph_painter[d]
    s = recall['vue.svg', fresh[]]
    k = d.s
    total = len[s.stats]
    green = lory.rgba[66.0, 185.0, 131.0, 0.75]
    mx = d.x + 100.0 * k
    my = d.y + 100.0 * k
    i = 0
    while i lt total
        j = (i + 1) % total
        a = s.stats[i]
        b = s.stats[j]
        d.c = lory.triangle[d.c, mx, my, d.x + point_x[a.value, i, total] * k, d.y + point_y[a.value, i, total] * k, d.x + point_x[b.value, j, total] * k, d.y + point_y[b.value, j, total] * k, green]
        i = i + 1
    d.c = lory.ring[d.c, mx, my, 80.0 * k, 1.0 * k, lory.hex['#999999']]
    size = 10.0 * k
    i = 0
    for st in s.stats
        v = st.value + 10.0
        --- (an SVG text stands on its baseline)
        d.c = lory.text[d.c, d.x + point_x[v, i, total] * k, d.y + point_y[v, i, total] * k - size * 0.8, st.label, size, lory.hex['#666666']]
        i = i + 1
    d

fn controls[s, c, room]
    graph = gui.drawn['svg:graph', 0.0, 200.0, 200.0, _graph_painter, words = points_of[s.stats]]
    graph.opts['labels'] = labels_of[s.stats]
    rows = [graph]
    for st in s.stats
        rows = push[rows, gui.row[[gui.sized[gui.text[st.label], 20.0], gui.sized[gui.slider['svg:value:`st.label`', st.value, 0.0, 100.0, step = 1.0], 160.0], common.with_id[gui.text[value_words[st]], 'svg:shown:`st.label`'], gui.button['svg:remove:`st.label`', 'X']], gap = 8.0]]
    rows = push[rows, gui.row[[gui.sized[gui.field['svg:label', s.label], 140.0], gui.button['svg:add', 'Add a Stat']], gap = 8.0]]
    raw = common.with_id[gui.text[raw_of[s.stats], size = 13.0], 'svg:raw']
    kids = [gui.row[[gui.column[rows, gap = 8.0], raw], gap = 40.0, align = 'start']]
    if s.alert ne ''
        kids = push[kids, common.alert_of['svg', s.alert]]
    gui.column[kids, gap = 0.0]

--- `add`: a stat of the label typed (none typed: nothing)
fn added[s]
    if s.label eq ''
        return s
    s.stats = push[s.stats, Stat[s.label, 100.0, false]]
    s.label = ''
    s

--- `remove`: the stat taken out, while more than three are left
fn removed[s, label]
    if len[s.stats] lte 3
        s.alert = 'Can\'t delete more!'
        return s
    kept = slice[s.stats, 0, 0]
    gone = false
    for st in s.stats
        if st.label eq label and not gone
            gone = true
        else
            kept = push[kept, st]
    s.stats = kept
    s

fn handled[s, shown, c]
    if s.alert ne ''
        if common.alert_closed[shown, 'svg']
            s.alert = ''
        return s
    for ev in shown.events
        if ev.id eq 'svg:label' and ev.act eq 'edit'
            s.label = ev.words
        if (ev.id eq 'svg:label' and ev.act eq 'submit') or (ev.id eq 'svg:add' and ev.act eq 'press')
            s = added[s]
        if starts[ev.id, 'svg:remove:'] and ev.act eq 'press'
            s = removed[s, slice[ev.id, 11, len[ev.id]]]
        if starts[ev.id, 'svg:value:'] and ev.act eq 'change'
            label = slice[ev.id, 10, len[ev.id]]
            stats = s.stats
            i = 0
            while i lt len[stats]
                if stats[i].label eq label
                    st = stats[i]
                    st.value = common.js_round[ev.num]
                    st.worded = true
                    stats[i] = st
                i = i + 1
            s.stats = stats
    s

fn seen[s, tree]
    out = map['' = '']
    graph = common.node_by[tree, 'svg:graph']
    out['points'] = graph.words
    out['labels'] = ''
    if 'labels' in graph.opts
        out['labels'] = graph.opts['labels']
    amounts = slice[[''], 0, 0]
    for n in common.nodes_of[tree]
        if starts[n.id, 'svg:shown:']
            amounts = push[amounts, '`slice[n.id, 10, len[n.id]]`=`n.words`']
    out['values'] = join[amounts, ' ']
    out['label'] = common.words_by[tree, 'svg:label']
    out['raw'] = common.normalized[common.words_by[tree, 'svg:raw']]
    out['alert'] = common.words_by[tree, 'svg:alert:words']
    out

--- (a tree shown here, though nothing calls this, lets Crow type the
--- painters this module hands to gui: a function held in a node is typed
--- where a call reaches it, and in a module imported by the one that
--- shows the page no call does)
fn _painters_typed[frame]
    gui.show_at[lory.begin[frame], gui.space[0.0], 0.0, 0.0, 10.0, gui.light[]]
