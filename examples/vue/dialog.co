--- Modal with Transitions: "Show Modal" opens a dialog over the dimmed
--- page (its header given by the page, its body and footer the
--- component's own), and its OK closes it. Opening, the dialog fades in
--- from nothing and shrinks from 1.1 times its size; closing, it fades
--- out and grows back to 1.1, then is gone: each over 300 milliseconds
--- of CSS's `ease` (`lory.motion`), as Vue's `<Transition>` runs it.
use lory
use lory.gui
use lory.motion
use common

--- whether the dialog stands, whether it is leaving, and when its
--- motion began (ms)
struct Dialog [shown, leaving, began]

fn fresh[]
    Dialog[false, false, 0.0]

fn _length[]
    300.0

--- how far the motion has gone at `t`, eased (0 to 1)
fn eased_at[s, t]
    p = max[0.0, min[1.0, (t - s.began) / _length[]]]
    motion.ease_at['ease', p]

--- the dialog's opacity and scale at `t`
fn opacity_at[s, t]
    e = eased_at[s, t]
    if s.leaving
        return 1.0 - e
    e

fn scale_at[s, t]
    e = eased_at[s, t]
    if s.leaving
        return 1.0 + 0.1 * e
    1.1 - 0.1 * e

--- the dialog gone once its leaving is over
fn ticked[s, c]
    if s.shown and s.leaving and lory.time[c] - s.began gt _length[]
        s.shown = false
        s.leaving = false
    s

--- a number to six places, as the tests read a motion's
fn _six[x]
    common.js_number[common.js_round[x * 1000000.0] / 1000000.0]

fn controls[s, c, room]
    show = gui.button['modal:show', 'Show Modal']
    if not s.shown
        return gui.column[[show], gap = 0.0]
    t = lory.time[c]
    a = opacity_at[s, t]
    k = scale_at[s, t]
    header = common.named[common.styled['', 'Custom Header', 18.7, common.ink_vue[], common.bold[], c], 'modal:header']
    body = common.named[gui.text['default body'], 'modal:body']
    footer = common.named[gui.row[[gui.text['default footer'], gui.button['modal:ok', 'OK']], justify = 'between'], 'modal:footer']
    inside = gui.scaled[gui.faded[gui.column[[header, body, footer], gap = 20.0], a], k]
    mask = gui.layer['modal:mask', [inside], place = 'center', modal = true, scrim = true, dismiss = false, wide = 360.0, pad = 20.0]
    mask.opts['opacity'] = _six[a]
    mask.opts['scale'] = _six[k]
    gui.column[[show, mask], gap = 0.0]

fn handled[s, shown, c]
    t = lory.time[c]
    for ev in shown.events
        if ev.id eq 'modal:show' and ev.act eq 'press' and not s.shown
            s.shown = true
            s.leaving = false
            s.began = t
        if ev.id eq 'modal:ok' and ev.act eq 'press' and s.shown and not s.leaving
            s.leaving = true
            s.began = t
    s

fn seen[s, tree]
    out = map['' = '']
    if not common.holds[tree, 'modal:mask']
        out['shown'] = 'false'
        for key in ['header', 'body', 'footer', 'opacity', 'scale']
            out[key] = ''
        return out
    mask = common.node_by[tree, 'modal:mask']
    out['shown'] = 'true'
    out['header'] = common.normalized[common.node_by[tree, 'modal:header'].words]
    out['body'] = common.words_under[tree, 'modal:body']
    out['footer'] = common.words_under[tree, 'modal:footer']
    out['opacity'] = mask.opts['opacity']
    out['scale'] = mask.opts['scale']
    out

--- (a tree shown here, though nothing calls this, lets Crow type the
--- painters this module hands to gui: a function held in a node is typed
--- where a call reaches it, and in a module imported by the one that
--- shows the page no call does)
fn _painters_typed[frame]
    gui.show_at[lory.begin[frame], gui.space[0.0], 0.0, 0.0, 10.0, gui.light[]]

test the_motion_eases_as_css_does[]
    s = Dialog[true, false, 1000.0]
    abs[opacity_at[s, 1075.0] - 0.408511] lt 0.000001
    abs[scale_at[s, 1075.0] - 1.05915] lt 0.00001
    left = Dialog[true, true, 2000.0]
    abs[opacity_at[left, 2150.0] - 0.197597] lt 0.000001
