--- The repository's root: the examples and the parity programs reach the
--- packages through crow_modules/lory and crow_modules/kite, links to
--- packages/lory and packages/kite, as a program that installs them does.
--- The repository keeps its links relative, here and in each example and
--- package, so a clone works as it is: `crow install` would link the same
--- folders by their absolute paths. (A local path is spelled from `.`:
--- `packages/lory` alone is read as a repository's.)
name = 'lory_repository'
deps = map[lory = './packages/lory', kite = './packages/kite', map = './packages/map', sound = './packages/sound']
