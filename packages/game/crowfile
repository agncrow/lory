--- Lory's games: a clock that steps a game at a fixed rate, shapes that
--- meet, sparks, sounds. Lory, beside it in this repository, is linked in
--- crow_modules/ as Kite's is, by a relative link the repository keeps
--- (`crow install` would link the same folder by its absolute path):
---
---     ln -s ../../lory crow_modules/lory
name = 'game'
deps = map[lory = '../lory']
