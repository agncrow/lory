test a_stagger_counts_from_where_it_starts[]
    staggers[stagger[100.0], 4] eq [0.0, 100.0, 200.0, 300.0]
    middle = stagger[100.0]
    middle.origin = 'center'
    staggers[middle, 5] eq [200.0, 100.0, 0.0, 100.0, 200.0]
    back = stagger[100.0]
    back.origin = 'last'
    staggers[back, 3] eq [200.0, 100.0, 0.0]
    turned = stagger[100.0]
    turned.reversed = true
    staggers[turned, 3] eq [200.0, 100.0, 0.0]
    based = stagger[100.0]
    based.base = 50.0
    staggered[based, 2, 4] eq 250.0
    staggers[stagger_range[100.0, 500.0], 3] eq [100.0, 300.0, 500.0]

test a_grid_stagger_measures_from_its_centre[]
