    along = stagger_grid[stagger[100.0], 3, 3]
    along.origin = 'center'
    along.axis = 'x'
    across = staggers[along, 9]
    across[0] eq -100.0
    across[1] eq 0.0
    across[2] eq 100.0

test a_scaled_stagger_counts_in_its_own_units[]
