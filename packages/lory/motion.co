    tl = timeline_add[tl, 'e', 100.0, '<<']
    tl = timeline_label[tl, 'here', '+=50']
    tl = timeline_add[tl, 'f', 100.0, 'here']
    tl = timeline_add[tl, 'g', 100.0, 'here-=25']
    tl = timeline_add[tl, 'h', 100.0, '250']
