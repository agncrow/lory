test a_throw_slows_to_where_its_power_carries_it[]
    thrown = inertia[0.0, 1000.0]
    g = glide[thrown]
    g.target eq 800.0
    g = glided[thrown, g, 16.0]
    g.value gt 0.0 and g.value lt 800.0
    g = glided[thrown, g, 10000.0]
    g.done
    g.value eq 800.0

test a_throw_past_its_bound_is_caught_by_a_spring[]
    thrown = inertia[0.0, 1000.0]
    thrown.high = 100.0
    g = glide[thrown]
    for ms in range[0, 2000, 16]
        g = glided[thrown, g, float[ms]]
    g.caught
    g.caught_at gt 0.0
    g.origin gt 100.0
    g = glided[thrown, g, 4000.0]
    g.done
    g.value eq 100.0

test a_snapped_throw_lands_on_its_step[]
    thrown = inertia[0.0, 1000.0]
    thrown.snap = 300.0
    glide[thrown].target eq 900.0

test timeline_positions_place_children_by_offset_label_and_previous[]
