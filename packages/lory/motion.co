    found[0] eq 0.0
    _near[found[3], 0.3]
    middle = stagger_scaled[0.1]
    middle.origin = 'center'
    _near[staggers[middle, 3][0], 0.1]
    edges = stagger_scaled[0.1]
    edges.origin = 'edges'
    out = staggers[edges, 5]
    out[0] eq 0.0 and out[4] eq 0.0
