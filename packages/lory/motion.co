test a_random_stagger_is_the_same_for_the_same_seed[]
    shuffled = stagger[100.0]
    shuffled.origin = 'random'
    shuffled.seed = 7
    once = staggers[shuffled, 6]
    again = staggers[shuffled, 6]
    once eq again
    sort[once] eq [0.0, 100.0, 200.0, 300.0, 400.0, 500.0]

test the_seeded_random_stays_in_its_range[]
    r = random_seeded[5]
    held = true
    for i in range[50]
        r = random_next[r, 10.0, 20.0, 0]
        if r.value lt 10.0 or r.value gt 20.0
            held = false
    held
    u = random_unit[random_seeded[5]]
    u.value gte 0.0 and u.value lt 1.0

test a_point_runs_along_a_polyline_by_its_length[]
    xs = [0.0, 100.0, 100.0]
    ys = [0.0, 0.0, 100.0]
    path_length[xs, ys] eq 200.0
    quarter = path_point[xs, ys, 0.25]
    quarter.x eq 50.0 and quarter.y eq 0.0
    quarter.angle eq 0.0
    three = path_point[xs, ys, 0.75]
    three.x eq 100.0 and three.y eq 50.0
    _near[three.angle, pi / 2.0]
    path_point[xs, ys, 1.0].y eq 100.0
    path_point[xs, ys, 2.0].y eq 100.0
    path_point[xs, ys, -1.0].x eq 0.0

test a_line_drawn_so_far_ends_at_its_fraction[]
    xs = [0.0, 100.0, 100.0]
    ys = [0.0, 0.0, 100.0]
    drawn = path_drawn[xs, ys, 0.75]
    drawn.xs eq [0.0, 100.0, 100.0]
    drawn.ys eq [0.0, 0.0, 50.0]
    whole = path_drawn[xs, ys, 1.0]
    whole.xs eq xs and whole.ys eq ys
    nothing = path_drawn[xs, ys, 0.0]
    nothing.xs[len[nothing.xs] - 1] eq 0.0
    hypotenuse[3.0, 4.0] eq 5.0
    hypotenuse[0.0, 0.0] eq 0.0

test text_splits_into_words_and_characters[]
    words_of['  the quick  fox '] eq ['the', 'quick', 'fox']
    characters_of['ab c'] eq ['a', 'b', ' ', 'c']
    len[words_of['']] eq 0

test number_helpers_damp_blend_map_wrap_and_snap[]
    damp[0.0, 100.0, 16.0, 0.0] eq 0.0
    damp[0.0, 100.0, 16.0, 1.0] eq 100.0
    blend[0.0, 100.0, 0.25] eq 25.0
    map_range[5.0, 0.0, 10.0, 0.0, 100.0] eq 50.0
    wrapped[370.0, 0.0, 360.0] eq 10.0
    wrapped[-10.0, 0.0, 360.0] eq 350.0
    snapped[17.0, 5.0] eq 15.0
    snapped[17.5, 5.0] eq 20.0
    snapped[17.0, 0.0] eq 17.0
