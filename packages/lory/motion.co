    reveal_line[1500.0, 200.0, 800.0, 'top-bottom', 0.0] eq 1500.0
    reveal_line[1500.0, 200.0, 800.0, 'center-bottom', 0.0] eq 1600.0
    reveal_line[1500.0, 200.0, 800.0, 'bottom-bottom', 0.0] eq 1700.0
