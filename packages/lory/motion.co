    child_of[tl, 'c'].offset eq 700.0
    child_of[tl, 'd'].offset eq 900.0
    child_of[tl, 'e'].offset eq 900.0
    label_at[tl, 'here'] eq 1050.0
    child_of[tl, 'f'].offset eq 1050.0
    child_of[tl, 'g'].offset eq 1025.0
    child_of[tl, 'h'].offset eq 250.0
    child_of[tl, 'i'].offset eq 360.0
