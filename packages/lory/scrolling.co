    a = _area_framed[a, _headset_at[2100.0, 100.0, 100.0, [], forward = 0.5]]
    a.top eq 60.0

--- (50,000 rows of 35, 5 rows drawn past each way)
fn _big[]
    v = virtual_of[50000, 35.0, overscan = 5]
    a = v.area
    a.tall = 400.0
    a.content = virtual_total[v]
    v.area = a
    v

test a_virtual_list_draws_the_rows_in_view_and_its_overscan[]
    v = _big[]
    virtual_total[v] eq 1750000.0
    virtual_in_view[v, 0.0, 400.0] eq [0, 11]
    virtual_rows[v] eq [0, 16]
    virtual_range[v, 35000.0, 400.0] eq [995, 1016]
    virtual_range[v, 35010.0, 400.0] eq [995, 1016]
    virtual_range[v, 35030.0, 400.0] eq [995, 1017]
    virtual_range[v, 1750000.0 - 400.0, 400.0] eq [49983, 49999]
    near = v
    near.area = area_to[v.area, virtual_total[v] - 400.0 - 500.0, 0.0]
    virtual_near_end[near] and not virtual_near_end[v]

test a_row_measured_above_the_scroll_moves_it_by_its_change[]
    v = _big[]
    v.area = area_to[v.area, 100.0, 0.0]
    v = virtual_measured[v, 0, 50.0]
    v.adjust eq 15.0
    virtual_start[v, 1] eq 50.0 and virtual_size[v, 0] eq 50.0
    v = virtual_measured[v, 20, 10.0]
    v.adjust eq 15.0 and virtual_start[v, 21] eq 50.0 + 20.0 * 35.0 - 25.0
    v = virtual_measured[v, 5, 35.0]
    v.measured eq [0, 20]

test a_virtual_list_scrolls_to_a_row_by_its_alignment[]
    v = _big[]
    virtual_scroll_for[v, 100, align = 'start'] eq 3500.0
    virtual_scroll_for[v, 100, align = 'end'] eq 3500.0 + 35.0 - 400.0
    virtual_scroll_for[v, 100, align = 'center'] eq 3500.0 + 17.5 - 200.0
    virtual_scroll_for[v, 100] eq 3135.0
    virtual_scroll_for[v, 3] eq 0.0

fn _list_framed[v, c]
    v = virtual_scrolled[c, v]
    faces = [gui.space[0.0]]
    faces = slice[faces, 0, 0]
    r = virtual_rows[v]
    i = r[0]
    while i lte r[1]
        faces = push[faces, gui.text['row `i`']]
        i = i + 1
    shown = gui.show_at[c, virtual_view[v, 'rows', 300.0, faces], 0.0, 0.0, lory.width[c] / lory.px[c], gui.dark[]]
    ended = lory.end[shown.canvas]
    v.adjust = v.adjust + 0.0 * ended
    virtual_heard[v, shown, 'rows']

test a_virtual_list_shown_measures_its_rows_and_the_wheel_scrolls_it[]
    v = _list_framed[virtual_of[1000, 50.0, overscan = 2], _frame_of[0.0, []]]
    v.area.tall eq 300.0
    len[v.measured] gt 0 and v.sizes[0] lt 50.0
    v.area.content eq virtual_total[v]
    v = _list_framed[v, _frame_of[100.0, [_mouse['move', 100.0, 100.0], _wheel_of[100.0, 100.0, 400.0]]]]
    --- (the rows drawn above the scroll measured, the scroll keeps them)
    v.area.top eq 400.0 + v.adjust and v.adjust lt 0.0
    virtual_rows[v][0] gt 2

test in_a_headset_the_stick_scrolls_a_virtual_list[]
    v = _list_framed[virtual_of[1000, 50.0], _headset_at[2000.0, 100.0, 100.0, []]]
    v = _list_framed[v, _headset_at[2100.0, 100.0, 100.0, [], forward = 1.0]]
    v.area.top eq 120.0 + v.adjust

test a_virtual_grid_draws_its_rows_and_columns_in_view_and_overscan[]
    g = grid_of[50000, 1000, 35.0, 100.0]
    a = g.rows.area
    a.tall = 400.0
    rows = g.rows
    rows.area = a
    g.rows = rows
    g.wide = 400.0
    grid_rows[g] eq [0, 16]
    grid_cols[g] eq [0, 6]
    g = grid_left[g, 5000.0]
    grid_cols[g] eq [47, 56]
    g = grid_left[g, 1000000.0]
    g.left eq 100000.0 - 400.0

test an_endless_feed_asks_for_more_and_is_told_ok_empty_or_error[]
    f = feed_of[]
    a = f.area
    a.content = 1000.0
    a.tall = 400.0
    f.area = a
    feed_wants[f] eq _texts[]
    f.area = area_to[f.area, 600.0, 0.0]
    feed_wants[f] eq ['end']
    f = feed_load[f, 'end']
    feed_status[f, 'end'] eq 'loading' and feed_wants[f] eq _texts[]
    f = feed_done[f, 'end', 'ok']
    feed_wants[f] eq ['end']
    f = feed_done[feed_load[f, 'end'], 'end', 'empty']
    feed_wants[f] eq _texts[]
    f = feed_load[f, 'end']
    feed_status[f, 'end'] eq 'empty'
    f = feed_reset[f]
    feed_status[f, 'end'] eq 'ok'
    both = feed_of[side = 'both', margin = 100.0]
    both.area = f.area
    feed_wants[both] eq ['end']
    both.area = area_to[f.area, 50.0, 0.0]
    feed_wants[both] eq ['start']
    manual = feed_of[mode = 'manual']
    manual.area = f.area
    feed_wants[manual] eq _texts[]

fn _feed_framed[f, c]
    f = feed_scrolled[c, f]
    shown = gui.show_at[c, feed_view[f, 'feed', 300.0, _rows[3]], 0.0, 0.0, lory.width[c] / lory.px[c], gui.dark[]]
    ended = lory.end[shown.canvas]
    f.margin = f.margin + 0.0 * ended
    feed_heard[f, shown, 'feed']

test a_manual_feeds_button_asks_for_more_and_retry_after_an_error[]
    f = _feed_framed[feed_of[mode = 'manual'], _frame_of[0.0, []]]
    shown = gui.show_at[_frame_of[50.0, []], feed_view[f, 'feed', 300.0, _rows[3]], 0.0, 0.0, 900.0, gui.dark[]]
    b = shown.boxes['feed:more:end']
    x = b[0] + b[2] / 2.0
    y = b[1] + b[3] / 2.0
    f = _feed_framed[f, _frame_of[100.0, _clicked[x, y]]]
    feed_status[f, 'end'] eq 'loading'
    f = _feed_framed[feed_done[f, 'end', 'error'], _frame_of[200.0, []]]
    shown = gui.show_at[_frame_of[250.0, []], feed_view[f, 'feed', 300.0, _rows[3]], 0.0, 0.0, 900.0, gui.dark[]]
    r = shown.boxes['feed:retry:end']
    f = _feed_framed[f, _frame_of[300.0, _clicked[r[0] + 4.0, r[1] + 4.0]]]
    feed_status[f, 'end'] eq 'loading'

test pull_to_refresh_pulls_only_from_the_top_up_to_its_threshold[]
    p = pull_down[pull_of[], 10.0]
    p = pull_move[p, 40.0, 0.0]
    pull_offset[p] eq 30.0 and not pull_can_refresh[p]
    p = pull_move[p, 200.0, 0.0]
    pull_offset[p] eq 64.0 and pull_can_refresh[p]
    p = pull_up[p]
    p.refreshing and pull_offset[p] eq 64.0
    p = pull_move[pull_down[p, 0.0], 10.0, 0.0]
    p.refreshing and pull_offset[p] eq 64.0
    p = pull_done[p]
    not p.refreshing and pull_offset[p] eq 0.0
    short = pull_up[pull_move[pull_down[pull_of[], 0.0], 30.0, 0.0]]
    not short.refreshing and pull_offset[short] eq 0.0
    down = pull_move[pull_down[pull_of[], 0.0], 300.0, 20.0]
    pull_offset[down] eq 0.0

fn _stick_along[ys, offset, pushing]
    s = stuck_of[]
    out = _texts[]
    for y in ys
        s = sticky_at[s, y, 400.0, 100.0, 200.0, 0.0, 1000.0, offset = offset, pushing = pushing]
        told = join[s.told, '+']
        out = push[out, '`s.state`:`told`']
    out

--- (a block 200 high at 100 in a context to 1000, the view 400 high;
--- pushing, fixed to the view's bottom, it lets go only once the view's
--- bottom less its height is back at its place)
test a_sticky_block_fixes_to_the_top_binds_to_its_context_and_lets_go[]
    _stick_along[[0.0, 150.0, 500.0, 800.0, 900.0, 700.0, 50.0], 0.0, false] eq ['free:', 'top:stick', 'top:', 'bound:bottom+unstick', 'bound:', 'top:stick', 'free:unstick']
    _stick_along[[0.0, 150.0, 800.0, 500.0, 50.0], 0.0, true] eq ['free:', 'top:stick', 'bound:bottom+unstick', 'bottom:stick', 'bottom:']
    _stick_along[[0.0, 80.0], 30.0, false] eq ['free:', 'top:stick']
    s = sticky_at[stuck_of[], 150.0, 400.0, 100.0, 200.0, 0.0, 1000.0, offset = 30.0]
    sticky_y[s, 150.0, 400.0, 100.0, 200.0, 1000.0, offset = 30.0] eq 180.0
    b = sticky_at[stuck_of[], 900.0, 400.0, 100.0, 200.0, 0.0, 1000.0]
    sticky_y[b, 900.0, 400.0, 100.0, 200.0, 1000.0] eq 800.0

fn _seen_along[ys, once]
    s = seen_of[]
    out = _texts[]
    for y in ys
        s = seen_at[s, y, 400.0, 500.0, 200.0, once = once]
        out = push[out, join[s.told, '+']]
    out

--- (a block 200 high at 500, the view 400 high)
test visibility_tells_each_place_once_and_its_reverse[]
    _seen_along[[0.0, 200.0, 550.0, 800.0, 200.0], true] eq ['off_screen', 'on_screen+top_visible', 'top_visible_reverse+passing+bottom_visible+top_passed', 'passing_reverse+bottom_visible_reverse+bottom_passed', 'top_passed_reverse+bottom_passed_reverse']
    _seen_along[[200.0, 0.0, 200.0], false] eq ['on_screen+top_visible', 'top_visible_reverse+off_screen', 'on_screen+top_visible']
    s = seen_at[seen_of[], 550.0, 400.0, 500.0, 200.0]
    s.passed eq 50.0 and s.share eq 0.25

test a_lazy_block_shows_once_it_comes_into_view[]
    not lazy_shown[false, 0.0, 400.0, 500.0, 200.0]
    lazy_shown[false, 150.0, 400.0, 500.0, 200.0]
    not lazy_shown[false, 150.0, 400.0, 500.0, 200.0, threshold = 0.5]
    lazy_shown[false, 200.0, 400.0, 500.0, 200.0, threshold = 0.5]
    lazy_shown[true, 0.0, 400.0, 5000.0, 200.0]

test parallax_moves_a_picture_a_layer_and_a_section_s_ground[]
    parallax_offset[1000.0, 800.0, 1000.0, 500.0] eq [75.0, 1.3]
    parallax_offset[0.0, 800.0, 1000.0, 500.0] eq [-425.0, 1.3]
    parallax_offset[1000.0, 800.0, 1000.0, 500.0, scale = 1.0] eq [0.0, 1.0]
    parallax_y[300.0, 0.5] eq 150.0 and parallax_y[300.0, -0.2] eq -60.0
    p = pages[_three[], 900.0, 700.0, page_options[], t = 0.0]
    p = pages_at[page_silent_to[p, 1, 0.0], 0.0]
    page_parallax[p, 0] eq 700.0 * 0.62
    page_parallax[p, 1] eq 0.0
    page_parallax[p, 2, cover = true] eq 0.0 - 700.0 * 0.62

test scroll_spy_progress_and_back_to_top[]
    spy_at[[0.0, 500.0, 1200.0], 0.0, 400.0, 2000.0] eq 0
    spy_at[[100.0, 500.0, 1200.0], 0.0, 400.0, 2000.0] eq -1
    spy_at[[0.0, 500.0, 1200.0], 450.0, 400.0, 2000.0, offset = 60.0] eq 1
    spy_at[[0.0, 500.0, 1900.0], 1600.0, 400.0, 2000.0] eq 2
    scrolled_share[800.0, 400.0, 2000.0] eq 0.5
    scrolled_share[0.0, 400.0, 300.0] eq 1.0
    back_to_top_shown[401.0] and not back_to_top_shown[400.0]

test offset_sections_are_a_share_of_the_view_and_may_centre[]
    offset_tall[800.0, 80.0] eq 640.0
    offset_scroll[800.0, 640.0, 800.0, 3000.0] eq 800.0
    offset_scroll[800.0, 640.0, 800.0, 3000.0, centered = true] eq 720.0
    offset_scroll[2800.0, 200.0, 800.0, 3000.0] eq 2200.0

test a_sections_media_pauses_as_it_is_left_and_plays_as_it_is_reached[]
    secs = [section[name = 'a'], section[name = 'b', autoplay = true]]
    p = pages[secs, 900.0, 700.0, page_options[], t = 0.0]
    page_media[p, 0, 1] eq ['pause:0', 'play:1']
    page_media[p, 1, 0] eq ['pause:1']
    page_media[p, -1, 1] eq ['play:1']

--- the fading effect: the section come to fades in over the one
--- left as the move goes, eased as the move is
test with_the_fading_effect_a_section_fades_in_over_the_one_left[]
    p = pages[_three[], 900.0, 700.0, page_options[], t = 0.0]
    page_fading[p, 0.0] eq Fade[0, 0, 1.0]
    p = page_key[p, 'ArrowDown', 100.0]
    f = page_fading[p, 450.0]
    f.from eq 0 and f.to eq 1 and f.share gt 0.0 and f.share lt 1.0
    f.share eq (page_y_at[p, 450.0] - 0.0) / 700.0
    p = pages_at[p, 450.0]
    shown = gui.show_at[_frame_of[450.0, []], pages_view[p, _faces[], fading = true], 0.0, 0.0, 900.0, gui.dark[]]
    shown.boxes['pages:1'][1] eq 0.0
    p = pages_at[p, 1000.0]
    page_fading[p, 1000.0] eq Fade[1, 1, 1.0]
