test fuzzy_ranks_run_from_an_exact_match_down_to_letters_in_order[]
    rank_of[words['Kalo'], words['Kalo']].rank eq 7.0
    rank_of[words['kalo'], words['KALO']].rank eq 6.0
    rank_of[words['Kalo Ven'], words['ka']].rank eq 5.0
    rank_of[words['Kalo Ven'], words['ven']].rank eq 4.0
    rank_of[words['Kalo Ven'], words['lo']].rank eq 3.0
    rank_of[words['Kalo Ven'], words['kv']].rank eq 2.0
    r = rank_of[words['Kalo Ven'], words['kav']]
    r.rank gt 1.0 and r.rank lt 2.0 and r.passed
    not rank_of[words['Kalo Ven'], words['xyz']].passed
    plain_letters['crème brûlée'] eq 'creme brulee'

test sub_rows_are_filtered_from_the_root_or_from_the_leaves[]
