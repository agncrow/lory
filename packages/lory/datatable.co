    aggregated['mean', [number[36], missing[], number[17]]].num eq 26.5
    aggregated['median', [number[3], number[1], number[2], number[10]]].num eq 2.5
    shown[aggregated['extent', [number[3], number[1], number[2]]]] eq '1,3'
    footer_value[t, m, 'age'].num eq 122.0

test groups_within_groups_name_the_path_to_them[]
