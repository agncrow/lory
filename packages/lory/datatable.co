    row_of[m, 'r4'].depth eq 2

test pages_count_the_rows_and_a_known_count_bounds_the_index[]
    t = page_size_set[_tested[], 2]
    m = models[t]
    page_count[t, m] eq 3
    not can_previous[t] and can_next[t, m]
