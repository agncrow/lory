test a_grid_pages_with_buttons_around_its_page_and_a_summary[]
    rows = for i in range[57]
        [number[i]]
    g = grid_page_pressed[grid[rows], 3]
    lang = grid_language[]
    words_shown = for b in grid_buttons[g, lang]
        b.label
    words_shown eq ['Previous', '1', '...', '3', '4', '5', '...', '6', 'Next']
    grid_summary[g, lang] eq 'Showing 31 to 40 of 57 results'
    grid_summary_title[g, lang] eq 'Page 4 of 6'
    empty = grid_searched[g, 'none such']
    grid_summary[empty, lang] eq ''
    len[grid_buttons[empty, lang]] eq 2
