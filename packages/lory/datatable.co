test a_grid_sort_press_turns_round_and_a_shift_press_adds[]
    rows = [[words['b'], number[2]], [words['a'], number[2]], [words['c'], number[1]]]
    g = grid_sort_pressed[grid[rows], 0, false]
    grid_order[g] eq [1, 0, 2]
    g = grid_sort_pressed[g, 0, false]
    grid_order[g] eq [2, 0, 1]
