    last_page[0, 10] eq 1
    last_page[95, 10] eq 10
    last_page[101, 10] eq 11

--- a long trail collapses to its first and last crumbs about an
--- ellipsis (-1)
test crumbs_collapse_about_an_ellipsis[]
    crumbs_shown[6, 4, 3, 2] eq [0, 1, 2, -1, 4, 5]
    crumbs_shown[9, 2, 2, 2] eq [0, 1, -1, 7, 8]
    crumbs_shown[10, 5, 0, 0] eq [-1]
    crumbs_shown[2, 4, 3, 0] eq [0, 1]
    crumbs_shown[8, 0, 1, 0] eq [0, -1]
    crumbs_shown[9] eq [0, -1, 8]
    crumbs_shown[9, 8, 1, 1, true] eq [0, 1, 2, 3, 4, 5, 6, 7, 8]
    len[crumbs_shown[0, 0, 0, 0]] eq 0

fn _trail[]
    gui.column[[breadcrumbs['trail', ['Home', 'Docs', 'Guides', 'Lory', 'Display'], '/', 3]]]

--- the crumbs before the last are links, the last is the page itself; the
--- ellipsis opens the trail out and its first crumb shown anew takes the
--- focus
test a_trail_links_its_crumbs_and_opens_out_by_its_ellipsis[]
    _fresh[]
    laid = _shown[_away[], _trail[]]
    'trail:0' in laid.boxes and 'trail:more' in laid.boxes
    not ('trail:4' in laid.boxes)
    not ('trail:1' in laid.boxes)
    home = _event_of[_shown[_press_on[laid, 'trail:0'], _trail[]], 'trail', 'press']
    home.words eq 'Home'
    home.num eq 0.0
    _has_event[_shown[_press_on[laid, 'trail:more'], _trail[]], 'trail', 'expand']
    crumbs_open['trail']
    opened = _shown[_quiet[], _trail[]]
    'trail:1' in opened.boxes and 'trail:3' in opened.boxes
    not ('trail:more' in opened.boxes)
    docs = _event_of[_shown[_key['Enter', false], _trail[]], 'trail', 'press']
    docs.words eq 'Docs'
    docs.num eq 1.0
    crumbs_collapse['trail']
    not crumbs_open['trail']
    not ('trail:1' in _shown[_quiet[], _trail[]].boxes)
    --- (an icon between them is drawn where words would be)
    'path:0' in _shown[_quiet[], gui.column[[breadcrumbs['path', ['A', 'B'], glyph = 'chevron_right']]]].boxes

fn _tools[loop, vertical]
    tools = [tool_button['cut', 'Cut'], tool_button['copy', '', 'file'], tool_separator[vertical], tool_toggle['bold', 'Bold', false, 'bold'], tool_link['help', 'Help']]
    gui.column[[gui.button['before', 'Before'], toolbar['tools', tools, 'Edit', loop = loop, vertical = vertical], gui.button['after', 'After']]]

--- a toolbar: one stop of Tab that enters at its first control (and
--- comes back to the one left), Left and Right moving round it (not past
--- its ends where it does not loop), Home and End, and Enter or space
--- pressing the one the focus is on
test a_toolbars_keys_move_round_it_and_press_its_controls[]
    _fresh[]
    tree = _tools[true, false]
    _shown[_away[], tree]
    _shown[_key['Tab', false], tree]
    entered = _shown[_key['Tab', false], tree]
    len[entered.events] eq 0
    _event_of[_shown[_key['ArrowRight', false], tree], 'tools', 'rove'].words eq 'copy'
    _event_of[_shown[_key['ArrowRight', false], tree], 'tools', 'rove'].words eq 'bold'
    _event_of[_shown[_key['ArrowRight', false], tree], 'tools', 'rove'].words eq 'help'
    _event_of[_shown[_key['ArrowRight', false], tree], 'tools', 'rove'].words eq 'cut'
    _event_of[_shown[_key['ArrowLeft', false], tree], 'tools', 'rove'].words eq 'help'
    _event_of[_shown[_key['Enter', false], tree], 'help', 'press'].words eq 'Help'
    _event_of[_shown[_key['Home', false], tree], 'tools', 'rove'].words eq 'cut'
    _event_of[_shown[_key[' ', false], tree], 'cut', 'press'].words eq 'Cut'
    len[_shown[_key['ArrowDown', false], tree].events] eq 0
    _event_of[_shown[_key['End', false], tree], 'tools', 'rove'].words eq 'help'
    _shown[_key['ArrowLeft', false], tree]
    toggled = _event_of[_shown[_key[' ', false], tree], 'bold', 'toggle']
    toggled.num eq 1.0
    --- (Tab leaves it, Shift-Tab comes back to the control left)
    len[_shown[_key['Tab', false], tree].events] eq 0
    _shown[_key['Tab', true], tree]
    _has_event[_shown[_key['Enter', false], tree], 'bold', 'toggle']
    --- (one that does not loop stops at its ends)
    _fresh[]
    still = _tools[false, false]
    _shown[_away[], still]
    _shown[_key['Tab', false], still]
    _shown[_key['Tab', false], still]
    len[_shown[_key['ArrowLeft', false], still].events] eq 0
    _shown[_key['End', false], still]
    len[_shown[_key['ArrowRight', false], still].events] eq 0
    --- (a vertical one moves by Up and Down)
    _fresh[]
    upright = _tools[true, true]
    _shown[_away[], upright]
    _shown[_key['Tab', false], upright]
    _shown[_key['Tab', false], upright]
    len[_shown[_key['ArrowRight', false], upright].events] eq 0
    _event_of[_shown[_key['ArrowDown', false], upright], 'tools', 'rove'].words eq 'copy'
    _event_of[_shown[_key['ArrowUp', false], upright], 'tools', 'rove'].words eq 'cut'
    bar_tall[] eq 64.0
    bar_tall['comfortable'] eq 56.0
    bar_tall['compact'] eq 48.0
    bar_tall['', true] eq 128.0

--- a toolbar's toggle group: pressed, a toggle tells what is chosen then,
--- one or many
test a_toolbars_toggles_choose_one_or_many[]
    _fresh[]
    one = gui.column[[toolbar['fmt', [tool_toggles['align', ['left', 'center', 'right'], ['left']]]]]]
    laid = _shown[_away[], one]
    picked = _event_of[_shown[_press_on[laid, 'align:1'], one], 'align', 'choose']
    picked.words eq 'center'
    picked.num eq 1.0
    _event_of[_shown[_press_on[laid, 'align:0'], one], 'align', 'choose'].words eq ''
    many = gui.column[[toolbar['fmt', [tool_toggles['marks', ['b', 'i', 'u'], ['b'], true]]]]]
    m = _shown[_away[], many]
    _event_of[_shown[_press_on[m, 'marks:2'], many], 'marks', 'choose'].words eq 'b\nu'

fn _places[chosen, mode, grow, shown]
    gui.column[[bottom_nav['nav', ['Ωq', 'Жz', 'Ψj'], ['home', 'search', 'user'], chosen, mode, grow, shown]]]

--- bottom navigation: each place a stop of Tab, Enter, space or a press
--- choosing it; `shift` shows only the chosen place's words, `grow` shares
--- the bar (each at most 168), and a bar not shown is gone
test bottom_navigation_is_reached_by_tab_and_chosen_by_its_keys[]
    _fresh[]
    place_index[['Ωq', 'Жz', 'Ψj'], 'Жz'] eq 1
    place_index[['Ωq', 'Жz', 'Ψj'], '2'] eq 2
    place_index[['Ωq', 'Жz', 'Ψj'], '7'] eq -1
    place_index[['Ωq', 'Жz', 'Ψj'], 'x'] eq -1
    tree = _places['Жz', '', false, true]
    laid = _shown[_away[], tree]
    laid.boxes['nav:0'][2] eq 80.0
    laid.boxes['nav:0'][3] eq 56.0
    _shown[_key['Tab', false], tree]
    _shown[_key['Tab', false], tree]
    chose = _event_of[_shown[_key['Enter', false], tree], 'nav', 'choose']
    chose.words eq 'Жz'
    chose.num eq 1.0
    _event_of[_shown[_key[' ', false], tree], 'nav', 'choose'].num eq 1.0
    _event_of[_shown[_press_on[laid, 'nav:2'], tree], 'nav', 'choose'].words eq 'Ψj'
    _drew[_shown[_quiet[], tree], 'Ω']
    shifted = _shown[_quiet[], _places['Жz', 'shift', false, true]]
    not _drew[shifted, 'Ω']
    _drew[shifted, 'Ж']
    grown = _places['1', '', true, true]
    _shown[_quiet[], grown]
    _shown[_quiet[], grown].boxes['nav:0'][2] eq 168.0
    bottom_nav['nav', ['Ωq'], ['home'], 'Ωq', shown = false].tag eq 'space'
    place_wide['Ωq', true, 300.0, 3] eq 100.0

fn _menu[vertical, stackable, wide]
    gui.column[[menu_bar['menu', [menu_entry['m:home', 'Home', true], menu_entry['m:news', 'News'], menu_entry['m:about', 'About', false, 'info']], vertical, true, stackable, wide], gui.button['after', 'After']]]

--- a menu bar: one stop of Tab whose arrows move round its entries
--- (along it, or down a vertical one), Home and End; Enter or space
--- presses the entry the focus is on
test a_menus_arrows_move_round_its_entries[]
    _fresh[]
    tree = _menu[false, false, 0.0]
    laid = _shown[_away[], tree]
    laid.boxes['m:news'][0] gt laid.boxes['m:home'][0]
    laid.boxes['m:news'][1] eq laid.boxes['m:home'][1]
    _shown[_key['Tab', false], tree]
    _event_of[_shown[_key['ArrowRight', false], tree], 'menu', 'rove'].words eq 'm:news'
    len[_shown[_key['ArrowDown', false], tree].events] eq 0
    _event_of[_shown[_key['End', false], tree], 'menu', 'rove'].words eq 'm:about'
    _event_of[_shown[_key['ArrowRight', false], tree], 'menu', 'rove'].words eq 'm:home'
    _event_of[_shown[_key['Enter', false], tree], 'm:home', 'press'].words eq 'Home'
    _event_of[_shown[_press_on[laid, 'm:about'], tree], 'm:about', 'press'].words eq 'About'
    --- (a vertical menu: its entries one under another, as wide as it)
    _fresh[]
    upright = _menu[true, false, 0.0]
    v = _shown[_away[], upright]
    v.boxes['m:news'][1] gt v.boxes['m:home'][1]
    v.boxes['m:home'][2] eq 852.0
    _shown[_key['Tab', false], upright]
    _event_of[_shown[_key['ArrowDown', false], upright], 'menu', 'rove'].words eq 'm:news'
    --- (stackable, on a narrow page it stacks)
    stacked = _shown[_away[], _menu[false, true, 600.0]]
    stacked.boxes['m:news'][1] gt stacked.boxes['m:home'][1]
    wide_page = _shown[_away[], _menu[false, true, 1200.0]]
    wide_page.boxes['m:news'][1] eq wide_page.boxes['m:home'][1]
    --- (a dropdown entry is one of its stops)
    _fresh[]
    dropping = gui.column[[menu_bar['dm', [menu_entry['d:a', 'A'], menu_drop['d:more', 'More', [menu_entry['d:x', 'X']]]]]]]
    _shown[_away[], dropping]
    _shown[_key['Tab', false], dropping]
    _event_of[_shown[_key['ArrowRight', false], dropping], 'dm', 'rove'].words eq 'd:more'

--- a stepper's states, and the steps that may be pressed: an editable
--- one, and in a linear stepper only up to the first not complete
test a_stepper_shows_its_states_and_is_stepped_where_it_may_be[]
    _fresh[]
    step_state[0, 1, [0]] eq 'complete'
    step_state[1, 1, [0]] eq 'active'
    step_state[2, 1, [0], [2]] eq 'error'
    step_state[3, 1, [0], [], [3]] eq 'disabled'
    step_state[4, 1, [0]] eq 'idle'
    step_pressable[0, 1, [0]]
    step_pressable[1, 1, [0]]
    not step_pressable[2, 1, [0]]
    step_pressable[2, 1, [0], true, false]
    not step_pressable[0, 1, [0], false]
    not step_pressable[1, 1, [0], true, false, [1]]
    tree = gui.column[[stepper['steps', ['Ωart', 'Address', 'Pay'], 1, [0], ['Your things', 'Where to', 'How']]]]
    laid = _shown[_away[], tree]
    'steps:0' in laid.boxes and 'steps:1' in laid.boxes
    not ('steps:2' in laid.boxes)
    back = _event_of[_shown[_press_on[laid, 'steps:0'], tree], 'steps', 'step']
    back.num eq 0.0
    back.words eq 'Ωart'
    _drew[_shown[_quiet[], tree], 'Ω']
    --- (on a phone the titles are hidden)
    small = gui.column[[stepper['steps', ['Ωart', 'Address', 'Pay'], 1, [0], mobile = true]]]
    s = _shown[_away[], small]
    s.boxes['steps:0'][2] eq 40.0
    not _drew[s, 'Ω']
    --- (the arrows: back set aside at the first step, on at the last)
    acts = gui.column[[step_actions['steps', 0, 3]]]
    a = _shown[_away[], acts]
    len[_shown[_press_on[a, 'steps:back'], acts].events] eq 0
    _event_of[_shown[_press_on[a, 'steps:on'], acts], 'steps', 'step'].num eq 1.0
    last = gui.column[[step_actions['steps', 2, 3]]]
    l = _shown[_away[], last]
    len[_shown[_press_on[l, 'steps:on'], last].events] eq 0
    --- (a vertical stepper opens the active step on its body and arrows)
    panels = gui.column[[stepper_vertical['v', ['One', 'Two'], 1, [gui.text['first'], gui.text['second']], [0]]]]
    p = _shown[_away[], panels]
    'v:on' in p.boxes and 'v:0' in p.boxes
    p.boxes['v:on'][1] gt p.boxes['v:1'][1]
    _event_of[_shown[_press_on[p, 'v:back'], panels], 'v', 'step'].num eq 0.0

--- an app bar as the page scrolls past its threshold: hidden going
--- down and shown going up (all of it, fully), never on a page too short;
--- inverted the other way about; flat at the top (elevate), collapsed past
--- the threshold, its image fading
test an_app_bar_hides_collapses_and_elevates_as_the_page_scrolls[]
    _fresh[]
    s0 = unscrolled[]
    s1 = bar_scrolled[s0, 100.0, 700.0, 3000.0, 'hide']
    s1.shown and s1.room eq 64.0 and s1.lifted eq 0.0
    s2 = bar_scrolled[s1, 500.0, 700.0, 3000.0, 'hide']
    not s2.shown
    s2.lifted eq 64.0
    s3 = bar_scrolled[s2, 450.0, 700.0, 3000.0, 'hide']
    s3.shown
    s4 = bar_scrolled[s3, 2300.0, 700.0, 3000.0, 'hide']
    s4.reached and not s4.shown
    s5 = bar_scrolled[s4, 2290.0, 700.0, 3000.0, 'hide']
    s5.shown and not s5.reached
    --- (the same frame again changes nothing)
    bar_scrolled[s2, 500.0, 700.0, 3000.0, 'hide'].shown eq s2.shown
    --- (a page too short to scroll past the threshold and the bar)
    short = bar_scrolled[bar_scrolled[s0, 100.0, 700.0, 1000.0, 'hide'], 300.0, 700.0, 1000.0, 'hide']
    short.shown
    --- (hide keeps the extension, fully-hide hides it too, flat)
    e = bar_scrolled[bar_scrolled[s0, 100.0, 700.0, 3000.0, 'hide', 300.0, 64.0, 48.0], 500.0, 700.0, 3000.0, 'hide', 300.0, 64.0, 48.0]
    e.room eq 64.0 and e.lifted eq 64.0
    f = bar_scrolled[bar_scrolled[s0, 100.0, 700.0, 3000.0, 'fully-hide', 300.0, 64.0, 48.0], 500.0, 700.0, 3000.0, 'fully-hide', 300.0, 64.0, 48.0]
    f.room eq 112.0 and f.lifted eq 112.0 and f.flat
    --- (inverted: shown only past the threshold, taking no room)
    i1 = bar_scrolled[s0, 100.0, 700.0, 3000.0, 'hide inverted']
    not i1.shown and i1.room eq 0.0 and i1.lifted eq 64.0
    i2 = bar_scrolled[i1, 400.0, 700.0, 3000.0, 'hide inverted']
    i2.shown and i2.lifted eq 0.0
    --- (elevate, collapse, fade-image, and the other way about)
    bar_scrolled[s0, 0.0, 700.0, 3000.0, 'elevate'].flat
    not bar_scrolled[s0, 10.0, 700.0, 3000.0, 'elevate'].flat
    bar_scrolled[s0, 10.0, 700.0, 3000.0, 'elevate inverted'].flat
    not bar_scrolled[s0, 10.0, 700.0, 3000.0, 'collapse'].collapsed
    bar_scrolled[s0, 300.0, 700.0, 3000.0, 'collapse'].collapsed
    bar_scrolled[s0, 10.0, 700.0, 3000.0, 'collapse inverted'].collapsed
    abs[bar_scrolled[s0, 150.0, 700.0, 3000.0, 'fade-image'].opacity - 0.5] lt 0.000001
    abs[bar_scrolled[s0, 60.0, 700.0, 3000.0, 'fade-image inverted'].opacity - 0.2] lt 0.000001
    plain = bar_scrolled[s0, 900.0, 700.0, 3000.0, '']
    plain.shown and plain.lifted eq 0.0 and not plain.flat
    --- (the bar: its icon pressed tells `press`, collapsed it is narrow)
    bar = gui.column[[app_bar['top', 'Lory', [tool_button['find', '', 'search']], s0, 'menu']]]
    laid = _shown[_away[], bar]
    _event_of[_shown[_press_on[laid, 'top:lead'], bar], 'top', 'press'].words eq 'lead'
    'find' in laid.boxes
    narrow = gui.column[[app_bar['top', 'A long title', [tool_button['find', '', 'search']], bar_scrolled[s0, 300.0, 700.0, 3000.0, 'collapse'], 'menu']]]
    n = _shown[_away[], narrow]
    not ('find' in n.boxes)
    _shown[_quiet[], narrow]
    display.ground_box['top'][2] eq 112.0
    hidden = gui.column[[app_bar['top', 'Lory', [], s2, 'menu'], gui.button['under', 'Under']]]
    h = _shown[_away[], hidden]
    h.boxes['top:lead'][1] lt 24.0
    system = gui.column[[system_bar[[gui.text['12:30', 12.0]]]]]
    _shown[_quiet[], system]
    _shown[_quiet[], system]
    display.ground_box['system bar'][3] eq 24.0

--- a pagination: a page, an arrow or a key tells the page it goes
--- to; the arrows at the ends are set aside, and all of it where disabled
test a_pagination_tells_the_page_pressed_and_its_keys_step[]
    _fresh[]
    tree = gui.column[[pagination['pages', 10, 3, 7]]]
    laid = _shown[_away[], tree]
    'pages:p6' in laid.boxes and 'pages:p10' in laid.boxes
    not ('pages:p7' in laid.boxes)
    _event_of[_shown[_press_on[laid, 'pages:p5'], tree], 'pages', 'page'].num eq 5.0
    _event_of[_shown[_key['ArrowLeft', false], tree], 'pages', 'page'].num eq 2.0
    _event_of[_shown[_key['ArrowRight', false], tree], 'pages', 'page'].num eq 4.0
    _event_of[_shown[_press_on[laid, 'pages:prev'], tree], 'pages', 'page'].num eq 2.0
    _event_of[_shown[_press_on[laid, 'pages:next'], tree], 'pages', 'page'].num eq 4.0
    first = gui.column[[pagination['pages', 10, 1, 7, first_last = true]]]
    f = _shown[_away[], first]
    'pages:first' in f.boxes and 'pages:last' in f.boxes
    len[_shown[_press_on[f, 'pages:prev'], first].events] eq 0
    _event_of[_shown[_press_on[f, 'pages:last'], first], 'pages', 'page'].num eq 10.0
    off = gui.column[[pagination['pages', 10, 3, 7, disabled = true]]]
    o = _shown[_away[], off]
    len[_shown[_press_on[o, 'pages:p5'], off].events] eq 0
    fitting = gui.column[[pagination['fit', 20, 1, 0, 400.0]]]
    fit = _shown[_away[], fitting]
    'fit:p2' in fit.boxes and 'fit:p20' in fit.boxes
    not ('fit:p3' in fit.boxes)

--- pages in windows: each button tells the page it moves to, for the
--- program to take or refuse
test page_windows_tell_the_move_of_each_button[]
    _fresh[]
    tree = gui.column[[page_windows['tp', 100, 7, 11, 2]]]
    laid = _shown[_away[], tree]
    _event_of[_shown[_press_on[laid, 'tp:more_prev'], tree], 'tp', 'move'].num eq 10.0
    _event_of[_shown[_press_on[laid, 'tp:more_next'], tree], 'tp', 'move'].num eq 13.0
    _event_of[_shown[_press_on[laid, 'tp:p12'], tree], 'tp', 'move'].num eq 12.0
    _event_of[_shown[_press_on[laid, 'tp:last'], tree], 'tp', 'move'].num eq 15.0
    _event_of[_shown[_press_on[laid, 'tp:first'], tree], 'tp', 'move'].num eq 1.0
    _event_of[_shown[_press_on[laid, 'tp:prev'], tree], 'tp', 'move'].num eq 10.0
    start = gui.column[[page_windows['tp', 100, 7, 1, 2]]]
    s = _shown[_away[], start]
    len[_shown[_press_on[s, 'tp:first'], start].events] eq 0

--- a navigation button says its icon where it is given no words, and is
--- pressed; stacked it is a rail's size, inline as wide as its column
test a_navigation_button_has_words_and_is_pressed[]
    _fresh[]
    tree = gui.column[[nav_button['nb', '', 'home', true, '3'], nav_button['nd', 'Drafts', 'file', false, 'dot', 'inline']]]
    laid = _shown[_away[], tree]
    laid.boxes['nb'][2] eq 80.0
    laid.boxes['nb'][3] eq 64.0
    laid.boxes['nd'][2] eq 852.0
    _event_of[_shown[_press_on[laid, 'nb'], tree], 'nb', 'press'].words eq 'home'
    _event_of[_shown[_press_on[laid, 'nd'], tree], 'nd', 'press'].words eq 'Drafts'

--- in a headset, a toolbar's button under the right hand's ray is pressed
--- by its trigger, as a press presses it on a screen
test in_a_headset_a_toolbar_button_under_the_ray_is_pressed_by_its_trigger[]
    _fresh[]
    frame = _in_headset[0, '[]']
    abs[lory.pointer_x[frame] - 500.0] lt 1.0
    tree = toolbar['tools', [tool_button['cut', 'Cut'], tool_button['copy', 'Copy']], flat = true]
    laid = gui.show_at[frame, tree, 470.0, 240.0, 400.0, gui.dark[]]
    b = laid.boxes['cut']
    500.0 gte b[0] and 500.0 lt b[0] + b[2] and 275.0 gte b[1] and 275.0 lt b[1] + b[3]
    pressed = gui.show_at[_in_headset[16, _ray_press[]], tree, 470.0, 240.0, 400.0, gui.dark[]]
    _event_of[pressed, 'cut', 'press'].words eq 'Cut'
