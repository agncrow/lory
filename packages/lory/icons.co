--- Lory's icons: every glyph a control needs, drawn by Lory from its own
--- lines, discs, rings and boxes, in the colour it is given.
---
---     c = icons.draw[c, 'check', x, y, 24.0, look.ink]
---
--- An icon is designed on a grid of 15 units, scaled to the
--- square it is drawn in: its strokes are a unit wide, so an icon drawn 15
--- pixels wide on whole pixels has crisp one-pixel lines, and their ends
--- and corners are round. Where an icon is solid (play, a filled star) it
--- is filled and edged with the same stroke, so its corners are round too.
---
--- The set: the controls' icons (Crow ui's names), a broad set of
--- general icons, and the icons further
--- components ask for (a map's pin, a table's sorts, a
--- player's volume, a hotkey's keys). A name is spelled with hyphens, as
--- the set spells it, or underscores, as Crow does: `eye_off` is `eye-off`.
--- Some names are another's drawing (`close` is `x`); every other name has
--- a drawing of its own. A name the set does not draw is a small square.
--- `names[]` lists them all, `known[name]` says whether one is drawn,
--- `turned` draws an icon turned about its middle (a section's chevron as
--- it opens), `spinning` turned as far as the time has taken a loading
--- icon, and `flipped` mirrored.
---
--- Strokes meet where an icon's parts touch, so an icon drawn in a colour
--- that is not opaque shows its joins darker: draw it opaque (mix the
--- colour with what it is drawn on, `lory.mix`) and fade the whole.

use lory
use math

--- how an icon is being drawn: its square's top left, the pixels one unit
--- of the grid is, a stroke's width in pixels, and its colour
struct Pen [x, y, unit, stroke, color]

--- ---- the set ----

--- the canvas with the icon `name` drawn in the square from (x, y), `size`
--- wide and tall, in the drawing's pixels; a name the set does not draw
--- is a small outlined square
fn draw[c, name, x, y, size, color]
    k = size / 15.0
    p = Pen[x, y, k, k, color]
    _drawn[c, p, _target[_spelled[name]]]

--- every name drawn, spelled with hyphens, in order
fn names[]
    out = slice[[''], 0, 0]
    for n in _crow_set[]
        out = push[out, _spelled[n]]
    for n in _general_set[]
        out = push[out, n]
    for n in _further_set[]
        out = push[out, n]
    for pair in _aliases[]
        out = push[out, pair[0]]
    sorted = sort[out]
    kept = slice[[''], 0, 0]
    i = 0
    while i lt len[sorted]
        if i eq 0 or sorted[i] ne sorted[i - 1]
            kept = push[kept, sorted[i]]
        i = i + 1
    kept

--- whether the set draws the name (a name it does not is drawn as a
--- small square)
fn known[name]
    _drawing[_target[_spelled[name]]]

--- the canvas with the icon drawn as `draw` draws it, then turned
--- clockwise about its square's middle by `degrees`: a chevron that turns
--- as its section opens (a quarter turn is
--- 90 clockwise and -90 counterclockwise). Every shape Lory draws is
--- placed by its corners and shaded from its own corner's numbers, so
--- turning the corners turns the shape whole: a rounded box stays rounded,
--- a line keeps its width
fn turned[c, name, x, y, size, color, degrees]
    before = len[c.verts]
    c = draw[c, name, x, y, size, color]
    --- (whole turns leave it as it is drawn, to the last bit)
    if degrees / 360.0 eq floor[degrees / 360.0]
        return c
    _spun[c, before, x + size / 2.0, y + size / 2.0, degrees]

--- the canvas with the icon drawn as a loading icon is at the frame's
--- time `t` (milliseconds, `lory.time[c]`): turned at an even pace, once
--- round every two seconds. Drawn
--- each frame, it spins
fn spinning[c, name, x, y, size, color, t]
    turned[c, name, x, y, size, color, _spin[t]]

--- how far a loading icon has turned at time t (milliseconds), in degrees:
--- a whole turn every two seconds
fn _spin[t]
    turns = t / 2000.0
    360.0 * (turns - floor[turns])

--- the canvas with the icon drawn as `draw` draws it, then flipped about
--- its square's middle: `horizontally`
--- (left and right swapped: the arrow right points left) or `vertically`
--- (top and bottom swapped). Every shape Lory draws is shaded alike on
--- either side of its middle, so a shape flipped is the shape mirrored
fn flipped[c, name, x, y, size, color, way]
    before = len[c.verts]
    c = draw[c, name, x, y, size, color]
    _mirror[c, before, x + size / 2.0, y + size / 2.0, way eq 'horizontally']

--- the canvas with its vertices from float `before` on mirrored about the
--- line down through (cx, cy) where `across`, else the line across it
fn _mirror[c, before, cx, cy, across]
    vs = c.verts
    step = lory.floats[]
    i = before
    while i lt len[vs]
        if across
            vs[i] = 2.0 * cx - vs[i]
        else
            vs[i + 1] = 2.0 * cy - vs[i + 1]
        i = i + step
    c.verts = vs
    c

--- the canvas with its vertices from float `before` on turned clockwise
--- about (cx, cy) by `degrees`; what they are shaded from is kept
fn _spun[c, before, cx, cy, degrees]
    a = degrees * pi / 180.0
    ca = cos[a]
    sa = sin[a]
    vs = c.verts
    step = lory.floats[]
    i = before
    while i lt len[vs]
        dx = vs[i] - cx
        dy = vs[i + 1] - cy
        vs[i] = cx + dx * ca - dy * sa
        vs[i + 1] = cy + dx * sa + dy * ca
        i = i + step
    c.verts = vs
    c

--- a name as the set spells it: underscores are hyphens
fn _spelled[name]
    replace[name, '_', '-']

--- the name whose drawing a name is: an alias's, or its own
fn _target[name]
    for pair in _aliases[]
        if pair[0] eq name
            return pair[1]
    name

--- ---- drawing on the grid ----

--- (every number below is in units of the grid, from its top left; a pen
--- puts them in the drawing's pixels)

--- a stroke through the points (x0, y0, x1, y1, …): its ends round, a
--- sharp corner rounded by a disc, and a gentle bend closed by the lines
--- on either side reaching past it, so a curve drawn as short lines shows
--- no notches and costs no discs
fn _stroke[c, p, pts]
    _path[c, p, pts, false]

--- a stroke around the points, the last joined to the first
fn _loop[c, p, pts]
    _path[c, p, pts, true]

fn _path[c, p, pts, closed]
    n = len[pts] / 2
    if n lt 2
        return c
    half = p.stroke / p.unit / 2.0
    sides = n - 1
    if closed
        sides = n
    i = 0
    while i lt sides
        j = i + 1
        if j eq n
            j = 0
        ax = pts[2 * i]
        ay = pts[2 * i + 1]
        bx = pts[2 * j]
        by = pts[2 * j + 1]
        dx = bx - ax
        dy = by - ay
        long = sqrt[dx * dx + dy * dy]
        if long gt 0.000001
            back = _reach[pts, n, i, closed, half] / long
            on = _reach[pts, n, j, closed, half] / long
            c = lory.line[c, p.x + (ax - dx * back) * p.unit, p.y + (ay - dy * back) * p.unit, p.x + (bx + dx * on) * p.unit, p.y + (by + dy * on) * p.unit, p.stroke, p.color]
        i = i + 1
    r = p.stroke / 2.0
    i = 0
    while i lt n
        if _turn[pts, n, i, closed] lt 0.9 or _turn[pts, n, i, closed] gt 1.5
            c = lory.circle[c, p.x + pts[2 * i] * p.unit, p.y + pts[2 * i + 1] * p.unit, r, p.color]
        i = i + 1
    c

--- the cosine of the turn a path makes at its point i (1 straight on, -1
--- doubling back), or 2 where the path ends there
fn _turn[pts, n, i, closed]
    h = i - 1
    j = i + 1
    if closed
        if h lt 0
            h = n - 1
        if j eq n
            j = 0
    if h lt 0 or j gte n
        return 2.0
    ux = pts[2 * i] - pts[2 * h]
    uy = pts[2 * i + 1] - pts[2 * h + 1]
    vx = pts[2 * j] - pts[2 * i]
    vy = pts[2 * j + 1] - pts[2 * i + 1]
    lengths = sqrt[(ux * ux + uy * uy) * (vx * vx + vy * vy)]
    if lengths lt 0.000000001
        return -1.0
    (ux * vx + uy * vy) / lengths

--- how far the lines meeting at point i reach past it: half a stroke
--- times the tangent of half the turn, where the bend is gentle (a sharp
--- one and an end are rounded by a disc instead)
fn _reach[pts, n, i, closed, half]
    t = _turn[pts, n, i, closed]
    if t lt 0.9 or t gt 1.5
        return 0.0
    half * sqrt[max[0.0, 1.0 - t] / (1.0 + t)]

--- the convex polygon through the points filled
fn _solid[c, p, pts]
    n = len[pts] / 2
    xs = for i in range[n]
        p.x + pts[2 * i] * p.unit
    ys = for i in range[n]
        p.y + pts[2 * i + 1] * p.unit
    lory.fill[c, xs, ys, p.color]

--- the convex polygon filled and edged, so its corners are round
fn _filled[c, p, pts]
    c = _solid[c, p, pts]
    _loop[c, p, pts]

--- a circle's edge about (cx, cy), the stroke centred on radius r
fn _ring[c, p, cx, cy, r]
    lory.ring[c, p.x + cx * p.unit, p.y + cy * p.unit, r * p.unit + p.stroke / 2.0, p.stroke, p.color]

--- a disc of radius r about (cx, cy)
fn _disc[c, p, cx, cy, r]
    lory.circle[c, p.x + cx * p.unit, p.y + cy * p.unit, r * p.unit, p.color]

--- a box's edge from (x, y), w wide and h tall, the stroke centred on it,
--- its corners rounded to radius r (at r 0 the stroke's own round corner)
fn _box[c, p, x, y, w, h, r]
    s = p.stroke
    lory.round_outline[c, p.x + x * p.unit - s / 2.0, p.y + y * p.unit - s / 2.0, w * p.unit + s, h * p.unit + s, r * p.unit + s / 2.0, s, p.color]

--- a box filled, its corners rounded to radius r
fn _block[c, p, x, y, w, h, r]
    lory.round_rect[c, p.x + x * p.unit, p.y + y * p.unit, w * p.unit, h * p.unit, r * p.unit, p.color]

--- the arc of a circle about (cx, cy) of radius r, from angle a0 to a1 in
--- degrees, clockwise from three o'clock
fn _arc[c, p, cx, cy, r, a0, a1]
    _stroke[c, p, _arc_points[cx, cy, r, r, a0, a1]]

--- an ellipse's edge about (cx, cy), rx across and ry down
fn _oval[c, p, cx, cy, rx, ry]
    _loop[c, p, slice[_arc_points[cx, cy, rx, ry, 0.0, 360.0], 0, 32]]

--- the points of an ellipse's arc about (cx, cy), rx across and ry down,
--- from angle a0 to a1 in degrees clockwise from three o'clock: a point
--- at least every 22.5 degrees
fn _arc_points[cx, cy, rx, ry, a0, a1]
    steps = max[2, ceil[abs[a1 - a0] / 22.5]]
    out = []
    for k in range[steps + 1]
        a = (a0 + (a1 - a0) * k / steps) * pi / 180.0
        out = push[out, cx + rx * cos[a]]
        out = push[out, cy + ry * sin[a]]
    out

--- the points of a quadratic curve from (x0, y0) to (x2, y2), pulled
--- toward (x1, y1)
fn _curve_points[x0, y0, x1, y1, x2, y2]
    out = []
    for k in range[9]
        t = k / 8.0
        u = 1.0 - t
        out = push[out, u * u * x0 + 2.0 * u * t * x1 + t * t * x2]
        out = push[out, u * u * y0 + 2.0 * u * t * y1 + t * t * y2]
    out

--- n strokes out from (cx, cy), from radius r0 to r1, the first at angle
--- a0 (degrees clockwise from three o'clock), the rest evenly round
fn _rays[c, p, cx, cy, r0, r1, n, a0]
    i = 0
    while i lt n
        a = (a0 + 360.0 * i / n) * pi / 180.0
        c = _stroke[c, p, [cx + r0 * cos[a], cy + r0 * sin[a], cx + r1 * cos[a], cy + r1 * sin[a]]]
        i = i + 1
    c

--- n dots of radius r from (x0, y0) to (x1, y1), the first and last on
--- those points
fn _dots[c, p, x0, y0, x1, y1, n, r]
    i = 0
    while i lt n
        t = 0.0
        if n gt 1
            t = (0.0 + i) / (n - 1)
        c = _disc[c, p, x0 + (x1 - x0) * t, y0 + (y1 - y0) * t, r]
        i = i + 1
    c

--- a dashed line from (x0, y0) to (x1, y1): `on` units drawn, `off` left
fn _dashes[c, p, x0, y0, x1, y1, on, off]
    lory.dashed[c, p.x + x0 * p.unit, p.y + y0 * p.unit, p.x + x1 * p.unit, p.y + y1 * p.unit, p.stroke, p.color, on * p.unit, off * p.unit, 0.0]

--- the pen with strokes w units wide
fn _wide[p, w]
    Pen[p.x, p.y, p.unit, p.unit * w, p.color]

--- the points turned clockwise about the square's middle by q quarter
--- turns: a drawing made pointing right points down at 1, left at 2 and
--- up at 3
fn _turned[pts, q]
    out = []
    n = len[pts] / 2
    for i in range[n]
        x = pts[2 * i]
        y = pts[2 * i + 1]
        if q % 4 eq 0
            out = push[out, x]
            out = push[out, y]
        if q % 4 eq 1
            out = push[out, 15.0 - y]
            out = push[out, x]
        if q % 4 eq 2
            out = push[out, 15.0 - x]
            out = push[out, 15.0 - y]
        if q % 4 eq 3
            out = push[out, y]
            out = push[out, 15.0 - x]
    out

--- the points seen in a mirror: left and right swapped
fn _mirrored[pts]
    out = []
    n = len[pts] / 2
    for i in range[n]
        out = push[out, 15.0 - pts[2 * i]]
        out = push[out, pts[2 * i + 1]]
    out

--- an arrow's head: two strokes `size` long meeting at its tip (x, y),
--- pointing at angle `a` (degrees clockwise from three o'clock)
fn _head[c, p, x, y, a, size]
    l = (a + 135.0) * pi / 180.0
    r = (a - 135.0) * pi / 180.0
    _stroke[c, p, [x + size * cos[l], y + size * sin[l], x, y, x + size * cos[r], y + size * sin[r]]]

--- an arc from angle a0 to a1 about (cx, cy), its end an arrow's head
--- pointing the way the arc goes
fn _arc_arrow[c, p, cx, cy, r, a0, a1, size]
    c = _arc[c, p, cx, cy, r, a0, a1]
    t = a1 * pi / 180.0
    way = a1 + 90.0
    if a1 lt a0
        way = a1 - 90.0
    _head[c, p, cx + r * cos[t], cy + r * sin[t], way, size]

--- a five-pointed star's points about (cx, cy), its tips `outer` from
--- the middle and the corners between them `inner`, from the top tip
--- round clockwise
fn _star_points[cx, cy, outer, inner]
    out = []
    for k in range[10]
        r = outer
        if k % 2 eq 1
            r = inner
        t = (-90.0 + 36.0 * k) * pi / 180.0
        out = push[out, cx + r * cos[t]]
        out = push[out, cy + r * sin[t]]
    out

--- a line from x0 to x1 at height y with a ring on it at x = k, the line
--- broken where the ring is (a mixer's track and knob), turned by q
--- quarter turns
fn _track[c, p, x0, x1, y, k, q]
    c = _stroke[c, p, _turned[[x0, y, k - 2.75, y], q]]
    c = _stroke[c, p, _turned[[k + 2.75, y, x1, y], q]]
    m = _turned[[k, y], q]
    _ring[c, p, m[0], m[1], 1.5]

--- the points turned clockwise about the square's middle by `deg`
--- degrees
fn _rotated[pts, deg]
    t = deg * pi / 180.0
    ct = cos[t]
    st = sin[t]
    out = []
    n = len[pts] / 2
    for i in range[n]
        dx = pts[2 * i] - 7.5
        dy = pts[2 * i + 1] - 7.5
        out = push[out, 7.5 + dx * ct - dy * st]
        out = push[out, 7.5 + dx * st + dy * ct]
    out

--- the shape about (cx, cy) through the points filled, as triangles from
--- that middle: a shape every ray from the middle leaves once (a star, a
--- heart) is filled exactly
fn _fan[c, p, cx, cy, pts]
    n = len[pts] / 2
    mx = p.x + cx * p.unit
    my = p.y + cy * p.unit
    i = 0
    while i lt n
        j = (i + 1) % n
        c = lory.triangle[c, mx, my, p.x + pts[2 * i] * p.unit, p.y + pts[2 * i + 1] * p.unit, p.x + pts[2 * j] * p.unit, p.y + pts[2 * j + 1] * p.unit, p.color]
        i = i + 1
    c

--- n small squares a unit wide, from the one about (x0, y0) to the one
--- about (x1, y1): a dotted guide, crisp where its middles are on half
--- units
fn _specks[c, p, x0, y0, x1, y1, n]
    i = 0
    while i lt n
        t = 0.0
        if n gt 1
            t = (0.0 + i) / (n - 1)
        c = _block[c, p, x0 + (x1 - x0) * t - 0.5, y0 + (y1 - y0) * t - 0.5, 1.0, 1.0, 0.0]
        i = i + 1
    c

--- a square's edge dotted, from (a, a) to (b, b), n dots a side
fn _dotted_square[c, p, a, b, n]
    step = (b - a) / (n - 1)
    c = _specks[c, p, a, a, b, a, n]
    c = _specks[c, p, a, b, b, b, n]
    c = _specks[c, p, a, a + step, a, b - step, n - 2]
    _specks[c, p, b, a + step, b, b - step, n - 2]

--- a guide drawn as a solid line, or as n dots between the ends of `dots`
fn _guide[c, p, line, dots, n, solid]
    if solid
        return _stroke[c, p, line]
    _specks[c, p, dots[0], dots[1], dots[2], dots[3], n]

--- the box from (x, y), w wide and h tall, turned clockwise about the
--- square's middle by q quarter turns: its corner, width and height
fn _turned_rect[x, y, w, h, q]
    if q % 4 eq 1
        return [15.0 - y - h, x, h, w]
    if q % 4 eq 2
        return [15.0 - x - w, 15.0 - y - h, w, h]
    if q % 4 eq 3
        return [y, 15.0 - x - w, h, w]
    [x, y, w, h]

--- a box filled, turned by q quarter turns
fn _block_turned[c, p, x, y, w, h, r, q]
    b = _turned_rect[x, y, w, h, q]
    _block[c, p, b[0], b[1], b[2], b[3], r]

--- the points of an S about (cx, cy), w wide and h tall: the upper bowl
--- from its right round over the top to the middle, the lower from the
--- middle round under the bottom
fn _s_points[cx, cy, w, h]
    rx = w / 2.0
    ry = h / 4.0
    top = _arc_points[cx, cy - ry, rx, ry, -30.0, -270.0]
    low = _arc_points[cx, cy + ry, rx, ry, -90.0, 150.0]
    concat[top, slice[low, 2, len[low]]]

--- a capital A standing from x0 to x1, its top at `top` and its feet on
--- `base`
fn _cap_a[c, p, x0, x1, top, base]
    mid = (x0 + x1) / 2.0
    c = _stroke[c, p, [x0, base, mid, top, x1, base]]
    y = top + (base - top) * 0.65
    f = (base - y) / (base - top)
    _stroke[c, p, [x0 + (mid - x0) * f, y, x1 - (x1 - mid) * f, y]]

--- a small a about x = cx standing on `base`: a bowl of radius r and its
--- stem
fn _small_a[c, p, cx, base, r]
    c = _ring[c, p, cx, base - r, r]
    _stroke[c, p, [cx + r, base - 2.0 * r, cx + r, base]]

--- a chain's link as two halves facing across the middle, turned by
--- `slant` degrees: joined by a bar, broken (pulled apart, the bar's
--- stubs and the break's marks), or apart
fn _link[c, p, kind, slant]
    s = 0.0
    if kind ne 'joined'
        s = 1.0
    left = concat[[6.5 - s, 4.5], _arc_points[4.5 - s, 7.5, 3.0, 3.0, -90.0, -270.0], [6.5 - s, 10.5]]
    c = _stroke[c, p, _rotated[left, slant]]
    c = _stroke[c, p, _rotated[_mirrored[left], slant]]
    if kind eq 'joined'
        return _stroke[c, p, _rotated[[5.0, 7.5, 10.0, 7.5], slant]]
    if kind eq 'broken'
        c = _stroke[c, p, _rotated[[3.5, 7.5, 5.0, 7.5], slant]]
        c = _stroke[c, p, _rotated[[10.0, 7.5, 11.5, 7.5], slant]]
        c = _stroke[c, p, _rotated[[7.5, 1.0, 7.5, 3.0], slant]]
        return _stroke[c, p, _rotated[[7.5, 12.0, 7.5, 14.0], slant]]
    c

--- ---- the names ----

--- Crow ui's closed set, as Crow's spec spells it (language-spec.md, "The
--- icon set")
fn _crow_set[]
    ['check', 'x', 'plus', 'minus', 'chevron_down', 'chevron_up', 'chevron_left', 'chevron_right',
     'arrow_up', 'arrow_down', 'arrow_left', 'arrow_right', 'search', 'menu', 'more', 'settings',
     'user', 'home', 'calendar', 'clock', 'refresh', 'play', 'pause', 'stop', 'upload', 'download',
     'trash', 'edit', 'copy', 'link', 'external', 'info', 'warning', 'error', 'success', 'star',
     'filter', 'sort', 'chart', 'table', 'bell', 'mail', 'lock', 'eye', 'eye_off', 'dollar',
     'bookmark', 'flag', 'tag', 'circle', 'dot', 'loader']

--- the general icons' names
fn _general_set[]
    ['accessibility', 'activity-log', 'align-baseline', 'align-bottom', 'align-center-horizontally',
     'align-center-vertically', 'align-left', 'align-right', 'align-top', 'all-sides', 'angle',
     'archive', 'arrow-bottom-left', 'arrow-bottom-right', 'arrow-down', 'arrow-left',
     'arrow-right', 'arrow-top-left', 'arrow-top-right', 'arrow-up', 'aspect-ratio', 'avatar',
     'backpack', 'badge', 'bar-chart', 'bell', 'blending-mode', 'bookmark', 'bookmark-filled',
     'border-all', 'border-bottom', 'border-dashed', 'border-dotted', 'border-left', 'border-none',
     'border-right', 'border-solid', 'border-split', 'border-style', 'border-top', 'border-width',
     'box', 'box-model', 'button', 'calendar', 'camera', 'card-stack', 'card-stack-minus',
     'card-stack-plus', 'caret-down', 'caret-left', 'caret-right', 'caret-sort', 'caret-up',
     'chat-bubble', 'check', 'check-circled', 'checkbox', 'chevron-down', 'chevron-left',
     'chevron-right', 'chevron-up', 'circle', 'circle-backslash', 'clipboard', 'clipboard-copy',
     'clock', 'code', 'color-wheel', 'column-spacing', 'columns', 'commit', 'component-1',
     'component-2', 'component-boolean', 'component-instance', 'component-none',
     'component-placeholder', 'container', 'cookie', 'copy', 'corner-bottom-left',
     'corner-bottom-right', 'corner-top-left', 'corner-top-right', 'corners', 'countdown-timer',
     'counter-clockwise-clock', 'crop', 'cross-1', 'cross-2', 'cross-circled', 'crosshair-1',
