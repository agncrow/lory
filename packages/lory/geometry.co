    vertex_count[g] eq 30
    len[g.indices] eq 120
    g.positions[0] eq -1.0 and g.positions[1] eq 1.5 and g.positions[2] eq 0.0
    g.normals[2] eq 1.0 and g.normals[len[g.normals] - 1] eq 1.0
    g.uvs[0] eq 0.0 and g.uvs[1] eq 1.0
    len[g.groups] eq 0

