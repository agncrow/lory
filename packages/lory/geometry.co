    c.positions[len[c.positions] - 2] eq 1.5

test a_lathe_turns_its_outline_about_the_y_axis[]
    g = lathe[[0.0, -0.5, 0.5, 0.0, 0.0, 0.5]]
    vertex_count[g] eq 39
    len[g.indices] eq 144
    --- (the first turn is the outline itself, at phi 0: x out along z)
