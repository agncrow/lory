    vertex_count[g] eq 10
    g.indices[0] eq 1 and g.indices[1] eq 2 and g.indices[2] eq 0
    g.uvs[0] eq 0.5 and g.uvs[1] eq 0.5
    vertex_count[circle[1.0, 2]] eq 5
    ring[].positions[0] eq 0.5
    vertex_count[ring[0.5, 1.0, 32, 1]] eq 66
    len[ring[0.5, 1.0, 12, 4].indices] eq 12 * 4 * 6

test a_sphere_has_one_triangle_a_segment_at_each_pole[]
    g = sphere[1.0, 8, 6]
    vertex_count[g] eq 63
    len[g.indices] eq 240
    --- (a pole's uvs are moved half a segment, to the middle of its fan)
    g.uvs[0] eq 0.0625 and g.uvs[1] eq 1.0
    g.uvs[len[g.uvs] - 2] eq 0.9375 and g.uvs[len[g.uvs] - 1] eq 0.0
    _worst_normal[g] lt 0.000000000001
    --- (its upper half keeps both triangles where it is cut off)
    len[sphere[1.0, 8, 6, 0.0, 6.283185307179586, 0.0, 1.5707963267948966].indices] eq 264

test a_cylinder_is_its_side_then_its_top_and_bottom_and_a_cone_has_no_top[]
    g = cylinder[]
    vertex_count[g] eq 196
    len[g.indices] eq 384
    g.groups[0] eq 0 and g.groups[1] eq 192 and g.groups[2] eq 0
    g.groups[3] eq 192 and g.groups[4] eq 96 and g.groups[5] eq 1
    g.groups[6] eq 288 and g.groups[7] eq 96 and g.groups[8] eq 2
    open = cylinder[1.0, 1.0, 1.0, 8, 2, true]
    len[open.groups] eq 3
    k = cone[]
    vertex_count[k] eq 131
    len[k.indices] eq 192
    k.groups[5] eq 2
    _worst_normal[k] lt 0.000000000001

test a_torus_a_knot_and_a_capsule_are_grids_about_their_tubes[]
    vertex_count[torus[]] eq 637
    len[torus[].indices] eq 3456
    vertex_count[torus_knot[]] eq 585
    len[torus_knot[].indices] eq 3072
    _worst_normal[torus_knot[]] lt 0.000000000001
    c = capsule[]
    vertex_count[c] eq 90
    len[c.indices] eq 432
    --- (from the bottom of its lower cap to the top of its upper one)
