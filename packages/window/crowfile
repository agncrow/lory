--- Lory's window: a site's pages before their reader in a headset. Lory,
--- beside it in this repository, is linked in crow_modules/ as Kite's is,
--- by a relative link the repository keeps (`crow install` would link the
--- same folder by its absolute path):
---
---     ln -s ../../lory crow_modules/lory
name = 'window'
deps = map[lory = '../lory']
